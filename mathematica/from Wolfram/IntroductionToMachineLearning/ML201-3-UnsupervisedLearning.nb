Cell[CellGroupData[{

Cell["Feature Extraction", "Section",ExpressionUUID->"47d3ef63-c42a-4506-a7ce-73902e0302f2"],

Cell[TextData[{
 "The images used in this example are taken from ",
 ButtonBox["http://vision.stanford.edu/aditya86/ImageNetDogs/",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://vision.stanford.edu/aditya86/ImageNetDogs/"], None},
  ButtonNote->"http://vision.stanford.edu/aditya86/ImageNetDogs/"],
 ". They have been included in the Images folder included in the archive with \
the course notebooks."
}], "Text",ExpressionUUID->"082bf788-b16a-4224-881a-e4f002db1758"],

Cell[TextData[{
 "Import the images from the ",
 Cell[BoxData["\"\<Images\>\""], "Input",ExpressionUUID->
  "35b84b02-b8f6-48bd-b3bf-036f38a2f404"],
 " directory:"
}], "Text",ExpressionUUID->"7434d450-8e75-4a70-8aa1-3a9ebd82a667"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<Images\>\""}], "}"}],
     "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dogImages", "=", 
   RowBox[{"RandomSample", "[", 
    RowBox[{"Import", "/@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RandomSample", "[", 
         RowBox[{
          RowBox[{"FileNames", "[", 
           RowBox[{"\"\<*.jpg\>\"", ",", "#"}], "]"}], ",", "20"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"{", 
        RowBox[{"\"\<n02085620-Chihuahua\>\"", ",", "\"\<n02088238-basset\>\"",
          ",", "\"\<n02099712-Labrador_retriever\>\""}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"9b5f7ee1-d4d5-4546-8f2a-\
a8eb622f9740"],

Cell[BoxData[
 RowBox[{"Take", "[", 
  RowBox[{"dogImages", ",", "8"}], "]"}]], "Input",ExpressionUUID->"d57f5590-\
d0b9-4449-818b-daf054304ae1"],

Cell[BoxData[
 RowBox[{"dogFeatures", "=", 
  RowBox[{"FeatureExtraction", "[", "dogImages", "]"}]}]], "Input",
 CellID->1001080811,ExpressionUUID->"50747ca3-58fc-4774-9234-90467ff9e978"],

