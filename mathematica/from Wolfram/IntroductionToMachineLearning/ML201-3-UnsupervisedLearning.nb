 "."
}], "Text",ExpressionUUID->"6bc2544e-844d-4de6-88d1-54e62dbbeb7d"],

Cell["Download the MNIST dataset:", "CodeText",ExpressionUUID->"e6484513-7aac-47d4-9f4c-573d37f08d92"],

Cell[BoxData[
 RowBox[{
  RowBox[{"digitImages", "=", 
   RowBox[{"RandomSample", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ResourceData", "[", "\"\<MNIST\>\"", "]"}], "\[LeftDoubleBracket]", 
      RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], ",", "1000"}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"016940e6-9884-4b79-89e7-6812363c77ec"],

Cell[BoxData[
 RowBox[{"Short", "[", "digitImages", "]"}]], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"544f7e62-139a-4756-b3c8-d067c4adcdcc"],

