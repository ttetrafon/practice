Cell[CellGroupData[{

Cell["Clustering", "Section",ExpressionUUID->"a9779798-4eb6-4284-ac2f-63628ab5e007"],

Cell[CellGroupData[{

Cell["\<\
Key idea: Use feature space distance to group data into clusters\
\>", "Subsubsection",ExpressionUUID->"5f281c04-5e37-4f10-b881-69a9a248a593"],

Cell["\<\
If you reduce to only two dimensions, you can see some clusters:\
\>", "Text",ExpressionUUID->"61f2e05e-3fcc-4ee7-92e1-351037e1df4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FeatureSpacePlot", "[", "dogImages", "]"}], ",", "3"}]], "Input",Ex\
pressionUUID->"768ed063-ab96-48f7-9b12-686d58bc373f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["How to Get Those Clusters", "Section",ExpressionUUID->"6d49a0aa-8703-4fee-8d13-b8b831828eb9"],

Cell["Prepare the data for use by a machine learning function:", "Text",ExpressionUUID->"415ef294-71e6-4432-9f3e-7d056249face"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cfImages", "=", 
   RowBox[{"ConformImages", "[", "dogImages", "]"}]}], ";"}]], "Input",Express\
ionUUID->"cd99e0a3-6a08-4f4d-9403-c4a4ed05b436"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dims", "=", 
   RowBox[{"DimensionReduce", "[", 
    RowBox[{"cfImages", ",", "2"}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"03f2f56a-1367-4f4e-9dd5-05ee9e8001b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{"Rule", ",", 
     RowBox[{"{", 
      RowBox[{"dims", ",", "cfImages"}], "}"}]}], "]"}]}], ";"}]], "Input",Exp\
ressionUUID->"06f41e1e-3fa4-46c4-a903-3f596a4243f7"],

Cell[BoxData[
 RowBox[{"data", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",ExpressionUUID->"a18da9ed-cda7-\
4728-9162-071772f29eac"],

Cell[TextData[{
 StyleBox["Now use ", "Text"],
 StyleBox[ButtonBox["FindClusters",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FindClusters.html"], None},
  
  ButtonNote->"http://reference.wolfram.com/language/ref/FindClusters.html"], 
  "Text"],
 StyleBox[" (shows the clustering) or ", "Text"],
 StyleBox[ButtonBox["ClusterClassify",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ClusterClassify.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/ClusterClassify.html"], 
  "Text"],
 StyleBox[" (returns the cluster index for each image):", "Text"]
}], "Text",ExpressionUUID->"e25f5482-ae86-46c5-83e0-be6d9bc23e99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"clusters", " ", "=", 
   RowBox[{"FindClusters", "[", 
    RowBox[{"data", ",", "3"}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"b44725f7-df1d-465d-afca-dc6d7c11f779"],

Cell[BoxData[
 RowBox[{"Length", " ", "/@", " ", "clusters"}]], "Input",ExpressionUUID->"d12f1aea-346d-43fd-a5d4-c3ade23267fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RandomSample", "[", 
    RowBox[{"#", ",", "3"}], "]"}], "&"}], "/@", " ", "clusters"}]], "Input",E\
xpressionUUID->"ad69dcd7-6077-409c-b38e-40a0cf594132"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Clustering Exercise", "Section",ExpressionUUID->"41de18c0-da49-4228-ae5e-5c640a20032d"],

Cell["\<\
From the \[OpenCurlyDoubleQuote]FashionMNIST\[CloseCurlyDoubleQuote] dataset, \
used earlier for the classification exercise, get images of bags in addition \
to sneakers and boots (labels 7, 8 and 9):\
\>", "Text",ExpressionUUID->"b35b1d98-0c3e-458d-8a25-46351e676a77"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fashionMNISTdata", " ", "=", " ", 
   RowBox[{"ResourceData", "[", "\"\<FashionMNIST\>\"", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"517c2a5a-3278-44e3-960c-1213540f3660"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sneakersBootsAndBags", " ", "=", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"fashionMNISTdata", ",", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"7", ",", "8", ",", "9"}], "}"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}]}], "]"}], "//", 
    "Keys"}]}], ";"}]], "Input",ExpressionUUID->"2a3de53a-90cd-4d68-be96-\
dbbccf0b237f"],

Cell["\<\
Construct a 2D clustering diagram that shows how similar to or different from \
each other the three categories are.\
\>", "Text",ExpressionUUID->"768e5116-ec59-4459-aa30-ed4f5748b0f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Clustering as a Basis for Classification", "Section",ExpressionUUID->"10ea6cbf-4d00-48ee-a797-8d9c2e5bc9cd"],

Cell[TextData[{
 "ClusterClassify can create a ",
 ButtonBox["ClassifierFunction",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/ClassifierFunction.html"],
     None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/ClassifierFunction.html"],
 " directly from the clustering of unlabeled data."
}], "Text",ExpressionUUID->"5a6b4812-e8b7-429f-b892-8099a7631d64"],

Cell["Labeled data:", "CodeText",ExpressionUUID->"ea6e993f-1bce-476a-81bc-dce79b2135fa"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"-", "10"}], "\<\"Class A\"\>"},
    {
     RowBox[{"-", "9"}], "\<\"Class A\"\>"},
    {
     RowBox[{"-", "8"}], "\<\"Class A\"\>"},
    {
     RowBox[{"-", "7"}], "\<\"Class A\"\>"},
    {"5", "\<\"Class B\"\>"},
    {"6", "\<\"Class B\"\>"},
    {"7", "\<\"Class B\"\>"},
    {"8", "\<\"Class B\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 Deletable->False,
 GeneratedCell->False,ExpressionUUID->"10a36171-866d-47b0-8ac3-3d5247124a0c"],

Cell["Clustered unlabeled data:", "CodeText",ExpressionUUID->"e2221887-d340-459d-8767-06740c1638e2"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "10"}], ",", 
       RowBox[{"-", "9"}], ",", 
       RowBox[{"-", "8"}], ",", 
       RowBox[{"-", "7"}]}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 Deletable->False,
 GeneratedCell->False,ExpressionUUID->"9b1588c7-973d-43af-85b5-12a74c46fab0"],

Cell["Build a classifier from the clustering:", "CodeText",ExpressionUUID->"ebf0c556-3f31-4f33-8c75-f762fbbb6785"],

Cell[BoxData[
 RowBox[{"c", "=", 
  RowBox[{"ClusterClassify", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "10"}], ",", 
     RowBox[{"-", "9"}], ",", 
     RowBox[{"-", "8"}], ",", 
     RowBox[{"-", "7"}], ",", "5", ",", "6", ",", "7", ",", "8"}], "}"}], 
   "]"}]}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"cf600c42-828f-4c71-babd-0ff57b8d1efd"],

Cell[BoxData[
 RowBox[{"c", "/@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"-", "10"}], ",", 
    RowBox[{"-", "9"}], ",", 
    RowBox[{"-", "8"}], ",", 
    RowBox[{"-", "7"}], ",", "5", ",", "6", ",", "7", ",", "8"}], 
   "}"}]}]], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"5e2f1eff-f9bc-46b7-bbc8-57f38792e489"],

Cell["Classify new data points:", "CodeText",ExpressionUUID->"ef0f8222-a48d-4fc4-bde9-ed79628a920d"],

Cell[BoxData[
 RowBox[{"c", "[", 
  RowBox[{"-", "4"}], "]"}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"73f3737c-4bc1-4afa-8245-89014bcc741c"],

Cell[BoxData[
 RowBox[{"c", "[", "10", "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"1618623b-9ed9-4e35-b2c6-0c1abbc1795b"],

