Cell["\<\
Use SynthesizeMissingValues to impute missing values using the learned \
distribution:\
\>", "Text",
 CellID->603863772,ExpressionUUID->"461c156a-3874-4248-904f-43ed076cdf74"],

Cell[BoxData[
 RowBox[{"SynthesizeMissingValues", "[", 
  RowBox[{"ld", ",", 
   RowBox[{"{", 
    RowBox[{"5.5", ",", 
     RowBox[{"Missing", "[", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->858074235,ExpressionUUID->"6adb748b-29fa-4de2-bcd8-ee23b6859ce3"],

