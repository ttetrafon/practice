Cell[CellGroupData[{

Cell["Feature Extraction", "Section",ExpressionUUID->"448a733e-f363-42cb-9909-aac3b0340072"],

Cell["\<\
Machine learning algorithms work on numerical vectors. Your data may not be \
numerical to begin with.\
\>", "Text",ExpressionUUID->"777259d5-01c6-40b6-894d-d9dc6e17ae6a"],

Cell[CellGroupData[{

Cell["Key idea: Map data to a vector", "Subsection",ExpressionUUID->"00f3aca7-1783-4ab3-a475-f7b7f87f47df"],

Cell["You may think in terms of characters rather than numbers:", "Text",ExpressionUUID->"ac65091e-955b-436d-9eb2-76a80affb53d"],

Cell[BoxData[
 RowBox[{"FeatureExtract", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<the cat is grey\>\"", ",", "\"\<my cat is fast\>\"", 
     ",", "\"\<this dog is scary\>\"", ",", "\"\<the big dog\>\""}], "}"}], 
   ",", "\"\<SegmentedCharacters\>\""}], "]"}]], "Input",ExpressionUUID->\
"354af99c-874c-48f4-9b06-2063607c04bd"],

Cell["Or you may think in terms of words rather than letters:", "Text",ExpressionUUID->"ba53624f-e03a-4566-a7ea-5e0670de6f3e"],

Cell[BoxData[
 RowBox[{"FeatureExtract", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<the cat is grey\>\"", ",", "\"\<my cat is fast\>\"", 
     ",", "\"\<this dog is scary\>\"", ",", "\"\<the big dog\>\""}], "}"}], 
   ",", "\"\<SegmentedWords\>\""}], "]"}]], "Input",ExpressionUUID->"3b3d4704-\
4be0-449d-8247-3c5adf197d84"],

Cell[TextData[{
 "You can use established, w",
 StyleBox["ell-known",
  FontWeight->"Plain"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "algorithms:"
}], "Text",ExpressionUUID->"60d46a24-c476-4a8d-b1fa-790f01534e8f"],

Cell[BoxData[
 RowBox[{"FeatureExtract", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<A large cat\>\"", ",", "\"\<my cat is fast\>\""}], "}"}], 
   ",", "\"\<TFIDF\>\""}], "]"}]], "Input",ExpressionUUID->"6e359957-90d3-\
481d-a456-f4188a3029e2"],

Cell[BoxData[
 RowBox[{"FeatureExtract", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<the cat is grey\>\"", ",", "\"\<my cat is fast\>\"", 
     ",", "\"\<this dog is scary\>\"", ",", "\"\<the big dog\>\""}], "}"}], ",", 
   RowBox[{"{", "\"\<TFIDF\>\"", "}"}]}], "]"}]], "Input",ExpressionUUID->\
"93243546-5d27-453c-bed8-ae06c0121101"],

Cell["\<\
You can perform feature extraction and dimension reduction at the same time:\
\>", "Text",ExpressionUUID->"143a4ba4-0f64-433e-9491-3d27af78e5aa"],

Cell[BoxData[
 RowBox[{"FeatureExtract", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<the cat is grey\>\"", ",", "\"\<my cat is fast\>\"", 
     ",", "\"\<this dog is scary\>\"", ",", "\"\<the big dog\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<TFIDF\>\"", ",", "\"\<DimensionReducedVector\>\""}], "}"}]}],
   "]"}]], "Input",ExpressionUUID->"685e1944-ff01-4812-a1b6-1795c2b1e102"],

