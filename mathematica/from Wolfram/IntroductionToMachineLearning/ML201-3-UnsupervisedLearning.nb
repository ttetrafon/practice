4d3c-8ec9-fbf2db02e3e1"],

Cell["\<\
Try the following different methods available for LearnDistribution to see \
which produces the best result:\
\>", "Text",ExpressionUUID->"1f75d4e8-e0ad-41ac-8551-0cbcc288a16d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"methods", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Multinormal\>\"", ",", "\"\<KernelDensityEstimation\>\"", 
     ",", "\"\<DecisionTree\>\""}], "}"}]}], ";"}]], "Input",ExpressionUUID->\
"749908c4-2ca7-4077-a68a-c7aa14419a08"],

Cell[BoxData[
 RowBox[{"distributions", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"LearnDistribution", "[", 
     RowBox[{"paintings", ",", 
      RowBox[{"Method", "\[Rule]", "#"}]}], "]"}], "&"}], " ", "/@", " ", 
   "methods"}]}]], "Input",ExpressionUUID->"a3232bf6-e136-4c73-8b71-\
c5bd4b6909ce"],

Cell[BoxData[
 RowBox[{"RandomVariate", " ", "/@", " ", "distributions"}]], "Input",Expressi\
onUUID->"1a64dee9-7705-44a4-b45c-1d4f6e52ee44"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Learn to Replace Missing Values", "Section",ExpressionUUID->"201c9ac9-6646-4353-9634-336cf7842a69"],

Cell[TextData[{
 ButtonBox["SynthesizeMissingValues",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/SynthesizeMissingValues.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/SynthesizeMissingValues.html"],\

 " can learn from complete examples to generate replacement values for \
missing values in each new sample:"
}], "Text",ExpressionUUID->"a34a1ec8-41cf-4f7d-8681-9d7b26709dc3"],

Cell[BoxData[
 RowBox[{"SynthesizeMissingValues", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1.1", ",", "1.4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"2.3", ",", "3.1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"3", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Missing", "[", "]"}], ",", "5.4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"8.7", ",", "7.5"}], "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"88dc8ebb-bca5-497f-8f51-135faddef7b9"],

Cell[TextData[{
 "SynthesizeMissingValues can also work with a ",
 ButtonBox["LearnedDistribution",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/LearnedDistribution.html"]\
, None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/LearnedDistribution.html"],
 "."
}], "Text",ExpressionUUID->"1cea7324-c633-44a6-89e2-20ac83323b5f"],

Cell["Train a distribution on a two-dimensional dataset:", "Text",
 CellID->590984867,ExpressionUUID->"0addca74-46d7-4cf0-9e2c-28020817a6a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"iris", "=", 
   RowBox[{
    RowBox[{"ExampleData", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<MachineLearning\>\"", ",", "\"\<FisherIris\>\""}], "}"}], 
      ",", "\"\<Data\>\""}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "3"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[95]:=",
 CellID->413810976,ExpressionUUID->"e9d9a61c-eee2-4afa-a608-0f496acfbda8"],

Cell[BoxData[
 RowBox[{"ld", "=", 
  RowBox[{"LearnDistribution", "[", "iris", "]"}]}]], "Input",
 CellLabel->"In[96]:=",
 CellID->1821755823,ExpressionUUID->"e05f3a0d-1098-4875-9319-fc2ac9f061b7"],

Cell["Plot the PDF along with the training data:", "Text",
 CellID->1985577640,ExpressionUUID->"770c4459-52c3-4ac6-b6e4-9e1a6981f9c5"],

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{"ld", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "4", ",", "8"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "1", ",", "7"}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
