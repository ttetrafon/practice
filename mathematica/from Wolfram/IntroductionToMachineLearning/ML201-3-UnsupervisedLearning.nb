Cell[CellGroupData[{

Cell["LearnDistribution Exercise", "Section",ExpressionUUID->"0a54173d-c8dd-4641-bfbb-e479f4add04c"],

Cell["\<\
Learn a distribution from the following samples of paintings by Van Gogh and \
then produce a few computer-generated imitations in Van \
Gogh\[CloseCurlyQuote]s style, based on the learned distribution.\
\>", "Text",ExpressionUUID->"86bf38c8-56cb-4022-bef0-0514a405c733"],

Cell[TextData[{
 "Source: ",
