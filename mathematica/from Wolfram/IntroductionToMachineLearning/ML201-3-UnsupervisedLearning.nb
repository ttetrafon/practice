Cell[CellGroupData[{

Cell["Learn from Any Kind of Data", "Section",ExpressionUUID->"9140959e-a203-44dc-90ed-7e971970245b"],

Cell[TextData[{
 "Internally, the FindAnomalies function uses ",
 ButtonBox["LearnDistribution",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/LearnDistribution.html"], 
    None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/LearnDistribution.html"],
 " to model the distribution of non-anomalous data in order to detect \
\[OpenCurlyDoubleQuote]out-of-distribution\[CloseCurlyDoubleQuote] examples."
}], "Text",ExpressionUUID->"7f69243d-f820-45f4-bdc0-0fbf5775d8e1"],

Cell["\<\
LearnDistribution can be used on many types of data, including numerical, \
nominal and images.\
\>", "Text",ExpressionUUID->"d566a15d-c329-48c4-b29b-f2fd7446981c"],

