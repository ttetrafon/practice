Cell[CellGroupData[{

Cell["Labeled Data for Supervised Learning", "Section",ExpressionUUID->"240957ca-0b3c-46a6-888e-9d06f121ce4c"],

Cell["\<\
Wolfram Language makes it easy to get started with machine learning. Simply \
put the data and its associated labels into one of the machine learning \
superfunctions.\
\>", "Text",ExpressionUUID->"92a5a574-9116-4cf7-8360-a67b4b99bb11"],

Cell[TextData[{
 "Classification is a supervised learning task; you have to tell the system \
what it is looking at/for. This can be done in Wolfram Language using the ",
 ButtonBox["Classify",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Classify.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Classify.html"],
 " function."
}], "Text",ExpressionUUID->"5cbb8f82-1f59-476d-a706-16d360245737"],

Cell["\<\
Feed a list of images, each with a label \[OpenCurlyDoubleQuote]Day\
\[CloseCurlyDoubleQuote] or \[OpenCurlyDoubleQuote]Night\
\[CloseCurlyDoubleQuote], to Classify:\
\>", "Text",ExpressionUUID->"7638b401-7e51-4149-9fd1-5e0ab2ea77e3"],

