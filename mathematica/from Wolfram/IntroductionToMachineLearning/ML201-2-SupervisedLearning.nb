Cell[CellGroupData[{

Cell["Classification Exercise", "Section",ExpressionUUID->"58065e9c-27d7-4569-99f4-5b04c4c759e4"],

Cell[CellGroupData[{

Cell["Sneaker or Boot", "Subsection",ExpressionUUID->"3360cd86-edf9-4e74-9ec9-17c43ca8d750"],

Cell["\<\
In this exercise, you will use the \[OpenCurlyDoubleQuote]FashionMNIST\
\[CloseCurlyDoubleQuote] dataset from the Wolfram Data Repository to train a \
classifier to distinguish a sneaker from a boot.\
\>", "Text",ExpressionUUID->"57af9697-2494-472e-8283-476543228473"],

Cell["Download the training dataset:", "Text",ExpressionUUID->"2fa18eae-c444-4325-a9f0-b03954b80ec4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trainingData", "=", 
   RowBox[{"ResourceData", "[", 
    RowBox[{"\"\<FashionMNIST\>\"", ",", "\"\<TrainingData\>\""}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"2ae0cb3b-9edb-4b77-940e-bcc759f96b68"],

Cell["Download the test dataset:", "Text",ExpressionUUID->"85466212-0a48-473f-8910-104f9f502400"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testData", "=", 
   RowBox[{"ResourceData", "[", 
    RowBox[{"\"\<FashionMNIST\>\"", ",", "\"\<TestData\>\""}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"cc280bea-01f9-4822-978e-a66c904aa89d"],

Cell["Check the number of samples in each dataset:", "Text",ExpressionUUID->"174244b9-f56a-4baa-a7f2-dfff109bc276"],

Cell[BoxData[
 RowBox[{"Length", "/@", 
  RowBox[{"{", 
   RowBox[{"trainingData", ",", "testData"}], "}"}]}]], "Input",ExpressionUUID\
->"430f3c03-0bf9-4510-9089-80da0a95e19d"],

Cell["\<\
The dataset has images labeled with one of the following 10 labels:\
\>", "Text",ExpressionUUID->"495040d9-cacf-4dbb-a765-6ea7c872a7bf"],

Cell[BoxData[
 RowBox[{"ResourceData", "[", 
  RowBox[{"\"\<FashionMNIST\>\"", ",", "\"\<ClassLabels\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"c3df4798-94a8-42f3-ade5-fd0048d33a61"],

Cell["\<\
Select training examples labeled:
7\[Rule] \"Sneaker\"
or 
9\[Rule] \"Ankle boot\"\
\>", "Text",ExpressionUUID->"241e2f60-ded5-4099-b5ac-f5e7842cb14c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"selectedTrainingData", " ", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"trainingData", ",", 
     RowBox[{
      RowBox[{"MatchQ", "[", 
       RowBox[{
        RowBox[{"Values", "@", "#"}], ",", 
        RowBox[{"7", " ", "|", "9"}]}], "]"}], "&"}]}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"f559775e-3217-49d2-8b72-8675ba979eb6"],

Cell["\<\
Build a classifier to classify images from the TestData dataset as \
\[OpenCurlyDoubleQuote]Sneaker\[CloseCurlyDoubleQuote] or \
\[OpenCurlyDoubleQuote]Ankle boot\[CloseCurlyDoubleQuote]:\
\>", "Text",ExpressionUUID->"dc5196e4-3b34-4df1-8a73-1a83f97d6b29"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"write", " ", "your", " ", "code", " ", "here"}], "*)"}]], "Input",E\
xpressionUUID->"cca0f69a-8e2f-41fb-8a62-cbd3bd827b4e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["On Your Own", "Subsection",ExpressionUUID->"e783bd37-4ccd-4ee0-8b8a-53f1a448c499"],

Cell["\<\
Try using Classify[ ] for identifying images of any of the following famous \
pairs:\
\>", "Text",ExpressionUUID->"aaced4b3-4cfe-4d0e-bdd3-71f857a4568c"],

Cell["Dogs and cats", "Item",ExpressionUUID->"655c65f5-6a28-488e-a6ec-9d83671ef573"],

Cell["Tom and Jerry", "Item",ExpressionUUID->"f7087073-ef31-4508-882c-1b5f79b3f734"],

Cell["Chalk and cheese", "Item",ExpressionUUID->"9ed7eb64-2025-4aab-a042-a8ac81b94947"],

Cell["Hammer and nails", "Item",ExpressionUUID->"7e7d3f10-c4d7-4e2f-af50-25bf96c3fb11"],

Cell["Fish and chips", "Item",ExpressionUUID->"fb4425c5-e63b-459b-99e2-5a5257912695"],

Cell["Ant and Dec", "Item",ExpressionUUID->"fe5c8dc7-22a1-4ddc-9de3-ffce5f3d1366"],

Cell["Batman and Robin", "Item",ExpressionUUID->"d68819cf-f933-48bc-9d75-6902ff43aa84"],

Cell["Asterix and Obelix", "Item",ExpressionUUID->"557cb816-c0a8-462e-88bf-a2d5eb83bc21"],

Cell["\<\
Your classifier function must be able to identify a new image that it has not \
seen before as one of the two in your pair.\
\>", "Text",ExpressionUUID->"c68bf597-6df4-4498-804c-ae06a6a2a65d"],

Cell[TextData[{
 "A helpful function for finding images on the web is ",
 ButtonBox["WebImageSearch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/WebImageSearch.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/WebImageSearch.html"],
 ":"
}], "Text",ExpressionUUID->"611ba817-5d27-4c12-80e1-518e02cf9527"],

Cell[BoxData[
 RowBox[{"WebImageSearch", "[", "\"\<tiger\>\"", "]"}]], "Input",ExpressionUUID->"4de8aa78-a28f-4af9-8b5d-c517b5de6fec"],

Cell[TextData[{
 StyleBox["Note: ",
  FontWeight->"Bold"],
 "WebImageSearch requires internet connectivity and uses external services \
that require ",
 ButtonBox["Service Credits",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.wolfram.com/service-credits/"], None},
  ButtonNote->"https://www.wolfram.com/service-credits/"],
 "."
}], "Text",ExpressionUUID->"3db45575-23ab-4efb-9e07-d7dd4b67c7ab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["A Workflow for Classification", "Section",ExpressionUUID->"b7119996-2790-4104-ac01-ee5574634cb8"],

Cell[CellGroupData[{

Cell["Standard Workflow for Machine Learning", "Subsection",ExpressionUUID->"d5a23c61-8d2d-4cc2-8956-59fb9b6b2d5c"],

Cell["\<\
Most machine learning projects follow a standard workflow. This was outlined \
earlier as:\
\>", "Text",ExpressionUUID->"0ad20843-9136-4194-a6db-ae44ca0e8524"],

Cell["Get data", "Item",ExpressionUUID->"d661fb84-de99-42cb-8e3f-08acf9217d3f"],

Cell["Choose a model", "Item",ExpressionUUID->"90598881-8277-4c55-b3d3-4d94d9184a89"],

Cell["Train the model", "Item",ExpressionUUID->"40641fdc-3326-458e-8e44-b1454f896954"],

Cell["Test the model performance", "Item",ExpressionUUID->"b673d141-2efb-49b9-a8be-218c10c4a135"],

Cell["Deploy for real-world use", "Item",ExpressionUUID->"9fcb7eaf-8052-48d4-9738-9ad0d3041e8f"],

Cell["\<\
In the case of using Classify, the model choice and the training are done \
simultaneously.\
\>", "Text",ExpressionUUID->"6c6a90e6-0c3f-418e-891a-2f25871ef446"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Get the Data", "Subsection",ExpressionUUID->"64331ed5-236d-4c65-9cac-67fe97a58fbc"],

Cell["\<\
A number of datasets are available for trying the task of classification:\
\>", "Text",ExpressionUUID->"be95d417-17ed-41eb-8059-c70ca2d69c95"],

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"ExampleData", "[", "\"\<MachineLearning\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ExampleData", "[", 
       RowBox[{"#", ",", "\"\<LearningTask\>\""}], "]"}], "===", 
      TagBox[
       StyleBox["\"\<Classification\>\"",
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True],
       FullForm]}], ")"}], "&"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"22c211c4-182d-44c6-90f8-77c7bd81f85a"],

Cell["\<\
You can also look at: \
https://datarepository.wolframcloud.com/search/?i=classification\
\>", "Text",ExpressionUUID->"5720c43b-101c-4b6c-8518-8141f33e37df"],

Cell["Get and prep your data:", "Text",ExpressionUUID->"cd176c24-0ee0-47de-b404-f66c4b847121"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trainingDataCl", "=", 
   RowBox[{"ExampleData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<MachineLearning\>\"", ",", "\"\<Titanic\>\""}], "}"}], 
     ",", "\"\<TrainingData\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"ebec486f-f2ce-4674-a2a3-16a2ff98b93b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testingDataCl", "=", 
   RowBox[{"ExampleData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<MachineLearning\>\"", ",", "\"\<Titanic\>\""}], "}"}], 
     ",", "\"\<TestData\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"12eaadc1-192d-4098-9859-1d520daec049"],

Cell[BoxData[
 RowBox[{"trainingDataCl", "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"05865893-f51f-4265-8d82-88246c47324e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Train the Classifier", "Subsection",ExpressionUUID->"fec22c5a-2390-4a24-8ed6-a9d24377c9d8"],

Cell["\<\
The specific machine learning method to be used is automatically selected by \
Classify:\
\>", "Text",ExpressionUUID->"73b7ef61-c22f-451f-a768-ac9ebd46969b"],

Cell[BoxData[
 RowBox[{"classifier", " ", "=", " ", 
  RowBox[{"Classify", "[", "trainingDataCl", "]"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"a90694d0-3561-4d5f-a5f8-dd20c02bbac8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Test the Classifier", "Subsection",ExpressionUUID->"b0f0ddc2-66cb-4ac2-968e-ae77a92fe626"],

Cell[TextData[{
 ButtonBox["ClassifierMeasurements",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ClassifierMeasurements.\
html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/ClassifierMeasurements.html"],
 " provides a suite of commonly used performance metrics to evaluate the \
performance of the classifier."
}], "Text",ExpressionUUID->"3c31bd85-4d39-40de-b90c-361d65b4f21d"],

Cell["\<\
Check how well the trained classifier is performing on the test dataset:\
\>", "Text",ExpressionUUID->"305a67c5-9466-444b-b2b6-ed7240f219d0"],

Cell[BoxData[
 RowBox[{"clMeasures", " ", "=", 
  RowBox[{"ClassifierMeasurements", "[", 
   RowBox[{"classifier", ",", "testingDataCl"}], "]"}]}]], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"ff3c5c4c-2634-4d85-b957-da21c477a925"],

Cell[BoxData[
 RowBox[{"clMeasures", "[", "\"\<Accuracy\>\"", "]"}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"6fb85a90-1028-4680-ad27-d5c6ab9a7da9"],

Cell[BoxData[
 RowBox[{"clMeasures", "[", "\"\<ConfusionMatrixPlot\>\"", "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"8b5d0c55-3d31-4a45-84f0-bd6ab55ac9ed"],

Cell[BoxData[
 RowBox[{"clMeasures", "[", "\"\<Properties\>\"", "]"}]], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"2df52698-0c4d-4d90-bf93-9c789b99c336"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Deploy the Classifier", "Subsection",ExpressionUUID->"f6e4af70-ca6e-40ef-b73d-3ea5ed719337"],

Cell["\<\
Set up a web form to accept inputs that can be fed into your classifier model \
to obtain an output:\
\>", "Text",ExpressionUUID->"a9e4c745-2359-48a6-b438-d43508f6128d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"form", "=", 
   RowBox[{"FormPage", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<class\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<1st\>\"", ",", "\"\<2nd\>\"", ",", "\"\<3rd\>\""}], 
         "}"}]}], ",", 
       RowBox[{"\"\<age\>\"", "\[Rule]", "\"\<Number\>\""}], ",", 
       RowBox[{"\"\<sex\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<male\>\"", ",", "\"\<female\>\""}], "}"}]}]}], "}"}], ",", 
     RowBox[{"Function", "[", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"classifier", "[", 
         RowBox[{"{", 
          RowBox[{"#class", ",", "#age", ",", "#sex"}], "}"}], "]"}], ",", 
        "100"}], "]"}], "]"}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"25b78147-883c-43c1-b0bb-1114840bdd7b"],

Cell["\<\
Deploy the form and the classifier model to work behind the web form:\
\>", "Text",ExpressionUUID->"b18d11b9-b1f5-4c2e-8196-87f1ccc5d86c"],

Cell[BoxData[
 RowBox[{"co", "=", 
  RowBox[{"CloudDeploy", "[", 
   RowBox[{"form", ",", 
    RowBox[{"CloudObject", "[", "\"\<TitanicForm\>\"", "]"}], ",", 
    RowBox[{"Permissions", "\[Rule]", "\"\<Public\>\""}]}], "]"}]}]], "Input",\
ExpressionUUID->"f8a713b8-91f1-4b3b-8ed3-b9faccf1790d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict", "Section",ExpressionUUID->"a5786db7-c1bb-44d9-aa04-1c194809f152"],

Cell[TextData[{
 "The other major machine learning superfunction available in Wolfram \
Language is ",
 ButtonBox["Predict",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Predict.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Predict.html"],
 ". This can help with answering questions of the type, How much? or How many?"
}], "Text",ExpressionUUID->"73533f93-11ba-42cc-ab51-031fc7b4f656"],

Cell["\<\
The labels for the data are actually numerical values. Once you feed the \
labeled data into the Predict function and train it, you get a function that \
can predict a numerical value for any new example it has not seen before.\
\>", "Text",ExpressionUUID->"627a7a5e-116c-4802-a981-ebff9f03dec1"],

Cell[CellGroupData[{

Cell["Get the Data", "Subsection",ExpressionUUID->"42a05f92-405d-4937-bd9e-ae7393c6e030"],

Cell["\<\
Here are the available example datasets for \[OpenCurlyDoubleQuote]Prediction\
\[CloseCurlyDoubleQuote] learning tasks:\
\>", "Text",ExpressionUUID->"4a164fe1-de15-4145-8c7a-2ec8a94f2d65"],

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"ExampleData", "[", "\"\<MachineLearning\>\"", "]"}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ExampleData", "[", 
       RowBox[{"#", ",", "\"\<LearningTask\>\""}], "]"}], "===", 
      TagBox[
       StyleBox["\"\<Prediction\>\"",
        ShowSpecialCharacters->False,
        ShowStringCharacters->True,
        NumberMarks->True],
       FullForm]}], ")"}], "&"}]}], "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"2f7dc9df-abab-4f55-86ad-5442452d9ddc"],

Cell["Set up training and test data:", "Text",ExpressionUUID->"3b7fbdec-47c2-47ea-9817-2dadefc5b3ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trainingDataPr", "=", 
   RowBox[{"ExampleData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<MachineLearning\>\"", ",", "\"\<WineQuality\>\""}], "}"}], 
     ",", "\"\<TrainingData\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"eaeede01-d421-4755-8055-d071b91241c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"testingDataPr", "=", 
   RowBox[{"ExampleData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<MachineLearning\>\"", ",", "\"\<WineQuality\>\""}], "}"}], 
     ",", "\"\<TestData\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[115]:=",ExpressionUUID->"fc4d0324-ac72-4304-b5a3-2715df3b0c92"],

Cell["\<\
Look at the description for each feature variable in an example:\
\>", "Text",ExpressionUUID->"0531f1ce-54d5-4204-84c0-41987d46d489"],

Cell[BoxData[
 RowBox[{"ExampleData", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<MachineLearning\>\"", ",", "\"\<WineQuality\>\""}], "}"}], 
   ",", "\"\<VariableDescriptions\>\""}], "]"}]], "Input",
 CellLabel->
  "In[117]:=",ExpressionUUID->"1656328d-7f6b-4bb6-8dc8-b1376e830216"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Train a Predictor", "Subsection",ExpressionUUID->"f1f27023-2f8f-4774-871c-2134b573b911"],

Cell["Train a predictor function:", "Text",ExpressionUUID->"67d457a6-e6dc-4075-8cf4-aefe4b920048"],

Cell[BoxData[
 RowBox[{"predictor", "=", 
  RowBox[{"Predict", "[", "trainingDataPr", "]"}]}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"87a806f9-df0e-4f21-a034-eae4a39acb06"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Test the Predictor Performance", "Subsection",ExpressionUUID->"6156c8f6-af6c-4474-a2a7-ad17bb3cc2a0"],

Cell[TextData[{
 ButtonBox["PredictorMeasurements",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/PredictorMeasurements.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/PredictorMeasurements.html"],
 " makes it easy to evaluate the performance of the trained predictor using a \
number of commonly used performance metrics."
}], "Text",ExpressionUUID->"5d2134e1-8d27-41a8-8eb4-7a4359f9e26c"],

Cell["Test the performance of the predictor on the test data:", "Text",ExpressionUUID->"6f74d37e-2019-4270-8d88-b7020c768e70"],

Cell[BoxData[
 RowBox[{"predMeasures", "=", 
  RowBox[{"PredictorMeasurements", "[", 
   RowBox[{"predictor", ",", "testingDataPr"}], "]"}]}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"0cbd5b52-2fc5-4382-9e14-1dcca848352d"],

Cell[BoxData[
 RowBox[{"predMeasures", "[", "\"\<StandardDeviation\>\"", "]"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"c4e65c49-0308-41f1-88be-b13fb67b1ba7"],

Cell[BoxData[
 RowBox[{"predMeasures", "[", "\"\<ComparisonPlot\>\"", "]"}]], "Input",Expres\
sionUUID->"74068e45-e674-4653-b101-58b5acf75fe8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Predict What Comes Next in a Sequence", "Section",ExpressionUUID->"da657f5b-41b1-4110-9bcd-c95f89cea01d"],

Cell[TextData[{
 "The ",
 ButtonBox["SequencePredict",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/SequencePredict.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/SequencePredict.html"],
 " function in Wolfram Language uses the Markov model to predict what comes \
next in a sequence based on some existing sequences provided to it. "
}], "Text",ExpressionUUID->"5c27dd0f-851e-43d8-8262-e12f84dad86a"],

Cell[CellGroupData[{

Cell["Text Prediction", "Subsection",ExpressionUUID->"a6222bf3-edad-4061-a53a-4eebbb13a93a"],

Cell[TextData[{
 "Get the text of Jane Austen\[CloseCurlyQuote]s novel ",
 StyleBox["Pride and Prejudice",
  FontSlant->"Italic"],
 ":"
}], "Text",ExpressionUUID->"0f94c47e-62d0-4851-b398-b10b428f7779"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ExampleData", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Text\>\"", ",", "\"\<PrideAndPrejudice\>\""}], "}"}], "]"}], 
  ";"}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"874240b9-b17f-4591-9f59-1d02319740ea"],

Cell["Create a sequence predictor:", "Text",ExpressionUUID->"89e8408a-38e2-4f42-a9e5-e007cabf395f"],

Cell[BoxData[
 RowBox[{"sp", "=", 
  RowBox[{"SequencePredict", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ExampleData", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<Text\>\"", ",", "\"\<PrideAndPrejudice\>\""}], "}"}], 
      "]"}], "}"}], ",", 
    RowBox[{"FeatureExtractor", "\[Rule]", " ", "\"\<SegmentedWords\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"2ddbdf57-4804-44bc-8083-80c32680a201"],

Cell["\<\
Provide a set of characters to begin with and ask for the sequence predicted \
to follow this set:\
\>", "Text",ExpressionUUID->"719de121-6946-4afd-a003-f772da7c86b4"],

Cell[BoxData[{
 RowBox[{"sp", "[", 
  RowBox[{"\"\<Mr. Bingley, I am\>\"", ",", 
   RowBox[{"\"\<RandomNextElement\>\"", "\[Rule]", "50"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"sp", "[", 
  RowBox[{"\"\<Mr. Bingley, I am\>\"", ",", 
   RowBox[{"\"\<RandomNextElement\>\"", "\[Rule]", "50"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"sp", "[", 
  RowBox[{"\"\<Mr. Bingley, I am\>\"", ",", 
   RowBox[{"\"\<NextSequence\>\"", "\[Rule]", "50"}]}], "]"}]}], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"62b5cff1-2d44-4f51-a339-d20f71605bef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise ", "Subsection",ExpressionUUID->"f471dc40-4465-4dd4-b4cd-c4de3d8d0e8d"],

