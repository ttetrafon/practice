Cell[TextData[{
 StyleBox[ButtonBox["NearestNeighbors",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/method/NearestNeighbors.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/method/NearestNeighbors.html"],
  
  FontWeight->"Plain"],
 "\nFind known data points that are nearest to the input sample in feature \
space and use only those to infer the class or value."
}], "Text",ExpressionUUID->"c377bbe7-2d8b-40f1-895e-fcb660214f2b"],

Cell[TextData[{
 StyleBox[ButtonBox["LogisticRegression",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/method/LogisticRegression.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/method/LogisticRegression.\
html"],
  FontWeight->"Plain"],
 "\nFit the best linear combination of logistic sigmoid functions to predict \
a binary outcome based on the input samples."
}], "Text",ExpressionUUID->"f5d5cc6b-c1b6-4f77-b609-32ccab30e4f9"],

Cell[TextData[{
 StyleBox[ButtonBox["SupportVectorMachine",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/method/\
SupportVectorMachine.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/method/SupportVectorMachine.\
html"],
  FontWeight->"Plain"],
 "\nFind the hyperplane that best partitions the data (maximum-margin \
hyperplane)."
}], "Text",ExpressionUUID->"3b2a1bcf-f243-4286-8df6-87a1e2d5d81c"],

Cell[TextData[{
 StyleBox[ButtonBox["RandomForest",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/method/RandomForest.html"]\
, None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/method/RandomForest.html"],
  FontWeight->"Plain"],
 "\nConstruct a decision tree that repeatedly partitions the data. Do this \
repeatedly to create an ensemble of decision trees and choose the decision \
tree that gives the best predictive power."
}], "Text",ExpressionUUID->"ff33618d-dad9-42dc-bbd5-1a08a25d7e8c"],

Cell[TextData[{
 StyleBox[ButtonBox["NaiveBayes",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/method/NaiveBayes.html"], 
    None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/method/NaiveBayes.html"],
  FontWeight->"Plain"],
 "\nDetermine the class using Bayes\[CloseCurlyQuote]s theorem and assuming \
that features are independent given the class."
}], "Text",ExpressionUUID->"4f514bb7-68e8-45e1-ac53-fd340472a040"],

Cell[TextData[{
 StyleBox[ButtonBox["NeuralNetwork",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/method/NeuralNetwork.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/method/NeuralNetwork.html"],
  FontWeight->"Plain"],
 "\nModel class probabilities or predict the value distribution using a \
neural network."
}], "Text",ExpressionUUID->"6ad1957c-fb55-4c53-91f3-337c8bef642f"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options for Classify and Predict", "Section",ExpressionUUID->"903bd697-6ab5-4763-8ed1-4d157038a786"],

Cell[CellGroupData[{

Cell["PerformanceGoal", "Subsection",ExpressionUUID->"71bccf12-f71d-4dc8-9222-9b419f6a82b3"],

Cell["\<\
While training your model, you can specify which aspects of its performance \
should be optimized:\
\>", "Text",ExpressionUUID->"9b561ce3-8afa-4d5e-aa91-18ab4671fb81"],

Cell["\<\
\"DirectTraining\"\[LongDash]train directly on the full dataset, without \
model searching\
\>", "Text",ExpressionUUID->"94b2f6c8-c54e-494a-83a8-6a2d18273f8c"],

Cell["\"Memory\"\[LongDash]minimize storage requirements of the predictor", \
"Text",ExpressionUUID->"6f2d665c-77ee-423c-b7fa-6ac21b01e381"],

Cell["\"Quality\"\[LongDash]maximize accuracy of the predictor", "Text",ExpressionUUID->"e7fabdf4-983b-46f6-a3cc-1ac7a4d3e3b4"],

Cell["\"Speed\"\[LongDash]maximize speed of the predictor", "Text",ExpressionUUID->"48ed3c1d-3380-4148-a396-8118a36c0f6e"],

Cell["\"TrainingSpeed\"\[LongDash]minimize time spent producing the \
predictor", "Text",ExpressionUUID->"96c2effa-9ec4-47f0-8fa4-9a163f3da1f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TimeGoal", "Subsection",ExpressionUUID->"dbd3c6de-9fd3-49e5-82e0-a0a006bfe662"],

Cell["\<\
You can specify how long to spend training the classifier in seconds.\
\>", "Text",ExpressionUUID->"b8c769aa-45ab-4f02-9c68-71207dc87fa0"],

Cell["\<\
Train a classifier while specifying a total training time of 5 seconds:\
\>", "Text",ExpressionUUID->"e6bdcdc7-8610-46c6-956a-6cae0d190973"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Classify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<A\>\"", ",", "\"\<A\>\"", ",", "\"\<B\>\"", 
       ",", "\"\<B\>\""}], "}"}]}], ",", 
    RowBox[{"TimeGoal", "\[Rule]", "5"}]}], "]"}], " ", "//", " ", 
  "AbsoluteTiming"}]], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"2fb212f6-59e3-4ca9-b35f-ed395eebe1f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["TargetDevice", "Subsection",ExpressionUUID->"15932e31-55c8-4185-9604-e94ccb0739ef"],

Cell["The target device on which to perform training:", "Text",ExpressionUUID->"ccce0dfb-9d5f-492f-b3ee-edbb00db5e2e"],

Cell[BoxData[
 RowBox[{"TargetDevice", "\[Rule]", "\"\<CPU\>\"", " ", 
  RowBox[{"(*", 
   RowBox[{"works", " ", "on", " ", "all", " ", "devices"}], 
   "*)"}]}]], "Input",ExpressionUUID->"132c429a-b6ae-4f3a-be06-632131c1392e"],

Cell[BoxData[
 RowBox[{"TargetDevice", "\[Rule]", "\"\<GPU\>\"", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "can", " ", "speed", " ", "up", " ", "the", " ", "process", " ", "does", " ",
      "NOT", " ", "work", " ", "on", " ", "all", " ", "devices"}], ",", " ", 
    RowBox[{
    "compatible", " ", "NVIDIA", " ", "graphics", " ", "card", " ", 
     "required"}]}], "*)"}], " "}]], "Input",ExpressionUUID->"ae2c2a65-e564-\
4da2-9e0e-3115f6976f5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ValidationSet", "Subsection",ExpressionUUID->"91291cd1-8b2c-4af2-9ac5-f9415cbc1319"],

Cell[TextData[{
 "The set of data on which to evaluate the model during training; this can \
improve the accuracy of the classifier function. The ",
 ButtonBox["ValidationSet",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ValidationSet.html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/ValidationSet.html"],
 " also needs to be different from the training set."
}], "Text",ExpressionUUID->"0e5e0986-a7d9-438d-bcd9-101e2c52e7d9"],

Cell["\<\
Train a logistic regression classifier on the Fisher Iris data:\
\>", "Text",
 CellID->937458593,ExpressionUUID->"f7c2ad1e-b74a-4496-8319-cb6289b701c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trainingset", "=", 
   RowBox[{"ExampleData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<MachineLearning\>\"", ",", " ", "\"\<FisherIris\>\""}], 
      "}"}], ",", "\"\<TrainingData\>\""}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[107]:=",
 CellID->3634399,ExpressionUUID->"bc4e680a-7ac7-4244-884f-5fc9d875ae46"],

Cell[BoxData[
 RowBox[{"c1", "=", 
  RowBox[{"Classify", "[", 
   RowBox[{"trainingset", ",", 
    RowBox[{"Method", "\[Rule]", " ", "\"\<LogisticRegression\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[108]:=",
 CellID->1196765458,ExpressionUUID->"d759ee4a-749a-42f7-b14a-d5c009f2b381"],

Cell["\<\
Obtain the L2 regularization coefficient of the trained classifier:\
\>", "Text",
 CellID->143922690,ExpressionUUID->"e581b78d-92fb-4cb0-967d-c72a528b54a3"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"c1", ",", "\"\<L2Regularization\>\""}], "]"}]], "Input",
 CellLabel->"In[110]:=",
 CellID->419980959,ExpressionUUID->"d34fd766-9dff-45d4-b5e1-03a2f17a67cb"],

Cell["Specify a validation set:", "Text",
 CellID->31588121,ExpressionUUID->"6a128832-4f9a-4250-b095-bdb54e153381"],

Cell[BoxData[
 RowBox[{
  RowBox[{"validationset", "=", 
   RowBox[{
    RowBox[{"ExampleData", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<MachineLearning\>\"", ",", " ", "\"\<FisherIris\>\""}], 
       "}"}], ",", "\"\<TestData\>\""}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", "10"}], "]"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[111]:=",
 CellID->111199895,ExpressionUUID->"64ad8f51-58f1-46e8-bddd-2ac32847e4a9"],

Cell[BoxData[
 RowBox[{"c2", "=", 
  RowBox[{"Classify", "[", 
   RowBox[{"trainingset", ",", 
    RowBox[{"ValidationSet", "\[Rule]", "validationset"}], ",", 
    RowBox[{"Method", "\[Rule]", " ", "\"\<LogisticRegression\>\""}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[112]:=",
 CellID->2142427736,ExpressionUUID->"efb29020-ab44-49bf-9a9a-eab0eb23242d"],

Cell["A different L2 regularization coefficient has been selected:", "Text",
 CellID->32090467,ExpressionUUID->"24a3d327-a73b-4235-9f26-cfb59a886e2e"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"c2", ",", "\"\<L2Regularization\>\""}], "]"}]], "Input",
 CellLabel->"In[113]:=",
 CellID->222974767,ExpressionUUID->"8822fe09-bd48-4666-9afd-6bc8741213f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Watch Out for These Issues", "Section",ExpressionUUID->"fb7ad878-aedb-4069-a31f-df4208cceb38"],

Cell[CellGroupData[{

Cell["Unbalanced Data", "Subsection",ExpressionUUID->"c81360f9-da9a-458d-b1c0-ba7338943da0"],

Cell["\<\
Data should be fair and representative. That is not always what you have.\
\>", "Text",ExpressionUUID->"cf7e7e41-f22b-4431-9392-2cd8a84c6ac8"],

Cell["\<\
The data being used to train the following classifier has four male samples \
versus one female sample. The model will have seen far fewer samples of one \
class than the other.\
\>", "Text",ExpressionUUID->"aff09884-667d-4ff9-b83c-761758ff0e0f"],

Cell["Train a classifier with unbalanced data:", "Text",ExpressionUUID->"73bcb825-0d25-47ee-ae8d-6f0b090a572a"],

Cell[BoxData[
 RowBox[{"cf", "=", 
  RowBox[{"Classify", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1.82", "->", "\"\<male\>\""}], ",", 
      RowBox[{"1.90", "->", "\"\<male\>\""}], ",", 
      RowBox[{"1.75", "->", "\"\<male\>\""}], ",", 
      RowBox[{"1.55", "->", "\"\<male\>\""}], ",", 
      RowBox[{"1.6", "->", "\"\<female\>\""}]}], "}"}], ",", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<LogisticRegression\>\"", ",", 
       RowBox[{"\"\<L2Regularization\>\"", "->", ".001"}]}], "}"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"b734d708-7887-423c-8424-175dbdbf5116"],

Cell["Try it on new data:", "Text",ExpressionUUID->"1bb684ba-7db1-4c2d-9067-32da6263e068"],

Cell[BoxData[
 RowBox[{"cf", "[", "1.6", "]"}]], "Input",
 CellLabel->
  "In[144]:=",ExpressionUUID->"e11443fd-e462-4c69-9588-2d7da7844623"],

Cell["Look at the results for various input values:", "Text",ExpressionUUID->"c498648b-02b5-4f69-836c-ba6441015c02"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"cf", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Probability\>\"", ",", "\"\<female\>\""}], "}"}]}], "]"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"77715eb7-f049-422c-b55e-de62637e34e3"],

Cell["Look at the class probabilities for a specific input value:", "Text",ExpressionUUID->"ad0b329b-fc19-467c-9438-6297a142f387"],

Cell[BoxData[
 RowBox[{"cf", "[", 
  RowBox[{"1.6", ",", "\"\<Probabilities\>\""}], "]"}]], "Input",
 CellLabel->
  "In[147]:=",ExpressionUUID->"45e9a158-3894-40f3-9f26-d5987656338b"],

Cell[TextData[{
 "You can use ",
 ButtonBox["ClassPriors",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ClassPriors.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ClassPriors.html"],
 " to specify explicit prior probabilities to assume for output classes, \
independent of anything deduced from the training set:"
}], "Text",ExpressionUUID->"3dc22421-18cf-4a53-b4fa-fa863627856c"],

Cell[BoxData[
 RowBox[{"cf", "[", 
  RowBox[{"1.6", ",", "\"\<Probabilities\>\"", ",", 
   RowBox[{"ClassPriors", "\[Rule]", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<male\>\"", "\[Rule]", "0.5"}], ",", 
      RowBox[{"\"\<female\>\"", "\[Rule]", "0.5"}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[148]:=",ExpressionUUID->"11af56da-72b5-4694-b53a-93baeb2b12d7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Unbalanced Outcomes", "Subsection",ExpressionUUID->"4719d908-c5be-4689-9378-80801cf0b1a4"],

Cell["\<\
Sometimes the most likely prediction is not the best prediction, especially \
if the cost of misclassifying a particular class as the other is more \
expensive than the other way around.\
\>", "Text",ExpressionUUID->"3c790ba0-0c71-4557-887d-789ca30fdee6"],

Cell["Here is a toy dataset with labels \[OpenCurlyDoubleQuote]healthy\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]diseased\
\[CloseCurlyDoubleQuote]:", "Text",ExpressionUUID->"647b6167-3f57-4789-b1ea-\
e7f909ccc213"],

Cell[BoxData[
 RowBox[{
  RowBox[{"trainingset", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "\[Rule]", "\"\<healthy\>\""}], ",", 
     RowBox[{"2", "\[Rule]", "\"\<diseased\>\""}], ",", 
     RowBox[{"3", "\[Rule]", "\"\<healthy\>\""}], ",", 
     RowBox[{"4", "\[Rule]", "\"\<diseased\>\""}], ",", 
     RowBox[{"5", "\[Rule]", "\"\<healthy\>\""}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[93]:=",
 CellID->1648532844,ExpressionUUID->"1979a1b3-1b18-4a00-a5fc-7d85686a7d92"],

Cell["Build a classifier:", "Text",ExpressionUUID->"1b92c1d2-f25c-4fca-95ee-cca0448bc264"],

Cell[BoxData[
 RowBox[{"c", "=", 
  RowBox[{"Classify", "[", "trainingset", "]"}]}]], "Input",
 CellLabel->"In[94]:=",
 CellID->1080564650,ExpressionUUID->"ee5c2bb0-e985-47a1-b31c-f4852761d8bd"],

Cell["Predict the most probable class for a new example:", "Text",
 CellID->510916105,ExpressionUUID->"d30aad4d-0860-46e0-8a8c-4870d18c1962"],

Cell[BoxData[
 RowBox[{"c", "[", 
  RowBox[{"2.5", ",", " ", "\"\<Probabilities\>\""}], "]"}]], "Input",
 CellLabel->"In[95]:=",
 CellID->391508067,ExpressionUUID->"1dffe08f-a761-4dcd-b72b-5410699998fe"],

Cell[BoxData[
 RowBox[{"c", "[", "2.5", "]"}]], "Input",
 CellLabel->"In[96]:=",
 CellID->1327356029,ExpressionUUID->"ba4e32e5-e2e3-457e-b3e8-181082886abd"],

Cell[TextData[{
 "Use ",
 ButtonBox["UtilityFunction",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/UtilityFunction.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/UtilityFunction.html"],
 " to set the decision utility to penalize misclassification of the class ",
 Cell[BoxData["\"\<diseased\>\""], "Input",ExpressionUUID->
  "1df3950a-092c-455f-ae36-704fb58805a5"],
 ":"
}], "Text",
 CellID->2062261006,ExpressionUUID->"1793814d-42f7-4c84-bbea-2284cffd5874"],

Cell[BoxData[
 RowBox[{"c", "[", 
  RowBox[{"2.5", ",", 
   RowBox[{"UtilityFunction", "\[Rule]", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<healthy\>\"", "\[Rule]", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<healthy\>\"", "\[Rule]", " ", "1"}], ",", " ", 
         RowBox[{"\"\<diseased\>\"", "\[Rule]", " ", "0"}]}], "|>"}]}], ",", 
      RowBox[{"\"\<diseased\>\"", "\[Rule]", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<healthy\>\"", "\[Rule]", " ", 
          RowBox[{"-", "1"}]}], ",", 
         RowBox[{"\"\<diseased\>\"", "\[Rule]", "1"}]}], "|>"}]}]}], 
     "|>"}]}]}], "]"}]], "Input",
 CellLabel->"In[91]:=",
 CellID->86712585,ExpressionUUID->"5f10d246-913b-427d-add5-3147b6455e54"],

Cell[BoxData[
 RowBox[{"c", "[", 
  RowBox[{"2.5", ",", 
   RowBox[{"UtilityFunction", "->", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<healthy\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<healthy\>\"", "->", "1"}], ",", 
         RowBox[{"\"\<diseased\>\"", "->", "0"}]}], "|>"}]}], ",", 
      RowBox[{"\"\<diseased\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<healthy\>\"", "->", "0"}], ",", 
         RowBox[{"\"\<diseased\>\"", "->", "1"}]}], "|>"}]}]}], "|>"}]}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"a3653e95-f60e-441e-966d-c8dea707bad9"]
}, Open  ]]
