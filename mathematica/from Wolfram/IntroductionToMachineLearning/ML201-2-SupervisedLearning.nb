Cell[CellGroupData[{

Cell["Get the Data", "Subsection",ExpressionUUID->"2fc3ed03-9de9-4df5-a6a3-e2f52bc875b6"],

Cell[CellGroupData[{

Cell["The Data Repository", "Subsubsection",ExpressionUUID->"02d86d1d-0466-48e8-8b0d-62c63ac8dd50"],

Cell[TextData[{
 "A good place to get data for machine learning projects: ",
 ButtonBox["https://datarepository.wolframcloud.com/category/Machine-Learning",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://datarepository.wolframcloud.com/category/Machine-Learning/"],
     None},
  ButtonNote->
   "https://datarepository.wolframcloud.com/category/Machine-Learning/"]
}], "Text",ExpressionUUID->"3379ee95-413a-4b23-8093-0be72a12238b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Data from the web or a local file", "Subsubsection",ExpressionUUID->"a38f1853-6869-427d-a741-f92a70d2db79"],

Cell[TextData[{
 StyleBox[ButtonBox["Import",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Import.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Import.html"],
  FontWeight->"Plain"],
 StyleBox[" ",
  FontWeight->"Plain"],
 "is one of the most useful and flexible functions in Wolfram Language. The \
syntax for this incredible function is simple:"
}], "Text",ExpressionUUID->"89f47b93-96db-4525-9062-26031bbfe6f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Import", "[", "\"\<https://www.baseball-reference.com/\>\"", "]"}], 
  RowBox[{"(*", 
   RowBox[{"data", " ", "location"}], "*)"}]}]], "Input",ExpressionUUID->\
"c65153b6-db77-492c-9cfe-3b9c5a28baad"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"\"\<https://www.baseball-reference.com/leagues/majors/2022-batting-\
leaders.shtml\>\"", ",", "\"\<Data\>\""}], "]"}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"28b137e7-672e-4024-a444-331f41e52813"],

Cell["\<\
The data location can either be a URL on the web or the path to a local file:\
\
\>", "Text",ExpressionUUID->"c7e49e05-83e1-4221-b2f9-f4545daf46a8"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<Images\>\"", 
     ",", "\"\<n02099712-Labrador_retriever\>\"", 
     ",", "\"\<n02099712_129.jpg\>\""}], "}"}], "]"}], "]"}]], "Input",Express\
ionUUID->"57865a87-463c-4521-bd30-24684a2347db"],

Cell["\<\
The function also has a second argument that can be used to specify which \
elements of the data are to be imported:\
\>", "Text",ExpressionUUID->"27c92d15-791d-436e-9ae1-ea99160bf201"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"\"\<https://www.wolfram.com\>\"", ",", "\"\<Images\>\""}], 
  "]"}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"b4710afe-e614-4cd9-ad56-83eb3a8465bb"],

Cell[BoxData[
 RowBox[{"Import", "[", 
  RowBox[{"\"\<https://www.wolfram.com\>\"", ",", "\"\<Elements\>\""}], 
  "]"}]], "Input",ExpressionUUID->"7a9456a8-00f7-44c4-91c2-17e707611fab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Labeled Data", "Subsection",ExpressionUUID->"64b04477-e101-46fd-b500-376f3e195f40"],

Cell["\<\
Data to be input to the Classify function can be labeled in a few different \
ways:\
\>", "Text",ExpressionUUID->"dccc7fca-19fb-4732-a6a7-a82697cd68a9"],

