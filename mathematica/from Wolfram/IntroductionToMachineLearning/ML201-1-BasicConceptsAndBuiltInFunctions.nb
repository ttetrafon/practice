Cell[CellGroupData[{

Cell["Highlight Different Elements of Text", "Subsection",ExpressionUUID->"97384cc9-a31d-4e2d-a333-91d3c0aebd06"],

Cell["Show the grammatical structure of natural language text:", "Text",ExpressionUUID->"50e87a5b-7f66-4b8c-b0f1-1cca4511a744"],

Cell[BoxData[
 RowBox[{"str", "=", 
  RowBox[{"TextStructure", "[", 
   RowBox[{"\"\<The house is blue. My dog is fast.\>\"", 
    ",", "\"\<ConstituentTree\>\""}], "]"}]}]], "Input",ExpressionUUID->\
"1cea55a0-7d7b-4f76-a35d-6bdffecb25f0"],

Cell["Find parts of speech:", "Text",ExpressionUUID->"034ea457-2ebd-4817-9932-6aa4461d7533"],

Cell[BoxData[
 RowBox[{
  RowBox[{"moon", "=", 
   RowBox[{"WikipediaData", "[", "\"\<Moon\>\"", "]"}]}], ";"}]], "Input",Expr\
essionUUID->"1f18908b-ae52-4ce9-a284-5b303b1b0fca"],

Cell[BoxData[
 RowBox[{"TakeLargest", "[", 
  RowBox[{
   RowBox[{"Counts", "[", 
    RowBox[{"TextCases", "[", 
     RowBox[{"moon", ",", "\"\<Noun\>\""}], "]"}], "]"}], ",", "10"}], 
  "]"}]], "Input",ExpressionUUID->"121afdf9-59af-461c-b222-5c0b9dc60d55"],

Cell["Find quantitative elements:", "Text",ExpressionUUID->"a7beec3c-cddf-4e85-ac53-f3e5033fc708"],

Cell[BoxData[
 RowBox[{"TextCases", "[", 
  RowBox[{"moon", ",", "\"\<Quantity\>\""}], "]"}]], "Input",ExpressionUUID->\
"33feb938-70f2-43cc-9eba-926e7e9a1ac4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Machine Learning for Natural Language Processing (NLP)", "Section",ExpressionUUID->"f695d4d4-11ac-4d5a-86f4-caba6303a970"],

Cell[CellGroupData[{

Cell["Old Workflows for NLP (Fine-Tuned Models\[LongDash]Locally)", \
"Subsection",ExpressionUUID->"db12d2d2-322e-4c70-96d1-a5299431b86f"],

Cell["\<\
So far, the workflow for using deep learning for text applications has been \
as follows:\
\>", "Text",ExpressionUUID->"ca011242-3e80-4020-af7e-154eb7b9b8fc"],

Cell["Find data (a lot, as much as possible!)", "Item",ExpressionUUID->"09d2eb74-2434-4097-8cfb-1b52ba29ef72"],

Cell["\[Implies] Find (pre-trained!!) specialized net & loss (proxy task)", \
"Item",ExpressionUUID->"c4efa3f3-6c65-4b4b-b179-07f7b4e6826f"],

Cell[TextData[{
 "\[Implies] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{"Train", " ", "or", " ", "fine"}], "-", "tune"}]},
       {"Test"},
       {
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Clean", "&"}], " ", "augment", " ", "data"}], "+", 
            "regularize"}], "&"}], " ", "tune", " ", "net"}], ",", "loss", ",", 
         RowBox[{"training", " ", "strategy"}]}]}
      }], ")"}], "N"], TraditionalForm]],ExpressionUUID->
  "b836a99b-225b-4d9c-80e9-6b1029dc586b"]
}], "Item",ExpressionUUID->"a26c948e-6462-4f18-b75f-cd698bd1a7ed"],

Cell["\[Implies] Deploy", "Item",ExpressionUUID->"70ad5797-5926-43ad-9981-337fdf75f7c8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["New Workflows", "Subsection",ExpressionUUID->"82af2288-35e6-4ca8-994a-583941c12240"],

Cell["\<\
In the present world, after the appearance of large language models (LLMs), \
the workflow has morphed into something like this:\
\>", "Text",ExpressionUUID->"22aefa8b-4b61-4bd6-812e-ef4525f88e87"],

Cell["Find a few representative examples", "Item",ExpressionUUID->"c3bc467e-6b7b-41a7-a35b-2a79f3b38c33"],

Cell["\[Implies] Choose a massively trained generalist LLM", "Item",ExpressionUUID->"32cefb4b-0713-49d3-b442-6054c2d2cd41"],

Cell[TextData[{
 "\[Implies] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Create", " ", "specialized", " ", 
         RowBox[{"prompt", "(", "s", ")"}]}]},
       {"Test"},
       {
        RowBox[{"Improve", " ", 
         RowBox[{"prompt", "(", "s", ")"}]}]}
      }], ")"}], "N"], TraditionalForm]],ExpressionUUID->
  "75c3539c-b9c9-4462-9ccf-950d8c846748"]
}], "Item",ExpressionUUID->"bed017e0-d027-468b-8fa0-5cf5be0dbad2"],

Cell["\[Implies] Set a proxy", "Item",ExpressionUUID->"38f8dcd9-f729-4cf4-b8e4-8c3000ff513c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wolfram Language Makes It Easy to Work with LLMs", "Section",ExpressionUUID->"a474c9c2-3d83-4ad7-904d-fcadc07305bd"],

Cell["\<\
You can connect to any generative model service provider: OpenAI, Anthropic, \
PaLM. \
\>", "Text",ExpressionUUID->"b4503485-f84d-4682-8563-4c1607dbe018"],

Cell[TextData[{
 "There are different ways to ",
 ButtonBox["set up access to an LLM",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://support.wolfram.com/62525"], None},
  ButtonNote->"https://support.wolfram.com/62525"],
 ":"
}], "Text",ExpressionUUID->"abd7cb78-69e8-419c-9187-acd8ad57259b"],

Cell["\<\
Splash screen will guide you to get and register an API key from Mathematica \
Preferences \:25ba AI Settings \:25ba Services.\
\>", "Subsubitem",ExpressionUUID->"145adfb9-7533-4661-890b-13f658d6d062"],

Cell[CellGroupData[{

Cell["Find and store the API key under a canonical name.", "Subsubitem",ExpressionUUID->"dcd301d0-2464-48fa-84a9-110613d67544"],

Cell[BoxData[
 RowBox[{"\t\t", 
  RowBox[{
   RowBox[{"SystemCredential", "[", "\"\<XXX_API_KEY\>\"", "]"}], 
   "=", "\"\<yourkeytoXXXservice\>\""}]}]], "Input",ExpressionUUID->"fbcdad6d-\
b7d3-4745-8567-5e393c37b6d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Generate Text", "Subsection",ExpressionUUID->"64b05e9f-6c88-4f96-b048-615136c396ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LLMSynthesize", 
  "[", "\"\<tell me a joke about the International Space Station\>\"", 
  "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"48a81111-dca7-425f-ba23-75dbbf4f9ced"],

Cell[BoxData["\<\"Why don't astronauts living on the International Space \
Station pay rent?\\n\\nBecause it's literally out of this world!\"\>"], \
"Output",
 CellLabel->"Out[5]=",ExpressionUUID->"241581c3-9660-41f3-9a8a-b7236d2991e7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Classify Sentiment", "Subsection",ExpressionUUID->"61560069-e68f-46fa-836e-0864a211d539"],

Cell[BoxData[
