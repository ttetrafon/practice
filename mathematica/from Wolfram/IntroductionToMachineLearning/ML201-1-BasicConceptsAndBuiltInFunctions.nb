Notebook[{

Cell[CellGroupData[{
Cell["Basic Concepts and Built-In Functions", "Subtitle",ExpressionUUID->"abd2714b-c40b-491d-9b98-1f3d249655e3"],

Cell[CellGroupData[{

Cell["Learning Objectives", "Section",ExpressionUUID->"864be964-62a2-4f15-9a29-57e95c5c9314"],

Cell["\<\
Become familiar with common terms and definitions associated with machine \
learning\
\>", "Item",ExpressionUUID->"d8404d93-4f42-4853-b9d6-25b97d0ab21f"],

Cell["Use Wolfram Language functions for machine learning tasks", "Item",ExpressionUUID->"f0cf9d72-3376-4ce4-a041-389e6f343ba2"],

Cell["Know about different machine learning paradigms", "Item",ExpressionUUID->"2f231539-087f-42b3-a859-f8a3f0c66a00"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Definitions", "Section",ExpressionUUID->"c86c3dde-36a3-44d1-9f80-ce8f8c62e1f0"],

Cell[CellGroupData[{

Cell["What Is Machine Learning?", "Subsection",ExpressionUUID->"f553e67f-35ad-4324-9072-a8a3a8979dec"],

Cell["\<\
Machine learning is the process where a computer \
\[OpenCurlyDoubleQuote]learns\[CloseCurlyDoubleQuote] a model from data. \
Instead of giving explicit instructions to the computer to do something, you \
program it to do some tasks by showing it examples.\
\>", "Text",ExpressionUUID->"7a867f5b-4772-4ec0-89f6-49a66b2c6beb"],

Cell[CellGroupData[{

Cell["Useful terms", "Subsubsection",ExpressionUUID->"c6c30ee1-ba7f-42e7-abcb-d883f2fd5a5c"],

Cell[TextData[{
 StyleBox["Data",
  FontWeight->"Bold"],
 ": Digital information collected for the task"
}], "Item",ExpressionUUID->"eaa2ced1-045f-4344-bdf0-2b1de5c3e553"],

Cell[TextData[{
 StyleBox["Dataset",
  FontWeight->"Bold"],
 ": A set of data examples (or observations or samples) to learn from"
}], "Item",ExpressionUUID->"86b3d450-81b7-4e4d-9772-f0950d25c4a6"],

Cell[CellGroupData[{

Cell[TextData[{
 "Independent variables ",
 StyleBox["(or ",
  FontWeight->"Plain"],
 StyleBox["predictor variables",
  FontWeight->"Bold"],
 StyleBox[" or ",
  FontWeight->"Plain"],
 StyleBox["features ",
  FontWeight->"Bold"],
 StyleBox["or attributes or ",
  FontWeight->"Plain"],
 StyleBox["input",
  FontWeight->"Bold"],
 StyleBox[")",
  FontWeight->"Plain"]
}], "Item",
 FontWeight->Bold,ExpressionUUID->"0d9edf0e-1bc3-462e-95c0-ddfe3d30a035"],

Cell[BoxData[
 InterpretationBox[Cell[BoxData[
   FormBox[
    RowBox[{
     OverscriptBox["x", "\[RightVector]"], "\[LongEqual]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["x", "1"], " ", "\[Ellipsis]"}], ",", 
       SubscriptBox["x", "n"]}], "}"}]}], TraditionalForm]], "Subsubsection",
   ExpressionUUID->"729272ff-26c2-48a0-b13d-45a71fae3bbe"],
  ExpressionCell[
   TraditionalForm[
   OverVector[$CellContext`x] == {$CellContext`\[Ellipsis] 
      Subscript[$CellContext`x, 1], 
      Subscript[$CellContext`x, $CellContext`n]}], 
   "Subsubsection"]]], "SubitemParagraph",ExpressionUUID->"31c249e7-da1f-47a6-\
b13d-9ee8311e9227"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Dependent variable ",
 StyleBox["(or ",
  FontWeight->"Plain"],
 StyleBox["response variables",
  FontWeight->"Bold"],
 StyleBox[" or ",
  FontWeight->"Plain"],
 StyleBox["label",
  FontWeight->"Bold"],
 StyleBox[" or ",
  FontWeight->"Plain"],
 StyleBox["output",
  FontWeight->"Bold"],
 StyleBox[")",
  FontWeight->"Plain"]
}], "Item",
 FontWeight->Bold,ExpressionUUID->"09d98a06-8f37-4bc3-aea2-fe37134a7e7b"],

Cell[BoxData[
 InterpretationBox[Cell[BoxData[
   FormBox["y", TraditionalForm]], "Subsubsection",ExpressionUUID->
   "9db52b88-8888-4382-8431-47bf69d90f33"],
  ExpressionCell[
   TraditionalForm[$CellContext`y], "Subsubsection"]]], "SubitemParagraph",Exp\
ressionUUID->"ff0cb1a9-2407-4998-aec1-c92ae34689e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model", "Item",
 FontWeight->Bold,ExpressionUUID->"51850125-1450-40c7-9753-b478465cfaff"],

Cell[CellGroupData[{

Cell["\<\
A function and associated optimization criteria (e.g. distributional \
assumptions) used to approximate the behavior suggested by the data \
\>", "Subitem",ExpressionUUID->"6febc7f0-0b56-4cbd-97cf-e2dbb3ecd328"],

Cell[BoxData[
 InterpretationBox[Cell[BoxData[
   FormBox[
    RowBox[{"y", "\[LongEqual]", 
     RowBox[{"f", "(", 
      OverscriptBox["x", "\[RightVector]"], ")"}]}], TraditionalForm]], 
   "Subsubsection",ExpressionUUID->"ae4f4e6b-84e1-49e9-aad0-2c87704299f6"],
  ExpressionCell[
   TraditionalForm[$CellContext`y == $CellContext`f[
      OverVector[$CellContext`x]]], "Subsubsection"]]], "SubitemParagraph",Exp\
ressionUUID->"2c55baa8-fd86-4d26-b709-ce3c7ab47445"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
A blackbox represented by an algorithm that takes training data as input and \
produces labels/predictions as output\
\>", "Subitem",ExpressionUUID->"32b166a0-d302-46c3-ac38-b5702de4e8af"],

Cell[BoxData[
 InterpretationBox[Cell[BoxData[
   FormBox[
    RowBox[{
     OverscriptBox["x", "\[RightVector]"], "\[Rule]", 
     RowBox[{
      FrameBox[
       InterpretationBox[Cell[
        "Blackbox", "Subsubsection",ExpressionUUID->
         "461f799a-939b-41d1-bf9b-9c22ed51318b"],
        TextCell["Blackbox", "Subsubsection"]],
       StripOnInput->False], "\[Rule]", "y"}]}], TraditionalForm]], 
   "Subsubsection",ExpressionUUID->"7bf83b73-5b32-4540-b3bd-ff0f39663ba7"],
  ExpressionCell[
   TraditionalForm[OverVector[$CellContext`x] -> (Framed[
       TextCell["Blackbox", "Subsubsection"]] -> $CellContext`y)], 
   "Subsubsection"]]], "SubitemParagraph", \
"TraditionalForm",ExpressionUUID->"6ba578f4-2bc9-4465-894c-3a3c401c63e2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Learning", "Item",
 FontWeight->Bold,ExpressionUUID->"6e90f608-3e03-4ce7-a60e-5475cdc443a7"],

Cell["\<\
1) Process of identifying the function or the algorithm (and the \
corresponding parameters) that best represents the relationship between the \
input and output\
\>", "ItemParagraph",ExpressionUUID->"47c79208-3988-4776-89ab-0191e901d070"],

Cell["2) Tuning parameters to fit data", "ItemParagraph",ExpressionUUID->"125e9e34-a36c-49de-ad98-deeed556a285"],

Cell[TextData[{
 "(",
 StyleBox["Parameters: ",
  FontWeight->"Bold"],
 "Values in the model or algorithm that are not assumed by the predictor or \
response variables)"
}], "ItemParagraph",ExpressionUUID->"d39deab5-af8c-4763-b581-4168e63958bc"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

