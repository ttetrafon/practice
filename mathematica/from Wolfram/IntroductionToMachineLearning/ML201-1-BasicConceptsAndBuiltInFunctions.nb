Cell[CellGroupData[{

Cell["Using Built-in Machine Learning in Wolfram Language ", "Section",ExpressionUUID->"52dc7ec6-92f4-47d4-9638-8595f03e0a69"],

Cell["\<\
Wolfram Language has a number of built-in functions powered by machine \
learning that makes it possible for you to skip steps 1\[Dash]4, so you can \
focus on step 5.\
\>", "Text",ExpressionUUID->"48508d3b-5dab-4524-ac30-cb159eb4c950"],

