\"", ",", 
    " ", "\"\<\:09a8\:09ae\:09b8\:09cd\:0995\:09be\:09b0 \:098f\:09ac\:0982 \
\:09b8\:09cd\:09ac\:09be\:0997\:09a4\>\"", 
    ",", "\"\<\:0c39\:0c32\:0c4b \:0c2e\:0c30\:0c3f\:0c2f\:0c41 \:0c38\:0c4d\
\:0c35\:0c3e\:0c17\:0c24\:0c02\>\"", 
    ",", "\"\<\:4f60\:597d\:ff0c\:6b61\:8fce\:5149\:81e8\>\"", 
    ",", "\"\<Bonjour et bienvenue\>\"", 
    ",", "\"\<\:3053\:3093\:306b\:3061\:306f\:3001\:3044\:3089\:3063\:3057\
\:3083\:3044\>\"", 
    ",", "\"\<\:0cb9\:0cb2\:0ccb \:0cae\:0ca4\:0ccd\:0ca4\:0cc1 \:0cb8\:0ccd\
\:0cb5\:0cbe\:0c97\:0ca4\>\"", ",", "\"\<hujambo na karibu\>\"", 
