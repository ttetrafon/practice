Cell[CellGroupData[{

Cell["Generate an Image from Descriptive Text", "Subsection",ExpressionUUID->"8bc9f8a8-e3d6-4bc3-8690-d93dcc3002de"],

Cell["\<\
This requires external service authentication, billing and internet \
connectivity. The following example was created with the OpenAI API:\
\>", "Text",ExpressionUUID->"f9245e37-1806-4e41-baa7-342d38207e81"],

