Cell[CellGroupData[{

Cell["Very easy to use", "Item",ExpressionUUID->"b881ec67-6f7f-4ede-a4fb-86dbdb933ced"],

Cell["\<\
Task oriented: classification, prediction, clustering, dimensionality \
reduction, etc.\
\>", "Subitem",ExpressionUUID->"0a459a17-fc06-4c8a-b4a1-823dc3ba2185"],

Cell["Automatic selection of algorithms and parameters", "Subitem",ExpressionUUID->"a22554ce-506e-4c00-8a6c-08ab6acb2826"],

Cell["\<\
Can handle a wide range of data types (numerical, images, text, etc.)\
\>", "Subitem",ExpressionUUID->"585b08da-34fa-4650-96bc-463ba1a192ac"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Neural Net Framework", "Subsection",ExpressionUUID->"9c8a78e6-de64-41c2-a080-9948c396292b"],

Cell["\<\
Model oriented with capabilities for representation, construction, training \
and deployment of networks\
\>", "Item",ExpressionUUID->"f4a5bef7-ca13-4932-a114-0bf099d04b4f"],

Cell["\<\
High flexibility: symbolic composition and manipulation of layers\
\>", "Item",ExpressionUUID->"d747460f-1034-493d-bcd1-02a7291573b4"],

Cell["\<\
Diverse data types such as image, text and audio handled with dedicated \
encoders and decoders\
\>", "Item",ExpressionUUID->"f4287aad-7c0c-4d62-9fb2-37388f507760"],

Cell[CellGroupData[{

