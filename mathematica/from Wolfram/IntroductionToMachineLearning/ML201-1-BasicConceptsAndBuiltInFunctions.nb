Cell[CellGroupData[{

Cell["Using Built-in Machine Learning in Wolfram Language ", "Section",ExpressionUUID->"0d1957db-a4a7-4eab-a784-22a48269fbd5"],

Cell[CellGroupData[{

Cell["Summarize Text", "Subsection",ExpressionUUID->"02f21e2f-57e8-4b9b-9497-0bc5744d467d"],

Cell["This requires access to a large language model (LLM) API:", "Text",ExpressionUUID->"d73760fd-5134-4ec0-8d4d-e162d314d996"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TextSummarize", "[", 
  RowBox[{"WikipediaData", "[", "\"\<SpaceX\>\"", "]"}], "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"5dc1cbdf-4635-46a3-97b9-452f22a57bce"],

Cell[BoxData["\<\"SpaceX, an American spacecraft manufacturer and launch \
service provider, was founded by Elon Musk in 2002 with the goal of reducing \
space transportation costs and colonizing Mars. The company operates the \
Falcon 9 and Falcon Heavy rockets, the Dragon and Starship spacecraft, and \
offers internet service via its Starlink satellites. SpaceX has achieved \
several milestones, including being the first private company to develop a \
liquid-propellant rocket that reached orbit and to send a spacecraft to the \
International Space Station. From 2019 to present, SpaceX has been involved \
in various projects, including the launch of the world's largest commercial \
satellite constellation, Starlink, and the development of the Starship launch \
vehicle. The company has also made history by launching two NASA astronauts \
into orbit. SpaceX operates manufacturing, refurbishment, development, and \
test facilities across the U.S., and has won numerous contracts from NASA and \
the U.S. military. The company's low launch prices have led to market \
pressure on competitors.\"\>"], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"50eedf84-909f-45cb-a210-bcdece73d5cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TextSummarize", "[", 
  RowBox[{
   RowBox[{"WikipediaData", "[", "\"\<SpaceX\>\"", "]"}], 
   ",", "\"\<Keywords\>\""}], "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"72059243-6767-4f71-b626-ff52d8a1355a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"SpaceX\"\>", ",", "\<\"Elon Musk\"\>", 
   ",", "\<\"space exploration\"\>", ",", "\<\"Falcon 9\"\>", 
   ",", "\<\"Falcon Heavy\"\>", ",", "\<\"Dragon\"\>", 
   ",", "\<\"Starship\"\>", ",", "\<\"Starlink satellites\"\>", 
   ",", "\<\"Mars colonization\"\>", ",", "\<\"rocket launch.\"\>"}], 
  "}"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"23226128-beaa-4c4e-8c69-f408f5cfbe1b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Answer a Question Based on Text Provided", "Subsection",ExpressionUUID->"104b26a0-a54e-4bb8-a447-8bca57f7bba7"],

Cell[TextData[{
 ButtonBox["WikipediaData",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/WikipediaData.html"], 
    None},
  ButtonNote->"https://reference.wolfram.com/language/ref/WikipediaData.html"],
 " utilizes MediaWiki\[CloseCurlyQuote]s API to retrieve article and category \
contents and metadata from the English-language Wikipedia."
}], "Text",ExpressionUUID->"776276be-3114-41e9-8af3-00b006d3898e"],

Cell[TextData[{
 StyleBox[ButtonBox["WikipediaSearch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/WikipediaSearch.html"], 
    None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/WikipediaSearch.html"],
  FontWeight->"Plain"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "utilizes MediaWiki\[CloseCurlyQuote]s API to find article and category \
pages in the English-language Wikipedia:"
}], "Text",ExpressionUUID->"8cb794a7-0803-4330-93e5-ab183aa4da9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "question", "=", "\"\<Who was the architect of the Sagrada Familia?\>\""}], 
  ";"}]], "Input",ExpressionUUID->"4a20c727-3459-4a08-83a5-ef7ca0652a13"],

Cell[BoxData[
 RowBox[{"articles", "=", 
  RowBox[{"WikipediaSearch", "[", 
   RowBox[{"\"\<Content\>\"", "\[Rule]", "question"}], "]"}]}]], "Input",Expre\
ssionUUID->"3ba8d18c-68be-4947-b5bb-5444509c7504"],

Cell[BoxData[
 RowBox[{
  RowBox[{"contents", "=", 
   RowBox[{"WikipediaData", "[", "articles", "]"}]}], ";"}]], "Input",Expressi\
onUUID->"87ff9dc2-2fdf-4e0d-8006-e69a98fb1a5e"],

Cell[BoxData[
 RowBox[{"FindTextualAnswer", "[", 
  RowBox[{"contents", ",", "question"}], "]"}]], "Input",ExpressionUUID->\
"1552b8a5-74e1-4600-b91f-10376e396e97"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Classify Sentiment", "Subsection",ExpressionUUID->"c0fa6d2a-29a4-4ec2-ba54-3245634f0736"],

Cell[BoxData[
 RowBox[{"Classify", "[", 
  RowBox[{"\"\<Sentiment\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<I love this movie\>\"", ",", " ", "\"\<I am so sad\>\"", ",",
      " ", "\"\<My phone broke again\>\""}], "}"}]}], "]"}]], "Input",
 CellTags->"Sentiment",
 CellLabel->"In[1]:=",ExpressionUUID->"2125c910-230f-42a8-8973-6e27d165aa82"],

Cell[BoxData[
 RowBox[{"Classify", "[", 
  RowBox[{"\"\<FacebookTopic\>\"", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<I bought a new computer\>\"", ",", 
     " ", "\"\<happy birthday!\>\"", ",", 
     " ", "\"\<these shoes looks nice\>\""}], "}"}]}], "]"}]], "Input",
 CellTags->"FacebookTopic",
 CellID->1781770441,ExpressionUUID->"bec6ae7b-a62c-4b5c-8b47-55a01e597a67"],

Cell[BoxData[
 RowBox[{"Classify", "[", 
  RowBox[{"\"\<Spam\>\"", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<SALE! Buy more\>\"", ",", " ", "\"\<Call mom now\>\"", ",", 
     " ", "\"\<Send money now\>\""}], "}"}]}], "]"}]], "Input",
 CellTags->"Spam",ExpressionUUID->"d863e288-4d2a-4328-96b2-abadb27798ab"]
}, Open  ]],

