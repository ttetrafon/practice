Cell[CellGroupData[{

Cell["Intermediate Examples", "Section",ExpressionUUID->"9f138fb2-d1eb-ba45-8ebd-813a37b176f9"],

Cell[CellGroupData[{

Cell["N-Body Simulations", "Subsection",ExpressionUUID->"9b296ced-e17d-7c43-aa49-721d25bb4cbf"],

Cell["\<\
Simulate a number of objects that are being attracted by gravity:\
\>", "Text",ExpressionUUID->"2589ec44-6ad4-4848-ada4-12109986dc26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tMax", "=", "5"}], ";", " ", 
  RowBox[{"nBodies", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"simData", "=", "\[IndentingNewLine]", 
  RowBox[{"NBodySimulation", "[", "\[IndentingNewLine]", 
   RowBox[{"\"\<InverseSquare\>\"", ",", "\[IndentingNewLine]", 
    RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mass\>\"", "->", "1"}], ",", 
         RowBox[{"\"\<Position\>\"", "->", "#1"}], ",", 
         RowBox[{"\"\<Velocity\>\"", "->", "#2"}]}], "|>"}], "&"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"nBodies", ",", "3"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"0.1", "*", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nBodies", ",", "3"}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}], ",", 
    "\[IndentingNewLine]", "tMax"}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"43245473-bf90-6748-a4e4-595426f7a2bf"],

Cell["Show the trajectories of all objects:", "Text",ExpressionUUID->"b15b9ab6-8956-f649-8b43-6ef58c54757e"],

Cell[BoxData[
 RowBox[{"trajectories", "=", "\[IndentingNewLine]", 
  RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"simData", "[", 
      RowBox[{"All", ",", "\"\<Position\>\"", ",", "t"}], "]"}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"SphericalRegion", " ", "->", " ", "True"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"32a27526-5b5b-6347-8384-328c5100dfff"],

Cell["Create an animation with tracer lines:", "Text",ExpressionUUID->"3e96e556-de2d-f447-8f86-51c5708847cc"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"simData", "[", 
         RowBox[{"All", ",", "\"\<Position\>\"", ",", "t"}], "]"}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tCurrent"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PerformanceGoal", "->", " ", "\"\<Quality\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"PlotRange", "[", "trajectories", "]"}]}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Point", "[", 
         RowBox[{"simData", "[", 
          RowBox[{"All", ",", "\"\<Position\>\"", ",", "tCurrent"}], "]"}], 
         "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tCurrent", ",", " ", "0.01", ",", " ", "\"\<Time\>\""}], "}"}],
      ",", "0.01", ",", " ", "tMax", ",", "0.1", ",", " ", 
     RowBox[{"Exclusions", " ", "->", " ", "0"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ControlType", " ", "->", " ", "LabeledSlider"}], ",", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"4dcd8f70-c3d0-d64e-a4aa-22daad53dd80"],

Cell[CellGroupData[{

Cell["Periodic Planar Orbits", "Subsubsection",
 CellChangeTimes->{{3.958729701445404*^9, 3.958729725198946*^9}, {
  3.958729858436884*^9, 
  3.9587298848313885`*^9}},ExpressionUUID->"1a215544-0564-4a46-8d46-\
b8c3b72586b8"],

Cell["\<\
In 1993, a zero angular momentum solution to the three-body problem was \
found, with three equal masses moving around a figure-eight shape:\
\>", "Text",ExpressionUUID->"a49bef64-b599-f740-a87a-1abd0deda32e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "=", "10."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"figure8", "=", "\[IndentingNewLine]", 
   RowBox[{"NBodySimulation", "[", "\[IndentingNewLine]", 
    RowBox[{"\"\<InverseSquare\>\"", ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"\"\<Mass\>\"", "\[Rule]", "1"}], ",", 
         RowBox[{"\"\<Position\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0.97000436", ",", 
            RowBox[{"-", "0.24308753"}], ",", "0."}], "}"}]}], ",", 
         RowBox[{"\"\<Velocity\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0.4662036850", ",", "0.4323657300", ",", 
            RowBox[{"-", "0."}]}], "}"}]}]}], "\[RightAssociation]"}], ",", 
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"\"\<Mass\>\"", "\[Rule]", "1"}], ",", 
         RowBox[{"\"\<Position\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.97000436"}], ",", "0.24308753", ",", "0."}], 
           "}"}]}], ",", 
         RowBox[{"\"\<Velocity\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0.4662036850", ",", "0.4323657300", ",", "0."}], 
           "}"}]}]}], "\[RightAssociation]"}], ",", 
       RowBox[{"\[LeftAssociation]", 
        RowBox[{
         RowBox[{"\"\<Mass\>\"", "\[Rule]", "1"}], ",", 
         RowBox[{"\"\<Position\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0.", ",", "0.", ",", "0."}], "}"}]}], ",", 
         RowBox[{"\"\<Velocity\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.93240737"}], ",", 
            RowBox[{"-", "0.86473146"}], ",", "0"}], "}"}]}]}], 
        "\[RightAssociation]"}]}], "}"}], ",", "\[IndentingNewLine]", "T"}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{"figure8", "[", 
         RowBox[{"All", ",", "\"\<Position\>\"", ",", "t"}], "]"}], "]"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tCurrent"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PerformanceGoal", "->", " ", "\"\<Quality\>\""}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", "Automatic"}]}], "\[IndentingNewLine]",
       "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Graphics3D", "[", "\[IndentingNewLine]", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Point", "[", 
         RowBox[{"figure8", "[", 
          RowBox[{"All", ",", "\"\<Position\>\"", ",", "tCurrent"}], "]"}], 
         "]"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tCurrent", ",", " ", "0.01", ",", " ", "\"\<Time\>\""}], "}"}],
      ",", "0.01", ",", " ", "T", ",", "0.1", ",", " ", 
     RowBox[{"Exclusions", " ", "->", " ", "0"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ControlType", " ", "->", " ", "LabeledSlider"}], ",", 
   RowBox[{"SaveDefinitions", "->", "True"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.958729898646435*^9, 3.9587300410824757`*^9}, {
  3.958732789300167*^9, 3.958732848983555*^9}, {3.9587328792381554`*^9, 
  3.9587328795838127`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"cc4b2b3f-b110-a842-914f-bc0e906e7204"],

