Cell[TextData[{
 StyleBox["\[LongDash] Kip Thorne, astrophysicist, 2017 Nobel Prize winner \
and consultant for ",
  FontSize->18,
  FontColor->GrayLevel[0.5]],
 StyleBox["Interstellar",
  FontSize->18,
  FontSlant->"Italic",
  FontColor->GrayLevel[0.5]]
}], "Text",
 TextAlignment->Right,ExpressionUUID->"b472a226-392e-1741-b635-9ea4e2a81602"]
}, Open  ]],

Cell["", "EndOfSlide",ExpressionUUID->"46c72855-53ed-4a7e-be75-c1ad1c5e1a8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"a99cff0a-9334-47d9-a007-66c583b6224e"],

Cell[CellGroupData[{

Cell["Introductory Examples", "Section",ExpressionUUID->"447f66d5-e140-4c4d-9320-8265d576f11c"],

Cell[CellGroupData[{

Cell["Modelling a Projectile", "Subsection",ExpressionUUID->"02f573c0-881f-a141-a47d-d24acc323938"],

Cell["\<\
We can model the projectile as a point mass subject only to uniform gravity.\
\>", "Text",ExpressionUUID->"66e79540-074c-eb43-a7c0-c1668d2a66b9"],

Cell["Newton\[CloseCurlyQuote]s second law gives:", "Text",ExpressionUUID->"6e7b7c9a-e4ab-4a6f-baf2-8702071f609a"],

Cell[TextData[Cell[BoxData[
 TemplateBox[<|"boxes" -> FormBox[
     RowBox[{
       StyleBox["m", "TI"], 
       SuperscriptBox[
        OverscriptBox[
         StyleBox["r", "TI"], "\[RightVector]"], "\[Prime]\[Prime]"], 
       "\[LongEqual]", 
       StyleBox["m", "TI"], 
       OverscriptBox[
        StyleBox["g", "TI"], "\[RightVector]"]}], TraditionalForm], 
   "errors" -> {}, "input" -> "m \\vec{r}'' = m \\vec{g}}", "state" -> 
   "Boxes"|>,
  "TeXAssistantTemplate"]], "Input",
 FontSize->16,ExpressionUUID->"684e5981-d840-ec4e-9a66-96b1a39c96f1"]], "Text",\
ExpressionUUID->"fc7eb069-3c8a-d649-a394-42d83e932988"],

Cell["Define our parameters:", "Text",ExpressionUUID->"9a5e874c-5a30-b44c-94ad-e58e0708c472"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Theta]", "=", 
   RowBox[{"\[Pi]", "/", "6"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v0", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"QuantityMagnitude", "[", 
    RowBox[{"UnitConvert", "[", 
     RowBox[{
      RowBox[{
       TemplateBox[{"\"Earth\"", 
         RowBox[{"Entity", "[", 
           RowBox[{"\"Planet\"", ",", "\"Earth\""}], "]"}], 
         "\"Entity[\\\"Planet\\\", \\\"Earth\\\"]\"", "\"planet\""},
        "Entity"], "[", 
       TemplateBox[{"\"gravity\"", 
         RowBox[{"EntityProperty", "[", 
           RowBox[{"\"Planet\"", ",", "\"Gravity\""}], "]"}], 
         "\"EntityProperty[\\\"Planet\\\", \\\"Gravity\\\"]\""},
        "EntityProperty"], "]"}], ",", "\"\<SI\>\""}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"e610e3e8-b22f-0946-91ef-d9355c4c91e0"],

Cell["Set up the equation (with initial conditions) to solve:", "Text",ExpressionUUID->"3233f520-1286-9b42-b506-55a3a12aa2e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"y", "''"}], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"-", "g"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "''"}], "[", "t", "]"}], "\[Equal]", "0"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"inits", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "'"}], "[", "0", "]"}], "\[Equal]", 
      RowBox[{"v0", "*", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "0", "]"}], "\[Equal]", 
      RowBox[{"v0", "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", "0", "]"}], "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "\[Equal]", "0"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"cd2d5e08-b9a3-3749-82c3-f4db0f24c0af"],

Cell["Solve the system:", "Text",ExpressionUUID->"b41e3d42-8f19-b049-9ab0-6ccce19b62b1"],

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqs", ",", "inits"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0.", ",", "10"}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"58d68d75-23d6-ed46-9f67-a7d1efa460d2"],

Cell["Visualise the trajectory:", "Text",ExpressionUUID->"394475af-f702-7f4a-bc40-45ab30d4e57c"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}]}], "}"}], "/.", "sol"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<Projectile Trajectory\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"6f9b2973-732d-a64d-9d4a-26b42a201356"],

Cell[TextData[{
 "An event corresponds to a particular time ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "a"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "1ed77b02-2eeb-4e4d-a2cf-8a23e609f266"],
 " crossed during the integration of ",
 Cell[BoxData[
  StyleBox["eqns", "TI"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "98797137-f675-9648-9874-58692deccb7b"],
 " in ",
 ButtonBox["NDSolve",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/NDSolve.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/NDSolve.html"],
 ":"
}], "Text",ExpressionUUID->"45bd8c54-7942-d042-9641-cf1edc7841d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"event", "=", 
   RowBox[{"WhenEvent", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], "==", "0"}], ",", 
     RowBox[{"tof", "=", "t"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"eventSol", "=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"NDSolve", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eqs", ",", "inits", ",", "event"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
    "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]}], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"149b40f4-253f-bd41-b148-64ab551d4ade"],

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], ",", 
      RowBox[{"y", "[", "t", "]"}]}], "}"}], "/.", "eventSol"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tof"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "->", 
    RowBox[{"\"\<Time of Flight = \>\"", "<>", 
     RowBox[{"ToString", "[", "tof", "]"}], "<>", "\"\<s\>\""}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->
  "In[104]:=",ExpressionUUID->"92004b0d-62b0-584b-8243-bc1bec8b7f8c"],

Cell["\<\
Define a function to find the \[OpenCurlyQuote]time-of-flight\
\[CloseCurlyQuote] for a projectile:\
\>", "Text",ExpressionUUID->"ac125f72-a4a9-d443-8c5f-155f475c5795"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findTimeOfFlight", "[", 
   RowBox[{"\[Theta]_", "?", "NumericQ"}], "]"}], ":=", "\[IndentingNewLine]",
   "  ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eqs", ",", "inits", ",", "event", ",", "time", ",", "sol"}], 
     "}"}], ",", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"eqs", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "''"}], "[", "t", "]"}], "==", 
         RowBox[{"-", "g"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "==", "0"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"inits", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "==", 
         RowBox[{"v0", "*", 
          RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "0", "]"}], "==", 
         RowBox[{"v0", "*", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"y", "[", "0", "]"}], "==", "0"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"event", "=", 
      RowBox[{"WhenEvent", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "[", "t", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"time", "=", "t"}], ";", " ", "\"\<StopIntegration\>\""}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "    ", 
     RowBox[{"sol", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"eqs", ",", "inits", ",", "event"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "    ", 
     "time"}]}], "\[IndentingNewLine]", "  ", "]"}]}]], "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"3fab052a-9d34-584e-a588-fba2589dc95b"],

Cell["Generate some data for a range of launch angles:", "Text",ExpressionUUID->"b170adf1-d1df-4c4a-9d5c-44ec8c048d11"],

Cell[BoxData[
 RowBox[{
  RowBox[{"projectileData", "=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", 
       RowBox[{"findTimeOfFlight", "[", "\[Theta]", "]"}], ",", 
       RowBox[{"v0", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"findTimeOfFlight", "[", "\[Theta]", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "0.02", ",", 
       FractionBox["\[Pi]", "2"], ",", "0.02"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"03d6c0d6-204d-7a4c-8a6a-43c15e0150fb"],

Cell["\<\
We want to find the launch angle that maximises the horizontal range:\
\>", "Text",ExpressionUUID->"70e120b7-5f00-e445-a2c0-6cc912e6c519"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MaximalBy", "[", 
  RowBox[{"projectileData", ",", 
   RowBox[{
    RowBox[{"#", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "&"}]}], "]"}]], "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"10d858fa-7d6d-e94f-828e-9c4420c6d33c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"0.78`", ",", "1.4352641202387009`", ",", "10.203486937009734`"}], 
   "}"}], "}"}]], "Output",
 CellLabel->
  "Out[107]=",ExpressionUUID->"cf9da551-b9b4-9843-ab4c-a2284ed00721"]
}, Open  ]],

Cell[TextData[{
 "We can also use the built-in ",
 ButtonBox["FindMaximum",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FindMaximum.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FindMaximum.html"],
 ":"
}], "Text",ExpressionUUID->"e0e7bd11-88f0-c643-8794-5fde8ab6decb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\[Theta]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"FindMaximum", "[", 
  RowBox[{
   RowBox[{"v0", "*", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
    RowBox[{"findTimeOfFlight", "[", "\[Theta]", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "0.1"}], "}"}], ",", 
   RowBox[{"AccuracyGoal", "->", "6"}]}], "]"}]}], "Input",
 CellLabel->
  "In[108]:=",ExpressionUUID->"92bfcb3e-d732-3346-ba98-1edd4c83629a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"10.204081628584282`", ",", 
