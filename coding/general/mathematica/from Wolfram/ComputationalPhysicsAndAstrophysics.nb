Cell[CellGroupData[{

Cell["Stellar Cluster Dataset", "Subsection",ExpressionUUID->"a2773a74-c3d9-a547-9746-093f2cc736c1"],

Cell[TextData[{
 "Along with all the curated data from ",
 ButtonBox["Wolfram|Alpha",
