Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"06ce6390-7caf-f241-9286-800eeedf1994"],

Cell[CellGroupData[{

Cell["Intermediate Examples", "Section",ExpressionUUID->"35e9130f-9dcd-fe4b-8e43-3b8d9f739c33"],

Cell[CellGroupData[{

Cell["Properties of the Planck Radiation Law", "Subsection",ExpressionUUID->"42f63f5a-917c-bd41-a8b2-2be7a2da3fa1"],

Cell["\<\

Visualise the spectral radiance for the radiation emitted by a body at 5000 \
degrees Celsius, as a function of wavelength:\
\>", "Text",ExpressionUUID->"e03d031e-f309-e442-8746-f2b068926c09"],

Cell[BoxData[
 RowBox[{"srPlot", "=", 
  RowBox[{"PlanckRadiationLaw", "[", 
   RowBox[{
    TemplateBox[{
     "5000", "\"\[Degree]C\"", "degrees Celsius", "\"DegreesCelsius\""},
     "Quantity"], ",", "\"\<SpectralPlot\>\""}], "]"}]}]], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"ae55f01a-3f78-be48-9116-ee4cac9e56d6"],

Cell["\<\
Determine the peak and mean wavelengths as well as the colour of the body:\
\>", "Text",ExpressionUUID->"7c77c7cd-fc9c-e64a-98d8-1788a65b9b4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"peak", ",", "mean", ",", "color"}], "}"}], "=", 
  "\[IndentingNewLine]", 
  RowBox[{"Map", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"PlanckRadiationLaw", "[", 
       RowBox[{
        TemplateBox[{
         "5000", "\"\[Degree]C\"", "degrees Celsius", "\"DegreesCelsius\""},
         "Quantity"], ",", "#"}], "]"}], "]"}], "&"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\"\<MaxWavelength\>\"", ",", "\"\<MeanWavelength\>\"", 
      ",", "\"\<Color\>\""}], "}"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"8d4733c1-54e3-c84f-a8fa-58e1c19c1c4a"],

Cell["\<\
Compare the visible spectrum with the distribution of spectral radiance for \
5000 degrees Celsius:\
\>", "Text",ExpressionUUID->"2c94d7a9-4a33-1246-ba53-959d36cd3cd8"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"2", "*", 
        RowBox[{"10", "^", 
         RowBox[{"-", "6"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", 
       RowBox[{"10", "^", "14"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", "\[IndentingNewLine]", 
     RowBox[{"ColorFunction", "\[Rule]", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "u"}], "}"}], ",", 
        RowBox[{
         RowBox[{"ColorData", "[", "\"\<VisibleSpectrum\>\"", "]"}], "[", 
         RowBox[{"x", " ", 
          SuperscriptBox["10", "9"]}], "]"}]}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", "srPlot", ",", 
   "\[IndentingNewLine]", 
   InterpretationBox[
    DynamicModuleBox[{Typeset`open = False}, 
     TemplateBox[{"Expression", "SequenceIcon", 
       GridBox[{{
          ItemBox[
           RowBox[{
             TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["Sequence", "IconizedItem"]}]]}, {
          ItemBox[
           RowBox[{
             TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["4", "IconizedItem"]}]]}, {
          ItemBox[
           RowBox[{
             TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
             TagBox["968", "IconizedItem"]}]]}}, 
        GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
        "Column", 
        GridBoxItemSize -> {
         "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
       Dynamic[Typeset`open]},
      "IconizedObject"]],
    Sequence[
    PlotRange -> {{0, 2 10^(-6)}, {0, 2 10^13}}, AspectRatio -> 1/GoldenRatio,
      PlotRangePadding -> 0, 
     Options[$CellContext`plot]],
    SelectWithContents->True,
    Selectable->False]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"103279bc-e0ba-7d49-9389-26a4a4b4a489"],

Cell["Define the Wien distribution law and Rayleigh\[Dash]Jeans\
\[CloseCurlyQuote]s law:", "Text",ExpressionUUID->"2e621a56-bc84-044d-9e5b-\
19335ecf6411"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wienDistributionLaw", "[", 
    RowBox[{"T_", ",", "\[Nu]_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Quantity", "[", 
     RowBox[{"2", ",", 
      FractionBox["\"\<PlanckConstant\>\"", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\"\<SpeedOfLight\>\"", "2"], 
         "*", "\"\<Steradians\>\""}], ")"}]]}], "]"}], "*", 
    SuperscriptBox["\[Nu]", "3"], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"Quantity", "[", 
         RowBox[{"1", ",", 
          
          FractionBox["\"\<PlanckConstant\>\"", \
"\"\<BoltzmannConstant\>\""]}], "]"}], "*", "\[Nu]"}], "T"]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rayleighJeansLaw", "[", 
    RowBox[{"T_", ",", "\[Nu]_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Quantity", "[", 
     RowBox[{"2", ",", 
      FractionBox["\"\<BoltzmannConstant\>\"", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\"\<SpeedOfLight\>\"", "2"], 
         "*", "\"\<Steradians\>\""}], ")"}]]}], "]"}], "*", 
    SuperscriptBox["\[Nu]", "2"], "*", "T"}]}], ";"}]}], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"72e70511-9e35-2d48-bdc9-9526adedad29"],

Cell[TextData[{
 "Also relevant here are the functions ",
 ButtonBox["FormulaLookup",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FormulaLookup.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FormulaLookup.html"],
 " and ",
 ButtonBox["FormulaData",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FormulaData.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FormulaData.html"],
 "!"
}], "Text",ExpressionUUID->"65d5c224-c76e-164f-9d1a-6dbf6252ffc1"],

Cell[BoxData[
 RowBox[{"Grid", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Wein Distribution Law\>\"", ",", 
       RowBox[{"wienDistributionLaw", "[", 
        RowBox[{
         RowBox[{"QuantityVariable", "[", 
          RowBox[{"\"\<T\>\"", ",", "\"\<Temperature\>\""}], "]"}], ",", 
         RowBox[{"QuantityVariable", "[", 
          RowBox[{"\"\<\[Nu]\>\"", ",", "\"\<Frequency\>\""}], "]"}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Rayleigh\[Dash]Jeans' Law\>\"", ",", 
       RowBox[{"rayleighJeansLaw", "[", 
        RowBox[{
         RowBox[{"QuantityVariable", "[", 
          RowBox[{"\"\<T\>\"", ",", "\"\<Temperature\>\""}], "]"}], ",", 
         RowBox[{"QuantityVariable", "[", 
          RowBox[{"\"\<\[Nu]\>\"", ",", "\"\<Frequency\>\""}], "]"}]}], 
        "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"\"\<Planck's Radiation Law\>\"", ",", 
       RowBox[{"Last", "[", 
        RowBox[{"FormulaData", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<PlanckRadiationLaw\>\"", ",", "\"\<Frequency\>\""}], 
          "}"}], "]"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Frame", "\[Rule]", "All"}], ",", 
   RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
   RowBox[{"FrameStyle", "\[Rule]", "LightGray"}], ",", 
   RowBox[{"ItemStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", "\"\<Text\>\"", "}"}], ",", "Automatic"}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"c8ae02ca-9982-644f-b63c-76bdba1dceda"],

Cell[TextData[{
 "Compute the values of the three formulas at 7000 K over the span of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "13"], TraditionalForm]],ExpressionUUID->
  "e2e5a41e-35d6-a343-8ca9-fe06666f5188"],
 " to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", "15"], TraditionalForm]],ExpressionUUID->
  "4d130d59-3032-0c42-8a54-6e0f3e3e0be3"],
 " Hz:"
}], "Text",ExpressionUUID->"3742e6ce-3624-604c-9a58-3005b892065f"],

