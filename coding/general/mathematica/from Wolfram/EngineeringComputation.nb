Cell["Define our equations:", "Text",
 CellChangeTimes->{{3.9826129096324368`*^9, 
  3.98261293485882*^9}},ExpressionUUID->"be58d999-2eb3-5344-8bbd-\
05f6b027e3de"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "x", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqns", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"m", " ", 
       RowBox[{
        RowBox[{"x", "''"}], "[", "t", "]"}]}], "\[Equal]", 
      RowBox[{
       RowBox[{"g", " ", "m"}], "-", 
       FractionBox[
        RowBox[{"k", " ", 
         SuperscriptBox[
          RowBox[{"i", "[", "t", "]"}], "2"]}], 
        SuperscriptBox[
         RowBox[{"x", "[", "t", "]"}], "2"]]}]}], ",", 
     RowBox[{
      RowBox[{"v", "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       RowBox[{"r", " ", 
        RowBox[{"i", "[", "t", "]"}]}], "+", 
       RowBox[{"l", " ", 
        RowBox[{
         RowBox[{"i", "'"}], "[", "t", "]"}]}]}]}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9826129376928864`*^9, 3.982612944292118*^9}, {
  3.98261341003673*^9, 3.982613433817911*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"297ffcf3-ec9b-544c-81f4-2d911e731a47"],

