 CellLabel->"In[27]:=",ExpressionUUID->"6b6d2e7c-d5fd-2a4a-8d74-1af6580078e2"],

Cell[TextData[{
 "Include an external forcing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "cos", 
         RowBox[{"(", 
           RowBox[{"\[Omega]", 
             StyleBox["t", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "F \\cos(\\omega t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bff0a8a0-ed65-3e48-824f-37ac48e1fbad"],
 " to the oscillations:"
}], "Text",
 CellChangeTimes->{{3.981385785981249*^9, 3.9813858119388676`*^9}, {
  3.9813858512170677`*^9, 
  3.9813858776958065`*^9}},ExpressionUUID->"01c221c6-b72d-2445-8510-\
0247f4e6089b"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"b", ",", "m", ",", "k", ",", "F", ",", "\[Omega]", ",", "y"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ode", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"m", " ", 
      RowBox[{
       RowBox[{"y", "''"}], "[", "t", "]"}]}], "+", 
     RowBox[{"b", " ", 
      RowBox[{
       RowBox[{"y", "'"}], "[", "t", "]"}]}], "+", 
     RowBox[{"k", " ", 
      RowBox[{"y", "[", "t", "]"}]}]}], "==", 
    RowBox[{"F", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Omega]", " ", "t"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ic", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "'"}], "[", "0", "]"}], "==", "0"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.981385421427683*^9, 3.981385434014183*^9}, {
  3.9813854672718544`*^9, 3.981385470850443*^9}, {3.981385557821739*^9, 
  3.9813855630487003`*^9}, {3.9813856844986134`*^9, 3.9813857611064625`*^9}, {
  3.981385815992836*^9, 3.9813858467126617`*^9}, {3.9813858966561356`*^9, 
  3.981385955056364*^9}, {3.981387735366331*^9, 3.9813877492283115`*^9}, {
  3.981387794484152*^9, 3.9813877947958775`*^9}, {3.9813882708037415`*^9, 
  3.9813882709858265`*^9}, {3.9825144551909447`*^9, 3.982514455468977*^9}, {
  3.9825190845728188`*^9, 3.982519100216358*^9}, {3.982520067170656*^9, 
  3.982520087612337*^9}, {3.9827431967645664`*^9, 
  3.982743213189953*^9}},ExpressionUUID->"10996254-5649-814e-9193-\
d08eb5ce06e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"forcedSol", "=", 
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ode", ",", "ic"}], "}"}], ",", 
     RowBox[{"y", "[", "t", "]"}], ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "[", "t_", "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"forcedSol", ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", ">", "0"}], ",", 
       RowBox[{"b", ">", "0"}], ",", 
       RowBox[{"k", ">", "0"}], ",", 
       RowBox[{"\[Omega]", ">", "0"}]}], "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.981385421427683*^9, 3.981385434014183*^9}, {
  3.9813854672718544`*^9, 3.981385470850443*^9}, {3.981385557821739*^9, 
  3.9813855630487003`*^9}, {3.9813856844986134`*^9, 3.9813857611064625`*^9}, {
  3.981385815992836*^9, 3.9813858467126617`*^9}, {3.9813858966561356`*^9, 
  3.981385955056364*^9}, {3.981387735366331*^9, 3.9813877492283115`*^9}, {
  3.981387794484152*^9, 3.9813877947958775`*^9}, {3.9813882708037415`*^9, 
  3.9813882709858265`*^9}, {3.9825144551909447`*^9, 3.982514455468977*^9}, {
  3.9825190845728188`*^9, 3.982519100216358*^9}, {3.982520067170656*^9, 
  3.982520143708288*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"3e055892-c3c6-3046-973d-2569f0f58c28"],

