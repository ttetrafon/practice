Cell[BoxData[
 RowBox[{"dampedSol", "=", "\[IndentingNewLine]", 
  RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
