 CellChangeTimes->{
  3.981377097046812*^9},ExpressionUUID->"a05a4719-69c1-4b88-82d3-\
119e3b33a988"],

Cell[CellGroupData[{

Cell["Solving PDEs over 3D Regions", "Subsection",
 CellChangeTimes->{{3.9813771124148293`*^9, 
  3.981377118089693*^9}},ExpressionUUID->"541d5c4b-4618-eb4b-bfca-\
6f5387faaebc"],

Cell["\<\
The displacement of a teaspoon as a force is applied to it can be modeled \
with partial differential equations.\
\>", "Text",
 CellChangeTimes->{
  3.982749532380978*^9},ExpressionUUID->"62eed434-010e-4a9d-b2d9-\
d48b6c949f06"],

Cell["\<\
Set up initial displacement variables and material parameters:\
\>", "Text",ExpressionUUID->"b60f3c78-4146-4f23-97a2-05411814e120"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
       RowBox[{"w", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pars", "=", 
   RowBox[{"<|", 
    RowBox[{"\"\<Material\>\"", "\[Rule]", 
     TemplateBox[{"\"silver\"", 
       RowBox[{"Entity", "[", 
         RowBox[{"\"Element\"", ",", "\"Silver\""}], "]"}], 
       "\"Entity[\\\"Element\\\", \\\"Silver\\\"]\"", "\"element\""},
      "Entity"]}], "|>"}]}], ";"}]}], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"35131323-0b4e-453d-95c5-b9ef288ac144"],

