 RowBox[{
  RowBox[{"params", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"r", "\[Rule]", "10"}], ",", 
     RowBox[{"m", "\[Rule]", "0.05"}], ",", 
     RowBox[{"k", "\[Rule]", "1"}], ",", 
     RowBox[{"l", "\[Rule]", "0.05"}], ",", 
     RowBox[{"g", "\[Rule]", "9.8"}], ",", 
     RowBox[{
      SubscriptBox["x", "0"], "->", "0.5"}]}], "}"}]}], ";"}]], "Input",
