Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "->", "1"}], ",", 
        RowBox[{"b", "->", "0.2"}], ",", 
        RowBox[{"m", "->", "5"}], ",", 
        RowBox[{"k", "->", "0.1"}], ",", 
        RowBox[{"\[Omega]", "->", "\[Omega]1"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "tMax"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", "All"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", "\"\<Displacement\>\"", "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "->", "LightGray"}]}], "\[IndentingNewLine]", 
    "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Omega]1", ",", ".01", ",", "\"\<Driving Frequency\>\""}], 
      "}"}], ",", "0", ",", "1", ",", ".01", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tMax", ",", "150", ",", "\"\<Max Time\>\""}], "}"}], ",", "1", 
     ",", "200", ",", ".1", ",", 
     RowBox[{"Appearance", "->", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"TrackedSymbols", ":>", 
    RowBox[{"{", 
     RowBox[{"tMax", ",", "\[Omega]1"}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.981385677721365*^9, 3.981385679810417*^9}, {
