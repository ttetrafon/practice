Cell[BoxData[{
 RowBox[{
  RowBox[{"load", " ", "=", " ", 
   RowBox[{
    RowBox[{"SolidMechanicsPDEComponent", "[", 
     RowBox[{"vars", ",", "pars"}], "]"}], "\[Equal]", 
    RowBox[{"SolidBoundaryLoadValue", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", "10"]}], "<=", "x", "<=", 
       FractionBox["1", "10"]}], ",", "vars", ",", "pars", ",", 
      RowBox[{"<|", 
       RowBox[{"\"\<Force\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", 
          TemplateBox[{
            RowBox[{"-", "2000"}], "\"N\"", "newtons", "\"Newtons\""},
           "Quantity"]}], "}"}]}], "|>"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fixed", " ", "=", " ", 
   RowBox[{"SolidFixedCondition", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "<", 
       RowBox[{"-", 
        FractionBox["1", "10"]}]}], "||", 
      RowBox[{"x", ">", 
       FractionBox["1", "10"]}]}], ",", "vars", ",", "pars"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9826121949935703`*^9, 3.982612219684824*^9}, {
  3.9826123250507545`*^9, 3.9826123336214123`*^9}},
