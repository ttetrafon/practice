Cell[CellGroupData[{

Cell["Intermediate Examples", "Section",
 CellChangeTimes->{{3.98137718030402*^9, 
  3.9813771886912785`*^9}},ExpressionUUID->"c1ec30f6-b25c-44d6-905f-\
e01abe2940f9"],

Cell[CellGroupData[{

Cell["Audio Processing", "Subsection",
 CellChangeTimes->{{3.9813771929945602`*^9, 
  3.981377200273388*^9}},ExpressionUUID->"17b3e296-7c01-c840-928a-\
1fdb0b64d059"],

Cell["Consider the following audio clip of a man speaking:", "Text",
 CellChangeTimes->{{3.9647640027976894`*^9, 3.9647640082707615`*^9}, {
  3.9826112098997364`*^9, 
  3.98261121249806*^9}},ExpressionUUID->"1e199a8c-04db-49c9-a444-\
952642cc4cb5"],

Cell[BoxData[
 RowBox[{"speech", "=", 
  RowBox[{"ExampleData", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<Audio\>\"", ",", "\"\<MaleVoice\>\""}], "}"}], 
    ",", "\"\<Audio\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.964757178289934*^9, 3.964757189651232*^9}, {
   3.9647572276695175`*^9, 3.9647572531143*^9}, 3.982611220222948*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"f027503c-458d-0748-bc35-9e2102048a27"],

Cell["We can speed up the audio while preserving the pitch:", "Text",
 CellChangeTimes->{{3.9647998061189976`*^9, 3.964799822271393*^9}, 
   3.967204495874958*^9},ExpressionUUID->"6f204937-b1c6-0d40-8d13-\
e10b6e5086dd"],

Cell[BoxData[
 RowBox[{"speechFast", "=", 
  RowBox[{"AudioTimeStretch", "[", 
   RowBox[{"speech", ",", "0.5"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9647639747994537`*^9, 3.9647639787306137`*^9}, {
  3.964792529794611*^9, 3.964792531993307*^9}, {3.9826112292258587`*^9, 
  3.9826112404617577`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"03aaa335-fc6c-8a42-9cbd-66f594c06b99"],

Cell["Plot the original and contracted audio:", "Text",
 CellChangeTimes->{
  3.9647998627584763`*^9, {3.9648002548915634`*^9, 
   3.9648002562433643`*^9}},ExpressionUUID->"6dcddab9-616c-d747-82dd-\
0d87fe16b571"],

Cell[BoxData[
 RowBox[{"AudioPlot", "[", 
  RowBox[{"{", 
   RowBox[{"speech", ",", "speechFast"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.9647574153127575`*^9, 3.964757420681221*^9}, {
  3.964764169892599*^9, 3.964764170286545*^9}, {3.9647998458249397`*^9, 
  3.9647998501606007`*^9}, {3.9826112481337433`*^9, 3.9826112523396053`*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"3494b339-bab5-364b-bf7c-f0887241cbb0"],

Cell["We can also shift every pitch by one octave:", "Text",
 CellChangeTimes->{{3.9648025913506813`*^9, 
  3.964802624681381*^9}},ExpressionUUID->"da51c664-ceb0-4b4a-974a-\
c2bcf146a1cb"],

Cell[BoxData[
 RowBox[{"AudioPitchShift", "[", 
  RowBox[{"speech", ",", 
   TemplateBox[{
     RowBox[{"-", "1"}], 
     RowBox[{
       FrameBox[
        StyleBox[
        "\"octaves\"", ShowStringCharacters -> False, StripOnInput -> False], 
        FrameMargins -> 1, FrameStyle -> GrayLevel[0.85], BaselinePosition -> 
        Baseline, RoundingRadius -> 3, StripOnInput -> False]}], "octaves", 
     RowBox[{"IndependentUnit", "[", "\"octaves\"", "]"}]},
    "Quantity"]}], "]"}]], "Input",
 CellChangeTimes->{{3.964801603792095*^9, 3.9648016337088394`*^9}, {
  3.964802547314251*^9, 3.964802573140644*^9}, {3.982611259928919*^9, 
  3.982611275315199*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"89f79f61-9ab0-d247-854d-d45473b23889"],

Cell["\<\
Compute the max of the signal on each partition and display it on top of the \
waveform:\
\>", "Text",
 CellChangeTimes->{{3.9826113541162395`*^9, 
  3.9826113552146015`*^9}},ExpressionUUID->"2c72db95-58b3-bf4c-8b4c-\
5bc437bc1f7e"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"AudioPlot", "[", 
    RowBox[{"speech", ",", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", 
         StyleBox["\"opts\"", "IconizedCustomName", StripOnInput -> False], 
         GridBox[{{
            ItemBox[
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["Rule", "IconizedItem"]}]]}, {
            ItemBox[
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["96", "IconizedItem"]}]]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      PlotLayout -> "Averaged",
      SelectWithContents->True,
      Selectable->False]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"AudioLocalMeasurements", "[", 
      RowBox[{"speech", ",", "\"\<Max\>\""}], "]"}], ",", 
     "\[IndentingNewLine]", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"List", 
         StyleBox["\"opts\"", "IconizedCustomName", StripOnInput -> False], 
         GridBox[{{
            ItemBox[
             RowBox[{
               TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["List", "IconizedItem"]}]]}, {
            ItemBox[
             RowBox[{
               TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
               TagBox["2", "IconizedItem"]}]]}, {
            ItemBox[
             RowBox[{
               TagBox["\"Byte count: \"", "IconizedLabel"], 
               "\[InvisibleSpace]", 
               TagBox["280", "IconizedItem"]}]]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      {PlotStyle -> RGBColor[1, 0, 0], PlotRange -> All},
      SelectWithContents->True,
      Selectable->False]}], "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.982611312825001*^9, 3.982611319336725*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"05e791b6-a3c2-104c-9cc5-ac353f3e2bce"],

Cell["\<\

Compute the formants of the signal, which represent the distribution of \
frequencies filtered by the vocal tract, on each partition and display them \
on top of the spectrogram:\
\>", "Text",
 CellChangeTimes->{
  3.982611368925478*^9},ExpressionUUID->"5667b4ec-48c1-1d43-b629-\
01cf8d240334"],

Cell[BoxData[
 RowBox[{"formants", "=", 
  RowBox[{"AudioLocalMeasurements", "[", 
   RowBox[{"speech", ",", "\"\<Formants\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9826116522008877`*^9, 3.982611653826746*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"e9bfe646-00e6-1d46-991b-cabb75b92a7f"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Spectrogram", "[", 
    RowBox[{"speech", ",", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "7000"}], "}"}]}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", "formants", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.982611394647499*^9, 3.982611400587597*^9}, {
  3.9826116579765205`*^9, 3.9826116701866703`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"3b6f3e9c-24dc-204c-b2a9-4f20e6acace2"],

Cell["\<\
Simulate how the speech might change in a railway tunnel by creating a \
reverberation effect with an impulse response:\
\>", "Text",
 CellChangeTimes->{{3.9826117200248337`*^9, 
  3.982611720885853*^9}},ExpressionUUID->"ab973dec-43c7-e640-b79d-\
534bf724997d"],

Cell[BoxData[
 RowBox[{"model", "=", 
  RowBox[{"ExampleData", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<Audio\>\"", ",", "\"\<IRRailwayTunnel\>\""}], "}"}], 
    ",", "\"\<Audio\>\""}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9826117242453938`*^9, 3.982611724252655*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"5e9ad1f7-8514-5e4c-8972-e90f5045fedf"],

Cell[BoxData[
 RowBox[{"new", "=", 
  RowBox[{"AudioTrim", "[", 
   RowBox[{
    RowBox[{"AudioReverb", "[", 
     RowBox[{"speech", ",", "model"}], "]"}], ",", 
    RowBox[{"Duration", "[", "speech", "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9826117308473644`*^9, 3.9826117308555202`*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"6629bb84-af1a-8b48-8d65-3cfdb0edd7b0"],

Cell["\<\
The recording environment can boost or attenuate certain frequencies, thus \
altering the formants. Compute and visualize the new formants:\
\>", "Text",
 CellChangeTimes->{{3.9826125418910007`*^9, 
  3.982612543464258*^9}},ExpressionUUID->"e03ee5fd-e30f-3c4f-abe7-\
5a06a3a17b04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newFormants", " ", "=", " ", 
   RowBox[{"AudioLocalMeasurements", "[", 
    RowBox[{"new", ",", "\"\<Formants\>\""}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.982611750573738*^9, 3.9826117770669365`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"914c99c8-bbfc-7342-957a-f4c874a4f402"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Spectrogram", "[", 
    RowBox[{"new", ",", 
     RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "7000"}], "}"}]}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", "newFormants", "]"}]}], "\[IndentingNewLine]",
   "]"}]], "Input",
 CellChangeTimes->{{3.98261178112479*^9, 3.982611789072052*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"a97d37f1-9262-334b-baf0-e0ef23ba20cf"],

Cell[BoxData[
 RowBox[{"Names", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<*Filter\>\"", ",", "\"\<*Window\>\""}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.982612008684908*^9, 3.9826120096467857`*^9}, {
  3.9826120403790627`*^9, 3.982612044534502*^9}},
