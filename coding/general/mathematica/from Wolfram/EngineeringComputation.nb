  RowBox[{
   RowBox[{"AffineStateSpaceModel", "[", "\[IndentingNewLine]", 
    RowBox[{"eqns", ",", "\[IndentingNewLine]", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
