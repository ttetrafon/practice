Cell["\<\
Validate the requirement, \[OpenCurlyDoubleQuote]whenever the water level in \
the first tank is above 1.2 m, and for at least 6 s more, the water level in \
the second tank should be above 0.6 m\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{
  3.9825285520432434`*^9, {3.982749463256155*^9, 
   3.9827494806802683`*^9}},ExpressionUUID->"18ce308b-8ec2-e641-b94f-\
ddc2af63eec7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"req", "=", 
   RowBox[{"SystemModelAlways", "[", 
