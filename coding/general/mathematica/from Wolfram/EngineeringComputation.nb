Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["m", "TI"], 
        SuperscriptBox[
         StyleBox["x", "TI"], "\[Prime]\[Prime]"], "+", 
        StyleBox["b", "TI"], 
        SuperscriptBox[
         StyleBox["x", "TI"], "\[Prime]"], "+", 
        StyleBox["k", "TI"], 
        StyleBox["x", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
    "errors" -> {}, "input" -> "m x'' + bx' + kx = 0", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
