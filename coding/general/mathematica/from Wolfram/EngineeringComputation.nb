Cell["Set the input voltage as the sole feedback input:", "Text",
 CellChangeTimes->{3.964754938049265*^9},
 CellID->544687600,ExpressionUUID->"30a003ca-2427-e645-bd4f-ee3e656742e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sspec", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<InputModel\>\"", "->", 
      RowBox[{"AffineStateSpaceModel", "[", 
       RowBox[{
       "assm", ",", "Automatic", ",", "Automatic", ",", "Automatic", ",", 
        "None"}], "]"}]}], ",", 
     RowBox[{"\"\<FeedbackInputs\>\"", "->", "1"}]}], "|>"}]}], 
  ";"}]], "Input",
 CellLabel->"In[10]:=",
 CellID->86817179,ExpressionUUID->"f322cd80-a39a-a340-9448-a17f945186ae"],

