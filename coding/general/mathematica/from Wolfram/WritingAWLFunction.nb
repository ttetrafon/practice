Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "checkRule", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkRule", "[", 
    RowBox[{"rule", ":", 
     RowBox[{"KeyValuePattern", "[", 
      RowBox[{
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"StringQ", "[", "#", "]"}], " ", "&&", " ", 
           RowBox[{"!", " ", 
            RowBox[{"StringContainsQ", "[", 
             RowBox[{"#", ",", " ", "DigitCharacter"}], "]"}]}]}], "&"}], 
         ")"}]}], " ", "->", " ", 
       RowBox[{"_Integer", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}], ")"}]}]}], "]"}]}], "]"}], " ", ":=",
    " ", "rule"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"checkRule", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"checkRule", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<123\>\"", " ", "->", " ", "1"}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"checkRule", "[", 
  RowBox[{"{", 
   RowBox[{"\"\<a\>\"", " ", "->", " ", 
    RowBox[{"-", "1"}]}], "}"}], "]"}]}], "Input",
 CellChangeTimes->{3.98276254213328*^9},
