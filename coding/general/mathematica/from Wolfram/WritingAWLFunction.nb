}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"cf29ee00-48dd-2343-8756-12de53097fe1"],

Cell[CellGroupData[{

Cell["Useful Tips", "Section",ExpressionUUID->"18898d21-a381-4246-bf7a-e070b466eb9a"],

Cell[CellGroupData[{

Cell["Extracting Information", "Subsection",
 CellTags->
  "ExtraTips-ExtractingInformation",ExpressionUUID->"7d69bd41-269d-6f44-abef-\
15cbf260e4e3"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Getting Information about Wolfram Language Objects",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/tutorial/\
GettingInformationAboutWolframLanguageObjects.html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/tutorial/\
GettingInformationAboutWolframLanguageObjects.html"]
}], "Text",ExpressionUUID->"624d660f-4373-1746-bdc0-20334b92cd65"],

Cell["\<\
While full details about how a function works should be written up in \
documentation, key properties (definitions, options, etc.) can be extracted \
programmatically.\
\>", "Text",ExpressionUUID->"f9c0fc84-3290-bf4d-8e70-adcad6581cdf"],

Cell[CellGroupData[{

Cell["Function Information", "Subsubsection",
 CellChangeTimes->{{3.9827791718064384`*^9, 
  3.9827791720602894`*^9}},ExpressionUUID->"0947c5ae-5d27-3745-933b-\
eaafc7392db1"],

Cell[TextData[{
 "The quickest way to get information about a function is to use ",
 ButtonBox["Information",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Information.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Information.html"],
 ". For symbols, it has a convenient short form (",
 StyleBox["??", "Input"],
 ")."
}], "Text",
 CellChangeTimes->{{3.870447524163144*^9, 
  3.870447524165954*^9}},ExpressionUUID->"3d96d0e6-f572-524b-8cb8-\
431ff6ad7b90"],

Cell[TextData[{
 "Get information about ",
 ButtonBox["Dataset",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Dataset.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Dataset.html"],
 ":"
}], "Text",ExpressionUUID->"aed3cdc6-b408-084e-9b81-445fa4a1ca03"],

Cell[BoxData[{
 RowBox[{"Information", "[", "Dataset", "]"}], "\n", 
 RowBox[{"??", "Dataset"}]}], "Input",
 CellLabel->
  "In[150]:=",ExpressionUUID->"deca3e6e-75e5-924d-ac3a-f27251957c15"],

Cell["\<\
Under the hood, an Information object is an association with keys that can be \
extracted:\
\>", "Text",ExpressionUUID->"ac5319e7-7272-654d-b331-456123e9b08e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Information", "[", "Dataset", "]"}], "//", "Keys"}]], "Input",
 CellLabel->"",ExpressionUUID->"619e10ba-529b-1345-8d1f-1bd3630d763b"],

Cell["Extract the options of Dataset:", "Text",ExpressionUUID->"f1516b53-cc8d-bd44-a077-c73af81ac22d"],

Cell[BoxData[{
 RowBox[{"Options", "[", "Dataset", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Information", "[", 
  RowBox[{"Dataset", ",", " ", "\"\<Options\>\""}], "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"fd66e222-252f-e745-977f-5dc71cf1eaf4"],

Cell[TextData[{
 "Information has another short form (",
 StyleBox["?", "Input"],
 ") for extracting ",
 StyleBox["usage messages",
  FontSlant->"Italic"],
 "."
}], "Text",ExpressionUUID->"4bba86da-00c3-5d4c-9b38-979654e365cc"],

Cell[TextData[{
 "Create a usage message for ",
 StyleBox["scaleVector", "Input"],
 " (using the ",
 ButtonBox["MessageName",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/MessageName.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/MessageName.html"],
 " notation seen earlier) and extract it:"
}], "Text",
 CellChangeTimes->{{3.870447564337419*^9, 
  3.870447564340076*^9}},ExpressionUUID->"eceecffb-a20b-8c48-8e5c-\
99b4ffe430d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleVector", "::", "usage"}], " ", "=", 
    " ", "\"\<scaleVector[v, c] scales a vector v by a factor of c.\>\""}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Information", "[", 
  RowBox[{"scaleVector", ",", " ", "\"\<Usage\>\""}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"?", "scaleVector"}]}], "Input",ExpressionUUID->"3366dd41-2250-f94a-\
9237-ad338f0240c6"],

Cell[TextData[{
 ButtonBox["Definition",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Definition.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Definition.html"],
 " will print a function\[CloseCurlyQuote]s attributes, default values, \
options and (unless the function is read-protected) definitions:"
}], "Text",ExpressionUUID->"7271b71d-d5bc-0a48-8eac-66d42a3bc3e2"],

Cell[BoxData[
 RowBox[{"Definition", "[", "Dataset", "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"f78fdfaf-e334-a645-9514-ebb6d24afff0"],

Cell[TextData[{
 "(",
 ButtonBox["FullDefinition",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FullDefinition.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FullDefinition.html"],
 " will also give any dependent definitions, if they exist.)"
}], "Text",ExpressionUUID->"203ae3a0-00ef-644e-80d4-586f584c8fe7"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Styling Usage Messages",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.8707845854386377`*^9, 3.870784586302491*^9}, {
  3.9827791773311977`*^9, 3.982779179748543*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"5e7d65a0-910d-bc4b-82d2-f705f0120ccf"],

Cell["Messages are usually plain strings, but they can be styled:", "Text",ExpressionUUID->"147f41ba-9d2a-8245-bac8-aeeb3bc3903e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"scaleVector", "::", "usage"}], " ", "=", " ", 
  RowBox[{"ToString", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"StringForm", "[", "\[IndentingNewLine]", 
     RowBox[{"\"\<`1``2`, `3``4` scales a vector `2` by a scale factor of \
`3`.\>\"", ",", "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<scaleVector[\>\"", ",", " ", "\"\<Input\>\""}], "]"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<v\>\"", ",", " ", "Italic"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<c\>\"", ",", " ", "Italic"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<]\>\"", ",", " ", "\"\<Input\>\""}], "]"}]}], 
     "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "StandardForm"}], "\[IndentingNewLine]", "]"}]}]], "Input",ExpressionUUID->\
"b9a77710-a8b7-7a49-a31f-438008032c76"]
}, Closed]],

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"782cc066-2e94-af45-976f-c43223ae9361"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Object Data", "Subsubsection",
 CellChangeTimes->{{3.9827791825325813`*^9, 
  3.9827791828225727`*^9}},ExpressionUUID->"8c2c31cf-6185-344a-aa62-\
bfcdc7046dae"],

Cell["\<\
Information (in its long form) will also extract data from most objects:\
\>", "Text",ExpressionUUID->"2518c5f2-3de6-fe49-9ca9-61eec56262dc"],

Cell[BoxData[{
 RowBox[{"Information", "[", 
  RowBox[{"Databin", "[", "\"\<1qGFQ8v\>\"", "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Information", "[", 
  TemplateBox[{"\"London\"", 
    RowBox[{"Entity", "[", 
      RowBox[{"\"City\"", ",", 
        RowBox[{"{", 
          
          RowBox[{"\"London\"", ",", "\"GreaterLondon\"", ",", 
            "\"UnitedKingdom\""}], "}"}]}], "]"}], 
    "\"Entity[\\\"City\\\", {\\\"London\\\", \\\"GreaterLondon\\\", \
\\\"UnitedKingdom\\\"}]\"", "\"city\""},
   "Entity"], "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"a773a74b-bf62-c84c-9f88-41c827b7e2a6"],

Cell[TextData[{
 "As seen earlier, ",
 ButtonBox["Normal",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Normal.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Normal.html"],
 " can often be used to get data out of an object. Another trick is to \
replace the head of the object using ",
 ButtonBox["Apply",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Apply.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Apply.html"],
 " and ",
 ButtonBox["List",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/List.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/List.html"],
 ":"
}], "Text",
 CellChangeTimes->{{3.870447606407517*^9, 3.870447606410097*^9}, {
  3.870447650689309*^9, 
  3.870447650691845*^9}},ExpressionUUID->"a4fe6e6e-38eb-b445-9519-\
02a1f8f82605"],

Cell[BoxData[
 RowBox[{"object", " ", "=", " ", 
  RowBox[{"TimeSeries", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"4", ",", "5", ",", "6"}], "}"}], "}"}]}], "]"}]}]], "Input",Exp\
ressionUUID->"6a71875a-4ac7-a348-95f1-d8e1afc887bb"],

Cell[BoxData[{
 RowBox[{"Normal", "[", "object", "]"}], "\[IndentingNewLine]", 
 RowBox[{"List", "@@", "object"}]}], "Input",ExpressionUUID->"a83a6447-24f8-\
ff42-ab42-7706e6dfddf2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Function Names", "Subsubsection",
 CellChangeTimes->{{3.982779188419243*^9, 
  3.9827791886519184`*^9}},ExpressionUUID->"e5f7906b-df6e-2243-afca-\
f6508ff0eb98"],

Cell[TextData[{
 "Information can be used with asterisks (",
 StyleBox["*", "Input"],
 ") to find all the function names that match a particular form (where an \
asterisk represents zero or more characters)."
}], "Text",ExpressionUUID->"af2adeb9-319e-5440-a853-45d714cf2edf"],

Cell["\<\
Find all of the functions that contain the word \[OpenCurlyDoubleQuote]List\
\[CloseCurlyDoubleQuote] (case-sensitive):\
\>", "Text",ExpressionUUID->"8bd9d9ad-daeb-0e42-8b3d-3e2920b87762"],

Cell[BoxData[
 RowBox[{"?", 
  RowBox[{"*", "List", "*"}]}]], "Input",
 CellLabel->"",ExpressionUUID->"e3044045-a031-f448-81ce-68855c754d5c"],

Cell[TextData[{
 "Use ",
 ButtonBox["Names",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Names.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Names.html"],
 " to get a similar result:"
}], "Text",ExpressionUUID->"58db54f4-aa69-ae49-886b-c40475a0ef55"],

Cell[BoxData[
 RowBox[{"Names", "[", "\"\<*List*\>\"", "]"}]], "Input",ExpressionUUID->"1b6811b6-945c-d44b-86a3-803b2824bd87"],

Cell[TextData[{
 "Although Names does not format the result as nicely, it is more flexible \
because it allows ",
 ButtonBox["string patterns",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/guide/StringPatterns.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/guide/StringPatterns.html"],
 "."
}], "Text",ExpressionUUID->"dedbcf1a-a8fa-f345-b24f-ee1c8f6c84ca"],

Cell["\<\
Get only functions that contain \[OpenCurlyDoubleQuote]List\
\[CloseCurlyDoubleQuote] followed by an uppercase character (thus avoiding \
words like \[OpenCurlyDoubleQuote]Listen\[CloseCurlyDoubleQuote]):\
\>", "Text",
 CellChangeTimes->{
  3.870447675912017*^9},ExpressionUUID->"30fea66b-19ed-f844-854a-\
2ca3b4236a37"],

Cell[BoxData[
 RowBox[{"Names", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"___", "~~", "\"\<List\>\""}], ")"}], "|", 
   RowBox[{"(", 
    RowBox[{"___", "~~", "\"\<List\>\"", "~~", 
     RowBox[{"_", "?", "UpperCaseQ"}], "~~", "___"}], ")"}]}], "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"cab6101b-84a2-294b-939c-6fda2bc39ffb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Output Forms", "Subsubsection",
 CellChangeTimes->{{3.9827791921255455`*^9, 
  3.9827791926923923`*^9}},ExpressionUUID->"23dee9ee-99ea-cb44-9537-\
c1cebdeaf9f0"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Forms of Input and Output",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
TextualInputAndOutput.html#12368"], None},
