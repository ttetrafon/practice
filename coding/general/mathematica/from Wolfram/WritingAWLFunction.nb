Cell[TextData[{
 "Returning a ",
 ButtonBox["Failure",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Failure.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Failure.html"],
 " object is not always desirable. The second argument of ",
 ButtonBox["Enclose",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Enclose.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Enclose.html"],
 " can be used to modify the output."
}], "Text",
 CellChangeTimes->{{3.982673203698395*^9, 
  3.9826732153932533`*^9}},ExpressionUUID->"1ee65b56-f0bf-6c46-b7b2-\
e29d5ec3bc4e"],

Cell[TextData[{
 "Create a custom version of ",
 ButtonBox["StringTake",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/StringTake.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/StringTake.html"],
 " that produces a failure message if the string has fewer characters than \
the number being taken:"
}], "Text",ExpressionUUID->"1aef3c0d-8f77-c84d-bfd3-81829bd4fdee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"StringTake", "[", 
  RowBox[{"\"\<abc\>\"", ",", "4"}], "]"}]], "Input",
 CellChangeTimes->{{3.9826732233086433`*^9, 3.9826732299388103`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"f11d33f6-2450-8043-aabd-dc4e2966dc56"],

Cell[BoxData[
 TemplateBox[{
  "StringTake", "take", 
   "\"Cannot take positions \\!\\(\\*RowBox[{\\\"1\\\"}]\\) through \
\\!\\(\\*RowBox[{\\\"4\\\"}]\\) in \\\"\\!\\(\\*RowBox[{\\\"\\\\\\\"abc\\\\\\\
\"\\\"}]\\)\\\".\"", 2, 58, 1, 20009497494273290125, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9826732303154736`*^9},
