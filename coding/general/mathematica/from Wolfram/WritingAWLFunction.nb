Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"3182db65-07af-a543-a5cf-28aa43e01b69"],

Cell[CellGroupData[{

Cell["Motivation", "Section",ExpressionUUID->"00702c5e-711a-4916-8ac8-17827ecfb5f6"],

Cell["Wolfram Language has over 6,600 built-in functions:", "Text",
 CellChangeTimes->{{3.982778920000551*^9, 3.982778922889719*^9}, {
  3.982778973626831*^9, 
  3.9827789880320683`*^9}},ExpressionUUID->"666cfef8-8c97-a140-a434-\
9ce62edc6af2"],

Cell[BoxData[
 RowBox[{"Length", "[", 
  RowBox[{"WolframLanguageData", "[", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.982778925734747*^9, 3.9827789325705624`*^9}, {
  3.98277896374358*^9, 3.9827789673238487`*^9}},
 CellLabel->
  "In[282]:=",ExpressionUUID->"19152739-2420-ff47-8fa5-7385e5fb258b"],

Cell[CellGroupData[{

Cell["Qualities of a Good Function", "Subsection",
 CellTags->
  "Motivation-QualitiesOfAGoodFunction",ExpressionUUID->"206b1fcb-18f1-4edf-\
ab57-369fe9118961"],

Cell["Generally speaking, a \[OpenCurlyDoubleQuote]good\
\[CloseCurlyDoubleQuote] function is one that:", "Text",ExpressionUUID->\
"53a6b643-d4c8-41c1-b077-9ff45c72f398"],

Cell["is robust to all input (i.e. it is difficult to break)", "Item",
 CellChangeTimes->{
  3.870435816707301*^9},ExpressionUUID->"5401c0d2-e9d8-446c-bfef-\
753c57a432e5"],

Cell["gives a clear output (i.e. it does what you expect it to do)", "Item",
 CellChangeTimes->{
  3.870435817626718*^9},ExpressionUUID->"f86341fb-e87f-4c18-8ab4-\
b4de0de2549f"],

Cell["\<\
is flexible (i.e. it has the potential to be applied in contexts beyond its \
original scope)\
\>", "Item",
 CellChangeTimes->{
  3.870435818532618*^9},ExpressionUUID->"f5ce216b-8dac-41a0-bf69-\
1006d2b21b66"],

Cell["\<\
has clear documentation (i.e. it can be used and understood by others)\
\>", "Item",
 CellChangeTimes->{
  3.8704358194287167`*^9},ExpressionUUID->"824d96c2-660c-4a0f-a64f-\
ad0f5afaa31a"],

Cell["\<\
In other words, when presented with a well-designed function, you should be \
able to read and understand its documentation, apply it in a variety of \
contexts and receive the results you expect.\
\>", "Text",ExpressionUUID->"d7273ec1-e3a1-43bd-8059-cca41d0d3b93"],

Cell[TextData[{
 "These are just guidelines, however; sometimes, for example, it is useful \
for a function to be deliberately ",
 StyleBox["in",
  FontSlant->"Italic"],
 "flexible, with few or no options. \nFunctions of the form ",
 StyleBox["N",
  FontSlant->"Italic"],
 StyleBox["ame",
  FontSlant->"Italic"],
 "Q, for instance, often allow just one argument or no options:"
}], "Text",
 CellChangeTimes->{{3.9826468868408203`*^9, 3.982646890215063*^9}, 
   3.9827619447044487`*^9},ExpressionUUID->"526ca0f9-e71e-4aa8-9462-\
5e8313b4eab6"],

Cell[BoxData[
 RowBox[{"TrueQ", "[", 
  RowBox[{
   SuperscriptBox["E", 
    RowBox[{"I", " ", "\[Pi]"}]], "==", 
   RowBox[{"-", "1"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.982647018880533*^9, 3.9826470395969963`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"0fb49615-7bd3-354b-b6cd-f468caa75a46"],

