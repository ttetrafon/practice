}, Open  ]],

Cell[TextData[{
 "Note that the default value for ",
 ButtonBox["Lookup",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Lookup.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Lookup.html"],
 " here (",
 StyleBox["Black", "Input"],
 ") won\[CloseCurlyQuote]t ever get called. It is used to ensure that ",
 ButtonBox["ColorQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ColorQ.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ColorQ.html"],
 " evaluates to True in the case of no options being provided."
}], "Text",ExpressionUUID->"7e0a8323-8dac-954a-8caf-856f01f11109"],

Cell["\<\
We have not yet validated the \[OpenCurlyDoubleQuote]EdgeStyle\
\[CloseCurlyDoubleQuote] option value, hence:\
\>", "Text",
 CellChangeTimes->{{3.98266943847756*^9, 
  3.9826695022264576`*^9}},ExpressionUUID->"93fa9819-7a8d-b646-82be-\
977dcbc0ab42"],

Cell[BoxData[
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "1", ",", " ", 
   RowBox[{"\"\<EdgeStyle\>\"", " ", "->", " ", "badStyle"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"84646ae2-2dfc-fa41-89f3-3418dd85c30a"],

