}, Open  ]],

Cell[CellGroupData[{

Cell["UpValues vs DownValues", "Subsubsection",
 CellChangeTimes->{{3.9826716576694145`*^9, 
  3.9826716626557293`*^9}},ExpressionUUID->"d3f9d7c6-0d23-4815-ad1a-\
9c3ef7d9da1d"],

Cell[TextData[{
 "Consider the following example, where an upvalue has been created for ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "94182448-a85b-1c4c-86ce-3d8b9af695a1"],
 ":"
}], "Text",ExpressionUUID->"70680458-fb32-4076-8b7a-dd5b44b259cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "/:", 
   RowBox[{"Plus", "[", 
    RowBox[{
     RowBox[{"f", "[", "a_", "]"}], ",", " ", 
     RowBox[{"f", "[", "b_", "]"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"f", "[", 
    RowBox[{"a", "+", "b"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"fcd38eb1-eaf2-40ea-bd47-5e1ac5c9c320"],

Cell[TextData[{
 "Rather than doing this, you could instead create a new downvalue for ",
 ButtonBox["Plus",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Plus.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Plus.html"],
 "*:"
}], "Text",ExpressionUUID->"90b25b87-eb67-4229-bd7f-872556c03ab9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plus", "[", 
   RowBox[{
    RowBox[{"f", "[", "a_", "]"}], ",", " ", 
    RowBox[{"f", "[", "b_", "]"}]}], "]"}], " ", ":=", " ", 
  RowBox[{"f", "[", 
   RowBox[{"a", "+", "b"}], "]"}]}]], "Input",
 CellLabel->"",ExpressionUUID->"b91dc5be-dcc4-4ed4-838c-e784a4c333bc"],

Cell["\<\
However, since Plus is a built-in function\[LongDash]and fundamental to many \
other built-in functions!\[LongDash]changing its definition would be a very \
bad idea. As a general rule of thumb, it is better to create upvalues for \
less common functions than to create downvalues for more common ones.\
\>", "Text",
 CellChangeTimes->{{3.870438083781398*^9, 
  3.870438085390542*^9}},ExpressionUUID->"f7caedf8-f515-4109-b244-\
53955bbf2978"],

Cell[TextData[{
 "\n*For this to work properly, you would need to apply ",
 ButtonBox["Unprotect",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Unprotect.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Unprotect.html"],
 " to Plus first."
}], "Text",
 CellChangeTimes->{{3.870438095086776*^9, 
  3.870438100894822*^9}},ExpressionUUID->"277a33cf-8260-4596-86a0-\
b7dcb99de5a0"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"d47ea181-0b61-4a60-a0f1-fcf50c60fcbf"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

