Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"1a10db9c-ef8d-0440-8dc7-2a02bb0becf8"],

Cell[CellGroupData[{

Cell["Options", "Section",ExpressionUUID->"ff942aa5-d90a-0a4e-83c9-d9d9869e9251"],

Cell[CellGroupData[{

Cell["Adding Options", "Subsection",
 CellTags->
  "Options-AddingOptions",ExpressionUUID->"0794452f-29a5-6d46-a6ef-\
88f191400042"],

Cell["\<\
Adding options to a function provides a way to add extra functionality \
without cluttering the body of the function.\
\>", "Text",ExpressionUUID->"e0afac86-02ee-1148-8138-2e4af772fb88"],

Cell[TextData[{
 "Generally, custom option names should be descriptive, UpperCamelCase \
strings. While functions like ",
 ButtonBox["OptionValue",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/OptionValue.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/OptionValue.html"],
 " often treat strings and symbols interchangeably, using strings avoids \
potential clashes with other symbols."
}], "Text",ExpressionUUID->"8c77d800-a131-ca45-b7f4-fe3ab40f6d85"],

Cell[CellGroupData[{

Cell["Managing Options", "Subsubsection",
 CellChangeTimes->{{3.98266895356279*^9, 
  3.9826689569626255`*^9}},ExpressionUUID->"e82989e3-33b3-1a49-95e5-\
dbf4ce1c1693"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Options Management",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/guide/OptionsManagement.html"],
     None},
  ButtonNote->
   "http://reference.wolfram.com/language/guide/OptionsManagement.html"]
}], "Text",ExpressionUUID->"ce289891-3175-8141-bea2-4acdf4e889c3"],

Cell[TextData[{
 "Adding options to a function typically requires the use of three closely \
related functions: ",
 ButtonBox["Options",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Options.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Options.html"],
 ", OptionValue and ",
 ButtonBox["OptionsPattern",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/OptionsPattern.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/OptionsPattern.html"],
 "."
}], "Text",ExpressionUUID->"fd2ff4b6-e382-aa4a-a819-57cc47f84b1d"],

Cell["\<\
Options gives the list of default options assigned to a function:\
\>", "Text",ExpressionUUID->"29136995-96ac-6c47-bb18-0b3f12355920"],

Cell[BoxData[
 RowBox[{"Options", "[", "Plot", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"f90441f0-5e15-be45-b578-92ae028b55c6"],

Cell["OptionValue gives the value of a particular option:", "Text",ExpressionUUID->"9c2798df-8aeb-234d-9b67-82cb051f22a2"],

Cell[BoxData[
 RowBox[{"OptionValue", "[", 
  RowBox[{"Plot", ",", " ", "AlignmentPoint"}], "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"c20f3de9-311f-e244-b13f-f3cb7ff626a3"],

Cell["\<\
OptionsPattern represents a collection of options given as a sequence or list \
of rules:\
\>", "Text",ExpressionUUID->"e16d9e3f-d70a-794e-8f2f-71117fa96faf"],

Cell[BoxData[
 RowBox[{"MatchQ", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Option1\>\"", "\[Rule]", "optionValue1"}], ",", " ", 
     RowBox[{"\"\<Option2\>\"", " ", "->", " ", "optionValue2"}]}], "}"}], ",",
    " ", 
   RowBox[{"OptionsPattern", "[", "]"}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"87b51594-fc60-2c4c-a496-6f042ba2251a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Standard Usage", "Subsubsection",
 CellChangeTimes->{{3.9826686817177753`*^9, 
  3.9826686820541954`*^9}},ExpressionUUID->"4ca88f03-79e9-b542-8d14-\
868c03c30d60"],

Cell["Here is a typical setup using Options and OptionsPattern:", "Text",ExpressionUUID->"c970ea77-5087-414c-9eca-7f7214275cfa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"text_", ",", " ", 
     RowBox[{"options", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"text", ",", " ", "options"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9826686865803127`*^9, 3.9826686887128468`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"59ed13f7-c213-5043-91b0-bfb296e3fa1c"],

Cell[TextData[{
 "A named pattern (",
 StyleBox["options", "Input"],
 ") has been used on the left-hand side to enable the options to be inserted \
anywhere on the right-hand side."
}], "Text",ExpressionUUID->"734b39bf-09dc-5a4a-afc2-db8372bb9686"],

Cell["\<\
When the function is evaluated, the default options are not used unless they \
are listed explicitly:\
\>", "Text",ExpressionUUID->"78774bcd-10d8-9846-98ce-ea04da6c4744"],

Cell[BoxData[{
 RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Red"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
   RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "]"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"1f123018-34d4-814c-8d29-cbbbb9a73c9f"],

Cell["You can, however, ensure that they are used by default:", "Text",
 CellChangeTimes->{{3.982668926339836*^9, 
  3.9826689293237514`*^9}},ExpressionUUID->"fc5cdb20-9693-ee44-9bc2-\
27041b7363b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"text_", ",", " ", 
     RowBox[{"options", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"text", ",", " ", "options", ",", " ", 
     StyleBox[
      RowBox[{"Sequence", " ", "@@", " ", 
       RowBox[{"Options", "[", "styleText", "]"}]}],
      Background->RGBColor[1, 0.9, 0.8]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Blue"}], ",", " ", 
   RowBox[{"FontWeight", " ", "->", " ", "Plain"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.982668701924225*^9, 3.9826687097630424`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"57a72a71-a0c9-9641-bf4d-e6120623e3f4"],

Cell[TextData[{
 "(",
 StyleBox["Apply[Sequence, \[Ellipsis]]", "Input"],
 " has been used here to replace the ",
 ButtonBox["List",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/List.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/List.html"],
 " head with ",
 ButtonBox["Sequence",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Sequence.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Sequence.html"],
 ".)"
}], "Text",ExpressionUUID->"cb6eed59-da34-854c-81e8-a5f0e37f9eb5"],

Cell["\<\
Rather than inserting all options in one place, you can pick and choose \
particular options to be used in different places. This is where OptionValue \
comes in:\
\>", "Text",ExpressionUUID->"c62e1312-d68f-fe41-bee9-193c7d375fef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"FontWeight", " ", "->", " ", "Bold"}], ",", " ", 
     RowBox[{"\"\<UpperCase\>\"", " ", "->", " ", "False"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"string_", ",", " ", 
     RowBox[{"options", " ", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Style", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        StyleBox[
         RowBox[{"OptionValue", "[", "\"\<UpperCase\>\"", "]"}],
         Background->RGBColor[1, 0.9, 0.8]], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ToUpperCase", "[", "string", "]"}], ",", 
       "\[IndentingNewLine]", "string"}], "\[IndentingNewLine]", "]"}], ",", 
     "\[IndentingNewLine]", "options", ",", "\[IndentingNewLine]", 
     RowBox[{"FontColor", " ", "->", " ", 
      StyleBox[
       RowBox[{"OptionValue", "[", "FontColor", "]"}],
       Background->RGBColor[1, 0.9, 0.8]]}]}], 
    StyleBox["\[IndentingNewLine]",
     Background->RGBColor[1, 0.9, 0.8]], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Blue"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"\"\<UpperCase\>\"", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826687313631496`*^9, 3.982668759556343*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"94f2b9ba-0ac4-7e4e-a7ba-e34e152a3ae3"],

Cell["Option values can be delayed:", "Text",ExpressionUUID->"5cfd976b-30ab-4b49-a321-0b72e8ea8447"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    StyleBox[
     RowBox[{"FontColor", " ", ":>", " ", 
      RowBox[{"RandomColor", "[", "]"}]}],
     Background->RGBColor[1, 0.9, 0.8]], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"text_", ",", " ", 
     RowBox[{"options", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"text", ",", " ", "options", ",", " ", 
     RowBox[{"FontColor", " ", "->", " ", 
      RowBox[{"OptionValue", "[", "FontColor", "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9826688402732334`*^9, 3.9826688413108253`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"2c91f39b-abfe-6042-a2d8-7292c0046cfe"],

Cell["Test with multiple evaluations:", "Text",
 CellChangeTimes->{{3.982668848148855*^9, 
  3.982668854984783*^9}},ExpressionUUID->"037965bb-e995-574b-8383-\
ac7a95b7e1cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Echo", "[", 
     RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "]"}], ",", 
    "\[IndentingNewLine]", "5"}], "\[IndentingNewLine]", "]"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.9826688571818867`*^9, 3.9826688772651596`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"6154c8b0-a478-a841-9487-ddcaf31c1807"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options vs Arguments", "Subsubsection",
 CellChangeTimes->{{3.9826689686761017`*^9, 
  3.9826689722273827`*^9}},ExpressionUUID->"144de661-3c9f-004d-9f27-\
1d7155f76913"],

Cell["\<\
Without pattern restrictions, options may be misinterpreted as arguments.\
\>", "Text",ExpressionUUID->"8f24a290-ff71-f146-b3e4-7eba5427679f"],

Cell["\<\
Create a function that returns a styled word a number of times:\
\>", "Text",ExpressionUUID->"b5f9ceee-4dec-904e-8259-de1af4193fdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "multiWord", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "multiWord", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Colour\>\"", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"\"\<Weight\>\"", " ", "->", " ", "Plain"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"multiWord", "[", 
    RowBox[{
     RowBox[{"word_", ":", "\"\<defaultWord\>\""}], ",", "  ", 
     RowBox[{"repetitions_", ":", "1"}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Style", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"StringJoin", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"word", ",", " ", "repetitions"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"OptionValue", "[", "\"\<Colour\>\"", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"OptionValue", "[", "\"\<Weight\>\"", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982668974811514*^9, 3.9826689792508564`*^9}, {
  3.982669027681305*^9, 3.982669055410198*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"00ae098a-b848-8547-a86f-fd103ff1c097"],

Cell["\<\
When only options are given, they are mistaken for arguments:\
\>", "Text",ExpressionUUID->"2c0fd9a5-5706-074c-b805-f35768f4cd74"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"multiWord", "[", 
  RowBox[{
   RowBox[{"\"\<Colour\>\"", "->", "Blue"}], ",", 
   RowBox[{"\"\<Weight\>\"", "->", "Bold"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.982668986149708*^9, 3.98266899464135*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"7189db5b-0885-e945-8402-1b5ba935dfdd"],

Cell[BoxData[
 TemplateBox[{
  "StringJoin", "string", 
   "\"String expected at position \\!\\(\\*RowBox[{\\\"1\\\"}]\\) in \
\\!\\(\\*RowBox[{\\\"StringJoin\\\", \\\"[\\\", RowBox[{RowBox[{\\\"(\\\", \
RowBox[{\\\"\\\\\\\"Colour\\\\\\\"\\\", \\\"\[Rule]\\\", \
TemplateBox[Association[Rule[\\\"color\\\", RGBColor[0, 0, 1]]], \
\\\"RGBColorSwatchTemplate\\\"]}], \\\")\\\"}], \\\" \\\", \
TemplateBox[List[TemplateBox[List[RowBox[List[\\\"\\\\\\\"Weight\\\\\\\"\\\", \
\\\"\\\\[Rule]\\\", \\\"Bold\\\"]]], \\\"ImplicitList\\\"]], \
\\\"SymbolicOnesArray\\\"]}], \\\"]\\\"}]\\).\"", 2, 59, 6, 
   20009476260812965795, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{{3.9826689954501114`*^9, 3.982669057582985*^9}},
 CellLabel->
  "During evaluation of \
In[59]:=",ExpressionUUID->"ab41c9e9-adfe-bb45-a476-e1edd071b343"],

Cell[BoxData[
 StyleBox[
  RowBox[{"StringJoin", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\<\"Colour\"\>", "\[Rule]", 
      TemplateBox[<|"color" -> RGBColor[0, 0, 1]|>,
       "RGBColorSwatchTemplate"]}], ")"}], " ", 
    TemplateBox[{
      TemplateBox[{
        RowBox[{"\"Weight\"", "\[Rule]", "Bold"}]}, "ImplicitList"]},
     "SymbolicOnesArray"]}], "]"}],
  StripOnInput->False,
  LineColor->RGBColor[1, 0, 0],
  FrontFaceColor->RGBColor[1, 0, 0],
  BackFaceColor->RGBColor[1, 0, 0],
  GraphicsColor->RGBColor[1, 0, 0],
  FontWeight->Plain,
  FontSlant->Plain,
  FontVariations->{"StrikeThrough"->False,
  "Underline"->False},
  FontColor->RGBColor[1, 0, 0]]], "Output",
 CellChangeTimes->{{3.982668995704241*^9, 3.982669057796129*^9}},
 CellLabel->"Out[59]=",ExpressionUUID->"b9c3080f-0be8-1544-8f26-d7916c032e77"]
}, Open  ]],

Cell["\<\
Adding pattern restrictions to the arguments fixes this issue:\
\>", "Text",ExpressionUUID->"26ab7de0-656d-4a4c-9915-9acc9d3205c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "multiWord", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "multiWord", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Colour\>\"", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"\"\<Weight\>\"", " ", "->", " ", "Plain"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"multiWord", "[", 
    RowBox[{
     RowBox[{
      StyleBox["word_String",
       Background->RGBColor[1, 0.9, 0.8]], ":", "\"\<defaultWord\>\""}], ",", 
     "  ", 
     RowBox[{
      StyleBox["repetitions_Integer",
       Background->RGBColor[1, 0.9, 0.8]], ":", "1"}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Style", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"StringJoin", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"word", ",", " ", "repetitions"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"OptionValue", "[", "\"\<Colour\>\"", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"OptionValue", "[", "\"\<Weight\>\"", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"multiWord", "[", 
  RowBox[{
   RowBox[{"\"\<Colour\>\"", " ", "->", " ", "Blue"}], ",", " ", 
   RowBox[{"\"\<Weight\>\"", " ", "->", "Bold"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.982669008926609*^9, 3.9826690146169815`*^9}, {
  3.9826690964824543`*^9, 3.9826691180026627`*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"ce90569c-e9b0-9a46-90e8-03be4464a2b1"],

