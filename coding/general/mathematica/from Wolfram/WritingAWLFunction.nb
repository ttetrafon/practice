 "For this particular example, ",
 ButtonBox["GCD",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/GCD.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/GCD.html"],
 " does a better job:"
}], "Text",ExpressionUUID->"41d8d749-5859-4b46-b56d-5ffc9a1fa703"],

Cell[BoxData[
 RowBox[{"GCD", "[", 
  RowBox[{"629", ",", " ", "1147"}], "]"}]], "Input",ExpressionUUID->\
"0ddd129f-36ec-4340-bfb9-add8a121ae2c"]
}, Closed]],

Cell["", "Subsubsubsection",
