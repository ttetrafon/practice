Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"48ae6de9-0f9f-4741-abc6-326dea8fbbae"],

Cell[CellGroupData[{

Cell["Options", "Section",ExpressionUUID->"14fa7eba-1328-0f4a-a8d2-947db959648d"],

Cell[CellGroupData[{

Cell["Filtering Options", "Subsection",
 CellTags->
  "Options-FilteringOptions",ExpressionUUID->"bde9ad62-2aa7-f042-a7a5-\
9ed4ad872556"],

Cell[TextData[{
 "Filtering options with ",
 ButtonBox["FilterRules",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FilterRules.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FilterRules.html"],
 " is a way to ensure that all the right options go to all the right parts of \
a function, making it more robust."
}], "Text",ExpressionUUID->"61a1cbe7-3b2b-1a42-baaa-62e633fbfaa7"],

Cell[TextData[{
 "Create a function that takes a ",
 ButtonBox["Graphics",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Graphics.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Graphics.html"],
 " option as well as a custom title option:"
}], "Text",ExpressionUUID->"830d583e-93db-114d-a157-ea856b0f18ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "titledGraphic", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "titledGraphic", "]"}], " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Options", "[", "Graphics", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Title\>\"", " ", "->", " ", "\"\<\>\""}], "}"}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"titledGraphic", "[", 
    RowBox[{"graphic_", ",", " ", 
     RowBox[{"options", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Column", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{"OptionValue", "[", "\"\<Title\>\"", "]"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
        RowBox[{"graphic", ",", "\[IndentingNewLine]", 
         RowBox[{"Sequence", " ", "@@", " ", 
          StyleBox[
           RowBox[{"FilterRules", "[", 
            RowBox[{
             RowBox[{"{", "options", "}"}], ",", " ", 
             RowBox[{"Options", "[", "Graphics", "]"}]}], "]"}],
           Background->RGBColor[1, 0.9, 0.8]]}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9826692378066883`*^9, 3.9826692415453815`*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"cc9af850-6927-0f4e-b537-394fc8c5c59e"],

Cell["\<\
No matter the order in which they are used, options will be filtered to the \
relevant parts of the function:\
\>", "Text",ExpressionUUID->"8d54ea35-24e0-c04e-bf53-8965b58de55b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"titledGraphic", "[", 
  RowBox[{
   RowBox[{"Circle", "[", "]"}], ",", " ", 
   RowBox[{"Background", " ", "->", " ", "LightBlue"}], ",", " ", 
   RowBox[{"\"\<Title\>\"", " ", "->", " ", "\"\<This is a circle\>\""}], ",",
    " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}]}], "]"}]], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"9e553370-b324-654d-8f33-5173d7b1c7d8"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     InterpretationBox[Cell[BoxData[
       FormBox["\<\"This is a circle\"\>", TextForm]], "InlineText",
       ExpressionUUID->"7828fbb9-eb93-5f4e-8e74-1fd06a69197f"],
      Text["This is a circle"]]},
    {
     GraphicsBox[CircleBox[{0, 0}],
      Background->RGBColor[0.87, 0.94, 1],
      Frame->True]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Center}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Column"]], "Output",
 CellChangeTimes->{3.982669250832945*^9},
 CellLabel->
  "Out[102]=",ExpressionUUID->"8b97f78a-c4c8-c242-97a5-4c1acb1490f7"]
}, Open  ]],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"14577312-316d-5641-b439-25cbbd4b4001"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"1b2528e5-ce34-c247-b20e-54903e68dcb3"],

Cell[CellGroupData[{

Cell["Options", "Section",ExpressionUUID->"a744fa06-2cf6-6b4c-87c7-0b0b9062a1db"],

Cell[CellGroupData[{

Cell["Restricting Options", "Subsection",
 CellTags->
  "Options-RestrictingOptions",ExpressionUUID->"59b2f593-3303-6f48-85dc-\
60a6b156b884"],

Cell[TextData[{
 "Another way to make a function more robust is to restrict the option names \
or values that can be used within it. This is typically done with ",
 ButtonBox["Condition",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Condition.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Condition.html"],
 "."
}], "Text",
 CellChangeTimes->{{3.870436747812477*^9, 
  3.870436747814107*^9}},ExpressionUUID->"41d3e226-0e7b-7b41-9f43-\
ccfd46a93227"],

Cell[CellGroupData[{

Cell["Option Names", "Subsubsection",
 CellChangeTimes->{{3.982669294549343*^9, 
  3.9826692948629837`*^9}},ExpressionUUID->"2f08ab76-cfa6-944c-b3e3-\
406d43ad3865"],

Cell["\<\
Often, option names are required to be a members of a pre-defined list.\
\>", "Text",ExpressionUUID->"cc3bd064-c3f3-5443-bab0-2dbc6db3b1de"],

Cell["\<\
Require all option names of a function to be members of (the keys of) the \
default list of options:\
\>", "Text",ExpressionUUID->"b598bafa-199a-8347-8359-5eeb8d95a751"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "disk", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "disk", "]"}], " ", "=", " ", 
   RowBox[{"Options", "[", "Graphics", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"disk", "[", 
     RowBox[{"centre_", ",", " ", "radius_", ",", " ", 
      RowBox[{"options", " ", ":", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], 
    StyleBox["/;",
     Background->RGBColor[1, 0.9, 0.8]], 
    StyleBox[
     RowBox[{"ContainsAll", "[", 
      RowBox[{
       RowBox[{"Keys", "[", 
        RowBox[{"Options", "[", "disk", "]"}], "]"}], ",", " ", 
       RowBox[{"Keys", "[", 
        RowBox[{"{", "options", "}"}], "]"}]}], "]"}],
     Background->RGBColor[1, 0.9, 0.8]]}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Disk", "[", 
       RowBox[{"centre", ",", " ", "radius"}], "]"}], "}"}], ",", 
     "\[IndentingNewLine]", "options"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "1", ",", " ", 
   RowBox[{"Background", " ", "->", " ", "LightBlue"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "1", ",", " ", 
   RowBox[{"\"\<BadOption\>\"", " ", "->", " ", "value"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.982669297194496*^9, 3.982669304367733*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"be86f484-796d-aa41-9d1d-a396b91acc26"],

Cell[BoxData[
 GraphicsBox[DiskBox[{0, 0}, 1],
  Background->RGBColor[0.87, 0.94, 1]]], "Output",
 CellChangeTimes->{3.98266930478343*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"b3e9cf9b-b354-fd4e-9724-8829af08169c"],

Cell[BoxData[
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
   RowBox[{"\<\"BadOption\"\>", "\[Rule]", "value"}]}], "]"}]], "Output",
 CellChangeTimes->{3.9826693049894447`*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"7a0e17da-1f29-b046-8f63-b26ba7d093d5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Option Values", "Subsubsection",
 CellChangeTimes->{{3.982669314355747*^9, 
  3.9826693147300205`*^9}},ExpressionUUID->"27e2c900-8205-ea4e-9474-\
fa8ddc9e2c15"],

Cell["\<\
Like arguments, option values are often required to be of a particular form \
(string, integer, etc.).\
\>", "Text",ExpressionUUID->"8f19fe7b-91dd-3148-8273-1efc0c66a609"],

Cell["\<\
Require the value of a function\[CloseCurlyQuote]s \
\[OpenCurlyDoubleQuote]Colour\[CloseCurlyDoubleQuote] option to be a valid \
colour:\
\>", "Text",ExpressionUUID->"525b9c1f-c3a0-d24f-966d-ad1d2996bc5b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "disk", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "disk", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<Colour\>\"", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"\"\<EdgeStyle\>\"", " ", "->", " ", "Thick"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"disk", "[", 
     RowBox[{"centre_", ",", " ", "radius_", ",", " ", 
      RowBox[{"options", " ", ":", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], 
    StyleBox["/;",
     Background->RGBColor[1, 0.9, 0.8]], 
    StyleBox[
     RowBox[{"ColorQ", "[", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"{", "options", "}"}], ",", " ", "\"\<Colour\>\"", ",", " ", 
        "Black"}], "]"}], "]"}],
     Background->RGBColor[1, 0.9, 0.8]]}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"EdgeForm", "[", 
       RowBox[{"OptionValue", "[", "\"\<EdgeStyle\>\"", "]"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"OptionValue", "[", "\"\<Colour\>\"", "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Disk", "[", 
       RowBox[{"centre", ",", " ", "radius"}], "]"}]}], "\[IndentingNewLine]",
      "}"}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "1", ",", " ", 
   RowBox[{"\"\<Colour\>\"", " ", "->", " ", "Green"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "1", ",", " ", 
   RowBox[{"\"\<Colour\>\"", " ", "->", " ", "badColour"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826693182689514`*^9, 3.982669319942583*^9}, {
  3.9826693605646534`*^9, 3.982669360697605*^9}, {3.9826694184569473`*^9, 
  3.9826694325935993`*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"4b55c83a-6a26-c64f-9a41-576b95590f77"],

Cell[BoxData[
 GraphicsBox[
  {RGBColor[0, 1, 0], EdgeForm[Thickness[Large]], 
   DiskBox[{0, 0}, 1]}]], "Output",
 CellChangeTimes->{
  3.9826693256870804`*^9, {3.982669424835741*^9, 3.9826694333980007`*^9}},
 CellLabel->
  "Out[125]=",ExpressionUUID->"7493a4dc-1266-0b41-986c-df3e11096bf7"],

Cell[BoxData[
 RowBox[{"disk", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
   RowBox[{"\<\"Colour\"\>", "\[Rule]", "badColour"}]}], "]"}]], "Output",
 CellChangeTimes->{
  3.9826693256870804`*^9, {3.982669424835741*^9, 3.9826694336087513`*^9}},
 CellLabel->
