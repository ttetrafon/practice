Cell["CheckArguments", "Subsubsection",ExpressionUUID->"fcd77adc-0b70-2345-b83a-4c54e20b7d35"],

Cell[TextData[{
 "A function\[CloseCurlyQuote]s syntax can be checked (without evaluating it) \
with ",
 ButtonBox["CheckArguments",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/CheckArguments.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/CheckArguments.html"],
 ":"
}], "Text",ExpressionUUID->"8f0c1d6f-6d3d-1548-ab54-3d60794dfa3c"],

Cell[BoxData[{
 RowBox[{"CheckArguments", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", 
     RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"CheckArguments", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"1", ",", " ", "2", ",", " ", 
     RowBox[{"\"\<123\>\"", " ", "->", " ", "1"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], "Input",ExpressionUUID->\
"50b9f6a6-8a55-2f42-bc2e-77a5790fc1b9"],

Cell["\<\
CheckArguments allows arguments to be treated as options and vice versa:\
\>", "Text",ExpressionUUID->"fbd948a0-b8cf-8c49-991f-a3337741e44f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"CheckArguments", "[", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"\"\<c\>\"", " ", "->", " ", "3"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"\"\<OptionsMode\>\"", "\[Rule]", "\"\<Longest\>\""}], "|>"}]}], 
   "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Treat", " ", "\"\<c\>\"", " ", "as", " ", "an", " ", "option"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CheckArguments", "[", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"\"\<c\>\"", " ", "->", " ", "3"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
    RowBox[{"<|", 
     RowBox[{"\"\<OptionsMode\>\"", "\[Rule]", "\"\<Shortest\>\""}], "|>"}]}],
    "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Treat", " ", "\"\<c\>\"", " ", "as", " ", "an", " ", "argument"}],
    " ", "*)"}]}]}], "Input",ExpressionUUID->"8c76ee8d-d865-4049-ace2-\
769aa6cbf3c9"],

