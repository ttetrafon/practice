Cell["Useful Tips", "Section",ExpressionUUID->"4b38230b-38d0-d043-a71a-7aa97327d111"],

Cell[CellGroupData[{

Cell["Localisation", "Subsection",
 CellTags->
  "ExtraTips-Localisation",ExpressionUUID->"19ef4fa2-e1e7-944d-a97b-\
402b5151a100"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Modularity and the Naming of Things",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html"],
 "\nGuide: ",
 ButtonBox["Scoping Constructs",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/guide/ScopingConstructs.html"],
     None},
  ButtonNote->
   "http://reference.wolfram.com/language/guide/ScopingConstructs.html"]
}], "Text",ExpressionUUID->"b33ef222-8f57-4942-8d6d-ce3ca07a8cbc"],

Cell[TextData[{
 "A good practice for programming in general\[LongDash]not just for creating \
functions\[LongDash]is to ",
 StyleBox["localise variables",
  FontSlant->"Italic"],
 " wherever possible. There are three main functions for doing this: ",
 ButtonBox["With",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/With.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/With.html"],
 ", ",
 ButtonBox["Module",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Module.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Module.html"],
 " and ",
 ButtonBox["Block",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Block.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Block.html"],
 ". Each of these functions has a slightly different purpose, but for small \
tasks they are often interchangeable. Another function worth mentioning is ",
 ButtonBox["DynamicModule",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/DynamicModule.html"], 
    None},
  ButtonNote->"https://reference.wolfram.com/language/ref/DynamicModule.html"],
 ", which is typically used for creating dynamic interfaces."
}], "Text",ExpressionUUID->"616108b6-237a-354e-bfe7-390ba3a0ee87"],

Cell["\<\
All of these functions share a common structure: a list of variables in the \
first argument and an expression (containing the variables) in the second \
argument.\
\>", "Text",ExpressionUUID->"d888bc7e-d2ea-4448-aa69-54b1da78234b"],

Cell[CellGroupData[{

Cell["With", "Subsubsection",ExpressionUUID->"d21ce8e5-39d0-fd4b-96f1-a29838488726"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Local Constants",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html#19459"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html#19459"]
}], "Text",ExpressionUUID->"864445b6-48c5-3949-abab-b77fc8f2df83"],

Cell[TextData[{
 "With uses ",
 ButtonBox["lexical scoping",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Scope_(computer_science)#Lexical_\
scope"], None},
  ButtonNote->
   "https://en.wikipedia.org/wiki/Scope_(computer_science)#Lexical_scope"],
 ". It replaces its variables with their assigned values immediately, \
treating them like constants. Because of this, variables inside With cannot \
be reassigned:"
}], "Text",ExpressionUUID->"a9450b3a-f22b-5e4c-9ec2-e31d0b70c716"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"a", " ", "=", " ", "2"}]}], "]"}]], "Input",ExpressionUUID->\
"00e802e0-d9bf-d14a-baeb-6e87c60a2518"],

Cell["With is particularly useful for setting up initial data.", "Text",ExpressionUUID->"82536521-73cf-2c4d-a573-4d9a62d40e53"],

Cell[TextData[{
 "Create a function that plots some random temporal data (note the reuse of ",
 StyleBox["initialData", "Input"],
 " several times throughout the function):"
}], "Text",ExpressionUUID->"f28d9cf6-cbf8-f943-81e0-f7d9c5b3b17a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plotData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"plotData", "[", 
     RowBox[{"noOfPoints_", " ", ":", " ", "100"}], "]"}], " ", ":=", " ", 
    RowBox[{
     StyleBox["With",
      Background->RGBColor[1, 0.9, 0.8]], 
     StyleBox["[",
      Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"initialData", " ", "=", " ", 
        RowBox[{"RandomFunction", "[", 
         RowBox[{
          RowBox[{"ARProcess", "[", 
           RowBox[{
            RowBox[{"{", "0.7", "}"}], ",", "1"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "noOfPoints"}], "}"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
       RowBox[{"initialData", ",", "\[IndentingNewLine]", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "noOfPoints"}], "}"}], ",", " ", 
           RowBox[{
            RowBox[{"MinMax", "[", "initialData", "]"}], "+", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "  ", "1"}], "}"}]}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotLegends", " ", "->", " ", 
         RowBox[{"Grid", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Mean\>\"", ",", " ", 
               RowBox[{"Mean", "[", "initialData", "]"}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"\"\<Range\>\"", ",", " ", 
               RowBox[{"First", "[", 
                RowBox[{"Differences", "[", 
                 RowBox[{"MinMax", "[", "initialData", "]"}], "]"}], "]"}]}], 
              "}"}]}], "\[IndentingNewLine]", "}"}], ",", 
           "\[IndentingNewLine]", 
           InterpretationBox[
            DynamicModuleBox[{Typeset`open = False}, 
             TemplateBox[{"Expression", 
               StyleBox[
               "\"Grid options\"", "IconizedCustomName", StripOnInput -> 
                False], 
               GridBox[{{
                  RowBox[{
                    TagBox["\"Head: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["Sequence", "IconizedItem"]}]}, {
                  RowBox[{
                    TagBox["\"Length: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["4", "IconizedItem"]}]}, {
                  RowBox[{
                    TagBox["\"Byte count: \"", "IconizedLabel"], 
                    "\[InvisibleSpace]", 
                    TagBox["576", "IconizedItem"]}]}}, 
                GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
                "Column", 
                GridBoxItemSize -> {
                 "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
               Dynamic[Typeset`open]},
              "IconizedObject"]],
            Sequence[
            Frame -> True, FrameStyle -> GrayLevel[0.5], 
             Dividers -> {2 -> GrayLevel[0.85]}, BaseStyle -> "Text"],
            SelectWithContents->True,
            Selectable->False]}], "\[IndentingNewLine]", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", 
            StyleBox[
            "\"Plot options\"", "IconizedCustomName", StripOnInput -> False], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Sequence", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["6", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["952", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Sequence[
         PlotLabel -> 
          StringForm["A plot of `1` points", $CellContext`noOfPoints], 
          PlotStyle -> RGBColor[1, 0, 0], Filling -> Axis, Frame -> True, 
          FrameLabel -> {
            Style["x", "TI"], 
            Style["y", "TI"]}, ImageSize -> 500],
         SelectWithContents->True,
         Selectable->False]}], "\[IndentingNewLine]", "]"}]}], 
     "\[IndentingNewLine]", 
     StyleBox["]",
      Background->RGBColor[1, 0.9, 0.8]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"plotData", "[", "200", "]"}]}], "Input",ExpressionUUID->"a1e07a9d-\
50c8-2949-8ed6-1223961fb201"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Module", "Subsubsection",ExpressionUUID->"e1c1c3ce-794b-6d48-9390-539da22e0e36"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Modules and Local Variables",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html#7693"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html#7693"],
 "\nTech Note: ",
 ButtonBox["How Modules Work",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html#22619"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
ModularityAndTheNamingOfThings.html#22619"]
}], "Text",ExpressionUUID->"04ab935a-c998-d64a-abfa-4c34f94aed9d"],

Cell["\<\
Module uses lexical scoping. It is generally the go-to function for \
localising variables. To ensure there are no symbol conflicts, it creates new \
temporary symbols for each of its variables:\
\>", "Text",ExpressionUUID->"470509f9-09d9-6e41-b867-5cc2896fd8cc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "a", "}"}], ",", " ", "a"}], "]"}], ",", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "a", "}"}], ",", " ", "a"}], "]"}]}], "}"}]], "Input",Expres\
sionUUID->"bca2a55e-2df4-ae43-a421-5567747f077f"],

Cell["\<\
Module can be used to localise small\[LongDash]so-called \
\[OpenCurlyDoubleQuote]helper\[CloseCurlyDoubleQuote]\[LongDash]functions, \
which can then be used inside larger functions.\
\>", "Text",ExpressionUUID->"41957349-a72c-a242-aa63-107a8147dbe4"],

Cell[TextData[{
 "Create a function that plots a distribution of ",
 StyleBox["Titanic",
  FontSlant->"Italic"],
 " passengers by age:"
}], "Text",ExpressionUUID->"e62e0d2f-f514-d54f-a1c0-9bf5a6a79320"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "plotTitanicData", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotTitanicData", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"minAge_", " ", ":", " ", "20"}], ",", " ", 
      RowBox[{"maxAge_", " ", ":", " ", "30"}]}], "}"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"ExampleData", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<Dataset\>\"", ",", "\"\<Titanic\>\""}], "}"}], "]"}], 
        "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      StyleBox["Module",
       Background->RGBColor[1, 0.9, 0.8]], 
      StyleBox["[",
       Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"deleteMissing", ",", " ", "selectByAge"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Helper", " ", 
         RowBox[{"functions", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"deleteMissing", "[", "data_", "]"}], " ", ":=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", " ", 
           RowBox[{
            RowBox[{"FreeQ", "[", 
             RowBox[{"#", ",", " ", 
              RowBox[{"Missing", "[", "___", "]"}]}], "]"}], "&"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"selectByAge", "[", 
          RowBox[{"data_", ",", " ", "interval_"}], "]"}], " ", ":=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", " ", 
           RowBox[{
            RowBox[{"Between", "[", 
             RowBox[{
              RowBox[{"#", "[", "\"\<age\>\"", "]"}], ",", " ", "interval"}], 
             "]"}], " ", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Main", " ", 
          RowBox[{"function", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Histogram", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"selectByAge", "[", 
            RowBox[{
             RowBox[{"deleteMissing", "[", "data", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"minAge", ",", " ", "maxAge"}], "}"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "\"\<age\>\""}], "]"}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", "1", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"StringForm", "[", 
            
            RowBox[{"\"\<Distribution of passengers on the Titanic (aged `1` \
to `2`)\>\"", ",", " ", "minAge", ",", " ", "maxAge"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Frame", " ", "->", " ", "True"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Age\>\"", ",", " ", "\"\<Frequency\>\""}], "}"}]}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"ImageSize", " ", "->", " ", "500"}]}], 
         "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
      StyleBox["]",
       Background->RGBColor[1, 0.9, 0.8]]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",ExpressionUUID->"b1f09e10-7ea2-d144-b070-d13e15854666"],

Cell[BoxData[
 RowBox[{"plotTitanicData", "[", 
  RowBox[{"{", 
   RowBox[{"0", ",", " ", "20"}], "}"}], "]"}]], "Input",ExpressionUUID->\
"54134782-083d-304a-a928-1a7302e18960"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotTitanicData", "[", "minMax", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"minMax", ",", "100", ",", "\"\<MinMax\>\""}], "}"}], ",", "0", 
     ",", "100", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ControlType", "->", "IntervalSlider"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"b083e43e-7bf8-a146-8eb9-11e2ebd77e84"]
}, Open  ]],

