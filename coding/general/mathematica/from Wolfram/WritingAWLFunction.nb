Cell[TextData[{
 "Create a function to calculate the square root of a number (using ",
 ButtonBox["Newton's method",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Newton%27s_method"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Newton%27s_method"],
 ") that fails if the calculation takes too long:"
}], "Text",ExpressionUUID->"a263cba7-b931-0941-9591-907c3163280c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "newtonSqrt", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"newtonSqrt", "[", 
    RowBox[{"num_", ",", " ", "initialGuess_"}], "]"}], " ", ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Enclose", "[", "\[IndentingNewLine]", 
    RowBox[{"Confirm", "[", "\[IndentingNewLine]", 
     RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"FixedPoint", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", "+", 
             RowBox[{"num", "/", "#"}]}], ")"}], "/", "2."}], "&"}], ",", 
         "\[IndentingNewLine]", "initialGuess"}], "\[IndentingNewLine]", 
        "]"}], ",", "\[IndentingNewLine]", " ", "1"}], "\[IndentingNewLine]", 
      "]"}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"newtonSqrt", "[", 
  RowBox[{"15129", ",", " ", "badGuess"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"newtonSqrt", "[", 
  RowBox[{"15129", ",", " ", "1."}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826723050635815`*^9, 3.9826723535315247`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"1c24bd5a-a0f1-ac45-902b-73de2bd1d518"],

