Cell[CellGroupData[{

Cell["Common Practices", "Subsubsection",
 CellChangeTimes->{{3.982647202022089*^9, 
  3.98264720227125*^9}},ExpressionUUID->"90e437da-ebf6-4e13-8279-\
7ee0dc7455bb"],

Cell["For readability, it is usually best to:", "Text",ExpressionUUID->"b4d097ee-7951-4990-9b94-d9cdc2cb1332"],

Cell["\<\
Use lowercaseCamelCase for the function name (and its arguments)\
\>", "Item",
 CellChangeTimes->{{3.9826472135870953`*^9, 3.982647214649111*^9}, {
  3.98276201976799*^9, 
  3.9827620200901947`*^9}},ExpressionUUID->"36b389f6-600b-485b-9257-\
d8770de7433b"],

Cell["Use UppercaseCamelCase strings or symbols for any options", "Item",
 CellChangeTimes->{{3.9827620214508057`*^9, 
  3.9827620217535763`*^9}},ExpressionUUID->"6e75eef0-1bff-46e1-b83b-\
8f81d2468528"],

Cell["Other common conventions:", "Text",ExpressionUUID->"e193e075-4cb3-44fd-bd8a-7c2c161dc55a"],

Cell[TextData[{
 "Use ",
 StyleBox["functionName",
  FontSlant->"Italic"],
 "Q for functions that will always evaluate to ",
 ButtonBox["True",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/True.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/True.html"],
 " or ",
 ButtonBox["False",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/False.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/False.html"],
 " (e.g. ",
 ButtonBox["EvenQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/EvenQ.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/EvenQ.html"],
 "). (These functions are known as ",
 StyleBox["predicate functions",
  FontSlant->"Italic"],
 ".)"
}], "Item",
 CellChangeTimes->{{3.9826472359984264`*^9, 3.9826472490486183`*^9}, {
  3.982762061510296*^9, 
  3.98276206249551*^9}},ExpressionUUID->"bfcd3fe8-1618-4685-bcb5-\
2dc1c62256d9"],

Cell[TextData[{
 "Use $",
 StyleBox["name",
  FontSlant->"Italic"],
 " for global variables (e.g. ",
 ButtonBox["$Version",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/$Version.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/$Version.html"],
 ")"
}], "Item",
 CellChangeTimes->{{3.982762064190607*^9, 
  3.9827620645020084`*^9}},ExpressionUUID->"2854dc1f-76e5-4eae-a7b3-\
c4bd29386ec2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Quick Example", "Subsubsection",
 CellChangeTimes->{{3.9826473064450264`*^9, 
  3.982647306830179*^9}},ExpressionUUID->"63294c95-6644-4d86-90b1-\
821ae972b942"],

Cell["\<\
Here is an example of a function with one argument that multiplies the \
argument by three:\
\>", "Text",ExpressionUUID->"bccf357e-a0d8-4bb5-ba19-51475db574bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "multiplyByThree", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"multiplyByThree", "[", "num_", "]"}], " ", ":=", " ", 
   RowBox[{"num", " ", "*", " ", "3"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9826473353838787`*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"5c2a1e9f-e1d8-4932-8b05-cd600b67d6b6"],

Cell["\<\
These lines add the option to take the modulus of the result:\
\>", "Text",ExpressionUUID->"0851b823-979e-465f-b891-56010c2ac7ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "multiplyByThree", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Modulus\>\"", " ", "->", " ", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"multiplyByThree", "[", 
    RowBox[{"num_", ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Mod", "[", 
    RowBox[{
     RowBox[{"num", " ", "*", " ", "3"}], ",", 
     RowBox[{"OptionValue", "[", "\"\<Modulus\>\"", "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.9826473407871895`*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"8bbc735f-df60-4aa0-bf77-3709a35678cd"],

Cell["Here is the function in action:", "Text",ExpressionUUID->"45a4243c-8b1c-4e75-bfc3-fa32da6ddbc0"],

Cell[BoxData[{
 RowBox[{"multiplyByThree", "[", "7", "]"}], "\n", 
 RowBox[{"multiplyByThree", "[", 
  RowBox[{"7", ",", " ", 
   RowBox[{"\"\<Modulus\>\"", "\[Rule]", "5"}]}], "]"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"aaff92c0-5e47-44b0-807d-ed44e844db58"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"16ab6f6d-bd4b-4e81-9b6e-02abcb9d15bf"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"5d52e36b-f70f-407e-a1a4-5b46bb846eae"],

Cell[CellGroupData[{

Cell["The Basics", "Section",ExpressionUUID->"13fbf7eb-8f88-44e7-a3ce-961d7478f3fa"],

Cell[CellGroupData[{

Cell["Pure Functions", "Subsection",
 CellChangeTimes->{{3.982647458954462*^9, 
  3.9826474613718567`*^9}},ExpressionUUID->"ddf5a412-4d74-5447-a0f8-\
53ce9b0f80d4"],

Cell[TextData[{
 "The standard structure of a function definition requires you to give the \
function a name, which is not always desirable. The alternative\[LongDash]a ",
 StyleBox["pure function",
  FontSlant->"Italic"],
 "\[LongDash]has the benefit that it is defined in the same place it is used, \
meaning that someone reading your code will not have to go hunting for a \
definition."
}], "Text",
 CellChangeTimes->{{3.87043583946238*^9, 
  3.870435840701581*^9}},ExpressionUUID->"ae04bcf9-e566-4a7e-bde3-\
4fc61e9b4848"],

Cell[CellGroupData[{

Cell["Applications", "Subsubsection",ExpressionUUID->"80f2fe92-9fae-47cc-91b1-c50fa277cb41"],

Cell["You might want to use a pure function if your function is:", "Text",ExpressionUUID->"a43cb794-4f1a-49cb-bc29-c52e70d81357"],

Cell["Simple", "Item",
 CellChangeTimes->{{3.982647488025114*^9, 
  3.98264748949135*^9}},ExpressionUUID->"84e04d8e-bd91-4c97-baba-\
7446b6a81ab0"],

Cell["Only being used once", "Item",
 CellChangeTimes->{{3.982647491446789*^9, 
  3.982647491691677*^9}},ExpressionUUID->"c9ed335a-435c-418f-a1a6-\
be65a7ac97a2"],

Cell["Forms part of a larger function", "Item",
 CellChangeTimes->{{3.9826474939848137`*^9, 
  3.982647495944401*^9}},ExpressionUUID->"982a5705-8aa9-48f6-99f1-\
513d4997d932"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Forms", "Subsubsection",ExpressionUUID->"4c789946-c0aa-4524-a112-f92d2a724f18"],

Cell[TextData[{
 "Pure functions come in a variety of forms, all of which use ",
 ButtonBox["Function",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Function.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Function.html"],
 " \[OpenCurlyDoubleQuote]under the hood\[CloseCurlyDoubleQuote]."
}], "Text",ExpressionUUID->"40aeb24f-b6a8-476f-873f-d5b72f2bca4c"],

Cell[CellGroupData[{

Cell["Function", "Subsubsubsection",ExpressionUUID->"eb2d4173-9b12-4c30-9489-81f401de2d8d"],

Cell[TextData[{
 "Function is typically used in the form ",
 StyleBox["Function[", "Input"],
 StyleBox["parameters", "Input",
  FontSlant->"Italic"],
 StyleBox[", ", "Input"],
 StyleBox["body", "Input",
  FontSlant->"Italic"],
 StyleBox["]", "Input"],
 ":"
}], "Text",ExpressionUUID->"a9146347-d115-4941-a139-c9a6132e403d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Function", "[", 
   RowBox[{"n", ",", " ", 
    RowBox[{"n", "^", "2"}]}], "]"}], "[", "x", "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"8fb2def7-c6ad-472f-9cb5-36a543ae834a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p", ",", " ", "q"}], "}"}], ",", " ", 
    RowBox[{"p", " ", "+", " ", "q"}]}], "]"}], "[", 
  RowBox[{"x", ",", " ", "y"}], "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"5567f284-60af-4520-9edb-4382a3283b6a"],

Cell[TextData[{
 "The parameters can be dropped in favour of ",
 ButtonBox["slots",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Slot.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Slot.html"],
 " (",
 StyleBox["#", "Input"],
 "):"
}], "Text",ExpressionUUID->"72606f3a-0c31-4928-858e-49dac6753f2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Function", "[", 
   RowBox[{"#", "^", "2"}], "]"}], "[", "x", "]"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"83e0ea91-9b82-452a-a0c4-b65a97121310"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "(",
 StyleBox["body",
  FontSlant->"Italic"],
 ") &"
}], "Subsubsubsection",ExpressionUUID->"52d6243b-2877-486c-bae6-de222246ae10"],

Cell[TextData[{
 "A pure function can be shortened further by replacing ",
 StyleBox["Function[", "Input"],
 StyleBox["body", "Input",
  FontSlant->"Italic"],
 StyleBox["]", "Input"],
 " with ",
 StyleBox["(", "Input"],
 StyleBox["body", "Input",
  FontSlant->"Italic"],
 StyleBox[")&", "Input"],
 ":"
}], "Text",ExpressionUUID->"22080e74-7ab7-4303-9e4a-633257afb4b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"#", "^", "2"}], ")"}], "&"}], "[", "x", "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"31c8251c-01e5-461a-8471-c31a9ace3513"],

Cell[TextData[{
 "Arguments can be referenced by their positions (",
 StyleBox["#", "Input"],
 " is equivalent to ",
 StyleBox["#1", "Input"],
 "):"
}], "Text",ExpressionUUID->"ae26fc24-0a03-4071-950c-9d25b7ff2f8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"#1", "^", "2"}], ")"}], "&"}], "[", "x", "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"ec6e4e8d-a488-46c1-b919-60cd1ee62d58"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"#2", "^", "2"}], ")"}], "&"}], "[", 
  RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"981fd6a9-e186-454c-88e2-3d43993545c6"],

Cell["\<\
When applied to associations, slots can be referenced by labels:\
\>", "Text",ExpressionUUID->"393e1d75-bf50-426f-a85f-103a40efeedc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"#b", "^", "2"}], ")"}], "&"}], "[", 
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<a\>\"", " ", "->", " ", "x"}], ",", 
    RowBox[{"\"\<b\>\"", " ", "->", " ", "y"}], ",", " ", 
    RowBox[{"\"\<c\>\"", " ", "->", " ", "z"}]}], "|>"}], "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"f7af5110-2ae1-44f8-afe4-b098b44e7c38"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "f[",
 StyleBox["slots",
  FontSlant->"Italic"],
 "] &"
}], "Subsubsubsection",ExpressionUUID->"f2bd34b6-2e05-468d-8034-96521de76ad9"],

Cell["\<\
Pure functions can even be used as arguments for other functions:\
\>", "Text",ExpressionUUID->"d75bc2f1-827d-44b6-b23c-73621a4b07a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"#1", ",", " ", "#2", ",", " ", 
     RowBox[{"#1", "*", "#2"}]}], "]"}], "&"}], "[", 
  RowBox[{"x", ",", " ", "y"}], "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"f15a20a3-d800-4b05-b85d-bb1e6aa0d35b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Additional Slot Notation",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.982647558338917*^9, 3.982647560860531*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"eff34368-ac91-4c5a-94df-21627ffe26d8"],

Cell[TextData[{
 ButtonBox["SlotSequence",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/SlotSequence.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/SlotSequence.html"],
 " (",
 StyleBox["##", "Input"],
 ") refers to all of the arguments:"
}], "Text",ExpressionUUID->"cca3ef12-827b-4bb5-8ec9-01932b614d17"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "##", "]"}], "&"}], "[", 
  RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"a1b5c409-183a-42ad-8ab9-4565a43a0d7b"],

Cell[TextData[{
 StyleBox["##n", "Input"],
 " refers to the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[Null]n",
     FontSlant->"Italic"], "th"], TraditionalForm]],ExpressionUUID->
  "6c39eb9f-4558-4e0f-91c4-33e13d3181ef"],
 " argument and all of the arguments after it:"
}], "Text",
 CellChangeTimes->{
  3.870435862384774*^9},ExpressionUUID->"1c189623-a547-4be0-a0dc-\
93492cd556d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "##2", "]"}], "&"}], "[", 
  RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"5e5687fe-c6fb-4a2d-b2fe-c3f15ab575a2"],

Cell[TextData[{
 "While not common, a pure function can reference itself with ",
 StyleBox["#0", "Input"],
 ":"
}], "Text",ExpressionUUID->"ae0e3fe5-889d-4d75-b279-f5df9c5aca3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "#0", "]"}], "&"}], "[", "x", "]"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"417db4a1-59d4-426a-bea7-478152769894"]
}, Closed]],

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"94955cb7-e484-4aa8-968f-38901d08f895"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Precedence", "Subsubsection",ExpressionUUID->"676a3cdf-469f-484d-a327-5088654ecbc4"],

Cell["\<\
When code is evaluated, operators are applied sequentially according to their \
precedence. This can be thought of as an extension to mathematical \
precedence, where, for example, multiplication is applied before addition:\
\>", "Text",ExpressionUUID->"580f0f3d-d358-441b-9d87-f25206e6c624"],

Cell[BoxData[
 RowBox[{"2", " ", "+", " ", 
  RowBox[{"3", " ", "*", " ", "4"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"bcb40799-471b-47dc-a8dd-fbfa5c2f94b2"],

Cell["\<\
When using pure functions with an ampersand (&), it is usually best to \
include parentheses, both to make your intentions clear and to avoid errors.\
\>", "Text",ExpressionUUID->"e786cd4e-d638-45b4-abd4-912483106d14"],

Cell[TextData[{
 "Here, the pattern test (",
 StyleBox["?", "Input"],
 ") \[OpenCurlyQuote]binds more tightly\[CloseCurlyQuote] than the function (",
 StyleBox["&", "Input"],
 "), so parentheses are required for the code to work properly:"
}], "Text",
 CellChangeTimes->{{3.9826477831798744`*^9, 
  3.9826477843486423`*^9}},ExpressionUUID->"600ef062-c01f-43cc-b363-\
2846194bab8c"],

Cell[BoxData[{
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"_", "?", "OddQ"}], "[", "#", "]"}], "&"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], ",", 
   RowBox[{"_", "?", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"OddQ", "[", "#", "]"}], "&"}], ")"}]}]}], "]"}]}], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"98d43800-e48a-40de-ba87-83da1cece056"],

Cell["In the first case, the kernel treats it like:", "Text",
 CellChangeTimes->{{3.982647790155607*^9, 
  3.9826478058357067`*^9}},ExpressionUUID->"fb1601d5-9f09-6c45-a2eb-\
7cb30a2d002e"],

Cell[BoxData[
 RowBox[{"Cases", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"_", " ", "?", " ", "OddQ"}], "[", "#", "]"}], ")"}], " ", 
    "&"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.982647810681408*^9, 3.9826478199883575`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"caf444c2-ff20-564a-8134-c1f84d4e4453"],

Cell["\<\
This is testing for something nonsensical like \[OpenCurlyDoubleQuote]test \
whether the slot symbol itself is odd\[CloseCurlyDoubleQuote].\
\>", "Text",
 CellChangeTimes->{{3.9826478460648346`*^9, 
  3.9826478698473225`*^9}},ExpressionUUID->"9937d18d-19e1-254e-91fe-\
9408046d5c2c"],

Cell["This can be checked by looking at the full form:", "Text",ExpressionUUID->"62c468af-a115-41c0-bfd0-70b5091939a6"],

Cell[BoxData[{
 RowBox[{"FullForm", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"_", "?", "OddQ"}], "[", "#", "]"}], "&"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullForm", "[", 
  RowBox[{"_", "?", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"OddQ", "[", "#", "]"}], "&"}], ")"}]}], "]"}]}], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"c33e5175-b4b9-4b1f-bcdc-2d0ca27c0f24"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"6d520923-f55e-4233-8f41-436bee075390"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"fb2e3442-242c-45c5-a2a3-adb561d96aab"],

Cell[CellGroupData[{

Cell["Arguments", "Section",ExpressionUUID->"1d8224ee-d034-44b1-83ce-5778330d45c9"],

Cell[CellGroupData[{

Cell["Implementing Arguments", "Subsection",
 CellTags->
  "Arguments-ImplementingArguments",ExpressionUUID->"40ac2e5b-bdbe-4174-9129-\
17f8f446f545"],

Cell["\<\
Generally, arguments should be descriptive and lowerCamelCase. To add \
arguments to a function, put them (comma-separated) inside the square \
brackets:\
\>", "Text",ExpressionUUID->"cded11ec-0bf2-44df-bd7f-ec18e62b83a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "takeLogarithm", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"takeLogarithm", "[", 
   StyleBox[
    RowBox[{"base_", ",", " ", "value_"}],
    Background->RGBColor[1, 0.9, 0.8]], "]"}], ":=", 
  RowBox[{"Log", "[", 
   RowBox[{"base", ",", "value"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9826480019924335`*^9, 3.982648047916584*^9}, {
  3.9826481063942738`*^9, 3.982648109857052*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"72ac0caf-c021-4178-b4d3-e4381918245e"],

Cell[BoxData[
 RowBox[{"takeLogarithm", "[", 
  RowBox[{"E", ",", 
   SuperscriptBox["E", "5"]}], "]"}]], "Input",
 CellChangeTimes->{{3.9826480581766243`*^9, 3.982648065714548*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"a91a2638-42d7-2047-85bd-15f5ad28c453"],

Cell[BoxData[
 RowBox[{"takeLogarithm", "[", 
  RowBox[{"10", ",", "1000"}], "]"}]], "Input",
 CellChangeTimes->{{3.9826480734058933`*^9, 3.982648077458929*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"b2e577e5-e40d-864e-b92b-c9f96d626c8b"],

Cell["\<\
Note that there are underscores after the arguments on the left-hand side, \
but not on the right.\
\>", "Text",ExpressionUUID->"16b1669e-c356-4f8e-9d98-f5cd19b93951"],

Cell["\<\
A function can have no arguments at all. Even in this case, it is good \
practice to use square brackets to indicate that it is a function and not a \
variable.\
\>", "Text",
 CellChangeTimes->{{3.9826481722707386`*^9, 
  3.9826481725400295`*^9}},ExpressionUUID->"8c6bd485-5c54-4de4-9db9-\
b599a7515ee0"],

Cell[BoxData[
 RowBox[{"ColorData", "[", "]"}]], "Input",
 CellChangeTimes->{{3.982648182946203*^9, 3.982648185279625*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"99ce6b08-58b4-e448-a112-8c05d5fe30f3"],

Cell[BoxData[
 RowBox[{"CurrentImage", "[", "]"}]], "Input",
 CellChangeTimes->{{3.982771812785055*^9, 
  3.982771817396778*^9}},ExpressionUUID->"6fa31fca-2cc3-a946-bfca-\
e3e605944173"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"09035dba-662f-4785-83c2-994159ad8f4d"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"cab0cab0-8343-483f-9cc7-2fbef6215d43"],

Cell[CellGroupData[{

Cell["Arguments", "Section",ExpressionUUID->"1445a9c6-2804-4155-b9ea-74e7a2d25742"],

Cell[CellGroupData[{

Cell[TextData[{
 "Restricting Arguments: ",
 StyleBox["Typical Approaches",
  FontColor->GrayLevel[0.5]]
}], "Subsection",
 CellTags->
  "Arguments-RestrictingArgumentsTypical",ExpressionUUID->"a4b3024b-d4b1-417a-\
954c-aa7b3bd9b464"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Patterns and Transformation Rules",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/tutorial/\
PatternsAndTransformationRules.html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/tutorial/\
PatternsAndTransformationRules.html"]
}], "Text",ExpressionUUID->"de3736e8-aaaa-4f3c-8f43-9b9bdb7238f3"],

Cell[TextData[{
 "Restricting the arguments a function can take can make it more robust. It \
can also help someone to understand what the function is doing. Argument \
restriction is done with ",
 StyleBox["pattern matching",
  FontSlant->"Italic"],
 ", and there are a few common ways to do this."
}], "Text",ExpressionUUID->"5391e98a-3734-415d-9c59-281d25dbc75c"],

Cell[CellGroupData[{

Cell["Head", "Subsubsection",ExpressionUUID->"28b5aa17-d6f4-45bd-95e8-f1e027bddf5f"],

Cell[TextData[{
 "The simplest way to restrict an argument is to match a ",
 ButtonBox["Head",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Head.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Head.html"],
 ":"
}], "Text",ExpressionUUID->"be8f6c90-f962-46e3-b4ae-0cdb9c81b449"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "toUpperCase", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"toUpperCase", "[", 
    StyleBox["string_String",
     Background->RGBColor[1, 0.9, 0.8]], "]"}], " ", ":=", " ", 
   RowBox[{"ToUpperCase", "[", "string", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"toUpperCase", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"toUpperCase", "[", "notText", "]"}]}], "Input",
 CellChangeTimes->{{3.982648381782831*^9, 3.982648382901844*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"bbc774b3-c580-43ad-874d-5d8c04c0aab9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Pattern Test", "Subsubsection",
 CellChangeTimes->{{3.982648393534464*^9, 
  3.982648396779003*^9}},ExpressionUUID->"1cfd7a6b-8296-49d6-a4df-\
06083650e707"],

Cell[TextData[{
 "An alternative to matching a head is to use a ",
 ButtonBox["PatternTest",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/PatternTest.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/PatternTest.html"],
 " (",
 StyleBox["?", "Input"],
 ") with a ",
 "predicate function",
 ":"
}], "Text",ExpressionUUID->"f4ab181b-be17-4c2f-874b-83565023029a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "redStyle", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"redStyle", "[", 
    StyleBox[
     RowBox[{"string_", "?", "StringQ"}],
     Background->RGBColor[1, 0.9, 0.8]], "]"}], " ", ":=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{"string", ",", " ", "Red"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"redStyle", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"redStyle", "[", "notText", "]"}]}], "Input",
 CellChangeTimes->{{3.9826484004079113`*^9, 3.982648403214737*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"36c19e71-0d50-4ed1-a704-3e5d67e47d91"],

Cell["More complicated tests may require a pure function:", "Text",ExpressionUUID->"7a09d344-5e62-402f-9be8-77264f5ea1d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "greenStyle", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"greenStyle", "[", 
    RowBox[{"string_", "?", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "#", "]"}], "&&", 
        RowBox[{"StringContainsQ", "[", 
         RowBox[{"#", ",", " ", "\"\<go\>\"", ",", " ", 
          RowBox[{"IgnoreCase", " ", "->", " ", "True"}]}], "]"}]}], "&"}], 
      ")"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{"string", ",", " ", "Green"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"greenStyle", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"greenStyle", "[", "\"\<textContainingGo\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"greenStyle", "[", "notText", "]"}]}], "Input",
 CellChangeTimes->{{3.982648416135252*^9, 3.9826484188303833`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"ae0cf2f6-3a37-4f48-bc64-7e83818490b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Pattern", "Subsubsection",ExpressionUUID->"e89ec442-2a5f-4c37-a532-0da4ae2343d4"],

Cell[TextData[{
 "A pattern can be assigned a label with ",
 ButtonBox["Pattern",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Pattern.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Pattern.html"],
 " (",
 StyleBox[":", "Input"],
 "):"
}], "Text",ExpressionUUID->"28aa00f9-7901-4015-9f37-a6f92bd287c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "blueStyle", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"blueStyle", "[", 
    StyleBox[
     RowBox[{"string", ":", "_String"}],
     Background->RGBColor[1, 0.9, 0.8]], "]"}], " ", ":=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{"string", ",", " ", "Blue"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"blueStyle", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"blueStyle", "[", "notText", "]"}]}], "Input",
 CellChangeTimes->{{3.982648432313423*^9, 3.9826484351661625`*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"c9b8116b-9943-4c4c-be9a-93d2fe0167cc"],

Cell["\<\
For simple patterns like this one, assigning a label is not really necessary. \
However, it can be very useful when patterns span multiple arguments (more on \
this later).\
\>", "Text",
 CellChangeTimes->{{3.9826484569158936`*^9, 
  3.982648456916889*^9}},ExpressionUUID->"d54a6f16-c570-4eb8-8c6c-\
962323f7cb3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Condition", "Subsubsection",ExpressionUUID->"7e360aec-e658-4ade-afa0-30bd18c86a9b"],

Cell[TextData[{
 "Another way to restrict an argument is to apply a ",
 ButtonBox["Condition",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Condition.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Condition.html"],
 " (",
 StyleBox["/;", "Input"],
 ") with a pattern test."
}], "Text",ExpressionUUID->"51e06d7d-0531-4037-b4e4-9aadea1d70ae"],

Cell["This can be done inside the square brackets:", "Text",ExpressionUUID->"1b7767d5-483c-4db9-8bed-0b5d10b3d908"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "fontStyle", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fontStyle", "[", 
    RowBox[{"str_", " ", 
     StyleBox["/;",
      Background->RGBColor[1, 0.9, 0.8]], 
     StyleBox[" ",
      Background->RGBColor[1, 0.9, 0.8]], 
