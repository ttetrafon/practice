Cell["\<\
Several BeginX functions work with EndX functions to localise symbols. \
Compared to all of the other functions seen so far, these are somewhat \
unusual in that they do not use square brackets to enclose the things that \
are being localised.\
\>", "Text",
 CellChangeTimes->{{3.870446812509783*^9, 
  3.8704468144642267`*^9}},ExpressionUUID->"9e428d4e-5946-7d4d-a9e0-\
a8eb836cdd35"],

Cell[TextData[{
 "Use ",
 ButtonBox["Begin",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Begin.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Begin.html"],
 " and ",
 ButtonBox["End",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/End.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/End.html"],
 " to create a function in the context ",
 StyleBox["MyContext`", "Input"],
 ":"
}], "Text",ExpressionUUID->"0f92117d-1a0a-f14c-b491-2661434a1ba7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "f", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Begin", "[", "\"\<MyContext`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", "x"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"End", "[", "]"}], ";"}]}], "Input",ExpressionUUID->"1e25d79b-6b8f-\
784f-88de-550c8fe09ab3"],

Cell[TextData[{
 StyleBox["f", "Input"],
 " does not have any information without the full context:"
}], "Text",
 CellChangeTimes->{{3.870446847641494*^9, 
  3.870446849636361*^9}},ExpressionUUID->"4a5b723a-8e3e-6f46-b86c-\
426620b0d7f0"],

Cell[BoxData[{
 RowBox[{"?", "f"}], "\n", 
 RowBox[{"?", "MyContext`f"}]}], "Input",ExpressionUUID->"2db38645-3df0-0c40-\
b393-e0c963e2509d"],

Cell[TextData[{
 "Use ",
 ButtonBox["BeginPackage",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/BeginPackage.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/BeginPackage.html"],
 " and ",
 ButtonBox["EndPackage",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/EndPackage.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/EndPackage.html"],
 " to start and end a Wolfram Language package. These (together with Begin \
and End) are particularly useful for creating programs or codebases where \
symbol names are likely to conflict with those in the global context, or \
where definitions may need to be kept hidden from users. However, a full \
explanation goes beyond the scope of this course."
}], "Text",ExpressionUUID->"7e6b83af-f14b-f341-a7ad-b3a5b9db9e12"],

