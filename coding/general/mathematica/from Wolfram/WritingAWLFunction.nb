 "Note that attributes generally apply to ",
 StyleBox["all",
  FontSlant->"Italic"],
 " arguments of a function (with some exceptions, like HoldFirst), so they \
should be considered carefully."
}], "Text",ExpressionUUID->"6ce475f1-4f6e-5f47-84f3-5b4fa7424470"],

Cell["\<\
Consider the following function, which multiplies a vector by a scale factor. \
If the second argument is a list (of scale factors), it maps over it:\
\>", "Text",ExpressionUUID->"ad7561cc-2d16-9b4f-b914-d27726eaa3a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleVector", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleVector", "[", 
    RowBox[{"vector_", ",", " ", 
     RowBox[{"scaleFactor_", "?", "NumberQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"scaleFactor", "*", "vector"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleVector", "[", 
     RowBox[{"vector_", ",", " ", "scaleFactors_List"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"scaleVector", "[", 
        RowBox[{"vector", ",", " ", "#"}], "]"}], " ", "&"}], ",", " ", 
      "scaleFactors"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleVector", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleVector", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "Input",ExpressionUUID->\
"c7006c23-d061-a645-b6b0-5405d1322752"],

Cell["\<\
Attempting to recreate the function using the Listable attribute makes for \
shorter code:\
\>", "Text",ExpressionUUID->"07290fc6-a3da-5f48-b642-8a6cdde6f728"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "scaleVector", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Attributes", "[", "scaleVector", "]"}], " ", "=", " ", 
   RowBox[{"{", "Listable", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleVector", "[", 
     RowBox[{"vector_", ",", " ", "scaleFactor_"}], "]"}], " ", ":=", " ", 
    RowBox[{"scaleFactor", "*", "vector"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleVector", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "2"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleVector", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"4f3e768d-cb7c-5548-9cd1-55da4e97be3a"],

Cell[TextData[{
 "However, the result is incorrect because the function now threads over ",
 StyleBox["both",
  FontSlant->"Italic"],
 " its arguments."
}], "Text",ExpressionUUID->"85b68cd6-9b52-c541-bf05-65cb24798956"],

