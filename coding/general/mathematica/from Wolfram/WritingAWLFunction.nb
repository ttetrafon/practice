Cell["Find the culprit in an unexpectedly long evaluation:", "Text",ExpressionUUID->"1739f207-3690-f240-b014-70edc7db45b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   StyleBox[
    RowBox[{"EchoTiming", "[", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          UnderoverscriptBox["\[Product]", 
           RowBox[{"k", "=", "0"}], "max"], 
          FractionBox[
           RowBox[{"Sin", "[", 
            FractionBox["x", 
             RowBox[{
              RowBox[{"2", " ", "k"}], "+", "1"}]], "]"}], 
           FractionBox["x", 
            RowBox[{
             RowBox[{"2", " ", "k"}], "+", "1"}]]]}], ")"}], 
        RowBox[{"\[DifferentialD]", "x"}]}]}], ",", " ", 
      RowBox[{"\"\<k = \>\"", "<>", 
       RowBox[{"ToString", "[", "max", "]"}]}]}], "]"}],
    Background->RGBColor[1, 0.9, 0.8]], ",", 
   RowBox[{"{", 
    RowBox[{"max", ",", "6"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[142]:=",ExpressionUUID->"a7c5b552-1021-1147-b573-81619862abf0"],

