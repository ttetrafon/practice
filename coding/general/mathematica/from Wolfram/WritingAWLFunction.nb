Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"05ad3ff2-5527-4434-b436-6ac510103fe7"],

Cell[CellGroupData[{

Cell["Extending Capability", "Section",ExpressionUUID->"00b4c2e3-52d5-4c54-81e9-aa7d5d8d5310"],

Cell[CellGroupData[{

Cell["Recursion and Iteration", "Subsection",
 CellTags->
  "ExtendingCapability-RecursionAndIteration",ExpressionUUID->"0063e15e-c49c-\
43fa-8c7e-8a9ec8dea5bd"],

Cell[TextData[{
 StyleBox["Recursive",
  FontSlant->"Italic"],
 " and ",
 StyleBox["iterative",
  FontSlant->"Italic"],
 " functions (often known as \[OpenCurlyDoubleQuote]self-referential\
\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]looping\
\[CloseCurlyDoubleQuote] functions, respectively) are useful for tasks that \
can be broken down into smaller subtasks. (Click ",
 ButtonBox["here",
  BaseStyle->"Hyperlink",
  ButtonData->"SelfReference2"],
 " for an example of self-reference.)"
}], "Text",
 CellChangeTimes->{{3.870437510795248*^9, 3.870437544572624*^9}},
 CellTags->
  "SelfReference1",ExpressionUUID->"1fbcee26-54a0-4e10-9331-724efbe438a5"],

Cell[CellGroupData[{

Cell["Recursion", "Subsubsection",ExpressionUUID->"2b40650a-2c1b-4696-8e46-ef0bd1a4aa89"],

Cell[TextData[{
 "Recursive function definitions often use overloading. A classic example of \
recursion is computing the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[Null]n",
     FontSlant->"Italic"], "th"], TraditionalForm]],ExpressionUUID->
  "33d5bcb1-8d64-1242-b95b-a759fbbce408"],
 " ",
 ButtonBox["Fibonacci number",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Fibonacci_number"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Fibonacci_number"],
 ":"
}], "Text",
 CellChangeTimes->{{3.870437554142356*^9, 
  3.8704375655111322`*^9}},ExpressionUUID->"0af067df-ffc3-4e4e-8ef4-\
915d78cc1c42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "fibonacci", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "1", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "2", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "n_Integer", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"fibonacci", "[", 
     RowBox[{"n", "-", "1"}], "]"}], "+", 
    RowBox[{"fibonacci", "[", 
     RowBox[{"n", "-", "2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fibonacci", "[", "10", "]"}]}], "Input",
 CellChangeTimes->{{3.982670976228443*^9, 3.9826709775379066`*^9}},
 CellLabel->
  "In[188]:=",ExpressionUUID->"61c9e03b-30c7-4723-b073-c2f555190966"],

Cell["\<\
Create a function to get the names and sizes of all files within a directory, \
regardless of its structure:\
\>", "Text",ExpressionUUID->"3ae19e00-7578-4562-a928-9b9e892eb15b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "getFiles", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getFiles", "[", "filesOrDirectories_List", "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{"getFiles", ",", " ", "filesOrDirectories"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getFiles", "[", 
    RowBox[{"directory_", "?", "DirectoryQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"getFiles", "[", 
    RowBox[{"FileNames", "[", 
     RowBox[{"All", ",", " ", "directory"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getFiles", "[", "file___", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"FileNameTake", "[", "file", "]"}], " ", "->", " ", 
    RowBox[{"FileSize", "[", "file", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9826709822501316`*^9},
 CellLabel->
  "In[193]:=",ExpressionUUID->"4d111d12-e3ac-4c0c-9e3e-eb3bff0616a7"],

Cell["Apply the function to an example directory:", "Text",ExpressionUUID->"af6698ab-9a7d-4274-b15e-f97757fd0af1"],

Cell[BoxData[
 RowBox[{"getFiles", "[", 
  RowBox[{"ParentDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", 
    RowBox[{"InputNotebook", "[", "]"}], "]"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9826710466042747`*^9, 3.98267106698855*^9}},
 CellLabel->
  "In[206]:=",ExpressionUUID->"f64c3f3b-6da5-4f90-a6d1-5fbb3c7b689b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Alternative Solution",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870784041327219*^9, 3.870784042255279*^9}, {
  3.982671007966099*^9, 3.982671008390909*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"9dcb0a44-c4b6-43bb-a966-92b174dcbda3"],

Cell[TextData[{
 "For this particular example, ",
 ButtonBox["FileSystemMap",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FileSystemMap.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FileSystemMap.html"],
 " does a similar job:"
}], "Text",ExpressionUUID->"c2bee364-1297-444a-a841-9e579485dd3d"],

Cell[BoxData[
 RowBox[{"FileSystemMap", "[", 
  RowBox[{"FileSize", ",", " ", "exampleDirectory", ",", " ", "Infinity"}], 
  "]"}]], "Input",ExpressionUUID->"fc86e536-cd0b-4175-9227-0074829f6a31"]
}, Closed]],

