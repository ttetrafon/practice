Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"d9ef752f-57b7-410f-8115-f986810361bc"],

Cell[CellGroupData[{

Cell["Extending Capability", "Section",ExpressionUUID->"8039aa57-fe3e-4c9b-9a59-c6c10bdb7f5d"],

Cell[CellGroupData[{

Cell["UpValues", "Subsection",
 CellChangeTimes->{{3.982671668038414*^9, 3.982671668367029*^9}},
 CellTags->
  "ExtendingCapability-Upvalues",ExpressionUUID->"0e30e0ed-81b0-464f-8341-\
b56bfeb33445"],

Cell[TextData[{
 "Tutorial: ",
 ButtonBox["Associating Definitions with Different Symbols",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
TransformationRulesAndDefinitions.html#6972"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
TransformationRulesAndDefinitions.html#6972"]
}], "Text",ExpressionUUID->"9a770ce7-a97b-4bda-8b69-7dd14409495e"],

Cell[TextData[{
 "When a function is defined in the standard way, its definition is stored as \
a ",
 StyleBox["downvalue",
  FontSlant->"Italic"],
 ":"
}], "Text",ExpressionUUID->"fa90e43b-c88f-4201-97d6-51cb6c201b68"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", "x"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"DownValues", "[", "f", "]"}]}], "Input",ExpressionUUID->"b619a659-\
f327-410d-af5c-00e01d485d93"],

Cell[TextData[{
 "Sometimes it can be useful\.08 for a function to behave differently when it \
is used in a particular context. ",
 ButtonBox["TagSetDelayed",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/TagSetDelayed.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/TagSetDelayed.html"],
 " (",
 StyleBox["/:", "Input"],
 ") can set up special definitions for a function when it is being used \
inside an expression. These definitions are then stored as ",
 StyleBox["upvalues",
  FontSlant->"Italic"],
 ":"
}], "Text",ExpressionUUID->"884c98fc-8f90-4366-a43e-a567561e1ff4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "/:", 
    RowBox[{"expr", "[", 
     RowBox[{"f", "[", "x_", "]"}], "]"}], " ", ":=", " ", "x"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"UpValues", "[", "f", "]"}]}], "Input",ExpressionUUID->"540a1494-\
97d3-4472-b977-7010a7a5451a"],

Cell[TextData[{
 "Note that ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "204aef99-8e83-ac44-ad12-0c07af79b00e"],
 " can only appear one level deep in the expression, or it will not be \
\[OpenCurlyDoubleQuote]found\[CloseCurlyDoubleQuote] by ",
 ButtonBox["TagSetDelayed",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/TagSetDelayed.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/TagSetDelayed.html"],
 "."
}], "Text",
 CellChangeTimes->{{3.870437980392847*^9, 3.8704379813415127`*^9}, {
  3.982671729476242*^9, 
  3.9826717311456833`*^9}},ExpressionUUID->"b6894ebb-0e52-4709-bebd-\
dea9b88defab"],

Cell[CellGroupData[{

Cell["Standard Usage", "Subsubsection",
 CellChangeTimes->{{3.9826716319079113`*^9, 
  3.982671632230257*^9}},ExpressionUUID->"4ba8db7e-b1c2-4465-8977-\
957eb1fcd9a3"],

Cell[CellGroupData[{

Cell["Rule Systems", "Subsubsubsection",
 CellChangeTimes->{{3.982671672453701*^9, 
  3.9826716728457527`*^9}},ExpressionUUID->"74c065df-a59c-4cb4-947c-\
61af5adbad68"],

Cell["\<\
A good use of upvalues is for creating a \[OpenCurlyDoubleQuote]rule system\
\[CloseCurlyDoubleQuote] for a particular type of object.\
\>", "Text",ExpressionUUID->"6ddee99f-1491-4c69-8dbc-28d652c42841"],

Cell["\<\
Define your own version of logarithmic addition for positive numbers:\
\>", "Text",ExpressionUUID->"3e605bae-54c5-4bcb-bfa1-13e39c059fc3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "log", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"log", " ", "/:", " ", 
    RowBox[{
     RowBox[{"log", "[", "a_", "]"}], " ", "+", " ", 
     RowBox[{"log", "[", "b_", "]"}]}], " ", ":=", " ", 
    RowBox[{"log", "[", 
     RowBox[{"a", "*", "b"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"log", "[", "3", "]"}], "+", 
  RowBox[{"log", "[", "4", "]"}]}]}], "Input",ExpressionUUID->"2a117ca2-50c2-\
4e79-8e83-261b60923b4a"],

Cell[TextData[{
 "Note that ",
 StyleBox["log[a*b]", "Input"],
 " does not evaluate any further because ",
 StyleBox["log", "Input"],
 " does not have any downvalues. If it did, they would disrupt the \
TagSetDelayed definition."
}], "Text",
 CellChangeTimes->{{3.8704379968041773`*^9, 
  3.870438003594096*^9}},ExpressionUUID->"2cba063b-e2f7-4bfa-8e45-\
5262e31023cb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Databases", "Subsubsubsection",ExpressionUUID->"e64544b3-3be6-4f16-8612-a63e8782e65e"],

Cell["\<\
Another common use of upvalues is in setting up a \
\[OpenCurlyDoubleQuote]database\[CloseCurlyDoubleQuote] of properties for an \
object.\
\>", "Text",ExpressionUUID->"04122704-644b-4e38-9a3f-b4022ac6b25b"],

Cell[TextData[{
 "Many built-in objects work with ",
 ButtonBox["Information",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Information.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Information.html"],
 ", for example:"
}], "Text",ExpressionUUID->"c234e803-47d2-4900-86c3-d9a7df7f3cc1"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"InputNotebook", "[", "]"}], "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"3e2b4c5c-897e-4977-b862-5fa44dbe9cd3"],

Cell["(Information will be covered in more detail later.)", "Text",ExpressionUUID->"fdb85c3a-1aa0-4ad4-b0de-3fed01478175"],

Cell["\<\
Create an arithmetic object from which various properties can be extracted:\
\>", "Text",ExpressionUUID->"121bdc64-14ff-4587-ba0f-c80ab431c732"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "arithmeticObject", ",", " ", "summary", ",", " ", "sum", ",", " ", 
     "product"}], "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"arithmeticObject", " ", "/:", " ", 
   RowBox[{"summary", "[", 
    RowBox[{"arithmeticObject", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "]"}], " ", ":=", " ", 
   RowBox[{"Dataset", "[", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Var1\>\"", " ", "->", " ", "x"}], ",", " ", 
      RowBox[{"\"\<Var2\>\"", " ", "->", " ", "y"}], ",", " ", 
      RowBox[{"\"\<Sum\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{"x", "+", "y"}], ")"}]}], ",", " ", 
      RowBox[{"\"\<Product\>\"", " ", "->", " ", 
       RowBox[{"(", 
        RowBox[{"x", " ", "*", " ", "y"}], ")"}]}]}], "|>"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"arithmeticObject", " ", "/:", " ", 
   RowBox[{"sum", "[", 
    RowBox[{"arithmeticObject", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "]"}], ":=", 
   RowBox[{"x", " ", "+", " ", "y"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arithmeticObject", " ", "/:", " ", 
    RowBox[{"product", "[", 
     RowBox[{"arithmeticObject", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], "]"}], ":=", 
    RowBox[{"x", " ", "*", " ", "y"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"summary", "[", 
  RowBox[{"arithmeticObject", "[", 
   RowBox[{"3", ",", "4"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"sum", "[", 
  RowBox[{"arithmeticObject", "[", 
   RowBox[{"3", ",", " ", "4"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"product", "[", 
  RowBox[{"arithmeticObject", "[", 
   RowBox[{"3", ",", " ", "4"}], "]"}], "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"43fddbea-1fa0-4527-81c3-f7c6388e1b1b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["A Box Trick",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.8707841145202723`*^9, 3.870784115376292*^9}, {
  3.982671652092493*^9, 3.98267165439954*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"242387e2-8a52-4b22-a9d5-42f36ece0de6"],

Cell[TextData[{
 "Like the log function before it, ",
 StyleBox["arithmeticObject", "Input"],
 " cannot have any downvalues without disrupting the upvalues:"
}], "Text",ExpressionUUID->"b807692d-c46d-4c16-a71d-a5708073bd4f"],

Cell[BoxData[{
 RowBox[{"arithmeticObject", "//", "DownValues"}], "\[IndentingNewLine]", 
 RowBox[{"arithmeticObject", "[", 
  RowBox[{"3", ",", "4"}], "]"}]}], "Input",ExpressionUUID->"1a49a660-e682-\
4920-bd0f-87359c5b4a8a"],

Cell[TextData[{
 "However, by using ",
 ButtonBox["MakeBoxes",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/MakeBoxes.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/MakeBoxes.html"],
 " and ",
 ButtonBox["ToBoxes",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ToBoxes.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ToBoxes.html"],
 ", you can get around this limitation."
}], "Text",ExpressionUUID->"45f77b08-b8ae-4882-b902-bc0adb01ea83"],

Cell["\<\
Create a function that calculates some basic statistics from a list, using \
both upvalues and subvalues:\
\>", "Text",
 CellChangeTimes->{
  3.870438039941515*^9},ExpressionUUID->"6d1dcef1-a526-4901-85c1-\
bb68dc1ea97b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "dataAnalyse", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{"dataAnalyse", "/:", 
     RowBox[{"MakeBoxes", "[", 
      RowBox[{
       RowBox[{"dataAnalyse", "[", "data_", "]"}], ",", "form_"}], "]"}], ":=", 
     RowBox[{"ToBoxes", "[", 
      RowBox[{
       RowBox[{"Iconize", "[", 
        RowBox[{
         RowBox[{"dataAnalyse", "[", "data", "]"}], ",", 
         " ", "\"\<Data\>\""}], "]"}], ",", "form"}], "]"}]}], ";"}],
   Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dataAnalyse", "/:", 
    RowBox[{"Information", "[", 
     RowBox[{"dataAnalyse", "[", 
      RowBox[{"data", " ", ":", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"_", "?", "NumericQ"}], ".."}], "}"}]}], "]"}], "]"}], ":=", 
    RowBox[{"Dataset", "[", "\[IndentingNewLine]", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<Mean\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"dataAnalyse", "[", "data", "]"}], "[", "\"\<Mean\>\"", 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Length\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"dataAnalyse", "[", "data", "]"}], "[", "\"\<Length\>\"", 
         "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Properties\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Properties\>\"", ",", " ", "\"\<Mean\>\"", ",", 
          " ", "\"\<Length\>\""}], "}"}]}]}], "\[IndentingNewLine]", "|>"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dataAnalyse", "[", 
     RowBox[{"data", " ", ":", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"_", "?", "NumericQ"}], ".."}], "}"}]}], "]"}], 
    "[", "\"\<Mean\>\"", "]"}], ":=", 
   RowBox[{"Mean", "[", "data", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dataAnalyse", "[", "data_List", "]"}], "[", "\"\<Length\>\"", 
    "]"}], ":=", 
   RowBox[{"Length", "[", "data", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dataAnalyse", "[", "data_", "]"}], "[", "\"\<Properties\>\"", 
    "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\"\<Mean\>\"", ",", " ", "\"\<Length\>\""}], "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"170f5fa4-4cdb-4f9d-9649-7b461f87ad68"],

Cell["The upvalues and subvalues perform as expected:", "Text",
 CellChangeTimes->{
  3.870438044973822*^9},ExpressionUUID->"5c4c30be-4081-4656-aa45-\
6548fd64dcc5"],

Cell[BoxData[
 RowBox[{"Information", "[", 
  RowBox[{"dataAnalyse", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"a0b3edd3-dd1d-4225-adba-143218935b6d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataAnalyse", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], 
  "[", "\"\<Mean\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dataAnalyse", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}], 
  "[", "\"\<Length\>\"", "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"2a68693f-fb31-4df4-b4d1-0911d6a856dd"],

Cell["And the main definition works too:", "Text",ExpressionUUID->"fd9ebb2e-4e90-43f2-9a8d-4c2f22707b9f"],

Cell[BoxData[
 RowBox[{"dataAnalyse", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}], "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"392cbd77-16f5-4377-8208-ec50cccb45b2"],

Cell[TextData[{
 "In fact, the iconised form is treated as if it were ",
 StyleBox["dataAnalyse", "Input"],
 " itself:"
}], "Text",
 CellChangeTimes->{{3.8704380527653*^9, 
  3.8704380532354383`*^9}},ExpressionUUID->"cdc3c75e-8aea-431b-a0d5-\
0775e709609c"],

Cell[BoxData[
 RowBox[{
  InterpretationBox[
   DynamicModuleBox[{Typeset`open = False}, 
    TemplateBox[{"Expression", 
      StyleBox["\"Data\"", "IconizedCustomName", StripOnInput -> False], 
      GridBox[{{
         RowBox[{
           TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
           TagBox["dataAnalyse", "IconizedItem"]}]}, {
         RowBox[{
           TagBox["\"Byte count: \"", "IconizedLabel"], "\[InvisibleSpace]", 
           TagBox["160", "IconizedItem"]}]}}, 
       GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
       "Column", 
       GridBoxItemSize -> {
        "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
      Dynamic[Typeset`open]},
     "IconizedObject"]],
   $CellContext`dataAnalyse[{1, 2, 3}],
   SelectWithContents->True,
   Selectable->False], "[", "\"\<Mean\>\"", "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"f6cf5a20-1de9-4e2a-bb73-cfef79a20bcd"]
}, Closed]],

