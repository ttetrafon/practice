Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"0bc55092-64f1-e945-a3f7-b77e38f2f6c3"],

Cell[CellGroupData[{

Cell["Options", "Section",
 CellTags->"Options",ExpressionUUID->"e9f56f93-5882-d14c-a5be-8152c3855189"],

Cell[CellGroupData[{

Cell["Duplicated Options", "Subsection",
 CellTags->
  "Options-DuplicatedOptions",ExpressionUUID->"c24b75ce-e139-4a45-8200-\
e1e264060930"],

Cell["\<\
In the case of duplicated options, only the first option value will be used.\
\>", "Text",ExpressionUUID->"90295124-13e1-6c4a-9d0c-189b573a9124"],

Cell[TextData[{
 "Consider this definition of ",
 StyleBox["styleText", "Input"],
 " from earlier, where the implicit options (",
 StyleBox["options", "Input"],
 ") are listed before the explicit options (",
 StyleBox["Options[styleText]", "Input"],
 "):"
}], "Text",ExpressionUUID->"6d42bf06-9467-da47-8e38-a4783928e2c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"text_", ",", " ", 
     RowBox[{"options", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"text", ",", " ", 
     StyleBox["options",
      Background->RGBColor[1, 0.9, 0.8]], ",", " ", 
     RowBox[{"Sequence", "@@", 
      StyleBox[
       RowBox[{"Options", "[", "styleText", "]"}],
       Background->RGBColor[1, 0.9, 0.8]]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9826691649580097`*^9, 3.9826691656266384`*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"7e034a8d-ece4-db40-8773-5e11d294c6cc"],

Cell["\<\
In this case, the function works as intended; adding new options changes the \
output:\
\>", "Text",ExpressionUUID->"aa1eaa9c-13ce-7c41-8cc5-66164e6b73b7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Blue"}], ",", " ", 
   RowBox[{"FontWeight", " ", "->", " ", "Plain"}]}], "]"}]}], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"abd36f1b-80b0-9e46-bbd6-bbbae32e62f9"],

Cell[BoxData[
 StyleBox["\<\"text\"\>",
  StripOnInput->False,
  FontWeight->Bold,
  FontColor->RGBColor[1, 0, 0]]], "Output",
 CellChangeTimes->{3.9826691675939064`*^9},
 CellLabel->"Out[87]=",ExpressionUUID->"d0ad879a-4eb0-8e4f-a24c-65568c976ff5"],

Cell[BoxData[
 StyleBox["\<\"text\"\>",
  StripOnInput->False,
  FontWeight->Plain,
  FontColor->RGBColor[0, 0, 1]]], "Output",
 CellChangeTimes->{3.982669167792082*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"10278f16-c68c-934c-925b-c8c93869ae27"]
}, Open  ]],

Cell["\<\
However, if the order of the options is reversed, the explicit options take \
precedence instead:\
\>", "Text",ExpressionUUID->"e7681cf8-bf3c-5349-9264-3905d3d43635"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"text_", ",", " ", 
     RowBox[{"options", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Style", "[", 
    RowBox[{"text", ",", " ", 
     RowBox[{"Sequence", "@@", 
      StyleBox[
       RowBox[{"Options", "[", "styleText", "]"}],
       Background->RGBColor[1, 0.9, 0.8]]}], ",", " ", 
     StyleBox["options",
      Background->RGBColor[1, 0.9, 0.8]]}], "]"}]}], ";"}], "\n", 
 RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Blue"}], ",", " ", 
   RowBox[{"FontWeight", " ", "->", " ", "Plain"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826691726864967`*^9, 3.9826691769531116`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"ff0e80c5-7267-f24f-960c-45b2e200d9a3"],

Cell[BoxData[
 StyleBox["\<\"text\"\>",
  StripOnInput->False,
  FontWeight->Bold,
  FontColor->RGBColor[1, 0, 0]]], "Output",
 CellChangeTimes->{3.982669177556242*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"fd681e80-a731-184f-b372-751dbf2185dc"],

Cell[BoxData[
 StyleBox["\<\"text\"\>",
  StripOnInput->False,
  FontWeight->Bold,
  FontColor->RGBColor[1, 0, 0]]], "Output",
 CellChangeTimes->{3.9826691777642555`*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"ec344585-4f23-9a4b-8b9c-49216ce2a467"]
}, Open  ]],

Cell["\<\
To be absolutely sure which option values are being used in a function, it is \
good practice to remove any duplicates:\
\>", "Text",ExpressionUUID->"843325d9-bfda-464f-a9ed-267fc252f952"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "styleText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "styleText", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FontColor", " ", "->", " ", "Red"}], ",", " ", 
     RowBox[{"FontWeight", " ", "->", " ", "Bold"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"styleText", "[", 
    RowBox[{"text_", ",", " ", 
     RowBox[{"options", ":", " ", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Style", "[", "\[IndentingNewLine]", 
    RowBox[{"text", ",", " ", "\[IndentingNewLine]", 
     RowBox[{"Sequence", "@@", 
      StyleBox[
       RowBox[{"DeleteDuplicatesBy", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "options", "}"}], ",", " ", 
           RowBox[{"Options", "[", "styleText", "]"}]}], "]"}], ",", " ", 
         "First"}], "]"}],
       Background->RGBColor[1, 0.9, 0.8]]}]}], 
    StyleBox["\[IndentingNewLine]",
     Background->RGBColor[1, 0.9, 0.8]], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982669183325556*^9, 3.9826692012206726`*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"e2a12f69-a96d-6d42-b292-22851da85f17"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"styleText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"styleText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FontColor", " ", "->", " ", "Blue"}], ",", " ", 
   RowBox[{"FontWeight", " ", "->", " ", "Plain"}]}], "]"}]}], "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"47715550-e1f3-8844-b191-0773b3466060"],

Cell[BoxData[
 StyleBox["\<\"text\"\>",
  StripOnInput->False,
  FontWeight->Bold,
  FontColor->RGBColor[1, 0, 0]]], "Output",
 CellChangeTimes->{3.9826692107311287`*^9},
 CellLabel->"Out[97]=",ExpressionUUID->"877f9d73-6e84-2343-98b5-3f9f5653db25"],

Cell[BoxData[
 StyleBox["\<\"text\"\>",
  StripOnInput->False,
  FontWeight->Plain,
  FontColor->RGBColor[0, 0, 1]]], "Output",
 CellChangeTimes->{3.9826692109363556`*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"ef5f88d7-480c-9849-a20d-7fd1907598a3"]
}, Open  ]],

