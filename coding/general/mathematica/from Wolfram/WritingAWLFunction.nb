 "(This particular IDE shown above is ",
 ButtonBox["IntelliJ IDEA",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.jetbrains.com/idea/"], None},
  ButtonNote->"https://www.jetbrains.com/idea/"],
 ", for which there is a Wolfram Language plugin available. Debugging was \
covered earlier.)"
}], "Text",ExpressionUUID->"778ce3db-40c4-fa4a-afd8-e81b25e6ac26"],

