Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"ebce6e26-0e4b-456b-ad17-33d62823582a"],

Cell[CellGroupData[{

Cell["Arguments", "Section",ExpressionUUID->"22303f75-8b96-425d-b159-e88f8399648e"],

Cell[CellGroupData[{

Cell["Optional Arguments and Default Values", "Subsection",
 CellTags->
  "Arguments-OptionalAndDefault",ExpressionUUID->"de146a88-fa4d-4dbf-9c4e-\
d18f8c17ed1a"],

Cell[TextData[{
 "Having to insert all the arguments of a function every time it is used can \
be inconvenient. One solution is to make the arguments ",
 StyleBox["optional",
  FontSlant->"Italic"],
 ", replacing them with default values when the arguments are omitted."
}], "Text",ExpressionUUID->"bb3022a0-90f0-4b24-9832-27b2145686dd"],

Cell[CellGroupData[{

Cell["Optional", "Subsubsection",ExpressionUUID->"ec270100-cdb7-427b-b20b-af945f0d0d03"],

Cell[TextData[{
 "Use ",
 ButtonBox["Optional",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Optional.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Optional.html"],
 " (",
 StyleBox[":", "Input"],
 ") to make an argument optional and give it a default value:"
}], "Text",ExpressionUUID->"0ee9c2f8-9362-4381-a233-701ebf0cb4db"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "borderingCountries", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"borderingCountries", "[", 
   RowBox[{"country_Entity", ",", 
    RowBox[{"n_", ":", "2"}]}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"NestGraph", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<BorderingCountries\>\"", "]"}], " ", "&"}], ",", 
    "\[IndentingNewLine]", "country", ",", "\[IndentingNewLine]", "n", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.982775807749731*^9, 3.982775824356615*^9}, {
   3.9827758586944866`*^9, 3.982775885463356*^9}, 3.982775919744013*^9, {
   3.982775952133629*^9, 3.982775961061884*^9}, {3.982776171118408*^9, 
   3.982776176084503*^9}, {3.982776391262396*^9, 3.982776443291401*^9}},
 CellLabel->
  "In[216]:=",ExpressionUUID->"c4e9a064-9b97-a942-958c-169c75c41b51"],

Cell[BoxData[
 RowBox[{"borderingCountries", "[", 
  TemplateBox[{"\"Switzerland\"", 
    RowBox[{"Entity", "[", 
      RowBox[{"\"Country\"", ",", "\"Switzerland\""}], "]"}], 
    "\"Entity[\\\"Country\\\", \\\"Switzerland\\\"]\"", "\"country\""},
   "Entity"], "]"}]], "Input",
 CellChangeTimes->{{3.982776455440548*^9, 3.9827764582466297`*^9}},
 CellLabel->
  "In[219]:=",ExpressionUUID->"58aa272f-29e2-8147-9a10-5424d567fc32"],

Cell[BoxData[
 RowBox[{"borderingCountries", "[", 
  RowBox[{
   TemplateBox[{"\"Switzerland\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Country\"", ",", "\"Switzerland\""}], "]"}], 
     "\"Entity[\\\"Country\\\", \\\"Switzerland\\\"]\"", "\"country\""},
    "Entity"], ",", "1"}], "]"}]], "Input",
 CellChangeTimes->{{3.982776455440548*^9, 3.9827764672419662`*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"701eb9ce-73b7-7240-83de-1fb964fcfa3b"],

Cell[TextData[{
 "As you may have noticed, the short form of ",
 ButtonBox["Optional",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Optional.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Optional.html"],
 " is the same as that for ",
 ButtonBox["Pattern",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Pattern.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Pattern.html"],
 " (a colon). However, it will usually be clear which is which from the \
context."
}], "Text",
 CellChangeTimes->{{3.9826496844426193`*^9, 
  3.98264969022534*^9}},ExpressionUUID->"fe724f6b-2b88-42bc-b6c6-\
56b18a69453c"],

Cell[TextData[{
 "When using ",
 ButtonBox["Pattern",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Pattern.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Pattern.html"],
 " and ",
 ButtonBox["Optional",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Optional.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Optional.html"],
 " together, the pattern must go first:"
}], "Text",
 CellChangeTimes->{{3.9826496981455593`*^9, 
  3.9826497144573727`*^9}},ExpressionUUID->"690c849d-66d9-4f26-bacc-\
947b386d5c96"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "borderingCountries", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"borderingCountries", "[", 
   RowBox[{"country_Entity", ",", 
    RowBox[{"n", ":", "_Integer", ":", "2"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"NestGraph", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<BorderingCountries\>\"", "]"}], " ", "&"}], ",", 
    "\[IndentingNewLine]", "country", ",", "\[IndentingNewLine]", "n", ",", 
    "\[IndentingNewLine]", 
    RowBox[{"VertexLabels", " ", "->", " ", "Automatic"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9827765454389896`*^9, 3.9827765483433895`*^9}},
 CellLabel->
  "In[221]:=",ExpressionUUID->"477162f6-faa1-9549-b634-fe400acf1b30"],

Cell[BoxData[
 RowBox[{"borderingCountries", "[", 
  RowBox[{
   TemplateBox[{"\"Switzerland\"", 
     RowBox[{"Entity", "[", 
       RowBox[{"\"Country\"", ",", "\"Switzerland\""}], "]"}], 
     "\"Entity[\\\"Country\\\", \\\"Switzerland\\\"]\"", "\"country\""},
    "Entity"], ",", "1.3"}], "]"}]], "Input",
 CellChangeTimes->{{3.9827765574679127`*^9, 3.9827765729290676`*^9}},
 CellLabel->
  "In[224]:=",ExpressionUUID->"193c9c46-5584-7e4f-8059-1830833f5455"],

Cell[TextData[{
 "The syntax ",
 StyleBox["arg_?test:value", "Input"],
 " is not permitted. If you want to apply a pattern test and have a default \
value, you must use ",
 ButtonBox["Pattern",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Pattern.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Pattern.html"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9826497593289623`*^9, 
  3.982649760737747*^9}},ExpressionUUID->"2e7dc2fe-6360-4616-8c26-\
d2d9fedc6a61"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"badSyntax", ",", " ", "goodSyntax"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"badSyntax", "[", 
    RowBox[{"arg_", "?", 
     RowBox[{"IntegerQ", " ", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
   "arg"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goodSyntax", "[", 
    RowBox[{"arg", ":", 
     RowBox[{"_", "?", "IntegerQ"}], " ", ":", " ", "1"}], "]"}], " ", ":=", 
   " ", "arg"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"badSyntax", "[", "3", "]"}], "\[IndentingNewLine]", 
 RowBox[{"goodSyntax", "[", "3", "]"}]}], "Input",
 CellChangeTimes->{3.982649763506811*^9, 3.9826497961860733`*^9},
 CellLabel->
  "In[226]:=",ExpressionUUID->"b74a6cbb-d3db-45b2-ae47-d6f040066869"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Default",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"da46ceca-87cb-4267-b631-2b2372c516e1"],

Cell[TextData[{
 "One alternative to Optional is ",
 ButtonBox["Default",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Default.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Default.html"],
 ". While Optional indicates the optional property of an argument and its \
default value at the same time, Default separates these steps. Arguments that \
are optional are indicated inside the function with an underscore followed by \
a full stop (",
 StyleBox["_.", "Input"],
 "), and the corresponding default values are defined in a separate list."
}], "Text",
 CellChangeTimes->{
  3.870435929183165*^9},ExpressionUUID->"cdfb2720-bcb4-4d8c-ba63-\
d1c042300bb7"],

Cell["Give the second argument of a function a default value:", "Text",ExpressionUUID->"b50e641f-accc-4e26-8709-d5414d0904dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "anyStyle", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Default", "[", 
    RowBox[{"anyStyle", ",", " ", 
     StyleBox["2",
      Background->RGBColor[1, 0.9, 0.8]]}], "]"}], " ", "=", " ", "Bold"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"anyStyle", "[", 
    RowBox[{"text_String", ",", " ", 
     StyleBox["style_.",
      Background->RGBColor[1, 0.9, 0.8]]}], "]"}], " ", ":=", " ", 
   RowBox[{"Style", "[", 
    RowBox[{"text", ",", " ", "style"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"anyStyle", "[", "\"\<Some text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"anyStyle", "[", 
  RowBox[{"\"\<Some text\>\"", ",", " ", "Italic"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826498133091908`*^9, 3.98264981721278*^9}},
 CellLabel->
  "In[229]:=",ExpressionUUID->"2d36c126-daec-46a1-bebd-1873b0d9e768"],

Cell[BoxData[
 StyleBox["\<\"Some text\"\>",
  StripOnInput->False,
  FontWeight->Bold]], "Output",
 CellChangeTimes->{3.982649821008545*^9},
 CellLabel->
  "Out[232]=",ExpressionUUID->"9856f352-bb56-e645-bc05-c60879c4dcdc"],

Cell[BoxData[
 StyleBox["\<\"Some text\"\>",
  StripOnInput->False,
  FontSlant->Italic]], "Output",
 CellChangeTimes->{3.982649821603115*^9},
 CellLabel->
  "Out[233]=",ExpressionUUID->"fe9257b9-d821-ba40-8081-d03ccc736514"]
}, Open  ]],

Cell["Give all arguments the same default value:", "Text",ExpressionUUID->"815fc4fb-3b9e-43f0-a609-2d82f29da2cb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "listZero", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Default", "[", "listZero", "]"}], " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"listZero", "[", 
    RowBox[{"x_.", ",", " ", "y_."}], "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"listZero", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"listZero", "[", "a", "]"}], "\[IndentingNewLine]", 
 RowBox[{"listZero", "[", 
  RowBox[{"a", ",", " ", "b"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826502346189137`*^9, 3.982650237378845*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"4e3caca7-2b94-464c-adaf-3beb34bcf78a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.9826502377546425`*^9},
 CellLabel->
  "Out[237]=",ExpressionUUID->"1098331c-5d70-dd42-ba7f-ca5a8b0bde84"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"a", ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{3.982650238349964*^9},
 CellLabel->
  "Out[238]=",ExpressionUUID->"729bfde0-4b2d-b04a-9c5c-cb023c494994"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"a", ",", "b"}], "}"}]], "Output",
 CellChangeTimes->{3.9826502389481907`*^9},
 CellLabel->
  "Out[239]=",ExpressionUUID->"731955c3-d745-0445-ab6a-78b37ea25844"]
}, Open  ]],

Cell[TextData[{
 "Give the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[Null]n",
     FontSlant->"Italic"], "th"], TraditionalForm]],ExpressionUUID->
  "f4f838c6-89f3-4bac-ae5e-0ed9d7961ed4"],
 " argument a delayed default value based on its position:"
}], "Text",
 CellChangeTimes->{
  3.87043591056312*^9},ExpressionUUID->"0f0b12dd-bb10-4c21-8e41-b418acc48117"],

Cell[CellGroupData[{

