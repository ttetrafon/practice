          RowBox[{"Abs", "[", 
           RowBox[{"i", "-", "j"}], "]"}]}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "100"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "100"}], "}"}]}], "]"}], "]"}], 
    "]"}], ";"}], "//", "RepeatedTiming"}]], "Input",ExpressionUUID->\
"aa24c9da-b41b-5349-a473-8b7f48da3705"],

Cell["\<\
Depending on the type of input, some functions may use entirely different \
methods to arrive at the same result.\
\>", "Text",ExpressionUUID->"7d9e7d1c-19ee-3240-96e6-febad7ae5d7a"],

Cell[TextData[{
 "With real input, ",
 ButtonBox["Solve",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Solve.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Solve.html"],
 " will use numerical methods:"
}], "Text",ExpressionUUID->"c017347c-f0ab-3b4c-bdb4-1a1f7c7a9ec5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"x", "^", "4"}]}], "+", 
        RowBox[{"b", "*", 
         RowBox[{"x", "^", "3"}]}], "+", 
        RowBox[{"c", "*", "x"}], "+", "d"}], " ", "==", " ", "0"}], ",", " ", 
      "x"}], "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", "->", " ", "2."}], ",", " ", 
      RowBox[{"b", " ", "->", " ", "4."}], ",", " ", 
      RowBox[{"c", " ", "->", " ", "7."}], ",", " ", 
      RowBox[{"d", " ", "->", " ", "11."}]}], "}"}]}], ";"}], "//", 
  "RepeatedTiming"}]], "Input",ExpressionUUID->"a462f167-6227-894c-abaf-\
b138b2109dc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", "*", 
         RowBox[{"x", "^", "4"}]}], "+", 
        RowBox[{"b", "*", 
         RowBox[{"x", "^", "3"}]}], "+", 
        RowBox[{"c", "*", "x"}], "+", "d"}], " ", "==", " ", "0"}], " ", "/.",
       " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", " ", "->", " ", "2."}], ",", " ", 
        RowBox[{"b", " ", "->", " ", "4."}], ",", " ", 
        RowBox[{"c", " ", "->", " ", "7."}], ",", " ", 
        RowBox[{"d", " ", "->", " ", "11."}]}], "}"}]}], ",", " ", "x"}], 
    "]"}], ";"}], "//", "RepeatedTiming"}]], "Input",ExpressionUUID->\
"a2b9a747-2837-c141-a4b8-bd0a6ac41a5c"]
}, Closed]],

Cell[CellGroupData[{

Cell["2. Compile", "Subsubsection",
 WholeCellGroupOpener->
  True,ExpressionUUID->"2f67ca33-ab00-614e-ad19-c5fb61f40ffe"],

Cell[TextData[{
 "Use ",
 ButtonBox["Compile",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Compile.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Compile.html"],
 " to convert Wolfram Language code into faster machine code."
}], "Text",ExpressionUUID->"ecf1dcad-9dbc-9341-a953-b1be60f2ae07"],

Cell["Do a simple calculation 10\[ThinSpace]000 times:", "Text",ExpressionUUID->"59ea2488-46da-2842-afb1-44f1f79c2b8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"funct", ",", " ", "compiledFunct"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"funct", " ", "=", " ", 
    RowBox[{"Function", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sum", " ", "=", " ", "1."}], ",", " ", 
          RowBox[{"inc", " ", "=", " ", "1."}]}], "}"}], ",", " ", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"(", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"inc", " ", "=", " ", 
             RowBox[{"inc", "*", 
              RowBox[{"x", "/", "i"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"sum", " ", "=", " ", 
             RowBox[{"sum", " ", "+", " ", "inc"}]}]}], "\[IndentingNewLine]",
            ")"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"10", "^", "4"}]}], "}"}]}], "\[IndentingNewLine]", 
         "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"compiledFunct", " ", "=", " ", 
   RowBox[{
    StyleBox["Compile",
     Background->RGBColor[1, 0.9, 0.8]], 
    StyleBox["[",
     Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Block", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sum", " ", "=", " ", "1."}], ",", " ", 
         RowBox[{"inc", " ", "=", " ", "1."}]}], "}"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"inc", " ", "=", " ", 
            RowBox[{"inc", "*", 
             RowBox[{"x", "/", "i"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sum", " ", "=", " ", 
            RowBox[{"sum", " ", "+", " ", "inc"}]}]}], "\[IndentingNewLine]", 
          ")"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"10", "^", "4"}]}], "}"}]}], "\[IndentingNewLine]", 
        "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
    StyleBox["]",
     Background->RGBColor[1, 0.9, 0.8]]}]}], ";"}]}], "Input",ExpressionUUID->\
"4af3564b-be5d-4f42-94ce-415ccfc00131"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", " ", "=", " ", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "10"}], ",", " ", "10", ",", " ", "0.25"}], "]"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{"funct", ",", " ", "data"}], "]"}], ";"}], "//", "Quiet"}], "//",
   "RepeatedTiming"}]}], "Input",ExpressionUUID->"cc32c8ff-35a1-e844-8166-\
4a61431bf901"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"compiledFunct", ",", " ", "data"}], "]"}], ";"}], "//", 
  "RepeatedTiming"}]], "Input",ExpressionUUID->"d6149471-47bf-8549-ab97-\
5fcb2d2ea3a4"]
}, Closed]],

Cell[CellGroupData[{

Cell["3. Use Built-in Functions", "Subsubsection",
 WholeCellGroupOpener->True,
 CellChangeTimes->{{3.9827790995391064`*^9, 
  3.982779102677492*^9}},ExpressionUUID->"5d42df2f-fd1d-7a48-b753-\
83682e49bce1"],

Cell["\<\
Use built-in functions/algorithms where possible\[LongDash]they are almost \
always faster.\
\>", "Text",
 CellChangeTimes->{{3.870447282880241*^9, 
  3.870447283646076*^9}},ExpressionUUID->"49950bd1-618d-db4e-9471-\
12e1f0246714"],

Cell["Flatten 10 million 2\[Times]2 lists into 1\[Times]4 lists:", "Text",
 CellChangeTimes->{{3.870447287965712*^9, 
  3.870447292479869*^9}},ExpressionUUID->"2cc93746-c925-ad44-bef4-\
35a8c9f4dce2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", "7"}], ",", " ", "2", ",", " ", "2"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"Flatten", ",", " ", "data"}], "]"}], ";"}], "//", 
  "RepeatedTiming"}]}], "Input",ExpressionUUID->"9eb19b09-71cd-804d-b723-\
09d2a148b76f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{"data", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "1", "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "3"}], "}"}]}], "}"}]}], "]"}], ";"}], "//", 
  "RepeatedTiming"}]], "Input",ExpressionUUID->"b08bf133-422c-8a4a-bd1f-\
4b3ae6290744"]
}, Closed]],

Cell[CellGroupData[{

Cell["4. Use an IDE / Debugging Tools", "Subsubsection",
 WholeCellGroupOpener->True,
 CellChangeTimes->{{3.9827791066020527`*^9, 
  3.982779111092745*^9}},ExpressionUUID->"4714e192-34be-6645-9128-\
42a48607adb2"],

Cell["\<\
For large projects, use an Integrated Development Environment (IDE) for \
easier code management. For precise navigation through buggy code, use \
Mathematica\[CloseCurlyQuote]s debugging tool (under Evaluation \
\[FilledRightTriangle] Debugger):\
\>", "Text",
 CellChangeTimes->{{3.8704473039059877`*^9, 
  3.870447315395267*^9}},ExpressionUUID->"de635090-031e-f549-89b6-\
e1cec602a8c0"],

