Cell["\<\
While unit testing can seem a bit over the top for a single function, it can \
be very useful for testing several functions together (e.g. in a program or \
codebase).\
\>", "Text",ExpressionUUID->"9412ddf0-2921-b54e-885b-c296de020cb4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Debugging", "Subsubsection",ExpressionUUID->"044f3874-4244-624b-b1cc-b53c96d1dd63"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Tuning & Debugging",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/guide/TuningAndDebugging.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/guide/TuningAndDebugging.html"]
}], "Text",ExpressionUUID->"65bcd613-26ef-5f40-9197-a1b987eb77ef"],

Cell[TextData[{
 "Tracking down an error can be a difficult and frustrating process. Two of \
the simplest and most common functions used in debugging are ",
 ButtonBox["Echo",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Echo.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Echo.html"],
 " and ",
 ButtonBox["Trace",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Trace.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Trace.html"],
 ". Mathematica also has built-in debugging tools (under Evaluation \
\[FilledRightTriangle] Debugger), but using them goes beyond the scope of \
this course."
}], "Text",
 CellChangeTimes->{{3.870442691623308*^9, 
  3.87044269229207*^9}},ExpressionUUID->"d507f23f-5b67-5b40-9a71-\
58f3dc19fb44"],

Cell[CellGroupData[{

Cell["Echo", "Subsubsubsection",ExpressionUUID->"252ad538-f312-9048-8e28-d5c31f26dff4"],

Cell[TextData[{
 "With up to three arguments, Echo is like a super-charged version of ",
 ButtonBox["Print",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Print.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Print.html"],
 "."
}], "Text",ExpressionUUID->"f7c1cea3-09d3-3b41-82da-30f792ac2a48"],

Cell["Highlight values during a computation:", "Text",
 CellChangeTimes->{{3.9826745158683205`*^9, 
  3.982674515979307*^9}},ExpressionUUID->"26ba5e9a-2c4f-4447-9ff6-\
f981e82a96e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Total", "[", "\[IndentingNewLine]", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"number", "=", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      StyleBox[
       RowBox[{"Echo", "[", 
        RowBox[{"number", ",", " ", "\"\<Value:\>\"", ",", " ", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"number", " ", "<", " ", "0"}], ",", " ", 
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", " ", "Red"}], "]"}], ",", " ", 
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", " ", "Green"}], "]"}]}], "]"}], "&"}]}], "]"}],
       Background->RGBColor[1, 0.9, 0.8]]}], "\[IndentingNewLine]", "]"}], ",",
     "\[IndentingNewLine]", "5"}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.982674513537901*^9, 3.982674523228058*^9}},
 CellLabel->
  "(Debug) In[140]:=",ExpressionUUID->"2cc8597e-0e53-fd47-ba12-320137800dc8"],

