}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Check", "Subsubsection",ExpressionUUID->"3ec43e85-08cb-8b4a-b90b-9dc2882a9559"],

Cell[TextData[{
 ButtonBox["Check",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Check.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Check.html"],
 " can be used to return a different result if an error message is generated \
during a computation (a bit like an error-specific version of ",
 ButtonBox["If",
