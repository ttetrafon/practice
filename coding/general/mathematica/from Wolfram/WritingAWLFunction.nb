    "Find", " ", "the", " ", "first", " ", "output", " ", "with", " ", "an", " ",
      "error", " ", "above", " ", "some", " ", 
     RowBox[{"threshold", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"threshold", " ", "=", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Trace", "[", 
     RowBox[{
      RowBox[{"Nest", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"11", "*", "#"}], "-", "2"}], "&"}], ",", " ", "0.2", ",", 
        " ", "15"}], "]"}], ",", " ", 
      RowBox[{"num_Real", "/;", 
       RowBox[{
        RowBox[{"num", "-", "0.2"}], ">", "threshold"}]}], ",", " ", 
      RowBox[{"TraceDepth", "->", "3"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.982674642026085*^9, 3.982674648904497*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"cd86ca72-78bb-9e45-94ad-b0e2bab2404d"],

