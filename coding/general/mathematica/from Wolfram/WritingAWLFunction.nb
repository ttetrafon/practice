Cell[TextData[{
 "Use ",
 ButtonBox["ClearAll",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/ClearAll.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/ClearAll.html"],
 " to clear default values (",
 ButtonBox["Clear",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Clear.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Clear.html"],
 " alone is not enough):"
}], "Text",ExpressionUUID->"b7dcf27f-b823-43bb-a49c-9f8fd117a78a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"listZero", ",", " ", "listTwo"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DefaultValues", "/@", 
  RowBox[{"{", 
   RowBox[{"listZero", ",", " ", "listTwo"}], "}"}]}]}], "Input",
 CellLabel->
  "In[247]:=",ExpressionUUID->"09e67dbc-8d77-4490-bf50-3d4f7f1f2d9b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"Default", "[", "listZero", "]"}], "]"}], "\[RuleDelayed]", 
     "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"Default", "[", 
       RowBox[{"listTwo", ",", "n_"}], "]"}], "]"}], "\[RuleDelayed]", 
     RowBox[{"2", " ", "n"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9826502664182816`*^9},
 CellLabel->
  "Out[248]=",ExpressionUUID->"4bcd7807-4989-4049-aa76-bdcedf8f6f73"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"listZero", ",", " ", "listTwo"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"DefaultValues", "/@", 
  RowBox[{"{", 
   RowBox[{"listZero", ",", " ", "listTwo"}], "}"}]}]}], "Input",
 CellLabel->
  "In[249]:=",ExpressionUUID->"3d82f59f-5193-458b-b5bd-dec31fe5f368"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.982650268336809*^9},
 CellLabel->
  "Out[250]=",ExpressionUUID->"002d72a0-a9e2-ba4d-8423-7e0e9a37f8b1"]
}, Open  ]]
}, Closed]],

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"969e8feb-cd38-403b-865e-ba305a7537d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Overloading", "Subsubsection",ExpressionUUID->"7f1f7b76-cfbf-41b1-8ef8-ceb6677bdbaa"],

Cell[TextData[{
 "Rather than specifying optional or default values, you can simply give a \
function multiple definitions. This is known as ",
 StyleBox["overloading",
  FontSlant->"Italic"],
 " (more on this later):"
}], "Text",ExpressionUUID->"1156009c-ed4c-4882-9658-e052054c9919"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "partyInvitation", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"partyInvitation", "[", "]"}], ":=", "\"\<You're invited!\>\""}], "\n", 
 RowBox[{
  RowBox[{"partyInvitation", "[", "name_", "]"}], ":=", 
  RowBox[{"name", "<>", "\"\<, you're invited!\>\""}]}], "\n", 
 RowBox[{
  RowBox[{"partyInvitation", "[", 
   RowBox[{"name_", ",", "place_GeoPosition"}], "]"}], ":=", 
  RowBox[{"name", "<>", "\"\<, you're invited to \>\"", "<>", 
   RowBox[{"ToString", "[", "place", "]"}], "<>", "\"\<!\>\""}]}], "\n", 
 RowBox[{
  RowBox[{"partyInvitation", "[", 
   RowBox[{"name_", ",", "place_GeoPosition", ",", "time_DateObject"}], "]"}],
   ":=", 
  RowBox[{"name", "<>", "\"\<, you're invited to \>\"", "<>", 
   RowBox[{"ToString", "[", "place", "]"}], "<>", "\"\< at \>\"", "<>", 
   RowBox[{"ToString", "[", "time", "]"}], "<>", "\"\<!\>\""}]}]}], "Input",
 CellChangeTimes->{{3.9826502919753056`*^9, 3.98265029376478*^9}, {
  3.98277717545739*^9, 3.9827771765227356`*^9}, {3.982777351712303*^9, 
  3.9827774159000034`*^9}, {3.9827774714928246`*^9, 3.9827774728683662`*^9}, {
  3.9827775212712364`*^9, 3.9827775494665623`*^9}, {3.9827779646968136`*^9, 
  3.982777965094795*^9}, {3.982778046171175*^9, 3.982778149563017*^9}},
 CellLabel->
  "In[274]:=",ExpressionUUID->"58ed219b-5abe-48df-99ce-79d0a5034b84"],

Cell[BoxData[
 RowBox[{"Column", "[", "\[IndentingNewLine]", 
  RowBox[{"partyInvitation", " ", "@@@", " ", 
   RowBox[{"Rest", "[", 
    RowBox[{"FoldList", "[", 
     RowBox[{"Append", ",", 
      RowBox[{"{", "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Wolfie\>\"", ",", "Here", ",", "Now"}], "}"}]}], "]"}], 
    "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.982778089659031*^9, 3.9827780904842377`*^9}, {
  3.982778162221758*^9, 3.982778167210253*^9}},
 CellLabel->
  "In[280]:=",ExpressionUUID->"a33344ee-615c-cc4f-8742-4bbe9bca84d0"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"b8c6e924-9223-4447-afb1-44051efe5904"]
}, Open  ]]
