Cell[CellGroupData[{

Cell["Extending Capability", "Section",ExpressionUUID->"6f2afac0-d11e-4c1f-888b-1f9297854d40"],

Cell[CellGroupData[{

Cell["Overloading", "Subsection",
 CellTags->
  "ExtendingCapability-Overloading",ExpressionUUID->"0581befd-aea0-4505-943f-\
8aed01b0042b"],

Cell[TextData[{
 StyleBox["Overloading",
  FontSlant->"Italic"],
 " a function simply means giving it multiple definitions for different types \
of input."
}], "Text",ExpressionUUID->"3e2c7362-7ba7-4115-a57f-6c2f684e1737"],

Cell[CellGroupData[{

Cell["Standard Usage", "Subsubsection",
 CellChangeTimes->{{3.982670636424801*^9, 
  3.9826706368661137`*^9}},ExpressionUUID->"74ae7594-a993-4720-b1dd-\
ace75cfe0dc3"],

Cell[TextData[{
 "Overloading is generally preferred over using a branching function like ",
 ButtonBox["If",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/If.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/If.html"],
 ", ",
 ButtonBox["Which",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Which.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Which.html"],
 " or ",
 ButtonBox["Switch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Switch.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Switch.html"],
 "."
}], "Text",ExpressionUUID->"9014ab1d-d398-44fa-827d-0e6691c9e674"],

Cell["\<\
Round and square a number whether it is given as an integer, a fraction, a \
decimal or a string:\
\>", "Text",ExpressionUUID->"f1580ed9-3b58-4ea9-afeb-afe34f7640fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "square", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"square", "[", "integer_Integer", "]"}], " ", ":=", " ", 
   RowBox[{"integer", "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"square", "[", "fraction_Rational", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Round", "[", 
     RowBox[{"Divide", "@@", 
      RowBox[{"NumeratorDenominator", "[", "fraction", "]"}]}], "]"}], "^", 
    "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"square", "[", "decimal_Real", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Round", "[", "decimal", "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"square", "[", "string_String", "]"}], " ", ":=", 
   RowBox[{
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"Interpreter", "[", "\"\<SemanticNumber\>\"", "]"}], "[", 
      "string", "]"}], "]"}], "^", "2"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9826706543180485`*^9, 
  3.98277845038192*^9},ExpressionUUID->"f545a115-da0c-4871-b604-7895e757267c"],

Cell[BoxData[{
 RowBox[{"square", "[", "23", "]"}], "\[IndentingNewLine]", 
 RowBox[{"square", "[", 
  RowBox[{"69", "/", "3"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"square", "[", "23.4", "]"}], "\[IndentingNewLine]", 
 RowBox[{"square", "[", "\"\<twenty three point four\>\"", "]"}]}], "Input",
 CellChangeTimes->{3.9826706543180485`*^9, 
  3.98277845038192*^9},ExpressionUUID->"0a6a8f28-6e61-de41-a0c7-122419a98988"],

Cell[TextData[{
 "Create a function to test the ",
 ButtonBox["Collatz conjecture",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Collatz_conjecture"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Collatz_conjecture"],
 ":"
}], "Text",ExpressionUUID->"41d747e3-4619-4da0-a295-85a6b4339e6a"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "evenOddFun", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evenOddFun", "[", 
    RowBox[{"number_", "?", "EvenQ"}], "]"}], ":=", 
   RowBox[{"number", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"evenOddFun", "[", 
    RowBox[{"number_", "?", "OddQ"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"3", "*", "number"}], "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"evenOddFun", "[", "4", "]"}], "\[IndentingNewLine]", 
 RowBox[{"evenOddFun", "[", "5", "]"}]}], "Input",
 CellChangeTimes->{{3.9826706815327206`*^9, 3.982670682540819*^9}},
 CellLabel->
  "In[137]:=",ExpressionUUID->"334daf9b-5cf6-49a5-aa02-6f959538de54"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dependent Arguments", "Subsubsection",
 CellChangeTimes->{{3.9826706986365547`*^9, 
  3.98267069905319*^9}},ExpressionUUID->"7e3dacc3-e58d-4416-9ac6-\
274b243cbe4c"],

Cell["\<\
With the usual function syntax, the default value of one argument cannot be \
dependent on another argument:\
\>", "Text",ExpressionUUID->"44e246a1-ce0c-40bc-b4d1-b6074313e3f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{
      StyleBox["x_",
       Background->RGBColor[1, 0.9, 0.8]], ":", "1"}], ",", " ", 
     RowBox[{"y_", " ", 
      StyleBox[":",
       Background->RGBColor[1, 0.9, 0.8]], 
      StyleBox[" ",
       Background->RGBColor[1, 0.9, 0.8]], 
      StyleBox["x",
       Background->RGBColor[1, 0.9, 0.8]]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", "1", "]"}]}], "Input",
 CellChangeTimes->{3.9826707025228405`*^9},
 CellLabel->
  "In[147]:=",ExpressionUUID->"c50b0c2f-f4b4-4bdd-970f-b76b0c0f74e4"],

Cell["However, this behaviour can be mimicked with overloading.", "Text",ExpressionUUID->"62530527-8583-497f-b4d1-756791537f58"],

Cell["\<\
Create a function where the default value of the second argument equals the \
first argument:\
\>", "Text",ExpressionUUID->"71af7fae-c7d5-4642-99b0-fc85faa5b72f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", " ", "y_"}], " ", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ":", "1"}], "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "x"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", "a", "]"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", 
  RowBox[{"a", ",", " ", "b"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826707075915585`*^9, 3.9826707404997425`*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"3eca61de-d184-469e-b738-c1df1607c38b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Alternative Solutions",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870783995450531*^9, 3.8707839973188677`*^9}, {
  3.982670774068308*^9, 3.9826707744676056`*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"66df4bde-8e93-4bb5-95ae-b976d07d4e3f"],

Cell["\<\
For this particular example, it would be clearer to do some recursion in the \
second definition, like so:\
\>", "Text",ExpressionUUID->"b5315a0b-8c99-48af-b0d2-d6601d66a141"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", " ", "y_"}], " ", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", " ", ":", " ", "1"}], "]"}], " ", ":=", " ", 
   StyleBox[
    RowBox[{"f", "[", 
     RowBox[{"x", ",", " ", "x"}], "]"}],
    Background->RGBColor[1, 0.9, 0.8]]}], ";"}]}], "Input",
 CellChangeTimes->{3.982670784711027*^9},
 CellLabel->
  "In[162]:=",ExpressionUUID->"81a87fe7-8882-4e38-8efe-10485f4f45be"],

Cell["\<\
Or you could localise the default value of the second argument:\
\>", "Text",ExpressionUUID->"9a63b781-9c44-4407-aec0-5fbb71345706"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"x_", " ", ":", " ", "1"}], ",", " ", 
     RowBox[{"y_", " ", ":", " ", "dummy"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dummy", " ", "=", " ", "x"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.98267080210474*^9},
 CellLabel->
  "In[166]:=",ExpressionUUID->"8b0cf18c-7143-41f5-a3ce-3dc54ef360ae"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dependent Option Values", "Subsubsection",
 CellChangeTimes->{{3.982670818354067*^9, 
  3.982670822493372*^9}},ExpressionUUID->"d57e86eb-2830-4106-ac31-\
fcc62340ae72"],

Cell["The same principle can be applied to option values.", "Text",ExpressionUUID->"c883efc8-bba0-4a03-a181-42692b30e1a3"],

Cell["\<\
Create a function that puts a frame around a piece of text, where the \
rounding radius scales with the size of the frame margins:\
\>", "Text",ExpressionUUID->"79a566e3-0db5-4287-99b6-9694b941a4e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "frameText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "frameText", "]"}], " ", "=", 
   "\[IndentingNewLine]", 
   RowBox[{"DeleteDuplicatesBy", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Join", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"FrameMargins", " ", "->", " ", "10"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Options", "[", "Framed", "]"}]}], "\[IndentingNewLine]", 
      "]"}], ",", "\[IndentingNewLine]", "First"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"frameText", "[", 
     RowBox[{"text_String", ",", " ", 
      RowBox[{"options", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], 
    StyleBox["/;",
     Background->RGBColor[1, 0.9, 0.8]], 
    StyleBox[
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"{", "options", "}"}], ",", " ", "RoundingRadius"}], "]"}],
     Background->RGBColor[1, 0.9, 0.8]]}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Framed", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Text", "[", "text", "]"}], ",", "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{"RoundingRadius", " ", "->", " ", 
       RowBox[{
        RowBox[{"OptionValue", "[", "FrameMargins", "]"}], "/", "2"}]}],
      Background->RGBColor[1, 0.9, 0.8]], ",", "\[IndentingNewLine]", 
     "options"}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frameText", "[", 
    RowBox[{"text_String", ",", " ", 
     RowBox[{"options", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Framed", "[", 
    RowBox[{
     RowBox[{"Text", "[", "text", "]"}], ",", " ", "options"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"frameText", "[", "\"\<text\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"frameText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FrameMargins", " ", "->", " ", "50"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"frameText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"RoundingRadius", " ", "->", " ", "10"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"frameText", "[", 
  RowBox[{"\"\<text\>\"", ",", " ", 
   RowBox[{"FrameMargins", " ", "->", " ", "50"}], ",", " ", 
   RowBox[{"RoundingRadius", " ", "->", " ", "10"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826708281984024`*^9, 3.9826708626581554`*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"8131bd0c-4588-4b8c-aace-2d4d04d24ac9"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Alternative Solution",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.8707840193504972`*^9, 3.870784025678698*^9}, {
  3.9826708780910854`*^9, 3.9826708784890785`*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"d288dff0-fce6-46bd-953c-282e8ea0cad0"],

Cell[TextData[{
 "For this particular example, rather than overloading, it would be clearer \
to set the default value of ",
 ButtonBox["RoundingRadius",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/RoundingRadius.html"], 
    None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/RoundingRadius.html"],
 " to a dummy value (e.g. ",
 ButtonBox["Automatic",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Automatic.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Automatic.html"],
 "), then make a replacement:"
}], "Text",
 CellChangeTimes->{{3.870437402431024*^9, 
  3.870437410483783*^9}},ExpressionUUID->"2fe0e27b-1816-4258-b627-\
7dbbbdbac970"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "frameText", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "frameText", "]"}], " ", "=", 
   "\[IndentingNewLine]", 
   RowBox[{"DeleteDuplicatesBy", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Join", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FrameMargins", " ", "->", " ", "10"}], ",", " ", 
         StyleBox[
          RowBox[{"RoundingRadius", " ", "->", " ", "Automatic"}],
          Background->RGBColor[1, 0.9, 0.8]]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Options", "[", "Framed", "]"}]}], "\[IndentingNewLine]", 
      "]"}], ",", "\[IndentingNewLine]", "First"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frameText", "[", 
    RowBox[{"text_String", ",", " ", 
     RowBox[{"options", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Framed", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Text", "[", "text", "]"}], ",", "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{"RoundingRadius", " ", "->", " ", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"OptionValue", "[", "RoundingRadius", "]"}], ",", " ", 
         RowBox[{"Automatic", " ", "->", " ", 
          RowBox[{
           RowBox[{"OptionValue", "[", "FrameMargins", "]"}], "/", "2"}]}]}], 
        "]"}]}],
      Background->RGBColor[1, 0.9, 0.8]], ",", "\[IndentingNewLine]", 
     RowBox[{"Sequence", " ", "@@", " ", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"{", "options", "}"}], ",", " ", 
        RowBox[{"RoundingRadius", " ", "->", " ", "_"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98267088677689*^9, 3.982670894937628*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"e373bf66-0e2b-48bf-aae0-b625086ca363"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Catch-Alls and Zero Arguments", "Subsubsection",
 CellChangeTimes->{{3.98267092249547*^9, 
  3.9826709304408665`*^9}},ExpressionUUID->"c172a68b-d984-4583-8395-\
c056ce0e9b55"],

Cell["\<\
Overloading is especially useful for creating a \
\[OpenCurlyDoubleQuote]catch-all\[CloseCurlyDoubleQuote]: a definition \
designed to handle any input types previously unaccounted for.\
\>", "Text",ExpressionUUID->"c87ae8e2-837c-4b72-9a36-3803b2612fd6"],

Cell["\<\
The square function defined earlier will not evaluate if the input is not an \
integer, fraction, decimal or string:\
\>", "Text",ExpressionUUID->"778ce7c0-1de4-479b-89fb-4fea14d9dd55"],

Cell[BoxData[
 RowBox[{"square", "[", "badInput", "]"}]], "Input",
 CellLabel->
  "In[183]:=",ExpressionUUID->"bc6b3bb5-b09e-4d9d-9188-81dc393e4628"],

Cell["Add a catch-all case:", "Text",ExpressionUUID->"1be7ba2a-2a6d-4e5a-8a34-64b6a0798348"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"square", "[", "___", "]"}], " ", ":=", 
   " ", "\"\<Bad input \[Dash] try again\>\""}], ";"}]], "Input",
 CellLabel->
  "In[184]:=",ExpressionUUID->"1ce4421d-2519-49e6-acc5-2b1135826001"],

Cell["\<\
Additionally, rather than making every argument optional, overloading can be \
used to define a special zero-argument case:\
\>", "Text",ExpressionUUID->"f3b3d334-72c5-4af5-8563-bdb089dc6dbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"square", "[", "]"}], " ", ":=", 
   " ", "\"\<No arguments supplied\>\""}], ";"}]], "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"5fa4a121-51f8-4516-a73d-0f3771de67d3"],

Cell["The function will now handle all edge cases:", "Text",ExpressionUUID->"40d46b22-458f-4b8d-beee-9405cc813b7c"],

