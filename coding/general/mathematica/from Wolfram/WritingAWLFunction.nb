Cell[TextData[{
 "While Confirm is limited to a handful of failure types, there are several \
other ",
 ButtonBox["Confirm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Confirm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Confirm.html"],
 "-related functions with wider capabilities, all of which are supported by ",
 ButtonBox["Enclose",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Enclose.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Enclose.html"],
 ": ",
 ButtonBox["Confirm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Confirm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Confirm.html"],
 ", ",
 ButtonBox["ConfirmBy",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ConfirmBy.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ConfirmBy.html"],
 ", ",
 ButtonBox["ConfirmMatch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ConfirmMatch.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ConfirmMatch.html"],
 ", ",
 ButtonBox["ConfirmQuiet",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ConfirmQuiet.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ConfirmQuiet.html"],
 " and ",
 ButtonBox["ConfirmAssert",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ConfirmAssert.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ConfirmAssert.html"],
 "."
}], "Text",
 CellChangeTimes->{{3.98267236365514*^9, 
  3.9826723913842945`*^9}},ExpressionUUID->"d6910f86-92f8-a640-9469-\
b01c057eb63a"],

Cell["\<\
Create a function that returns a number only if it is positive:\
\>", "Text",ExpressionUUID->"a1e07e26-48a4-c646-a530-45bacfe6ae91"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "returnPositive", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"returnPositive", "[", "number_", "]"}], " ", ":=", " ", 
   RowBox[{"Enclose", "[", 
    RowBox[{"ConfirmBy", "[", 
     RowBox[{"number", ",", " ", 
      RowBox[{
       RowBox[{"#", ">=", "0"}], "&"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"returnPositive", "[", 
  RowBox[{"RandomInteger", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826731704401455`*^9, 3.9826731714926376`*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"ccb41f9b-c997-f142-8dd1-c72b20f65577"],

