 RowBox[{"square", "[", "]"}], "\[IndentingNewLine]", 
 RowBox[{"square", "[", "badInput", "]"}]}], "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"f45f2fa7-dfcf-4365-9553-57224715cbb1"],

