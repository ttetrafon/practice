Cell[TextData[{
 "Rather than printing every value on a new line, ",
 ButtonBox["Sow",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Sow.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Sow.html"],
 " and ",
 ButtonBox["Reap",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Reap.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Reap.html"],
 " can be used to bundle them into a single list:"
}], "Text",ExpressionUUID->"8e417e32-a1fc-834e-b80f-f8228aa5a33d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  StyleBox["Reap",
   Background->RGBColor[1, 0.9, 0.8]], "[", "\[IndentingNewLine]", 
  RowBox[{"Total", "[", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
