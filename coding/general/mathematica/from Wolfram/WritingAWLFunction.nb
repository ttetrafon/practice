Cell["\<\
Recreate the functions, this time sowing the grid points and plotting them:\
\>", "Text",ExpressionUUID->"1f163c5d-ce5e-3548-9b1d-d0032f2df6ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"gridPoints", ",", " ", "gridPointsMemoised"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gridPoints", "[", 
     RowBox[{"{", 
      RowBox[{"m_", ",", " ", "n_"}], "}"}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"m", "<=", "0"}], "||", 
     RowBox[{"n", "<=", "0"}]}]}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gridPoints", "[", 
     RowBox[{"{", 
      RowBox[{"m_", ",", " ", "n_"}], "}"}], "]"}], " ", ":=", " ", 
    RowBox[{
     StyleBox["Module",
      Background->RGBColor[1, 0.9, 0.8]], 
     StyleBox["[",
      Background->RGBColor[1, 0.9, 0.8]], 
     RowBox[{
      StyleBox[
       RowBox[{"{", 
        RowBox[{"a", ",", "b"}], "}"}],
       Background->RGBColor[1, 0.9, 0.8]], 
      StyleBox[",",
       Background->RGBColor[1, 0.9, 0.8]], 
      StyleBox[" ",
       Background->RGBColor[1, 0.9, 0.8]], 
      RowBox[{
       StyleBox[
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "n"}], "}"}]}],
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox[";",
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox[" ",
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox[
        RowBox[{"Sow", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], "]"}],
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox[";",
        Background->RGBColor[1, 0.9, 0.8]], " ", 
       RowBox[{
        RowBox[{"gridPoints", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"m", "-", "1"}], ",", " ", "n"}], "}"}], "]"}], " ", "+", 
        " ", 
        RowBox[{"gridPoints", "[", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", 
           RowBox[{"n", "-", "1"}]}], "}"}], "]"}]}]}]}], 
     StyleBox["]",
      Background->RGBColor[1, 0.9, 0.8]]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gridPointsMemoised", "[", 
     RowBox[{"{", 
      RowBox[{"m_", ",", " ", "n_"}], "}"}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"m", "<=", "0"}], "||", 
     RowBox[{"n", "<=", "0"}]}]}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gridPointsMemoised", "[", 
     RowBox[{"{", 
      RowBox[{"m_", ",", " ", "n_"}], "}"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"gridPointsMemoised", "[", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "n"}], "}"}], "]"}], " ", "=", " ", 
     RowBox[{
      StyleBox["Module",
       Background->RGBColor[1, 0.9, 0.8]], 
      StyleBox["[",
       Background->RGBColor[1, 0.9, 0.8]], 
      RowBox[{
       StyleBox[
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}],
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox[",",
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox[" ",
        Background->RGBColor[1, 0.9, 0.8]], 
       RowBox[{
        StyleBox[
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "n"}], "}"}]}],
         Background->RGBColor[1, 0.9, 0.8]], 
        StyleBox[";",
         Background->RGBColor[1, 0.9, 0.8]], 
        StyleBox[" ",
         Background->RGBColor[1, 0.9, 0.8]], 
        StyleBox[
         RowBox[{"Sow", "[", 
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], "]"}],
         Background->RGBColor[1, 0.9, 0.8]], 
        StyleBox[";",
         Background->RGBColor[1, 0.9, 0.8]], " ", 
        RowBox[{
         RowBox[{"gridPointsMemoised", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"m", "-", "1"}], ",", " ", "n"}], "}"}], "]"}], " ", "+", 
         " ", 
         RowBox[{"gridPointsMemoised", "[", 
          RowBox[{"{", 
           RowBox[{"m", ",", " ", 
            RowBox[{"n", "-", "1"}]}], "}"}], "]"}]}]}]}], 
      StyleBox["]",
       Background->RGBColor[1, 0.9, 0.8]]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", "7"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Map", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{"#", "[", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "n"}], "}"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"n", " ", "+", " ", "1"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"n", " ", "+", " ", "1"}]}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"GridLines", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", " ", 
           RowBox[{"Range", "[", "n", "]"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Epilog", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"PointSize", "[", "0.02", "]"}], ",", " ", 
           RowBox[{"Point", "[", 
            RowBox[{"Tuples", "[", 
             RowBox[{
              RowBox[{"Range", "[", "n", "]"}], ",", " ", "2"}], "]"}], 
            "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", 
            StyleBox[
            "\"Plot options\"", "IconizedCustomName", StripOnInput -> False], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Sequence", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["3", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["328", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Sequence[PlotLabel -> #, AspectRatio -> 1, ImageSize -> 400],
         SelectWithContents->True,
         Selectable->False]}], "\[IndentingNewLine]", "]"}], " ", "&"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"gridPoints", ",", " ", "gridPointsMemoised"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], "Input",Ex\
pressionUUID->"2f6e69d1-cb3e-0c40-8acf-683db277d488"]
}, Open  ]],

