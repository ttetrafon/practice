}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Iteration: ",
 StyleBox["Looping Constructs",
  FontColor->GrayLevel[0.5]]
}], "Subsubsection",
 CellChangeTimes->{{3.9826714835679893`*^9, 
  3.9826714839393845`*^9}},ExpressionUUID->"69de9b0f-bfdf-4cbd-ba1a-\
7df75a8d05df"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Looping Constructs",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/guide/LoopingConstructs.html"],
     None},
  ButtonNote->
   "http://reference.wolfram.com/language/guide/LoopingConstructs.html"]
}], "Text",
 CellChangeTimes->{{3.870437620669612*^9, 
  3.8704376212461987`*^9}},ExpressionUUID->"511bf9d4-3525-46a4-b683-\
440880db4147"],

Cell[TextData[{
 "Looping constructs employ what might be called \
\[OpenCurlyDoubleQuote]standard\[CloseCurlyDoubleQuote] iteration. They are \
useful for carrying out tasks a predetermined number of times or until a test \
fails to give ",
 ButtonBox["True",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/True.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/True.html"],
 ". Often different looping constructs can be used to perform the same task."
}], "Text",
 CellChangeTimes->{{3.8704376299606543`*^9, 3.870437651034842*^9}},
 CellID->428079372,ExpressionUUID->"a1367053-2d5c-4676-a3f1-011fbfcac683"],

Cell[TextData[{
 "While ",
 ButtonBox["For",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/For.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/For.html"],
 " is often the go-to function for creating loops in other languages, it is \
rarely used in the Wolfram Language; ",
 ButtonBox["Do",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Do.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Do.html"],
 ", ",
 ButtonBox["Table",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Table.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Table.html"],
 " and ",
 ButtonBox["While",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/While.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/While.html"],
 " are usually preferred."
}], "Text",ExpressionUUID->"7aa35610-6999-45c2-9430-5a19d5123e4c"],

Cell[TextData[{
 "Use Table to create a function that produces an ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", "\[Times]", "n"}], TraditionalForm]],ExpressionUUID->
  "218870cd-22ce-e84b-a21d-15d9140c6dfb"],
 "matrix by iterating over ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "b82dd2b9-dd3d-6b43-9121-a11cf4bbd5f1"],
 " and ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "7fde513e-b6d3-e441-8328-42915ddc65c7"],
 ":"
}], "Text",
 CellChangeTimes->{{3.870437697119556*^9, 
  3.870437725751328*^9}},ExpressionUUID->"8f977b43-81a2-4815-bb9e-\
04d35797e38d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "matrix", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"matrix", "[", 
     RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      SubscriptBox["a", 
       RowBox[{"i", ",", " ", "j"}]], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "m"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"matrix", "[", 
  RowBox[{"3", ",", " ", "4"}], "]"}]}], "Input",ExpressionUUID->"151a3afd-\
0a65-405c-922a-4cf2220e1d02"],

Cell["Create the same function with Do:", "Text",ExpressionUUID->"ed4c5573-bc06-4f9d-a1aa-f7a093e62630"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "matrix", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"matrix", "[", 
     RowBox[{"m_", ",", " ", "n_"}], "]"}], " ", ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"list", " ", "=", " ", 
        RowBox[{"{", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"list", ",", " ", 
           SubscriptBox["a", 
            RowBox[{"i", ",", " ", "j"}]]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "m"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Partition", "[", 
        RowBox[{"list", ",", " ", "n"}], "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"matrix", "[", 
  RowBox[{"3", ",", " ", "4"}], "]"}]}], "Input",ExpressionUUID->"ac390926-\
ac4b-4927-8841-aa95cadc30ca"],

Cell["\<\
Note that Do, unlike Table, does not return an output\[LongDash]hence the \
more verbose code in this case.\
\>", "Text",ExpressionUUID->"0ad7b8f8-f0bf-4d50-bbe9-a2dd2e344a85"],

Cell[TextData[{
 "Use While to create a function that calculates the ",
 ButtonBox["largest common factor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikipedia.org/wiki/Greatest_common_divisor"], None},
  ButtonNote->"https://en.wikipedia.org/wiki/Greatest_common_divisor"],
 " of two numbers:"
}], "Text",ExpressionUUID->"6bee6fef-ace4-4d90-aa57-fcc2e3f404e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "largestCommonFactor", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"largestCommonFactor", "[", 
     RowBox[{"num1_", ",", "num2_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"num1", ",", " ", "num2"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"b", "\[NotEqual]", "0"}], ",", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", " ", "b"}], "}"}], " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", 
            RowBox[{"Mod", "[", 
             RowBox[{"a", ",", " ", "b"}], "]"}]}], "}"}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "a"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"largestCommonFactor", "[", 
  RowBox[{"629", ",", " ", "1147"}], "]"}]}], "Input",ExpressionUUID->\
"cc3d8ee7-0b7c-4eab-8117-dd02b71fa585"],

Cell["\<\
Note that Do and Table localise their variables, but For and While do not \
(more on localisation later).\
\>", "Text",ExpressionUUID->"7a492a9c-4118-4baf-998b-1b214f6558b8"],

Cell[CellGroupData[{

