Cell[CellGroupData[{

Cell["Throw and Catch", "Subsubsection",
 CellChangeTimes->{{3.982673478924301*^9, 
  3.9826734793156796`*^9}},ExpressionUUID->"94f87a72-7660-5e47-959a-\
426364c1f04f"],

Cell[TextData[{
 ButtonBox["Throw",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Throw.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Throw.html"],
 " and ",
 ButtonBox["Catch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Catch.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Catch.html"],
 " work in a similar way to ",
 ButtonBox["Confirm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Confirm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Confirm.html"],
 " and ",
 ButtonBox["Enclose",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Enclose.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Enclose.html"],
 ", except the criteria for stopping a computation are more flexible. They \
are particularly useful for stopping loops early."
}], "Text",
 CellChangeTimes->{{3.982673595550207*^9, 
  3.9826736101538715`*^9}},ExpressionUUID->"a165f38e-9864-d34d-ab69-\
897c6558841a"],

Cell["\<\
Create a function to find the next prime after a given number:\
\>", "Text",ExpressionUUID->"2483dc39-d6fd-5b49-8840-4ef54c2eeb28"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "nextPrime", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nextPrime", "[", 
    RowBox[{"startingPoint_", ",", " ", "searchLength_"}], "]"}], " ", ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Catch", "[", "\[IndentingNewLine]", 
    RowBox[{"Do", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"PrimeQ", "[", "i", "]"}], ",", 
        RowBox[{"Throw", "[", "i", "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", "startingPoint", ",", " ", 
        RowBox[{"startingPoint", " ", "+", " ", "searchLength"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"nextPrime", "[", 
  RowBox[{
   RowBox[{"10", "^", "12"}], ",", " ", "50"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826736154807606`*^9, 3.9826736687236423`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"df84a59f-bd39-6342-a227-d5675f4ed272"],

Cell[BoxData["1000000000039"], "Output",
 CellChangeTimes->{3.9826736691377544`*^9},
 CellLabel->"Out[99]=",ExpressionUUID->"1f3a69d4-dc1a-ba4a-89ed-7d408bb4a87f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Mimicking Confirm/Enclose with Throw/Catch",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870784188225275*^9, 3.870784189105091*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"c5056205-29eb-7c4d-85cf-00b15f2d62eb"],

Cell["\<\
Throw and Catch can be used to mimic the behaviour of Confirm and Enclose:\
\>", "Text",ExpressionUUID->"5a1cc047-08bc-fd49-b3d0-0dd1afe304af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"result", "=", "$Failed"}], "}"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Catch", "[", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FailureQ", "[", "result", "]"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Throw", "[", "error", "]"}], ",", " ", "\[IndentingNewLine]", 
      "result"}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9826736376773453`*^9, 3.982673644353071*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"43401c3a-6702-2c40-bd53-c7d04cef976a"],

Cell[BoxData["error"], "Output",
 CellChangeTimes->{3.982673645186119*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"a4328d05-4368-2341-a2b1-2c5b4f6e99a9"]
}, Open  ]],

Cell[TextData[{
 "However, the result in this case is not quite the same, since ",
 ButtonBox["FailureQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FailureQ.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FailureQ.html"],
 " does not catch all of the same failure objects as ",
 ButtonBox["Confirm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Confirm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Confirm.html"],
 "."
}], "Text",
 CellChangeTimes->{{3.982673732669565*^9, 
  3.9826737340759087`*^9}},ExpressionUUID->"ab94afe3-707f-d14e-a4b3-\
ea19f22877af"]
}, Closed]],

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"ba4d6a2b-69ab-5640-96e1-d3b6924b9a04"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Break", "Subsubsection",ExpressionUUID->"48d40eb0-add6-da44-aa1c-2dcf19c0ea66"],

Cell[TextData[{
 ButtonBox["Break",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Break.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Break.html"],
 " will \[OpenCurlyDoubleQuote]exit\[CloseCurlyDoubleQuote] the nearest \
enclosing ",
 ButtonBox["Do",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Do.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Do.html"],
 ", ",
 ButtonBox["For",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/For.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/For.html"],
 " or ",
 ButtonBox["While",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/While.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/While.html"],
 " loop. Unlike ",
 ButtonBox["Throw",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Throw.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Throw.html"],
 "/",
 ButtonBox["Catch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Catch.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Catch.html"],
 ", this will not necessarily stop the computation (unless the loop is the \
outermost part of the program). Although less versatile than Throw/Catch, \
Break can also be used to stop a loop early."
}], "Text",
 CellChangeTimes->{{3.870442349444282*^9, 3.8704423814337053`*^9}, {
  3.98267374887521*^9, 
  3.982673751554367*^9}},ExpressionUUID->"94b10d18-2a2f-524f-aaa2-\
17ef3aec3b11"],

Cell[TextData[{
 "Recreate the ",
 StyleBox["nextPrime", "Input"],
 " function with Break and While:"
}], "Text",ExpressionUUID->"4804e805-4a19-8d4d-a005-ce7d1e805a27"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "nextPrime", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nextPrime", "[", 
   RowBox[{"startingPoint_", ",", " ", "searchLength_"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", " ", "=", " ", "startingPoint"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"i", "<", 
        RowBox[{"startingPoint", "+", "searchLength"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"PrimeQ", "[", "i", "]"}], ",", 
           StyleBox[
            RowBox[{"Break", "[", "]"}],
            Background->RGBColor[1, 0.9, 0.8]]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"i", "++"}]}], "\[IndentingNewLine]", ")"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "i"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nextPrime", "[", 
  RowBox[{
   RowBox[{"10", "^", "12"}], ",", " ", "10"}], "]"}]}], "Input",
 CellChangeTimes->{{3.982673768964531*^9, 3.982673779649*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"eeff7f5f-6533-c544-9256-01fc072f9788"],

Cell[BoxData["1000000000010"], "Output",
 CellChangeTimes->{{3.98267377310758*^9, 3.9826737799579716`*^9}},
 CellLabel->
  "Out[108]=",ExpressionUUID->"7acaae68-f950-c54c-92f1-2a16cd9f4a97"]
}, Open  ]],

Cell["\<\
(Note that this will print an incorrect result if no prime is found.)\
\>", "Text",ExpressionUUID->"bbcbbc1e-f668-3644-87b0-e8a010ae7132"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Alternative Solution",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
