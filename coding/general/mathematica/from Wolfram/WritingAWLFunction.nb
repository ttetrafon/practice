  RowBox[{
   RowBox[{
    RowBox[{"1", "/", "2"}], ";", " ", "\"\<NoError\>\""}], ",", 
   " ", "\"\<Error\>\""}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Check", "[", 
  RowBox[{
