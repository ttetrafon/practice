Cell[TextData[{
 StyleBox["Function syntax",
  FontSlant->"Italic"],
 " refers to the allowed forms of a function\[LongDash]the patterns of \
arguments or options that are valid to use within it. If the allowed syntax \
has been defined for a function, invalid forms will be highlighted in red as \
the function is typed."
}], "Text",ExpressionUUID->"5485cf15-94af-6a42-ab49-0a95d263e320"],

Cell[CellGroupData[{

Cell["SyntaxInformation", "Subsubsection",ExpressionUUID->"edd647a0-1ad4-e04d-8d0e-c0c10ea89bd1"],

