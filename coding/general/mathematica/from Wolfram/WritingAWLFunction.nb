In[58]:=",ExpressionUUID->"d2aee269-13fa-924e-a16b-df16fba0991d"],

Cell[BoxData[
 RowBox[{"StringTake", "[", 
  RowBox[{"\<\"abc\"\>", ",", "4"}], "]"}]], "Output",
 CellChangeTimes->{3.9826732306222343`*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"332392d3-b4f0-d54f-b2cc-dddd46a5e23f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stringTake", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringTake", "[", 
    RowBox[{"string_", ",", "n_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Enclose", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ConfirmQuiet", "[", "\[IndentingNewLine]", 
      RowBox[{"StringTake", "[", 
       RowBox[{"string", ",", "n"}], "]"}], "\[IndentingNewLine]", "]"}], ",",
      "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{
       RowBox[{"ReleaseHold", "[", 
        RowBox[{"#", "[", "\"\<HeldMessageCall\>\"", "]"}], "]"}], "&"}],
      Background->RGBColor[1, 0.9, 0.8]]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"stringTake", "[", 
  RowBox[{"\"\<Good string\>\"", ",", " ", "4"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"stringTake", "[", 
  RowBox[{"\"\<Short string\>\"", ",", " ", "100"}], "]"}]}], "Input",
 CellChangeTimes->{{3.982673236303377*^9, 3.9826732413162994`*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"f0e15b4f-0517-a042-abb8-d4f8ffa4e50f"],

Cell[BoxData["\<\"Good\"\>"], "Output",
