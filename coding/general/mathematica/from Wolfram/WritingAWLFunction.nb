                   RowBox[{"Hold", "[", 
                    RowBox[{"Confirm", "[", "anything", "]"}], "]"}], 
                   HoldForm], "SummaryItem"]}]}}, 
             GridBoxAlignment -> {
              "Columns" -> {{Left}}, "Rows" -> {{Automatic}}}, AutoDelete -> 
             False, GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
             GridBoxSpacings -> {"Columns" -> {{2}}, "Rows" -> {{Automatic}}},
              BaseStyle -> {
              ShowStringCharacters -> False, NumberMarks -> False, 
               PrintPrecision -> 3, ShowSyntaxStyles -> False}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}, "Rows" -> {{Top}}}, 
          AutoDelete -> False, 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
          BaselinePosition -> {1, 1}]}, 
       Dynamic[Typeset`open$$], ImageSize -> Automatic]},
     "SummaryPanel"],
    DynamicModuleValues:>{}], "]"}],
  Failure[
  "confirmnotag", <|
   "MessageTemplate" :> MessageName[Confirm, "confirmnotag"], 
    "MessageParameters" :> {Confirm}, "HeldInput" -> Hold[
      Confirm[$CellContext`anything]]|>],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
 CellChangeTimes->{3.9826733060937576`*^9},
 CellLabel->"Out[63]=",ExpressionUUID->"9b0b8c76-91a4-e644-bfef-c1058bb11820"]
}, Open  ]],

Cell[TextData[{
 "If you want to use ",
 ButtonBox["Confirm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Confirm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Confirm.html"],
 "X and ",
 ButtonBox["Enclose",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Enclose.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Enclose.html"],
 " \[OpenCurlyDoubleQuote]separately\[CloseCurlyDoubleQuote] (that is, where \
the confirmation is not directly surrounded by an ",
 ButtonBox["Enclose",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Enclose.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Enclose.html"],
 "), you will need to add (matching) tags:"
}], "Text",
 CellChangeTimes->{{3.9826735212667503`*^9, 3.9826735256750183`*^9}, 
   3.9826735790850754`*^9},ExpressionUUID->"ee00595f-6f2e-2b43-bda7-\
79238fcc8fa6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "confirmation", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"confirmation", " ", ":=", " ", 
   RowBox[{"ConfirmBy", "[", 
    RowBox[{
     RowBox[{"RandomInteger", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"#", ">=", "0"}], "&"}], ",", " ", "Null", ",", " ", 
     StyleBox["\"\<tag\>\"",
      Background->RGBColor[1, 0.9, 0.8]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Enclose", "[", 
  RowBox[{"confirmation", ",", " ", "Identity", ",", " ", 
   StyleBox["\"\<tag\>\"",
    Background->RGBColor[1, 0.9, 0.8]]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826733099919605`*^9, 
  3.9826733113851166`*^9}},ExpressionUUID->"9e2385a9-2023-414f-9d32-\
4216898bc15c"],

Cell[BoxData["3"], "Output",
 CellChangeTimes->{3.98267330780896*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"a1b178b5-6561-d447-846c-1be2c97a790d"]
