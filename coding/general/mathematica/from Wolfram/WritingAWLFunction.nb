Cell["Extending Capability", "Section",ExpressionUUID->"b9c37c25-13c8-4dd7-8b33-3b2c042d0126"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Operator Forms and Subvalues",
  FontColor->GrayLevel[0.5]]
}], "Subsection",
 CellTags->
  "Arguments-OperatorFormsAndSubValues",ExpressionUUID->"3324c056-ba4a-4178-\
933d-df2f52a5a9c4"],

Cell["\<\
Operator forms and (object) subvalues have similar syntax, but serve \
different purposes.\
\>", "Text",
 CellChangeTimes->{
  3.87043814413419*^9},ExpressionUUID->"1f8ba93e-80d7-4a15-b26f-4eeac68ffcf6"],

Cell[CellGroupData[{

Cell["Operator Forms", "Subsubsection",
 CellChangeTimes->{{3.9826717435048695`*^9, 
  3.982671743848444*^9}},ExpressionUUID->"6824b7e9-4a3c-4541-89b0-\
bf11b9d1c9ad"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Function Composition & Operator Forms",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/guide/\
FunctionCompositionAndOperatorForms.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/guide/\
FunctionCompositionAndOperatorForms.html"]
}], "Text",ExpressionUUID->"1dfa3e86-fbb1-4e55-8e9b-94b78fa97e12"],

Cell[TextData[{
 "While functions are often applied to expressions by \
\[OpenCurlyDoubleQuote]wrapping around\[CloseCurlyDoubleQuote] them, an ",
 StyleBox["operator",
  FontSlant->"Italic"],
 StyleBox[" form",
  FontSlant->"Italic"],
 " of a function (if it exists) allows it to be applied as a ",
 ButtonBox["Prefix",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Prefix.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Prefix.html"],
 ". In this respect, an operator form acts a bit like a pure function."
}], "Text",ExpressionUUID->"66976e86-cc06-4b9f-b03c-e349394214ed"],

Cell[TextData[{
 ButtonBox["Select",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Select.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Select.html"],
 ", for example, has an operator form. \nUse Select on a list in the \
\[OpenCurlyDoubleQuote]regular\[CloseCurlyDoubleQuote] way:"
}], "Text",
 CellChangeTimes->{{3.982671766641445*^9, 
  3.9826717742578526`*^9}},ExpressionUUID->"e2718e1c-ede5-4cfb-8cff-\
229275eed148"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Select", "[", 
  RowBox[{
   RowBox[{"Range", "[", "10", "]"}], ",", "EvenQ"}], "]"}]], "Input",
 CellChangeTimes->{{3.982671777244158*^9, 3.9826717977215004`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f356f9ec-c0ee-43b6-9ff6-164c798dd2d8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6", ",", "8", ",", "10"}], "}"}]], "Output",
 CellChangeTimes->{3.982671804612335*^9},
 CellLabel->"Out[1]=",
 CellID->48738004,ExpressionUUID->"a3f1b03b-47c6-c34e-8fb1-a9abaeb0b435"]
}, Open  ]],

Cell["As an operator:", "Text",
 CellChangeTimes->{{3.9826717789548664`*^9, 3.982671787410076*^9}},
 CellID->67796196,ExpressionUUID->"dd8293bc-8932-ea45-ac1f-298fc733ee59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Select", "[", "EvenQ", "]"}], "[", 
  RowBox[{"Range", "[", "10", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.982671777244158*^9, 3.982671799973587*^9}},
 CellLabel->"In[2]:=",
 CellID->719885457,ExpressionUUID->"a7149aa2-5300-4140-a216-d0ec3f1c12df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6", ",", "8", ",", "10"}], "}"}]], "Output",
 CellChangeTimes->{3.982671806204241*^9},
 CellLabel->"Out[2]=",
 CellID->167700164,ExpressionUUID->"2a528546-6b86-dd49-98ef-fa34e1bbf8eb"]
}, Open  ]],

Cell["And as a pure function:", "Text",
 CellChangeTimes->{{3.98267179202528*^9, 3.9826717943315277`*^9}},
 CellID->793607113,ExpressionUUID->"df4929d5-c856-fc4f-a16c-c6b8ffa36528"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Select", "[", 
    RowBox[{"#", ",", " ", "EvenQ"}], "]"}], "&"}], " ", "[", 
  RowBox[{"Range", "[", "10", "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.982671777244158*^9, 3.9826718022311897`*^9}},
 CellLabel->"In[3]:=",
 CellID->11878223,ExpressionUUID->"091b73d8-0336-d444-bdb5-1f3a2f7ff882"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6", ",", "8", ",", "10"}], "}"}]], "Output",
 CellChangeTimes->{3.9826718075537834`*^9},
 CellLabel->"Out[3]=",
 CellID->436614767,ExpressionUUID->"49e86642-0317-cd4c-ad91-02145ac6df55"]
}, Open  ]],

Cell["\<\
Defining an operator form of a function is very similar to defining a \
function in the usual way\[LongDash]there are just more square brackets \
involved:\
\>", "Text",ExpressionUUID->"fa6b3ff9-e042-4e77-b29a-5daa88c35dbf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "listOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"listOperator", "[", "expr1_", "]"}], "[", "expr2_", "]"}], " ", ":=",
    " ", 
   RowBox[{"List", "[", 
    RowBox[{"expr1", ",", " ", "expr2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listOperator", "[", "x", "]"}], "[", "y", "]"}]}], "Input",
 CellChangeTimes->{{3.98267187813904*^9, 3.982671878966652*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"4a3ba1b5-0e34-4e9f-9f7f-8278edb7928b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", ",", "y"}], "}"}]], "Output",
 CellChangeTimes->{3.9826720459405365`*^9},
 CellLabel->"Out[20]=",
 CellID->149535529,ExpressionUUID->"a2614089-3664-5d43-8428-38f763b9df38"]
}, Open  ]],

Cell[TextData[{
 "When a regular function is defined, the definition on the right-hand side \
of the ",
 ButtonBox["SetDelayed",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/SetDelayed.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/SetDelayed.html"],
 " symbol (",
 StyleBox[":=", "Input"],
 ") is stored as a ",
 ButtonBox["DownValue",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/DownValues.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/DownValues.html"],
 " for the function. When an operator form is defined, the definition is \
stored as a ",
 ButtonBox["SubValue",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/SubValues.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/SubValues.html"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.870438184960731*^9, {3.9826718364116974`*^9, 
   3.9826718732278423`*^9}},ExpressionUUID->"b5e7f457-a917-4ee3-9bed-\
897d4e0fe6be"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DownValues", "[", "listOperator", "]"}], "\[IndentingNewLine]", 
 RowBox[{"SubValues", "[", "listOperator", "]"}]}], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"d257ce29-14c8-4381-b345-60fe4a340cee"],

Cell[BoxData[
 RowBox[{"{", "}"}]], "Output",
 CellChangeTimes->{3.982672047179964*^9},
 CellLabel->"Out[21]=",
 CellID->378987841,ExpressionUUID->"e49bae03-c2fc-b04e-92c5-9d6cd0de1104"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{
