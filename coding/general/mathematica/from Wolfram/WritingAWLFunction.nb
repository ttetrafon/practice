  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/SyntaxInformation.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/SyntaxInformation.html"],
 "."
}], "Text",ExpressionUUID->"e0d2c405-c85c-e041-a592-0ace123c40c5"],

Cell["\<\
Specify that a function should take exactly one argument and zero options:\
\>", "Text",ExpressionUUID->"7c9d25b5-fede-2243-899c-1343bdc9c233"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SyntaxInformation", "[", "f", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<ArgumentsPattern\>\"", "->", 
     RowBox[{"{", "_", "}"}]}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"e5f43024-ccba-b84f-9e87-b232e125f90e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"1", ",", "2"}], "]"}], ";"}]}], "Input",ExpressionUUID->"f4da05df-\
8459-4b42-a729-4da4d7d54d83"],

Cell[TextData[{
 "Optional arguments can be set with the same notation seen in ",
 ButtonBox["Default",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Default.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Default.html"],
 " earlier: an underscore followed by a full stop (",
 StyleBox["_.", "Input"],
 ")."
