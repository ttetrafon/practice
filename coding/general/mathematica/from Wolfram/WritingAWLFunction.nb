Cell[TextData[{
 "Recreate the ",
 StyleBox["stringTake", "Input"],
 " function, this time returning the original string if it is too short:"
}], "Text",ExpressionUUID->"dd457ee6-6fb8-9943-b306-8eda40e6c826"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stringTake", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringTake", "[", 
    RowBox[{"string_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Check", "[", 
    RowBox[{
     RowBox[{"StringTake", "[", 
      RowBox[{"string", ",", "n"}], "]"}], ",", "string"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"stringTake", "[", 
  RowBox[{"\"\<Good string\>\"", ",", " ", "4"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"stringTake", "[", 
  RowBox[{"\"\<Short string\>\"", ",", " ", "100"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826734350958385`*^9, 3.9826734361354237`*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"97bd8a7d-a272-294f-bbb7-9a511afa8699"],

Cell[BoxData["\<\"Good\"\>"], "Output",
 CellChangeTimes->{3.982673437488867*^9},
 CellLabel->"Out[75]=",ExpressionUUID->"e71cb1c8-7e08-7d4d-bdba-b6e781fe7bd6"],

Cell[BoxData[
 TemplateBox[{
  "StringTake", "take", 
   "\"Cannot take positions \\!\\(\\*RowBox[{\\\"1\\\"}]\\) through \
\\!\\(\\*RowBox[{\\\"100\\\"}]\\) in \\\"\\!\\(\\*RowBox[{\\\"\\\\\\\"Short \
string\\\\\\\"\\\"}]\\)\\\".\"", 2, 76, 8, 20009497494273290125, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.982673437876938*^9},
 CellLabel->
  "During evaluation of \
In[73]:=",ExpressionUUID->"0aa2f951-a026-1947-bc84-be10a30ee7fc"],

Cell[BoxData["\<\"Short string\"\>"], "Output",
 CellChangeTimes->{3.982673438230238*^9},
 CellLabel->"Out[76]=",ExpressionUUID->"ae4c2371-ee32-0948-85b4-3e361b09bce7"]
}, Open  ]],

Cell[TextData[{
 ButtonBox["Check",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Check.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Check.html"],
 " is often used in conjunction with ",
 ButtonBox["Quiet",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Quiet.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Quiet.html"],
 " to quieten all messages of a certain type."
}], "Text",
 CellChangeTimes->{3.982673459108225*^9, 
  3.9826734978039246`*^9},ExpressionUUID->"dfc93f8c-ea2d-914e-b0ac-\
c45e2ab48182"],

Cell[TextData[{
 "Recreate the ",
 StyleBox["stringTake", "Input"],
 " function, this time quietening any \[OpenCurlyDoubleQuote]take\
\[CloseCurlyDoubleQuote] error messages, but allowing other messages to print:"
}], "Text",ExpressionUUID->"26e06bbb-90e5-a74c-ab0c-a603c4af5b39"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stringTake", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringTake", "[", 
    RowBox[{"string_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Check", "[", 
      RowBox[{
       RowBox[{"StringTake", "[", 
        RowBox[{"string", ",", "n"}], "]"}], ",", "string", ",", " ", 
       StyleBox[
        RowBox[{"StringTake", "::", "take"}],
        Background->RGBColor[1, 0.9, 0.8]]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{"StringTake", "::", "take"}],
      Background->RGBColor[1, 0.9, 0.8]]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"stringTake", "[", 
  RowBox[{"\"\<Good string\>\"", ",", " ", "4"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"stringTake", "[", 
  RowBox[{"\"\<Short string\>\"", ",", " ", "100"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"stringTake", "[", 
  RowBox[{"notAString", ",", " ", "1"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826734637831573`*^9, 3.982673471191681*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"d69ee591-382b-ed48-86b6-a8f7fca3a11b"],

