}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Iteration: ",
 StyleBox["Functional Iteration",
  FontColor->GrayLevel[0.5]]
}], "Subsubsection",
 CellChangeTimes->{{3.98267150723534*^9, 
  3.982671507508856*^9}},ExpressionUUID->"6bd0a92f-6c37-43ea-964a-\
4cc4de68cc6c"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Functional Iteration",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/guide/FunctionalIteration.\
html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/guide/FunctionalIteration.html"]
}], "Text",
 CellChangeTimes->{{3.870437776072176*^9, 
  3.870437776448112*^9}},ExpressionUUID->"c66c92c7-a964-4f60-acca-\
084fe7651062"],

Cell["\<\
Functional iteration is very similar to recursion and is carried out in much \
the same way: with overloading.\
\>", "Text",ExpressionUUID->"41d18dcc-e8fb-4286-8eaa-8caa0fbc7da1"],

Cell["\<\
Create a function to find the remainder after dividing one number by another:\
\>", "Text",ExpressionUUID->"9451c3c5-e2bf-45d7-b228-93d769598556"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "remainder", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"remainder", "[", 
     RowBox[{"number_", ",", " ", "modulus_"}], "]"}], " ", "/;", " ", 
    RowBox[{"Between", "[", 
     RowBox[{"number", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "modulus"}], "}"}]}], "]"}]}], " ", ":=", " ", 
   "number"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"remainder", "[", 
     RowBox[{
      RowBox[{"number_Integer", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}], ")"}]}], ",", " ", 
      RowBox[{"modulus_Integer", "?", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", ">", "0"}], "&"}], ")"}]}]}], "]"}], " ", ":=", 
    RowBox[{"remainder", "[", 
     RowBox[{
      RowBox[{"number", "-", "modulus"}], ",", " ", "modulus"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"remainder", "[", 
  RowBox[{"123456", ",", " ", "78"}], "]"}]}], "Input",ExpressionUUID->\
"f21580f3-a754-4b08-80aa-b5ac7d43022a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Alternative Solution",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870784072632024*^9, 3.870784073583921*^9}, {
  3.982671517694599*^9, 3.982671518040344*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"fd7dcafc-d0bb-4f25-b02d-3375d79c3f82"],

Cell[TextData[{
 "For this particular example, it would be better to use ",
 ButtonBox["Mod",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Mod.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Mod.html"],
 " or ",
 ButtonBox["QuotientRemainder",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/QuotientRemainder.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/QuotientRemainder.html"],
 ":"
}], "Text",ExpressionUUID->"6936a534-2e13-469f-8d8d-17d59cfe5251"],

Cell[BoxData[{
 RowBox[{"Mod", "[", 
  RowBox[{"123456", ",", " ", "78"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"QuotientRemainder", "[", 
  RowBox[{"123456", ",", " ", "78"}], "]"}]}], "Input",ExpressionUUID->\
"1c08f6a3-5ad7-48c0-949a-d38a5c19fe45"]
}, Closed]],

Cell[CellGroupData[{

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"557b96d2-7ab0-4a8b-b20d-115d13ef9b51"],

Cell["\<\
Functional iteration is easy to confuse with recursion. In functional \
iteration, the function being iterated must be the head of the expression on \
the right-hand side of the definition:\
\>", "Text",ExpressionUUID->"5b4fb0fc-d4c7-4313-afca-af78c4b938c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   TagBox[
    FrameBox["\<\"\[Ellipsis]\"\>"],
    "Placeholder"], "]"}], " ", ":=", " ", 
  RowBox[{"f", "[", 
   RowBox[{"g", "[", 
    TagBox[
     FrameBox["\<\"\[Ellipsis]\"\>"],
     "Placeholder"], "]"}], "]"}]}]], "Input",
 Evaluatable->False,ExpressionUUID->"26c6485d-06cb-4b45-a902-1d7361281ab4"],

Cell["\<\
In recursion, the function can appear anywhere on the right-hand side:\
\>", "Text",ExpressionUUID->"8de08e85-bd2d-4e49-9739-a57cdf3b7a7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   TagBox[
    FrameBox["\<\"\[Ellipsis]\"\>"],
    "Placeholder"], "]"}], " ", ":=", " ", 
  RowBox[{"g", "[", 
   RowBox[{"f", "[", 
    TagBox[
     FrameBox["\<\"\[Ellipsis]\"\>"],
     "Placeholder"], "]"}], "]"}]}]], "Input",
 Evaluatable->False,ExpressionUUID->"2790140a-ce0a-419e-ad7b-420508064edf"],

Cell[TextData[{
 "For functional iteration (but ",
 StyleBox["not",
  FontSlant->"Italic"],
 " looping constructs), the number of levels of iteration is limited by the \
value of ",
 ButtonBox["$IterationLimit",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/$IterationLimit.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/$IterationLimit.html"],
 ":"
}], "Text",ExpressionUUID->"ea760eee-8657-4f0d-9bf2-dc87e3940235"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "f", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"f", "[", 
    RowBox[{"x", "+", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"f", "[", "1", "]"}]}], "Input",ExpressionUUID->"6152c50d-0a91-4ce0-\
ac6d-4374447dc853"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"e7ad653d-2424-457d-8a64-cef9becf25c0"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"d33d5f41-4e59-4d59-a762-c8c4420b263d"],

Cell[CellGroupData[{

Cell["Extending Capability", "Section",ExpressionUUID->"06744dd1-f673-4685-9ca5-3213470553ec"],

Cell[CellGroupData[{

Cell["Memoisation", "Subsection",
 CellTags->
  "ExtendingCapability-Memoisation",ExpressionUUID->"0561b4eb-40e1-4f85-b947-\
d79d3558d89a"],

Cell[TextData[{
 StyleBox["Memoisation",
  FontSlant->"Italic"],
 " is a method of caching values to make iterative or recursive functions run \
more quickly."
}], "Text",ExpressionUUID->"b5ea7957-aff8-455c-a467-ef93bdf34996"],

Cell["Consider the recursive Fibonacci function created earlier:", "Text",ExpressionUUID->"7966d98c-eb95-4054-81aa-7d43b8d7fb38"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fibonacci", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "1", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "2", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "n_Integer", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"fibonacci", "[", 
     RowBox[{"n", "-", "1"}], "]"}], "+", 
    RowBox[{"fibonacci", "[", 
     RowBox[{"n", "-", "2"}], "]"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"5b916b4a-a8d2-43c2-8c2e-7202b8e4b661"],

Cell[TextData[{
 "In order to calculate the ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    StyleBox["\[Null]n",
     FontSlant->"Italic"], "th"], TraditionalForm]],ExpressionUUID->
  "2cf77b47-ac49-9744-a270-4c8cc382496e"],
 " Fibonacci number, it also has to calculate the result for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]],ExpressionUUID->
  "31c1b4e0-8805-9b4a-917f-e6068bc3d0ac"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "2"}], TraditionalForm]],ExpressionUUID->
  "ccb23f99-c9cc-764a-8a30-ee3e7a083f76"],
 ", \[Ellipsis], 2, making it run more slowly the larger ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "44c33b81-4497-044f-bf98-2fc4a73c24b3"],
 " gets:"
}], "Text",
 CellChangeTimes->{{3.870437827774621*^9, 
  3.870437872858553*^9}},ExpressionUUID->"5d0d2742-f668-4615-bb54-\
75ff1b68de42"],

Cell[BoxData[
 RowBox[{"RepeatedTiming", "[", 
  RowBox[{
   RowBox[{"fibonacci", "[", "30", "]"}], ";"}], "]"}]], "Input",ExpressionUUI\
D->"1fb49e70-bdf0-48ea-97f3-05654d0b8202"],

Cell["Incorporating memoisation makes the function much faster:", "Text",ExpressionUUID->"82912dc1-d73b-4b18-aedf-a7c2a3e1bfc2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fibonacci", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "1", "]"}], ":=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fibonacci", "[", "2", "]"}], ":=", "1"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fibonacci", "[", "n_", "]"}], ":=", 
    RowBox[{
     StyleBox[
      RowBox[{"fibonacci", "[", "n", "]"}],
      Background->RGBColor[1, 0.9, 0.8]], 
     StyleBox["=",
      Background->RGBColor[1, 0.9, 0.8]], 
     RowBox[{
      RowBox[{"fibonacci", "[", 
       RowBox[{"n", "-", "1"}], "]"}], "+", 
      RowBox[{"fibonacci", "[", 
       RowBox[{"n", "-", "2"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"RepeatedTiming", "[", 
  RowBox[{
   RowBox[{"fibonacci", "[", "30", "]"}], ";"}], "]"}]}], "Input",ExpressionUU\
ID->"f4c09ad4-4a26-455b-9659-a5da964e68cd"],

Cell[TextData[{
 "The catch is that all these values have to be stored somewhere, so this \
solution would not be suitable for very large ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "9bf79c14-0c69-1b4b-b0ff-dac1af901aea"],
 ":"
}], "Text",ExpressionUUID->"24a1bd62-8e20-47c9-a430-508785adf0b3"],

Cell[BoxData[
 RowBox[{"DownValues", "[", "fibonacci", "]"}]], "Input",ExpressionUUID->"c6af8ca9-fbbd-45ae-a009-3d205a098d35"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Alternative Solution",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.8707840849998293`*^9, 3.870784086119862*^9}, {
  3.982671568602787*^9, 3.9826715689597054`*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"f336be6c-95c1-46a9-af5a-964845b1ef83"],

Cell[TextData[{
 "A better solution here would be to use ",
 ButtonBox["Fibonacci",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Fibonacci.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Fibonacci.html"],
 ", which uses a formula rather than a recurrence relation:"
}], "Text",ExpressionUUID->"6d43861b-77d4-47eb-b26b-5d61e96f7fbd"],

Cell[BoxData[
 RowBox[{"Fibonacci", "[", "30", "]"}]], "Input",ExpressionUUID->"37d004a9-a11e-4ea2-a49c-38852bfdc4e0"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"3c1900ee-c5ac-4134-9c4b-62cf89b869c4"]
}, Closed]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"3f6cbe68-1f07-4e4b-8859-2fade1442cbc"],

Cell[CellGroupData[{

Cell["Extending Capability", "Section",ExpressionUUID->"a75584ea-d50c-4229-83e4-cfbc0c18567b"],

Cell[CellGroupData[{

Cell["Caching", "Subsection",
 CellTags->
  "ExtendingCapability-Caching",ExpressionUUID->"a9cdb24a-a751-4024-9996-\
847224bb2cf0"],

Cell[TextData[{
 ButtonBox["Once",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Once.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Once.html"],
 " provides a way to ",
 StyleBox["cache",
  FontSlant->"Italic"],
 " expensive or time-consuming computations:"
}], "Text",ExpressionUUID->"c34d3940-34cd-4622-9e6b-7392fc36d5c7"],

Cell[BoxData[
 RowBox[{"Once", "[", 
  RowBox[{
   RowBox[{"Pause", "[", "3", "]"}], ";", 
   RowBox[{"RandomReal", "[", "]"}]}], "]"}]], "Input",ExpressionUUID->\
"b417c1f0-13e6-4203-90a9-05f49c656966"],

Cell["\<\
For further evaluations of the same expression, only the result from the \
first evaluation is given:\
\>", "Text",ExpressionUUID->"ac32a935-3aa2-405c-b5bb-5d396cb55e0a"],

Cell[BoxData[
 RowBox[{"Once", "[", 
  RowBox[{
   RowBox[{"Pause", "[", "3", "]"}], ";", 
   RowBox[{"RandomReal", "[", "]"}]}], "]"}]], "Input",ExpressionUUID->\
"b52304ed-9c0c-4e2c-a36a-bc7099b8f8d0"],

Cell["This can be utilised in a similar way to memoisation:", "Text",ExpressionUUID->"0e1529fc-d94f-4071-9ded-23c8f2aabf7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fibonacci", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "1", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "2", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fibonacci", "[", "n_Integer", "]"}], " ", ":=", " ", 
    RowBox[{
     StyleBox["Once",
      Background->RGBColor[1, 0.9, 0.8]], 
     StyleBox["[",
      Background->RGBColor[1, 0.9, 0.8]], 
     RowBox[{
      RowBox[{"fibonacci", "[", 
       RowBox[{"n", "-", "1"}], "]"}], "+", 
      RowBox[{"fibonacci", "[", 
       RowBox[{"n", "-", "2"}], "]"}]}], 
     StyleBox["]",
      Background->RGBColor[1, 0.9, 0.8]]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"fibonacci", "[", "30", "]"}]}], "Input",ExpressionUUID->"4ee142c6-\
77c7-4aed-b6b6-26d0aa4d6e5a"],

Cell["However, once again, the values have to be stored somewhere:", "Text",ExpressionUUID->"ccaa8a2d-a4ff-45e7-ab6c-2b57b2746607"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PersistentObjects", "[", "\"\<Hashes/Once/*\>\"", "]"}], "//", 
  "Short"}]], "Input",
 CellLabel->"",ExpressionUUID->"8306d5c1-d03e-4e94-8925-96cc9d678ed4"],

Cell[TextData[{
 "They can be deleted with ",
 ButtonBox["DeleteObject",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/DeleteObject.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/DeleteObject.html"],
 ":"
}], "Text",ExpressionUUID->"bc31af23-8470-4bbc-84f5-235b29d7b882"],

Cell[BoxData[
 RowBox[{"DeleteObject", "[", 
  RowBox[{"PersistentObjects", "[", "\"\<Hashes/Once/*\>\"", "]"}], 
  "]"}]], "Input",ExpressionUUID->"0b2631ac-04e4-4d36-8b26-56ca348aaa4b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Data Structure",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870784096912506*^9, 3.870784098061963*^9}, {
  3.982671587236273*^9, 3.982671587607422*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"6373660c-5279-4af7-8c62-76989cb97b61"],

Cell[TextData[{
 "If you wish to constrain the amount of stored values, you can use the ",
 ButtonBox["data structure",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/DataStructure.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/DataStructure.html"],
 " ",
 Cell[BoxData["\"\<LeastRecentlyUsedCache\>\""], "Input",ExpressionUUID->
  "f60e0210-8fb1-2143-b19c-02f7d933d3de"],
 "."
}], "Text",ExpressionUUID->"77824195-5f3b-4d5e-9e19-684ffec559a6"],

Cell["\<\
Create a Fibonacci function that caches just the last five values:\
\>", "Text",ExpressionUUID->"c566916b-58df-478e-99a5-fbf62810c6b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"fibonacci", ",", " ", "fibCache"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibCache", "=", 
    RowBox[{"CreateDataStructure", "[", 
     RowBox[{"\"\<LeastRecentlyUsedCache\>\"", ",", "5"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "1", "]"}], " ", ":=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fibonacci", "[", "2", "]"}], " ", ":=", " ", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fibonacci", "[", "x_", "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"compute", ",", 
       RowBox[{"previous", " ", "=", 
        RowBox[{"fibCache", "[", 
         RowBox[{"\"\<Lookup\>\"", ",", "x"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"MissingQ", "[", "previous", "]"}]}], ",", 
       "\[IndentingNewLine]", "previous", ",", "\[IndentingNewLine]", 
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"compute", " ", "=", " ", 
          RowBox[{
           RowBox[{"fibonacci", "[", 
            RowBox[{"x", "-", "1"}], "]"}], "+", 
           RowBox[{"fibonacci", "[", 
            RowBox[{"x", "-", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"fibCache", "[", 
          RowBox[{"\"\<Insert\>\"", ",", 
           RowBox[{"x", "->", "compute"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "compute"}], "\[IndentingNewLine]", ")"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"856dc15c-4297-4e42-bbc2-9e452d7f5db0"],

Cell["The function is very quick:", "Text",ExpressionUUID->"141d4ee4-3e62-4241-a12a-c86c918ec658"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fibonacci", "[", "30", "]"}], "//", "RepeatedTiming"}]], "Input",Ex\
pressionUUID->"7dc8dcce-4a28-45bb-a506-8774d2cd4f6c"],

Cell["Check that only five values are being stored:", "Text",ExpressionUUID->"507eaf13-962c-4a72-a65c-04937f23600b"],

Cell[BoxData[
 RowBox[{"fibCache", "[", "\"\<Keys\>\"", "]"}]], "Input",ExpressionUUID->"2e93ecb7-d776-4868-908f-772c1de0d4f9"]
}, Open  ]],

