    URL["https://en.wikipedia.org/wiki/Scope_(computer_science)#Dynamic_\
scope"], None},
  ButtonNote->
   "https://en.wikipedia.org/wiki/Scope_(computer_science)#Dynamic_scope"],
 ". It sets up a miniature \[OpenCurlyDoubleQuote]global\
\[CloseCurlyDoubleQuote] environment in which the values of symbols can be \
temporarily reassigned. It is particularly useful for reassigning built-in \
constants."
}], "Text",ExpressionUUID->"8ee78b87-bdb1-d041-8d23-eca407e94095"],

Cell["Find the time in a different time zone:", "Text",ExpressionUUID->"767895e8-d5c4-ed44-a503-8746c882961a"],

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"$TimeZone", " ", "=", " ", "7"}], "}"}], ",", " ", 
   RowBox[{"DateString", "[", "Now", "]"}]}], "]"}]], "Input",ExpressionUUID->\
"8d22b105-efa0-8642-b1be-6df03e0e711e"],

Cell[TextData[{
 "Create a function that makes an ",
 ButtonBox["engineering guesstimation",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://en.wikibooks.org/wiki/Engineering_Guesstimations"], None},
  ButtonNote->"https://en.wikibooks.org/wiki/Engineering_Guesstimations"],
 " for the volume of a planetary body by assuming that \[Pi] = 3 and that the \
body is perfectly spherical:"
}], "Text",ExpressionUUID->"7fcc56a5-e1d8-0143-b226-94ecf15c9d25"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "planetaryVolume", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"planetaryVolume", "[", "object_", "]"}], " ", ":=", " ", 
   RowBox[{
    StyleBox["Block",
     Background->RGBColor[1, 0.9, 0.8]], 
    StyleBox["[",
     Background->RGBColor[1, 0.9, 0.8]], 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Pi", " ", "=", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"Volume", "[", 
        RowBox[{"Ball", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
          RowBox[{"object", "[", "\"\<Radius\>\"", "]"}]}], "]"}], "]"}], ",",
        " ", 
       RowBox[{"\"\<Meters\>\"", "^", "3"}]}], "]"}]}], 
    StyleBox["]",
     Background->RGBColor[1, 0.9, 0.8]]}]}], ";"}]}], "Input",
 CellLabel->"",ExpressionUUID->"8297e852-b206-c843-b430-a82511435efa"],

Cell["\<\
Estimate the volume of Jupiter and compare it to the true result:\
\>", "Text",ExpressionUUID->"75b1f1de-dc59-2c49-9a9c-bb53c8ecf3de"],

Cell[BoxData[{
 RowBox[{"planetaryVolume", "[", 
  TemplateBox[{"\"Jupiter\"", 
    RowBox[{"Entity", "[", 
      RowBox[{"\"Planet\"", ",", "\"Jupiter\""}], "]"}], 
    "\"Entity[\\\"Planet\\\", \\\"Jupiter\\\"]\"", "\"planet\""},
   "Entity"], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  TemplateBox[{"\"Jupiter\"", 
    RowBox[{"Entity", "[", 
      RowBox[{"\"Planet\"", ",", "\"Jupiter\""}], "]"}], 
    "\"Entity[\\\"Planet\\\", \\\"Jupiter\\\"]\"", "\"planet\""},
   "Entity"], "[", "\"\<Volume\>\"", "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"05180f0e-7e6c-3e45-8ba1-bedd8bffe137"]
}, Open  ]],

Cell[CellGroupData[{

Cell["DynamicModule", "Subsubsection",ExpressionUUID->"30b3211d-b709-384c-8eb6-772f4655614b"],

Cell[TextData[{
 "Tech Note: ",
 ButtonBox["Module versus DynamicModule",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
AdvancedDynamicFunctionality.html#877365235"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/\
AdvancedDynamicFunctionality.html#877365235"],
 "\nTech Note: ",
 ButtonBox["Introduction to Dynamic",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/tutorial/\
IntroductionToDynamic.html"], None},
  ButtonNote->
   "https://reference.wolfram.com/language/tutorial/IntroductionToDynamic.\
html"]
}], "Text",ExpressionUUID->"0a124744-d1ad-6443-99d2-5a0252202851"],

Cell[TextData[{
 "DynamicModule uses lexical scoping. It is what ",
 ButtonBox["Manipulate",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Manipulate.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Manipulate.html"],
 " uses behind the scenes, and as such is very useful for creating custom \
dynamic interfaces (sliders, buttons, etc.). As the name suggests, it is like \
Module, but for dynamic variables. (However, there are subtle differences\
\[LongDash]see the first Tech Note above for more details.)"
}], "Text",ExpressionUUID->"49260704-5790-3444-bcde-baa85d5a1bf3"],

Cell["\<\
Create a labelled slider with some dynamic elements and insert it into a \
dynamic interface:\
\>", "Text",ExpressionUUID->"602657ec-6f44-9446-b5e0-2b1c55b2c8fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "labelledSlider", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"labelledSlider", "[", 
     RowBox[{
      RowBox[{"Dynamic", "[", "x_", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"min_", " ", ":", " ", "0"}], ",", " ", 
        RowBox[{"max_", " ", ":", " ", "1"}]}], "}"}], ",", " ", 
      RowBox[{"label_", " ", ":", " ", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Row", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Pane", "[", 
         RowBox[{"label", ",", " ", "150", ",", " ", 
          RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Slider", "[", 
         RowBox[{
          RowBox[{"Dynamic", "[", "x", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Dynamic", "[", "x", "]"}]}], "\[IndentingNewLine]", "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"Spacer", "[", "1", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"BaseStyle", " ", "->", " ", "\"\<Text\>\""}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Interface", ":"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  StyleBox["DynamicModule",
   Background->RGBColor[1, 0.9, 0.8]], 
  StyleBox["[",
   Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", "=", "1"}], ",", " ", 
     RowBox[{"b", " ", "=", " ", "1"}], ",", " ", 
     RowBox[{"c", " ", "=", " ", "0"}], ",", " ", 
     RowBox[{"d", " ", "=", " ", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Column", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"labelledSlider", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "a", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", 
           " ", "\"\<Vertical stretch:\>\""}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"labelledSlider", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "b", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", 
           " ", "\"\<Horizontal stretch:\>\""}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"labelledSlider", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "c", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", 
           " ", "\"\<Horizontal translation:\>\""}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"labelledSlider", "[", 
          RowBox[{
           RowBox[{"Dynamic", "[", "d", "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", 
           " ", "\"\<Vertical translation:\>\""}], "]"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{
             RowBox[{"b", "*", "x"}], "+", "c"}], "]"}]}], "+", "d"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"-", "10"}], ",", " ", "10"}], "}"}], ",", " ", 
         InterpretationBox[
          DynamicModuleBox[{Typeset`open = False}, 
           TemplateBox[{"Expression", 
             StyleBox[
             "\"Plot options\"", "IconizedCustomName", StripOnInput -> False], 
             GridBox[{{
                RowBox[{
                  TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                  TagBox["Sequence", "IconizedItem"]}]}, {
                RowBox[{
                  TagBox["\"Length: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["3", "IconizedItem"]}]}, {
                RowBox[{
                  TagBox["\"Byte count: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["680", "IconizedItem"]}]}}, 
              GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
              "Column", 
              GridBoxItemSize -> {
               "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
             Dynamic[Typeset`open]},
            "IconizedObject"]],
          Sequence[PlotRange -> {10, -10}, AxesLabel -> {
             Style["x", 14, "TI"], 
             Style["y", 14, "TI"]}, ImageSize -> 500],
          SelectWithContents->True,
          Selectable->False]}], "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
    "]"}]}], "\[IndentingNewLine]", 
  StyleBox["]",
   Background->RGBColor[1, 0.9, 0.8]]}]}], "Input",ExpressionUUID->"439795f8-\
5b2f-1049-91fc-5256d64d6c48"],

Cell[TextData[{
 "Note the ",
 ButtonBox["Dynamic",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Dynamic.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Dynamic.html"],
 " wrapper in the first argument of ",
 StyleBox["labelledSlider", "Input"],
 ". This serves two purposes: first, to enable the dynamic variable to be \
\[OpenCurlyDoubleQuote]scoped\[CloseCurlyDoubleQuote] by the DynamicModule; \
second, to make it clear to the user that the first argument is dynamic \
(there is no \[OpenCurlyDoubleQuote]DynamicQ\[CloseCurlyDoubleQuote] function \
in the Wolfram Language)."
}], "Text",ExpressionUUID->"9373bc88-a47a-8649-835e-9abdc1e1cec9"],

Cell["Here\[CloseCurlyQuote]s a version of the interface using Manipulate:", \
"Text",ExpressionUUID->"9235271e-58fe-0142-9a33-ffd8765d2e0d"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{
         RowBox[{"b", "*", "x"}], "+", "c"}], "]"}]}], "+", "d"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
     InterpretationBox[
      DynamicModuleBox[{Typeset`open = False}, 
       TemplateBox[{"Expression", 
         StyleBox[
         "\"Plot options\"", "IconizedCustomName", StripOnInput -> False], 
         GridBox[{{
            RowBox[{
              TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["Sequence", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Length: \"", "IconizedLabel"], "\[InvisibleSpace]", 
              TagBox["3", "IconizedItem"]}]}, {
            RowBox[{
              TagBox["\"Byte count: \"", "IconizedLabel"], 
              "\[InvisibleSpace]", 
              TagBox["680", "IconizedItem"]}]}}, 
          GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
          "Column", 
          GridBoxItemSize -> {
           "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
         Dynamic[Typeset`open]},
        "IconizedObject"]],
      Sequence[PlotRange -> {10, -10}, AxesLabel -> {
         Style["x", 14, "TI"], 
         Style["y", 14, "TI"]}, ImageSize -> 500],
      SelectWithContents->True,
      Selectable->False]}], "\[IndentingNewLine]", "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "1", ",", "\"\<Vertical stretch\>\""}], "}"}], ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "1", ",", "\"\<Horizontal stretch\>\""}], "}"}], ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "0", ",", "\"\<Horizontal translation\>\""}], "}"}], ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", "0", ",", "\"\<Vertical translation\>\""}], "}"}], ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{
  3.982779042707348*^9},ExpressionUUID->"f03be575-7040-784a-b551-\
b3d742dbda0d"]
}, Open  ]],

