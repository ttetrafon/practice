Cell["\<\
Specify that a function should have at least one argument, but not more than \
two:\
\>", "Text",ExpressionUUID->"1c637b23-b155-2748-9371-9844c853c7cb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SyntaxInformation", "[", "f", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<ArgumentsPattern\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"_", ",", " ", "_."}], "}"}]}], "}"}]}], ";"}]], "Input",Express\
ionUUID->"5cf78fb3-91e8-f745-a225-87e0533e285c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "]"}], ";"}]], "Input",Express\
ionUUID->"42cfc0c2-0880-7f4c-a17d-7fcaf89afdc7"],

Cell["\<\
Specify that a function should take up to two arguments, plus some options:\
\>", "Text",ExpressionUUID->"40c05198-85cb-0e4a-b76c-a85412d33845"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "f", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<a\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\"\<b\>\"", " ", "->", " ", "2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SyntaxInformation", "[", "f", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"\"\<ArgumentsPattern\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"_", ",", " ", "_.", ",", " ", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "}"}]}], "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"cad5f6c3-107d-bf49-a8be-2a5bd0eeada4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"1", ",", " ", "2", ",", " ", 
    RowBox[{"\"\<c\>\"", " ", "->", " ", "3"}]}], "]"}], ";"}]], "Input",Expre\
ssionUUID->"9d2fae3d-037b-f045-83a3-3ea923ebcab7"],

Cell["\<\
SyntaxInformation may not always be able to distinguish between arguments and \
options:\
\>", "Text",ExpressionUUID->"94a7d00e-5604-d846-b3a5-b76048127bf8"],

