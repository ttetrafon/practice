Cell[TextData[{
 "However, the problem with this is that it extracts ",
 StyleBox["all",
  FontSlant->"Italic"],
 " of the data at once\[LongDash]potentially thousands or millions of data \
points. Defining ",
 StyleBox["subvalues",
  FontSlant->"Italic"],
 " for an object provides a way around this, allowing small snippets of data \
to be extracted independently."
}], "Text",
 CellChangeTimes->{
  3.8704382150795107`*^9},ExpressionUUID->"3c5da9f7-08c5-47a2-901b-\
a2383ef69e1b"],

Cell[TextData[{
 "One place they are commonly used is in ",
 ButtonBox["entities",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/guide/\
KnowledgeRepresentationAndAccess.html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/guide/\
KnowledgeRepresentationAndAccess.html"],
 ":"
}], "Text",ExpressionUUID->"c2905e17-ae16-4185-971a-58cbcfa0f41d"],

Cell[BoxData[
 RowBox[{
  TemplateBox[{"\"Jupiter\"", 
    RowBox[{"Entity", "[", 
      RowBox[{"\"Planet\"", ",", "\"Jupiter\""}], "]"}], 
    "\"Entity[\\\"Planet\\\", \\\"Jupiter\\\"]\"", "\"planet\""},
   "Entity"], "[", "\"\<Satellites\>\"", "]"}]], "Input",ExpressionUUID->\
"11c3fa3a-cc5a-46bf-b7d4-317fabe13967"],

Cell["\<\
Notice that the syntax for object subvalues is very similar to that of \
operator forms; the same can be said for how they are defined.\
\>", "Text",
 CellChangeTimes->{
  3.870438224087904*^9},ExpressionUUID->"e8d5f3e5-2ea5-40ed-9b9e-\
7a2f5e0b3d01"],

Cell["\<\
Create a function that produces an \[OpenCurlyDoubleQuote]arithmetic object\
\[CloseCurlyDoubleQuote], then define subvalues for that object to extract \
its properties:\
\>", "Text",
 CellChangeTimes->{
  3.870438248761969*^9},ExpressionUUID->"3417d810-4cf3-49b0-9ca7-\
90be7ddfe632"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"sumProd", ",", " ", "arithmeticObject"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sumProd", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{"arithmeticObject", "[", 
    RowBox[{"x", ",", " ", "y"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"arithmeticObject", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "[", "\"\<Properties\>\"", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\"\<Properties\>\"", ",", " ", "\"\<Sum\>\"", ",", 
     " ", "\"\<Product\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"arithmeticObject", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "[", "\"\<Sum\>\"", "]"}], ":=", 
   RowBox[{"x", " ", "+", " ", "y"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"arithmeticObject", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], "[", "\"\<Product\>\"", "]"}], ":=", 
   RowBox[{"x", " ", "*", " ", "y"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.982671994939663*^9, 3.9826719958759193`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"033b94fc-d341-41e4-9129-a82514fb267c"],

Cell[BoxData[
 RowBox[{"sumProd", "[", 
  RowBox[{"3", ",", " ", "4"}], "]"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"3a6a155a-cc3c-4cee-90a8-96fff265e220"],

Cell[BoxData[
 RowBox[{
  RowBox[{"arithmeticObject", "[", 
   RowBox[{"3", ",", "4"}], "]"}], "[", "\"\<Sum\>\"", "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"0458cd80-ff2d-4730-b2f1-cae361407c70"],

Cell[TextData[{
 "Note that ",
 StyleBox["arithmeticObject[x, y]", "Input"],
 " on its own does not evaluate any further. This is because ",
 StyleBox["arithmeticObject", "Input"],
 " does not have any downvalues. If it did, they would disrupt the subvalue \
definitions\[LongDash]but ",
 ButtonBox["evaluation order",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/tutorial/Evaluation.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/tutorial/Evaluation.html"],
 " is going beyond the scope of this course."
}], "Text",
 CellChangeTimes->{{3.870438254216049*^9, 
  3.870438264928206*^9}},ExpressionUUID->"c0451537-2d94-4705-aa37-\
30cae430f17c"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"f51d03ea-860a-45a0-b720-d1a4f8d45fb3"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

