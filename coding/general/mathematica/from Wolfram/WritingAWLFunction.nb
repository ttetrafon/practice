Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"c188759d-d025-a84b-8639-5c0d7e468462"],

Cell[CellGroupData[{

Cell["Useful Tips", "Section",ExpressionUUID->"4dafea00-fdf4-e340-a112-5483a044f350"],

Cell[CellGroupData[{

Cell["Progress Monitoring", "Subsection",
 CellTags->
  "ExtraTips-ProgressMonitoring",ExpressionUUID->"a88b8f89-98fb-964b-a9b7-\
19044e3e1b06"],

Cell["\<\
Even with optimal code, a function may take some time to evaluate. During \
such an evaluation, it can be reassuring to see that something is happening\
\[LongDash]or better yet, to know how long it will take to finish.\
\>", "Text",ExpressionUUID->"1dbbadf6-53a8-7b40-89e2-5cbebdf1265b"],

Cell[CellGroupData[{

Cell["Monitoring", "Subsubsection",ExpressionUUID->"2faf9fab-d907-444b-9a04-b46edc9a3b2c"],

Cell[TextData[{
 ButtonBox["Monitor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Monitor.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Monitor.html"],
 " allows you to temporarily display a dynamic object during an evaluation. A \
typical object to display is a ",
 ButtonBox["ProgressIndicator",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ProgressIndicator.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/ProgressIndicator.html"],
 ", the duration of which can be known (\[OpenCurlyDoubleQuote]determinate\
\[CloseCurlyDoubleQuote]) or unknown (\[OpenCurlyDoubleQuote]indeterminate\
\[CloseCurlyDoubleQuote])."
}], "Text",ExpressionUUID->"980a9603-5bc0-fb44-8f82-b83253a19be2"],

Cell["\<\
Create a function that returns all of the prime numbers within a range, \
displaying a (determinate) dynamic progress bar while it is running:\
\>", "Text",ExpressionUUID->"fbb60dbf-0c5f-b64b-b3cd-ac36f88796cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "primesBetween", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"primesBetween", "[", 
    RowBox[{"{", 
     RowBox[{"min_", ",", " ", "max_"}], "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", " ", "=", " ", "min"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Reap", "[", "\[IndentingNewLine]", 
       RowBox[{
        StyleBox["Monitor",
         Background->RGBColor[1, 0.9, 0.8]], 
        StyleBox["[",
         Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"While", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Between", "[", 
            RowBox[{"i", ",", " ", 
             RowBox[{"{", 
              RowBox[{"min", ",", " ", "max"}], "}"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"PrimeQ", "[", "i", "]"}], ",", " ", 
              RowBox[{"Sow", "[", "i", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"i", "++"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
         "\[IndentingNewLine]", 
         StyleBox[
          RowBox[{"ProgressIndicator", "[", 
           RowBox[{"i", ",", " ", 
            RowBox[{"{", 
             RowBox[{"min", ",", " ", "max"}], "}"}]}], "]"}],
          Background->RGBColor[1, 0.85, 0.85]]}], "\[IndentingNewLine]", 
        StyleBox["]",
         Background->RGBColor[1, 0.9, 0.8]]}], "\[IndentingNewLine]", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"c6a31e69-ccbc-454e-ab99-\
5c222e498f19"],

Cell[BoxData[
 RowBox[{"primesBetween", "[", 
  RowBox[{"{", 
   RowBox[{"0", ",", " ", 
    RowBox[{"10", "^", "6"}]}], "}"}], "]"}]], "Input",ExpressionUUID->\
"8b748fbd-7d36-c84c-a557-8158d1d3c2b8"],

Cell["\<\
Create a function that returns the birthday of a famous figure, displaying an \
indeterminate \[OpenCurlyDoubleQuote]loading necklace\[CloseCurlyDoubleQuote] \
while it is running:\
\>", "Text",ExpressionUUID->"b6c46bcf-db8b-e540-b1fd-f219baa248ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "birthday", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"birthday", "[", "person_String", "]"}], " ", ":=", 
   RowBox[{
    StyleBox["Monitor",
     Background->RGBColor[1, 0.9, 0.8]], 
    StyleBox["[",
     Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Enclose", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"With", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"personEntity", " ", "=", " ", 
           RowBox[{
            RowBox[{"Interpreter", "[", "\"\<Person\>\"", "]"}], "[", 
            "person", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"StringJoin", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Confirm", "[", 
            RowBox[{"personEntity", "[", "\"\<Name\>\"", "]"}], "]"}], ",", 
           "\[IndentingNewLine]", "\"\< (\>\"", ",", "\[IndentingNewLine]", 
           RowBox[{"StringDelete", "[", 
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{"Confirm", "[", 
               RowBox[{"personEntity", "[", "\"\<Occupation\>\"", "]"}], 
               "]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\"\<{\>\"", ",", " ", "\"\<}\>\""}], "}"}]}], "]"}], ",",
            "\[IndentingNewLine]", "\"\<) was born on \>\"", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"DateString", "[", 
            RowBox[{"Confirm", "[", 
             RowBox[{"personEntity", "[", "\"\<BirthDate\>\"", "]"}], "]"}], 
            "]"}], ",", "\[IndentingNewLine]", "\"\<.\>\""}], 
          "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Expression\>\"", "]"}], "&"}]}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{"ProgressIndicator", "[", 
       RowBox[{"Appearance", " ", "->", " ", "\"\<Necklace\>\""}], "]"}],
      Background->RGBColor[1, 0.85, 0.85]]}], "\[IndentingNewLine]", 
    StyleBox["]",
     Background->RGBColor[1, 0.9, 0.8]]}]}], ";"}]}], "Input",ExpressionUUID->\
"8d54418f-aaf2-7a48-a06e-a0645b9d144e"],

Cell[BoxData[
 RowBox[{"birthday", "[", "\"\<nicola tesla\>\"", "]"}]], "Input",ExpressionUU\
ID->"1324c25f-7772-6a42-8e70-b5fc2683f375"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Temporary Printing", "Subsubsection",
 CellChangeTimes->{{3.9827795556474113`*^9, 
  3.9827795558706226`*^9}},ExpressionUUID->"bf7d4007-b0d5-cf48-9300-\
8ca522acdb56"],

Cell[TextData[{
 ButtonBox["PrintTemporary",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/PrintTemporary.html"], 
    None},
  ButtonNote->"http://reference.wolfram.com/language/ref/PrintTemporary.html"],
 " is essentially a more basic version of Monitor."
}], "Text",ExpressionUUID->"dc6e8bd7-f001-f242-9713-8b68fab152a5"],

Cell[TextData[{
 "Create a function that temporarily prints the steps of an application\
\[CloseCurlyQuote]s build process (where, in this case, steps are mimicked \
with ",
 ButtonBox["Pause",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Pause.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Pause.html"],
 "):"
}], "Text",ExpressionUUID->"7c2f762a-a0da-6548-8ba6-5d17a36c2e7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "buildApplication", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"buildApplication", "[", "]"}], " ", ":=", " ", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "PrintTemporary", "[", "\"\<Searching for updates\[Ellipsis]\>\"", "]"}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"Pause", "[", "1", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "PrintTemporary", "[", "\"\<Downloading updates\[Ellipsis]\>\"", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Pause", "[", "1", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
     "PrintTemporary", "[", "\"\<Rendering interface\[Ellipsis]\>\"", "]"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Pause", "[", "1", "]"}], ";", 
     "\[IndentingNewLine]", "\"\<Done!\>\""}], "\[IndentingNewLine]", ")"}]}],
   ";"}]}], "Input",ExpressionUUID->"acc2f4ef-4ba9-9446-9412-b0c9857fdcd1"],

Cell[BoxData[
 RowBox[{"buildApplication", "[", "]"}]], "Input",ExpressionUUID->"e866375a-4040-e64a-a0a2-c0219af6a50f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Other Monitoring Options", "Subsubsection",
 CellChangeTimes->{{3.982779548717304*^9, 
  3.9827795528649693`*^9}},ExpressionUUID->"1559710d-cba7-bf41-ba6f-\
731dfe325b4d"],

Cell[TextData[{
 "Some functions like ",
 ButtonBox["StepMonitor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/StepMonitor.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/StepMonitor.html"],
 " and ",
 ButtonBox["EvaluationMonitor",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/EvaluationMonitor.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/EvaluationMonitor.html"],
 " have monitoring built in."
}], "Text",ExpressionUUID->"35a823e6-3d93-2347-828d-edee525204be"],

Cell[TextData[{
 "Print the steps of ",
 ButtonBox["FindRoot",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FindRoot.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FindRoot.html"],
 " as it searches for a solution:"
}], "Text",ExpressionUUID->"1605815a-0874-1543-8756-fefb9c099668"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";", " ", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "^", "2"}], "-", "2"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1"}], "}"}], ",", 
    StyleBox[
     RowBox[{"EvaluationMonitor", ":>", 
      RowBox[{"Print", "[", "x", "]"}]}],
     Background->RGBColor[1, 0.9, 0.8]]}], "]"}]}]], "Input",
 CellLabel->"",ExpressionUUID->"3da85df9-0e18-3c47-b2f2-e5eb692d3b0f"],

Cell["Sow and reap the steps in order to plot them:", "Text",ExpressionUUID->"34bb8692-0e80-a740-bfd7-bd4644c8d3a0"],

Cell[BoxData[
 RowBox[{"With", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{
      RowBox[{"Reap", "[", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "^", "2"}], "-", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "1"}], "}"}], ",", 
         RowBox[{"StepMonitor", "\[RuleDelayed]", 
          RowBox[{"Sow", "[", 
           RowBox[{"x", "-", 
            RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}]}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLogPlot", "[", 
    RowBox[{"data", ",", " ", 
     RowBox[{"Joined", " ", "->", " ", "True"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"39e59812-24e5-4840-\
81be-a328ec458d94"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["StepMonitor vs EvaluationMonitor",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"fbc62c36-b827-e64a-b24e-d88754855f89"],

Cell["To quote the documentation, StepMonitor is", "Text",ExpressionUUID->"e3f348a3-5411-384a-af8a-b29c290c4a7c"],

Cell[TextData[{
 StyleBox["\"\[Ellipsis]an option for ",
  FontSlant->"Italic"],
 StyleBox["iterative numerical computation functions",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" that gives an expression to ",
  FontSlant->"Italic"],
 StyleBox["evaluate whenever a step is taken by the numerical method used",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".\"",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"af36cfd2-8127-3f4e-a4e4-7ab9db22a547"],

Cell["while EvaluationMonitor is", "Text",ExpressionUUID->"e7af4cc6-815b-474e-9f9b-55f6d0d75b96"],

Cell[TextData[{
 StyleBox["\[OpenCurlyDoubleQuote]\[Ellipsis]an option for various ",
  FontSlant->"Italic"],
 StyleBox["numerical computation and plotting functions",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" that gives an expression to ",
  FontSlant->"Italic"],
 StyleBox["evaluate whenever functions derived from the input are evaluated \
numerically",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[".\"",
  FontSlant->"Italic"]
}], "Text",ExpressionUUID->"d27c349b-9420-154a-a1ed-3e305b6a2785"],

Cell["\<\
Generally, the expression given to EvaluationMonitor is evaluated more \
frequently than that of StepMonitor. This is easiest to show by example.\
\>", "Text",ExpressionUUID->"b7dcf75e-b925-d340-ad82-2e325a496d1c"],

Cell["Consider the following expression:", "Text",ExpressionUUID->"966e3a1f-8906-c541-81d2-e72e820f223d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "-", "1"}], ")"}], "^", "2"}], "+", 
  RowBox[{"100", "*", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"y", "-", 
      RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}]], "Input",
 Evaluatable->False,ExpressionUUID->"ebab4c0d-a7fa-0741-9476-efc7cb88e490"],

Cell[TextData[{
 "Suppose you want to minimise it for real values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "b4392d15-02ea-ae4a-b399-60be8f5058ad"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "d96b621c-b482-8f40-ad41-9d660a183a56"],
 ". Since the expression is of the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "2"], "+", 
    RowBox[{"100", " ", 
     SuperscriptBox["b", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "05006940-d3b7-e444-92ac-a8231c8dc7d3"],
 ", and anything squared is always positive, the smallest value it can be is \
0. Using Solve verifies that there is a solution in this case:"
}], "Text",ExpressionUUID->"660d10cc-e0d5-7749-9946-c54eb70fc639"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "1"}], ")"}], "^", "2"}], "+", 
     RowBox[{"100", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"y", "-", 
         RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}], "==", "0"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", "Reals"}], "]"}]], "Input",
 CellLabel->"",ExpressionUUID->"9ea13215-c0a2-ad4a-b9d9-e044db288941"],

Cell[TextData[{
 "However, suppose you did not know the minimum value you were aiming for. In \
that case, you could use ",
 ButtonBox["FindMinimum",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/FindMinimum.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/FindMinimum.html"],
 " to both find the minimum value ",
 StyleBox["and",
  FontSlant->"Italic"],
 " solve for ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "df27dbc5-7f92-b746-9731-b4a5130335bf"],
 " and ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "e0ca0a69-0c49-cf45-827c-c1c7206c4b9e"],
 ". Moreover, you could use StepMonitor and EvaluationMonitor to track how it \
arrived at its solution:"
}], "Text",
 CellChangeTimes->{{3.87044748505057*^9, 3.870447486086993*^9}},
 CellID->39726061,ExpressionUUID->"398dabe7-3cbe-2c48-8898-ca0970c52acb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", " ", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"solution", ",", " ", "monitorData"}], "}"}], " ", "=", " ", 
  RowBox[{"Reap", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"FindMinimum", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], "^", "2"}], "+", 
       RowBox[{"100", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", "0"}], "}"}]}], "}"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Initial", " ", "guesses", " ", "for", " ", "x", " ", "and", " ", 
        "y"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"StepMonitor", "\[RuleDelayed]", " ", 
       RowBox[{"Sow", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", "\"\<Steps\>\""}], "]"}]}], ",",
       "\[IndentingNewLine]", 
      RowBox[{"EvaluationMonitor", "\[RuleDelayed]", 
       RowBox[{"Sow", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", "\"\<Evaluations\>\""}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
    "_", ",", "\[IndentingNewLine]", "Rule"}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"",
 CellID->315075895,ExpressionUUID->"0b1c85fd-eedc-6f4f-b0fd-7e30eea9edb1"],

Cell["\<\
The monitored steps are a subset of the monitored evaluations:\
\>", "Text",
 CellID->166295432,ExpressionUUID->"0a91e262-f64e-af4b-ba18-5beb686f0dd5"],

Cell[BoxData[
 RowBox[{"Map", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], "^", "2"}], "+", 
       RowBox[{"100", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"x", "^", "2"}]}], ")"}], "^", "2"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "5"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotLabel", " ", "->", " ", "#"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Epilog", "\[Rule]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Green", ",", " ", 
           RowBox[{"PointSize", "[", "0.05", "]"}], ",", " ", 
           RowBox[{"Point", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}], " ", "/.", " ", 
             RowBox[{"solution", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"Yellow", ",", " ", 
           RowBox[{"PointSize", "[", "0.02", "]"}], ",", " ", 
           RowBox[{"Point", "[", 
            RowBox[{"#", "/.", "monitorData"}], "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", " ", "->", " ", "400"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", " ", "->", " ", "All"}]}], "\[IndentingNewLine]", 
     "]"}], " ", "&"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"\"\<Steps\>\"", ",", " ", "\"\<Evaluations\>\""}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellLabel->"",
 CellID->351378906,ExpressionUUID->"982d589b-8be1-8e41-80a5-f706e31fdfa2"]
}, Closed]],

Cell[CellGroupData[{

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
