Cell[CellGroupData[{

Cell["Error Handling", "Section",
 CellChangeTimes->{{3.870442056208379*^9, 
  3.8704420570759697`*^9}},ExpressionUUID->"4a170553-0849-d348-b3c5-\
44ac32ff3d23"],

Cell[CellGroupData[{

Cell["Messages", "Subsection",
 CellTags->
  "ErrorHandling-Messages",ExpressionUUID->"98109c29-198e-0e4c-a4ae-\
1a1f7dce35fe"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Messages",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/guide/Messages.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/guide/Messages.html"],
 "\n",
 "Tech Note: ",
 ButtonBox["Warnings and Messages",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/tutorial/WarningsAndMessages.\
html"], None},
  ButtonNote->
   "http://reference.wolfram.com/language/tutorial/WarningsAndMessages.html"]
}], "Text",ExpressionUUID->"7812a717-bf10-8e4c-a6f6-75a6213a9e9e"],

Cell[TextData[{
 "A very important part of error handling is explaining to the user what has \
gone wrong. This is usually done with ",
 StyleBox["error messages",
  FontSlant->"Italic"],
 " (along with good documentation)."
}], "Text",ExpressionUUID->"a0600d57-577e-2c40-9d24-ef98188ceb21"],

Cell[CellGroupData[{

Cell["Custom Messages", "Subsubsection",
 CellChangeTimes->{{3.982673946941223*^9, 
  3.982673947257992*^9}},ExpressionUUID->"d49c6cfd-0461-6f4e-9849-\
abb03e94bf96"],

Cell[TextData[{
 "A custom message can be created using ",
 ButtonBox["MessageName",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/MessageName.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/MessageName.html"],
 " (",
 StyleBox["::", "Input"],
 ") and printed with ",
 ButtonBox["Message",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Message.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Message.html"],
 ". Information within a message can be curated with template values, where \
the syntax is similar to that used in ",
 ButtonBox["StringForm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/StringForm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/StringForm.html"],
 ":"
}], "Text",ExpressionUUID->"28ba3dae-7c4d-b44f-804c-1b25ad7194f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"function", "::", "messageTag"}], " ", "=", 
   " ", "\"\<This is an error message with two template values: `1` and \
`2`.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Message", "[", 
  RowBox[{
   RowBox[{"function", "::", "messageTag"}], ",", " ", "\"\<hello\>\"", ",", 
   " ", "\"\<goodbye\>\""}], "]"}]}], "Input",
 CellLabel->"",ExpressionUUID->"1cbdbfa9-dba1-1540-84d2-5715f01862d8"],

Cell["\<\
Create a function that prints a message (unique to the input type) if the \
input is not a string:\
\>", "Text",ExpressionUUID->"4f2b37a1-a590-4443-a012-5c9c6b6430dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "stringToNum", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Messages", ":"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringToNum", "::", "num"}], " ", "=", 
   " ", "\"\<`1` is already a number.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stringToNum", "::", "badArg"}], " ", "=", 
    " ", "\"\<`1` is a `2`. It should be a string.\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringToNum", "[", "str_String", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Interpreter", "[", "\"\<SemanticNumber\>\"", "]"}], "[", "str", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringToNum", "[", 
    RowBox[{"num_", "?", "NumberQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"stringToNum", "::", "num"}], ",", " ", "num"}], "]"}], ";", 
     " ", "num"}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"stringToNum", "[", "sym_", "]"}], "/;", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"stringToNum", "::", "badArg"}], ",", " ", "sym", ",", " ", 
         RowBox[{"Head", "[", "sym", "]"}]}], "]"}], ";", "False"}], ")"}]}], 
    ":=", "\"\<dummy\>\""}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"stringToNum", "[", "\"\<twenty-two\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"stringToNum", "[", "22", "]"}], "\[IndentingNewLine]", 
 RowBox[{"stringToNum", "[", "notAStringOrNumber", "]"}]}], "Input",Expression\
UUID->"2dd4e828-8047-c044-8bc8-0581645afd2a"],

Cell[TextData[{
 "Note the different return methods used for non-string inputs. When the \
input is a number, the number itself is returned* (along with a message). \
However, if the input is anything else, the function returns unevaluated. By \
using ",
 ButtonBox["False",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/False.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/False.html"],
 " in a ",
 ButtonBox["Condition",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Condition.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Condition.html"],
 ", the dummy output will never be returned."
}], "Text",
 CellChangeTimes->{{3.870442535774885*^9, 
  3.8704425539810743`*^9}},ExpressionUUID->"5e172ef6-6080-234c-8081-\
302e2ab22406"],

Cell[TextData[{
 "*This is a fairly common approach, as is returning a failure object (such \
as $Failed) or nothing at all (",
 ButtonBox["Null",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Null.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Null.html"],
 ")."
}], "Text",
 CellChangeTimes->{
  3.8704425641412077`*^9},ExpressionUUID->"02337b74-e896-ff40-9c6f-\
83e70179b725"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Suppressing Messages", "Subsubsection",
 CellChangeTimes->{{3.9826739561899986`*^9, 
  3.9826739565015697`*^9}},ExpressionUUID->"67b7a20b-8ff5-f641-b64e-\
6e65d3908a40"],

Cell["Quiet will suppress all messages during a calculation:", "Text",ExpressionUUID->"d0a71dcc-c331-814a-b9b7-dd8a8bb24215"],

Cell[BoxData[
 RowBox[{"Quiet", "[", 
  RowBox[{"stringToNum", "/@", 
   RowBox[{"{", 
    RowBox[{"123", ",", " ", "\[FormalX]"}], "}"}]}], "]"}]], "Input",Expressi\
onUUID->"fc07ca0b-16d3-664a-b5df-af6fe5d8e15f"],

Cell["\<\
However, a \[OpenCurlyDoubleQuote]suppress everything\[CloseCurlyDoubleQuote] \
approach is generally not a good idea. A better approach is to quiet only the \
messages you want to:\
\>", "Text",ExpressionUUID->"92075f19-2bcb-3a47-b54e-f2deae217da6"],

Cell[BoxData[
 RowBox[{"Quiet", "[", 
  RowBox[{
   RowBox[{"stringToNum", "/@", 
