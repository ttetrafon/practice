  FontColor->GrayLevel[0.5]]
}], "Subsection",
 CellTags->
  "ErrorHandling-FlowControl-ExitingOnFailures",ExpressionUUID->"d1180dfc-\
e772-3941-b4b0-261e2f9c9410"],

Cell[TextData[{
 "Guide: ",
 ButtonBox["Flow Control",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/guide/FlowControl.html"], 
    None},
  ButtonNote->"https://reference.wolfram.com/language/guide/FlowControl.html"]
}], "Text",ExpressionUUID->"4d4ecc17-de02-0743-901b-47fd44a3b41b"],

Cell["\<\
An important part of error handling is catching errors before they can \
propagate to other parts of a program.\
\>", "Text",ExpressionUUID->"9b0374f8-51c4-3144-9995-78bde7d61625"],

Cell[CellGroupData[{

Cell["Confirm and Enclose", "Subsubsection",ExpressionUUID->"ffc6ab3d-4b61-8a44-8b61-1ed91be9c458"],

Cell[TextData[{
 ButtonBox["Confirm",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Confirm.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Confirm.html"],
 " and ",
 ButtonBox["Enclose",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Enclose.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Enclose.html"],
 " can be used together to abort a computation if a \
\[OpenCurlyDoubleQuote]failure object\[CloseCurlyDoubleQuote] is received by \
Confirm. Recognised failure objects include ",
 ButtonBox["Failure",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Failure.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Failure.html"],
 "[\[Ellipsis]], ",
 ButtonBox["Missing",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Missing.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Missing.html"],
 "[\[Ellipsis]], ",
 ButtonBox["$Failed",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/$Failed.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/$Failed.html"],
 ", ",
 ButtonBox["$Canceled",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/$Canceled.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/$Canceled.html"],
 " and ",
 ButtonBox["$Aborted",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/$Aborted.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/$Aborted.html"],
 "."
}], "Text",ExpressionUUID->"fc3b455a-9bf8-d448-a84e-292ef113fe43"],

Cell["\<\
Create a function that fails if a key is missing from an association:\
\>", "Text",ExpressionUUID->"04f67655-2058-9744-bda4-d01bf5c22d42"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "lookup", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lookup", "[", 
    RowBox[{"assoc_", ",", " ", "key_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Enclose", "[", 
    RowBox[{"Confirm", "[", 
     RowBox[{"Lookup", "[", 
      RowBox[{"assoc", ",", " ", "key"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"lookup", "[", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"1", " ", "->", " ", "a"}], ",", " ", 
     RowBox[{"2", " ", "->", " ", "b"}], ",", " ", 
     RowBox[{"3", " ", "->", " ", "c"}]}], "|>"}], ",", " ", "4"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9826722975560627`*^9, 3.9826722983041344`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"24ffc11d-4c23-b04f-b0a5-785b365b9d48"],

