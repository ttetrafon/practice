    URL["http://reference.wolfram.com/language/ref/NextPrime.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/NextPrime.html"],
 ":"
}], "Text",ExpressionUUID->"d8973981-db26-304c-a359-4e2eb99f2978"],

Cell[BoxData[
 RowBox[{"NextPrime", "[", 
  RowBox[{"10", "^", "12"}], "]"}]], "Input",ExpressionUUID->"a2edab5f-5097-\
184b-b853-fbe92dde54ed"]
}, Closed]],

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"c5b88122-7365-c24b-80c3-79b6e8309407"],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Additional Example",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870784208489669*^9, 3.8707842096004133`*^9}, {
  3.9826738019858894`*^9, 3.982673803609125*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"577223e6-c358-9d43-b21b-5e3785bd4750"],

Cell[TextData[{
 "Create a custom version of ",
 ButtonBox["PrimeQ",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/PrimeQ.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/PrimeQ.html"],
 " that checks all of the factors less than the square root of a number:"
}], "Text",ExpressionUUID->"e621e8b0-9dc2-ab40-ba1b-0772d08e3cd1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "primeQ", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"primeQ", "[", 
    RowBox[{"n_Integer", "?", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", ">", "3"}], "&"}], ")"}]}], "]"}], " ", ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tempDivisor", " ", "=", " ", "2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"While", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tempDivisor", " ", "<=", " ", 
         RowBox[{"Sqrt", "[", "n", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"result", " ", "=", " ", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"Divisible", "[", 
             RowBox[{"n", ",", " ", "tempDivisor"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"result", ",", " ", 
            StyleBox[
             RowBox[{"Break", "[", "]"}],
             Background->RGBColor[1, 0.9, 0.8]], ",", " ", 
            RowBox[{"tempDivisor", "++"}]}], "]"}]}], "\[IndentingNewLine]", 
         ")"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Not", "[", "result", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"primeQ", "[", "2354239", "]"}]}], "Input",
 CellChangeTimes->{{3.982673814695259*^9, 3.9826738321356106`*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"ab3bcef9-b6e5-6845-8360-7073c5547e53"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.982673832835985*^9},
 CellLabel->
  "Out[111]=",ExpressionUUID->"67eeede7-fe7e-fb48-88df-353547aeaf1b"]
}, Open  ]]
}, Closed]],

Cell["", "Subsubsubsection",
 CellFrame->{{0, 0}, {0, 1}},
 CellMargins->{{Inherited, Inherited}, {0, 0}},
 CellFrameMargins->{{0, 0}, {0, 0}},
 CellFrameStyle->GrayLevel[0.7],
 FontSize->10,ExpressionUUID->"15ec1e05-4684-f946-bc53-bee8771de28a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Continue", "Subsubsection",ExpressionUUID->"86767d3b-aa51-3d4a-9507-683e1bc49051"],

Cell[TextData[{
 ButtonBox["Continue",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Continue.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Continue.html"],
 " can be thought of as an opposite to Break. When a given criterion is met \
at a step inside a loop, instead of exiting the loop, Continue will \
\[OpenCurlyDoubleQuote]skip over\[CloseCurlyDoubleQuote] the current step and \
move onto the next one. Rather than a \[OpenCurlyDoubleQuote]single point\
\[CloseCurlyDoubleQuote] action (such as exiting a loop), Continue is better \
suited to performing an action several times."
}], "Text",ExpressionUUID->"3b88233f-a289-cd48-a797-3f5580cf8c16"],

Cell["\<\
Create a function that sums all of the (positive) odd integers less than or \
equal to a number:\
\>", "Text",ExpressionUUID->"489aa492-a745-ee4c-bcb9-ef7cfff0f079"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "oddTotal", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"oddTotal", "[", "num_", "]"}], " ", ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sum", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"EvenQ", "[", "i", "]"}], ",", " ", 
            StyleBox[
             RowBox[{"Continue", "[", "]"}],
             Background->RGBColor[1, 0.9, 0.8]]}], "]"}], ";", " ", 
          RowBox[{"(*", " ", 
           RowBox[{"Skip", " ", "every", " ", "even", " ", "integer"}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"sum", "+=", "i"}]}], "\[IndentingNewLine]", ")"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", "num"}], "}"}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", "sum"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"oddTotal", "[", "1234", " ", "]"}]}], "Input",
 CellChangeTimes->{{3.9826738515267544`*^9, 3.982673864524727*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"c840b399-f4ef-c243-a933-ee3733d4b074"],

Cell[BoxData["380689"], "Output",
 CellChangeTimes->{3.9826738678626537`*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"cbd802ed-ba68-e54b-a08c-05fa694351d2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Optional: ",
 StyleBox["Mimicking Break with Continue",
  FontColor->GrayLevel[0.5]]
}], "Subsubsubsection",
 WholeCellGroupOpener->True,
 CellFrameMargins->{{Inherited, Inherited}, {3, 3}},
 CellChangeTimes->{{3.870784218945804*^9, 3.8707842250493307`*^9}},
 Background->GrayLevel[
  0.95],ExpressionUUID->"cb480c2d-8378-f24c-9609-1d8c1b7c67de"],

Cell[TextData[{
 "Although not recommended, Continue can be used (with While) to recreate the \
",
 StyleBox["nextPrime", "Input"],
 " function:"
}], "Text",ExpressionUUID->"65e6f0d8-fb70-fc45-a3b4-246137b4cb5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "nextPrime", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nextPrime", "[", 
   RowBox[{"startingPoint_", ",", " ", "searchLength_"}], "]"}], " ", ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"i", " ", "=", " ", "startingPoint"}], ",", " ", 
      RowBox[{"j", "=", 
       RowBox[{"startingPoint", "+", "searchLength"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"i", "<", "j"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", " ", 
            RowBox[{"PrimeQ", "[", "i", "]"}]}], ",", 
           StyleBox[
            RowBox[{"Continue", "[", "]"}],
            Background->RGBColor[1, 0.9, 0.8]]}], "]"}], ";", " ", 
         RowBox[{"(*", " ", 
          RowBox[{"Skip", " ", "every", " ", "composite", " ", "number"}], 
          " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"j", "=", "i"}]}], "\[IndentingNewLine]", ")"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "j"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"nextPrime", "[", 
  RowBox[{
   RowBox[{"10", "^", "12"}], ",", " ", "100"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9826738805551777`*^9, 3.9826738966844425`*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"b6e1aa81-6e2c-ab41-ac43-44babd3a02c9"],

Cell[BoxData["1000000000039"], "Output",
 CellChangeTimes->{{3.9826738935194817`*^9, 3.982673897494114*^9}},
 CellLabel->
  "Out[120]=",ExpressionUUID->"d08de75e-ce04-7f46-a830-48912463f076"]
}, Open  ]],

Cell[TextData[{
 "Note that unlike the ",
 ButtonBox["Throw",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Throw.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Throw.html"],
 " and ",
 ButtonBox["Break",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Break.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Break.html"],
 " examples before it, this loop requires an extra parameter (",
 StyleBox["j", "Input"],
 ") to stop the loop."
}], "Text",
 CellChangeTimes->{{3.9826739136719894`*^9, 
  3.982673925766802*^9}},ExpressionUUID->"e8b0f80d-ed1f-c54a-bc54-\
97d21665e288"]
}, Open  ]],

