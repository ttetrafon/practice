Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{"data", " ", "=", " ", 
     RowBox[{
      RowBox[{
       StyleBox["Reap",
        Background->RGBColor[1, 0.9, 0.8]], 
       StyleBox["[",
        Background->RGBColor[1, 0.9, 0.8]], "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          StyleBox["Sow",
           Background->RGBColor[1, 0.9, 0.8]], 
          StyleBox["[",
           Background->RGBColor[1, 0.9, 0.8]], 
          RowBox[{"RandomReal", "[", "x", "]"}], 
          StyleBox["]",
           Background->RGBColor[1, 0.9, 0.8]]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "0", ",", " ", 
           RowBox[{"10", "^", "4"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], 
       "\[IndentingNewLine]", 
       StyleBox["]",
        Background->RGBColor[1, 0.9, 0.8]]}], "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
    ")"}], ";"}], "//", "RepeatedTiming"}]], "Input",ExpressionUUID->\
"76ea3fd5-64c3-f442-9871-b2805afa8bfe"],

Cell[TextData[{
 "(Sow and Reap work in a similar way to ",
 ButtonBox["Throw and Catch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    FrontEnd`FileName[{
      NotebookDirectory[]}, "4-CreatingFunctions_ErrorHandling.nb", 
     CharacterEncoding -> "UTF-8"], 
    "ErrorHandling-FlowControl-MoreExitOptions"}],
 ".)"
}], "Text",
 CellChangeTimes->{{3.8707848369614897`*^9, 
  3.870784836965682*^9}},ExpressionUUID->"df903c3a-1ab8-b443-84be-\
b3460c107574"],

Cell["\<\
If you prefer the style of AppendTo, use associations instead of lists. This \
is not as fast as Sow and Reap, but appends in constant time, rather than \
time proportional to the length of the data:\
\>", "Text",ExpressionUUID->"215cab73-2903-1e45-b20a-2047336ca388"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     StyleBox[
      RowBox[{"dataAssoc", "=", 
       RowBox[{"<|", "|>"}]}],
      Background->RGBColor[1, 0.9, 0.8]], ";", "\[IndentingNewLine]", 
     RowBox[{"key", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"dataAssoc", ",", 
         RowBox[{
          RowBox[{"key", "++"}], "\[Rule]", 
          RowBox[{"RandomReal", "[", "x", "]"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"10", "^", "4"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", 
     StyleBox[
      RowBox[{"data", " ", "=", " ", 
       RowBox[{"Values", "[", "dataAssoc", "]"}]}],
      Background->RGBColor[1, 0.9, 0.8]]}], "\[IndentingNewLine]", ")"}], 
   ";"}], "//", "RepeatedTiming"}]], "Input",ExpressionUUID->"468479b6-6ce0-\
f34d-a694-8d72261310e2"]
}, Closed]],

Cell[CellGroupData[{

Cell["8. Use Block or With", "Subsubsection",
 WholeCellGroupOpener->
  True,ExpressionUUID->"4e9f3825-6ee6-fb45-86bd-77b1e6e97b4a"],

Cell["Use Block or With instead of Module:", "Text",ExpressionUUID->"46bba93f-8c6f-e64f-ac12-45d6dfb98bba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", "2."}], "}"}], ",", " ", 
       RowBox[{"1", "/", "x"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"10", "^", "6"}], "}"}]}], "]"}], ";"}], "//", 
  "RepeatedTiming"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", "2."}], "}"}], ",", " ", 
       RowBox[{"1", "/", "x"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"10", "^", "6"}], "}"}]}], "]"}], ";"}], "//", 
  "RepeatedTiming"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", " ", "=", " ", "2."}], "}"}], ",", " ", 
       RowBox[{"1", "/", "x"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"10", "^", "6"}], "}"}]}], "]"}], ";"}], "//", 
  "RepeatedTiming"}]}], "Input",ExpressionUUID->"fee0e1eb-ca14-034a-bf68-\
98795a3bfb2b"]
}, Closed]],

Cell[CellGroupData[{

Cell["9. Use Stricter Pattern Matching", "Subsubsection",
 WholeCellGroupOpener->True,
 CellChangeTimes->{{3.9827791243240376`*^9, 
  3.982779133532402*^9}},ExpressionUUID->"87b007e3-cd30-c145-a2e4-\
d1c032de2b36"],

Cell["\<\
Use tighter patterns for faster searches\[LongDash]or avoid them altogether:\
\>", "Text",ExpressionUUID->"d8375d3a-5049-b642-b1f9-e2b5fc65eab4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", " ", "=", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{"1", ",", " ", "300"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Loose", " ", 
    RowBox[{"patterns", ":"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReplaceRepeated", "[", 
    RowBox[{"data", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a___", ",", " ", "b_", ",", " ", "c_", ",", " ", "d___"}], 
        "}"}], "/;", 
       RowBox[{"b", ">", "c"}]}], " ", ":>", " ", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "c", ",", " ", "b", ",", " ", "d"}], "}"}]}]}], 
    "]"}], ";"}], "//", "RepeatedTiming"}]}], "Input",ExpressionUUID->\
"3347bb55-02bc-904f-b4f0-d36600c54802"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"No", " ", "patterns", " ", "at", " ", 
    RowBox[{"all", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"flag", " ", "=", " ", "True"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"TrueQ", "[", "flag", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"flag", " ", "=", " ", "False"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"data", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", ">", " ", 
               RowBox[{"data", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"(", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"temp", " ", "=", " ", 
                 RowBox[{"data", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", 
                 " ", "temp"}], ";", "\[IndentingNewLine]", 
                RowBox[{"flag", " ", "=", " ", "True"}]}], 
               "\[IndentingNewLine]", ")"}]}], "\[IndentingNewLine]", "]"}], ",",
             "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "1", ",", " ", 
              RowBox[{
               RowBox[{"Length", "[", "data", "]"}], " ", "-", " ", "1"}]}], 
             "}"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
         ")"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "data"}], "\[IndentingNewLine]", ")"}], ";"}], "//", 
   "RepeatedTiming"}]}]], "Input",ExpressionUUID->"6ca6b0aa-da10-7c4b-951d-\
6f5c23dd631f"]
}, Closed]],

Cell[CellGroupData[{

Cell["10. Try Alternative Methods", "Subsubsection",
 WholeCellGroupOpener->True,
 CellChangeTimes->{{3.982779146812956*^9, 
  3.9827791495424232`*^9}},ExpressionUUID->"22656065-670c-0d4d-b134-\
6937a96360c9"],

Cell["\<\
If one method is not getting fast enough results, try a different one:\
\>", "Text",
 CellChangeTimes->{{3.870447390492972*^9, 
  3.8704473915998774`*^9}},ExpressionUUID->"b6864b78-91b8-e14d-8afe-\
802ee25ff425"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"temp", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"temp", " ", "=", " ", 
        RowBox[{"temp", "*", "i"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"2", "^", "16"}]}], "}"}]}], "\[IndentingNewLine]", "]"}], ";",
      "\[IndentingNewLine]", "temp"}], "\[IndentingNewLine]", ")"}], ";"}], "//",
   "RepeatedTiming"}]], "Input",ExpressionUUID->"e94eea8a-08fc-324e-b873-\
56ac861e1c2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Apply", "[", "\[IndentingNewLine]", 
    RowBox[{"Times", ",", "\[IndentingNewLine]", 
     RowBox[{"Range", "[", 
      RowBox[{"2", "^", "16"}], "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
  "//", "RepeatedTiming"}]], "Input",ExpressionUUID->"76f616d2-c60b-4143-8bf8-\
f2058d3ab0c1"]
}, Closed]]
}, Open  ]]
}, Open  ]],

