  3.870447263655973*^9}},ExpressionUUID->"6dfbf2ed-2911-bf44-8b8b-\
332a227d2551"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Det", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        StyleBox["1",
         Background->RGBColor[1, 0.9, 0.8]], "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Abs", "[", 
           RowBox[{"i", "-", "j"}], "]"}]}], ")"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "100"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "100"}], "}"}]}], "]"}], "]"}], 
    "]"}], ";"}], "//", "RepeatedTiming"}]], "Input",ExpressionUUID->\
"6d16fd60-e36d-e347-a838-4c958c0e6f12"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"N", "[", 
    RowBox[{"Det", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        StyleBox["1.",
         Background->RGBColor[1, 0.9, 0.8]], "/", 
        RowBox[{"(", 
