Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"69e04dac-5d4d-0f41-8277-79bf1266bcbf"],

Cell[CellGroupData[{

Cell["Useful Tips", "Section",ExpressionUUID->"f0e81825-6f9a-fc46-b553-4f0d04d7d0ab"],

Cell[CellGroupData[{

Cell["Common Pitfalls", "Subsection",
 CellChangeTimes->{{3.8704462305141068`*^9, 3.870446231553648*^9}},
 CellTags->
  "ExtraTips-CommonPitfalls",ExpressionUUID->"802c177c-22e4-7543-87a9-\
bcdb86ca5b95"],

Cell["\<\
In no particular order, here are some final tips and things to be aware of \
when writing a function.\
\>", "Text",
 CellChangeTimes->{{3.870447733753003*^9, 
  3.8704477359815683`*^9}},ExpressionUUID->"54f93d13-a05f-6643-b452-\
be5dfba52b08"],

Cell[CellGroupData[{

Cell["Overloading", "Subsubsection",ExpressionUUID->"2686f3a7-abba-5044-8bcb-c812ea45a0d4"],

Cell[TextData[{
 "Use overloading rather than a branching function (",
 ButtonBox["If",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/If.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/If.html"],
 ", ",
 ButtonBox["Which",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Which.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Which.html"],
 ", ",
 ButtonBox["Switch",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Switch.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Switch.html"],
 ", \[Ellipsis])."
}], "Item",
 CellChangeTimes->{{3.870447763895852*^9, 3.870447763900692*^9}, {
  3.870448745656988*^9, 
  3.870448774284854*^9}},ExpressionUUID->"a1d51315-5997-834e-84b2-\
029521eb7818"],

Cell["\<\
When overloading, be careful about the ordering of function definitions. For \
custom functions with multiple definitions, the Wolfram Language will check \
for the more specific definitions before going to the generic definition. \
When the generality of definitions is not determined, the Wolfram Language \
will store and try definitions in the order that the definitions were created.\
\>", "Item",ExpressionUUID->"956da7f4-6a79-2547-a751-fef733c18724"],

Cell["Include a catch-all definition.", "Item",ExpressionUUID->"61c05790-9e91-c749-a79c-a2b5acef4024"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Error Catching", "Subsubsection",
 CellChangeTimes->{{3.9827792004272766`*^9, 
  3.982779200773632*^9}},ExpressionUUID->"576e4ba4-8069-8942-bb05-\
bcc81aa0ad2a"],

Cell["Catch errors as early as possible.", "Item",ExpressionUUID->"ef11afdc-d806-ce4a-8b82-88b91d493821"],

Cell[CellGroupData[{

Cell["\<\
If using branching functions, supply default values and ensure that all tests \
give Boolean results (True or False):\
\>", "Item",ExpressionUUID->"a4a8151d-f123-bd42-b1b5-719bc084f2a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   StyleBox[
    RowBox[{"TrueQ", "[", 
     RowBox[{"x", ">", "0"}], "]"}],
    Background->RGBColor[1, 0.9, 0.8]], ",", " ", "1", ",", " ", "2"}], 
  "]"}]}], "Input",ExpressionUUID->"fb83e70e-61f4-dd47-a22c-f946b7e97cb6"],

Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"x", ">", "0"}], ",", " ", "1", ",", " ", "2", ",", " ", 
   StyleBox["defaultValue",
    Background->RGBColor[1, 0.9, 0.8]]}], "]"}]], "Input",ExpressionUUID->\
"af496c4b-a1fb-6c46-8e32-718485b51c81"],

Cell[BoxData[
 RowBox[{"Which", "[", 
  RowBox[{
   StyleBox[
    RowBox[{"TrueQ", "[", 
     RowBox[{"x", ">", "0"}], "]"}],
    Background->RGBColor[1, 0.9, 0.8]], ",", " ", "a", ",", " ", 
   StyleBox[
    RowBox[{"TrueQ", "[", 
     RowBox[{"x", "<", "0"}], "]"}],
    Background->RGBColor[1, 0.9, 0.8]], ",", " ", "b", ",", " ", 
   StyleBox["True",
    Background->RGBColor[1, 0.9, 0.8]], 
   StyleBox[",",
    Background->RGBColor[1, 0.9, 0.8]], 
   StyleBox[" ",
    Background->RGBColor[1, 0.9, 0.8]], 
   StyleBox["defaultValue",
    Background->RGBColor[1, 0.9, 0.8]]}], "]"}]], "Input",ExpressionUUID->\
"277b04a8-56af-3549-9daf-ba0fc9a704f2"],

Cell[BoxData[
 RowBox[{"Switch", "[", 
  RowBox[{"x", ",", " ", 
   StyleBox[
    RowBox[{"_", "?", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"#", ">", "0"}], "]"}], "&"}], ")"}]}],
    Background->RGBColor[1, 0.9, 0.8]], ",", " ", "a", ",", " ", 
   StyleBox[
    RowBox[{"_", "?", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"#", "<", "0"}], "]"}], "&"}], ")"}]}],
    Background->RGBColor[1, 0.9, 0.8]], ",", " ", "b", ",", " ", 
   StyleBox["_",
    Background->RGBColor[1, 0.9, 0.8]], 
   StyleBox[",",
    Background->RGBColor[1, 0.9, 0.8]], 
   StyleBox[" ",
    Background->RGBColor[1, 0.9, 0.8]], 
   StyleBox["defaultValue",
    Background->RGBColor[1, 0.9, 0.8]]}], "]"}]], "Input",ExpressionUUID->\
"089c5de9-d8db-5449-9bc9-1d8758f9665d"]
}, Open  ]],

Cell["\<\
Use default argument/option values to ensure that a function always evaluates.\
\>", "Item",ExpressionUUID->"d02da658-78ee-5c40-978d-2c1ccf5ad8d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Function Choice", "Subsubsection",
 CellChangeTimes->{{3.9827792036700153`*^9, 
  3.982779203956953*^9}},ExpressionUUID->"796a4ca9-bd91-054c-9aa8-\
2ed1b7786be8"],

Cell[TextData[{
 "Use ",
 ButtonBox["Do",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Do.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Do.html"],
 ", ",
 ButtonBox["Table",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Table.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Table.html"],
 ", etc. instead of ",
 ButtonBox["For",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/For.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/For.html"],
 "."
}], "Item",
 CellChangeTimes->{{3.8704478360501623`*^9, 3.8704478360538273`*^9}, {
  3.870447871070015*^9, 
  3.870447893687315*^9}},ExpressionUUID->"a0e1a060-e623-4b49-a4b0-\
f3a0599ed2db"],

Cell["\<\
When modifying lists, use Sow and Reap instead of Append, AppendTo, etc.\
\>", "Item",ExpressionUUID->"ca4d0430-5279-8549-90ee-65e51dedcc6b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Use ",
 ButtonBox["Replace",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Replace.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Replace.html"],
 " with a level specification instead of ",
 ButtonBox["ReplaceAll",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/ReplaceAll.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/ReplaceAll.html"],
 ":"
}], "Item",ExpressionUUID->"ee2cf584-0baa-124f-bbc0-022a43ba0e70"],

Cell[BoxData[
 RowBox[{"ReplaceAll", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "a"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", "a", "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "a", ",", " ", "a"}], "}"}], "}"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "->", " ", "b"}], "}"}]}], "]"}]], "Input",ExpressionUUI\
D->"27435d38-57a8-0a4a-b532-ec52b14b0528"],

Cell[BoxData[
 RowBox[{"Replace", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "a"}], "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", "a", "}"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "a", ",", " ", "a"}], "}"}], "}"}]}], "}"}], ",",
    " ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "->", " ", "b"}], "}"}], ",", " ", 
   StyleBox[
    RowBox[{"{", "3", "}"}],
    Background->RGBColor[1, 0.9, 0.8]]}], "]"}]], "Input",ExpressionUUID->\
"6125db1b-6f8b-2649-b986-0171deaf5d6d"]
}, Open  ]],

Cell[TextData[{
 "Do not use ",
 ButtonBox["Return",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Return.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Return.html"],
 "."
}], "Item",
 CellChangeTimes->{{3.870447918712633*^9, 
  3.87044792085503*^9}},ExpressionUUID->"0b0cbd4c-940f-304d-92c6-\
4e3844776a3a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Use ",
 ButtonBox["Cases",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/Cases.html"], None},
  ButtonNote->"http://reference.wolfram.com/language/ref/Cases.html"],
 " and ",
 ButtonBox["Select",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Select.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Select.html"],
 " properly:"
}], "Item",
 CellChangeTimes->{{3.870447951046855*^9, 
  3.870447951050703*^9}},ExpressionUUID->"993dc44c-a8c3-8b42-aa77-\
d775e96d6868"],

Cell["If your test is a function, you should use Select.", "Subitem",ExpressionUUID->"a672c03e-d81d-6946-805a-1c8ae0f56d7d"],

Cell["If your test is a pattern, you should use Cases.", "Subitem",ExpressionUUID->"5c89087a-2420-7e42-b827-ee632cb79de9"],

Cell["\<\
If you need to change/transform the elements while extracting them, you \
should use Cases.\
\>", "Subitem",ExpressionUUID->"9ab22315-48d4-1c4c-b90f-78e7202d0729"],

Cell["\<\
If it can be a mix of a pattern and a test function, Cases is better.\
\>", "Subitem",ExpressionUUID->"c9314404-0116-de45-a8d7-99bd923523d0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Code Writing", "Subsubsection",
 CellChangeTimes->{{3.982779207532444*^9, 
  3.9827792078768597`*^9}},ExpressionUUID->"38ecc1d3-1ba8-334f-ad4f-\
3483b5c84100"],

Cell["\<\
If working on a large project, use an IDE to manage your code.\
\>", "Item",ExpressionUUID->"a93e82a4-7c78-1344-9935-872148e4e1b4"],

Cell["\<\
Generally, readable code is preferred over slightly faster/more compact code.\
\>", "Item",
 CellChangeTimes->{{3.870447961362185*^9, 
  3.870447962314577*^9}},ExpressionUUID->"001c36e4-98b8-8741-a272-\
a67b43161fef"],

Cell["\<\
Format your code: use white space; use new lines; choose a spacing convention \
(tabs or spaces) and stick with it.\
\>", "Item",ExpressionUUID->"f2fc6284-9e7c-c34d-8a6f-8b6026ea671b"],

Cell["Comment your code!", "Item",ExpressionUUID->"bcfb02a0-8d6f-c64a-8af1-03784d4481dc"],

Cell["\<\
Give your functions usage and error messages (and, if relevant, \
documentation).\
\>", "Item",ExpressionUUID->"42c9a7a1-66a1-ca48-bafc-d1f2e3e372e9"],

Cell["Localise variables.", "Item",ExpressionUUID->"e234628e-c9c7-2247-934f-5da48319a6c5"],

Cell[TextData[{
 "Use full symbol names instead of shorthand (e.g. ",
 StyleBox["Map", "Input"],
 " instead of ",
 StyleBox["/@", "Input"],
 ")."
}], "Item",ExpressionUUID->"37b9852e-f538-b54e-a7a5-ea5c18e9f3d8"],

Cell[TextData[{
 "Use parentheses for clarity (especially when pattern matching or writing a ",
 ButtonBox["CompoundExpression",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["http://reference.wolfram.com/language/ref/CompoundExpression.html"], 
    None},
  ButtonNote->
   "http://reference.wolfram.com/language/ref/CompoundExpression.html"],
 ")."
}], "Item",ExpressionUUID->"ef08a768-9992-c348-abb6-abaab6aa45aa"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"b30c6351-c8a4-de45-9c9c-e6dbba83cf2b"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"b96deacd-f418-864c-a5ca-d9d71970355d"],

Cell[CellGroupData[{

Cell["Course Summary", "Section",
 CellTags->
  "CourseSummary",ExpressionUUID->"b3968b71-3863-8541-b529-4523b1c40eae"],

Cell["\<\
Creating a basic function is easy; creating a function that is flexible, \
robust, intuitive and powerful is not. In this course, you have learned about:\
\>", "Text",ExpressionUUID->"6f7ebbfb-20a5-e64d-b778-7901c1119975"],

Cell[TextData[{
 "Function structure: qualities of a good function, common practices, ",
 StyleBox["pure functions",
  FontColor->GrayLevel[0.5]]
}], "Item",ExpressionUUID->"1c270d5e-95ec-0b47-b133-d997fd417a80"],

Cell[TextData[{
 "Argument structure: implementation, restriction (pattern matching), \
optional arguments, default values, ",
 StyleBox["operator forms",
  FontColor->GrayLevel[0.5]],
 ", ",
 StyleBox["subvalues",
  FontColor->GrayLevel[0.5]]
}], "Item",
 CellChangeTimes->{
  3.870447996141437*^9},ExpressionUUID->"e60045fe-0db0-b245-9cf5-\
fe7c8396face"],

Cell["\<\
Option structure: implementation, restriction, duplication, filtering\
\>", "Item",ExpressionUUID->"a69ff379-8a0c-b244-bc31-a1ff1ac940ef"],

Cell["\<\
Coding methods: overloading, recursion and iteration, memoisation, caching, \
upvalues\
\>", "Item",ExpressionUUID->"65356f70-ad50-184d-8eb4-1cfcb98c6a69"],

Cell[TextData[{
 "Error handling: flow control, messages, ",
 StyleBox["testing",
  FontColor->GrayLevel[0.5]],
 ", ",
 StyleBox["debugging",
  FontColor->GrayLevel[0.5]]
}], "Item",ExpressionUUID->"b1dd0463-ae5d-394f-8c3b-b3818a3d9648"],

Cell[TextData[{
 "Localisation, syntax information, attributes, progress monitoring, \
information extraction, ",
 StyleBox["speed and efficiency",
  FontColor->GrayLevel[0.5]]
}], "Item",ExpressionUUID->"01db46ef-e937-3348-9c45-f8f20906deec"],

Cell[BoxData[""], "EndOfSlide",ExpressionUUID->"5bd6a564-c592-f845-a4a7-9f9794f676b7"]
}, Open  ]]
}, Open  ]]
