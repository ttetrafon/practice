Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"a8bf4cd9-2a4f-422c-a267-dc8802f21b3d"],

Cell[CellGroupData[{

Cell["Wolfram Language Syntax basics", "Section",
 CellChangeTimes->{{3.7057433247967978`*^9, 
  3.70574333247925*^9}},ExpressionUUID->"273a8a04-f393-42be-9aed-\
480ef305163d"],

Cell["\<\
All commands, functions, data, etc. can be entered like this...\
\>", "Text",
 CellChangeTimes->{{3.643626002838129*^9, 3.643626036252493*^9}, {
  3.64362661222541*^9, 3.64362662820795*^9}, {3.708232421535839*^9, 
  3.7082324424370403`*^9}, {3.708232510871917*^9, 
  3.708232513976687*^9}},ExpressionUUID->"20cbb4c1-2a46-4876-8367-\
084f98811e74"],

Cell["Head[argument1, argument2 ...]", "Program",
 CellChangeTimes->{{3.643626633773725*^9, 3.6436266725537653`*^9}},
 FontSize->24,ExpressionUUID->"bfa48598-1b0e-4dbb-8a18-ef7c281b3bca"],

Cell[CellGroupData[{

Cell["The Head.", "Item",
 CellChangeTimes->{{3.643626999515953*^9, 
  3.643627007610347*^9}},ExpressionUUID->"ba37738c-f6d6-4f1c-9e71-\
aed46fa532e3"],

Cell["\<\
The head describes what the function does (eg Classify) or what the data \
represents (e.g. Image). All the words are capitalised, a format called \
CamelCase.\
\>", "Subitem",
 CellChangeTimes->{{3.643626729189237*^9, 3.643626756051059*^9}, {
  3.643626865722381*^9, 3.6436268766069927`*^9}, {3.643626980483158*^9, 
  3.643626982963078*^9}, {3.708232402051193*^9, 3.708232403151475*^9}, {
  3.7082324501772327`*^9, 
  3.708232498462878*^9}},ExpressionUUID->"1168849c-8488-42bc-a345-\
beb2f833968f"]
}, Open  ]],

Cell["Square brackets.", "Item",
 CellChangeTimes->{{3.643626999515953*^9, 
  3.643627031298973*^9}},ExpressionUUID->"8afaffd0-a7da-446e-b4f9-\
28e874236222"],

Cell["Comma separated arguments.", "Item",
 CellChangeTimes->{{3.643626999515953*^9, 
  3.643627042081168*^9}},ExpressionUUID->"7916e577-c684-4aaf-9c97-\
262eef199e84"],

Cell["\<\
Data is grouped together with braces { } e.g. {1,2,3,...} or for x-y pairs \
{{1,2},{2,4},{3,5},...}\
\>", "Item",
 CellChangeTimes->{{3.643626999515953*^9, 3.643627042081168*^9}, {
  3.705844128231406*^9, 
  3.705844180769655*^9}},ExpressionUUID->"d8ab8767-5c69-43f8-b58c-\
52ed4a6d789e"],

Cell["\<\
Key-value data is grouped with an arrow \[Rule] typed with minus and greater \
eg. \[OpenCurlyDoubleQuote]Name\[CloseCurlyDoubleQuote]->\
\[CloseCurlyDoubleQuote]Jon\[CloseCurlyDoubleQuote]\
\>", "Item",
 CellChangeTimes->{{3.643626999515953*^9, 3.643627042081168*^9}, {
  3.705844128231406*^9, 3.7058442308135357`*^9}, {3.713151911116496*^9, 
  3.713151925851261*^9}},ExpressionUUID->"1bd99bbb-6f54-462b-a2bc-\
6f14e840120c"],

Cell[TextData[{
 "The final part of an expression is how to evaluate it!  You must press ",
 StyleBox["\[ShiftKey]\[EnterKey]",
  FontSize->24],
 StyleBox[" ",
  FontSize->18],
 "to evaluate the cell."
}], "Text",
 CellChangeTimes->{{3.643627127135009*^9, 3.643627166380925*^9}, 
   3.705750359488958*^9},ExpressionUUID->"abd8f5f2-9305-4315-b6db-\
c3d9c7236205"]
}, Open  ]]
}, Open  ]],

