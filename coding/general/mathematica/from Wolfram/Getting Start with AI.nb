Cell[CellGroupData[{

Cell["Neural Network design", "Section",
 CellChangeTimes->{{3.7056683164503183`*^9, 3.7056683304220867`*^9}, {
  3.705743460191803*^9, 
  3.7057434614856243`*^9}},ExpressionUUID->"fc4ff85c-398a-49ab-a972-\
26d78196feda"],

Cell["\<\
Neural networks are layers of regression that feed into each other in a way \
that mimics the architecture of the brain.

There is a language of primitives that you can use to build the networks.\
\>", "Text",
 CellChangeTimes->{{3.705669306285787*^9, 
  3.7056693640995197`*^9}},ExpressionUUID->"93586082-5be1-46bd-b848-\
5675d912dbe0"],

