Cell[CellGroupData[{

Cell["Working with neural networks", "Section",
 CellChangeTimes->{{3.7056683164503183`*^9, 3.7056683304220867`*^9}, {
  3.705743460191803*^9, 3.7057434614856243`*^9}, {3.7057517235203867`*^9, 
  3.705751732215665*^9}},ExpressionUUID->"2f966bc8-903c-4214-a68c-\
621d7f88fa8d"],

Cell["\<\
Key idea: NeuralNetworks can be represented as a symbolic graph where each \
layer holds fixed information about the layer type, inputs and outputs, and \
trainable weights. We can manipulate this expression like any other symbolic \
object.
Training with data just optimizes the weights in the object.\
\>", "Text",
 CellChangeTimes->{{3.705827595515319*^9, 3.7058276786866827`*^9}, {
  3.705827796940016*^9, 3.705827802044407*^9}, {3.708236674701982*^9, 
  3.7082366942659492`*^9}},ExpressionUUID->"a8dc2835-75a3-464f-b26e-\
cf90a573ae2d"],

Cell[CellGroupData[{

Cell["Retraining", "Subsection",
