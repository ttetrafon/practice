Cell[CellGroupData[{

Cell["Other Data Visualizations", "Section",ExpressionUUID->"b7ec12e8-0016-407b-a543-7f9b0392278c"],

Cell["\<\
There are many other types of visualizations\[LongDash]some are quite \
specialized. The US Baby Names dataset does not warrant using these types, \
but they are included for reference here.\
\>", "Text",ExpressionUUID->"677232d3-9210-4ee4-9837-bd8aabe20d8d"],

Cell["\<\
You can see how each figure is generated in the \
\[OpenCurlyDoubleQuote]Generate Figures\[CloseCurlyDoubleQuote] section. \
Hovering the mouse over the function name in the Function column of the table \
will give an example of each plot.\
\>", "Text",ExpressionUUID->"92a3fc62-dac4-4144-bd28-ad650e58a110"],

Cell[CellGroupData[{

Cell["Code to Generate Figure Tooltips", "Subsection",ExpressionUUID->"40f300a9-7cfd-43da-9351-ad4d5bbcd07c"],

Cell[CellGroupData[{

Cell["1D", "Subsubsection",ExpressionUUID->"0820494e-1b63-41a5-9675-286ec11440ee"],

