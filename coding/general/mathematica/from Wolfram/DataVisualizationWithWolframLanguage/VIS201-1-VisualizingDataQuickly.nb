       RowBox[{"GroupBy", "[", "\"\<Name\>\"", "]"}]}], ",", 
      RowBox[{"All", "/*", "Total"}], ",", "\"\<Number\>\""}], "]"}]}], ";"}],
   "*)"}]], "Input",ExpressionUUID->"5eea86fb-7560-4d8c-a767-4e2b77aa1006"],

