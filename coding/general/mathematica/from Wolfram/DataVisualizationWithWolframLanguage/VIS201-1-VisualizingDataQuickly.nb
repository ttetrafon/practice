Cell["\<\
Tabular can be thought of as an optimized form of a list of associations, \
where each row consists of an association whose keys are column names. \
\>", "Text",ExpressionUUID->"a4ea6c3c-d216-f74e-8f35-a45e97c4a67f"],

Cell["\<\
Typically, each column represents a variable and each row represents a \
measurement.\
\>", "Item",ExpressionUUID->"7ceca700-5ab6-8741-ab76-2d3392be211b"],

Cell["\<\
Each column is usually of a homogeneous type such as number, category, string \
or date.\
\>", "Item",ExpressionUUID->"1b603393-f491-194f-9c8e-8475f898f021"],

Cell["Data entries can be missing.", "Item",ExpressionUUID->"6fffef3a-6c98-5640-99d9-0db5a2b51c15"],

Cell[TextData[{
 "You can convert to Tabular from Dataset using ",
 ButtonBox["ToTabular",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/ToTabular.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/ToTabular.html"],
 ":"
}], "Text",ExpressionUUID->"10173ffa-cd6f-ae47-9475-dac2886e5b4c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"titanicDS", " ", "=", " ", 
   RowBox[{"ExampleData", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Dataset\>\"", ",", "\"\<Titanic\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Head", "[", "titanicDS", "]"}]}], "Input",
 CellLabel->
  "In[324]:=",ExpressionUUID->"0fb86627-200e-0648-86c7-c447ae1851d4"],

Cell[BoxData[{
 RowBox[{"titanicTabular", " ", "=", " ", 
  RowBox[{"ToTabular", "[", 
   RowBox[{"titanicDS", ",", "\"\<Dataset\>\""}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Head", "[", "titanicTabular", "]"}]}], "Input",
 CellLabel->
  "In[353]:=",ExpressionUUID->"29af81c5-daaf-f049-90d3-aabe187a2e16"],

Cell[TextData[StyleBox["Visualization functions can work directly with \
Tabular data.",
 FontWeight->"Plain"]], "Text",ExpressionUUID->"c51e2f7e-1235-c74d-8018-\
63905a640729"],

Cell[TextData[{
 "For example, view a histogram of the ages of the people on the ",
 StyleBox["Titanic",
  FontSlant->"Italic"],
 " using the \[OpenCurlyDoubleQuote]Titanic\[CloseCurlyDoubleQuote] data \
represented as a Tabular object:"
}], "Text",ExpressionUUID->"486c1f79-35e6-7941-b25c-8071de775ecd"],

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  RowBox[{"titanicTabular", "->", "\"\<age\>\""}], "]"}]], "Input",
 CellLabel->
  "In[355]:=",ExpressionUUID->"aacbae6d-d91a-a341-b184-4028cac51a3b"],

Cell[TextData[{
 "Functions like ",
 ButtonBox["Select",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Select.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Select.html"],
 " work seamlessly on Tabular:"
}], "Text",ExpressionUUID->"5a72abd0-75d0-a84a-bcb5-0cb9d23ff291"],

Cell[BoxData[
 RowBox[{"PairedHistogram", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"titanicTabular", ",", 
      RowBox[{
       RowBox[{"#survived", "===", "True"}], "&"}]}], "]"}], 
    "->", "\"\<age\>\""}], ",", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{"titanicTabular", ",", 
      RowBox[{
       RowBox[{"#survived", "===", "False"}], "&"}]}], "]"}], 
    "->", "\"\<age\>\""}]}], "]"}]], "Input",
 CellLabel->
  "In[360]:=",ExpressionUUID->"fea05621-1042-c548-bc10-223617b6f1b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Obtaining Tabular: Import", "Section",ExpressionUUID->"6286e158-5ea9-ac4e-8599-63444db4c3c3"],

Cell["\<\
A very common data file format is comma-separated values (CSV).\
\>", "Text",ExpressionUUID->"1b7e26b6-7593-c34c-8b22-0c0eb3e4d323"],

Cell["Such formats can be imported directly into a Tabular object:", "Text",ExpressionUUID->"94978284-b604-c140-8e7c-894dcd4c96dd"],

Cell[BoxData[
 RowBox[{"trees", " ", "=", " ", 
  RowBox[{"Import", "[", 
   RowBox[{"\"\<ExampleData/TreesOwnedByTheCityOfChampaign.csv\>\"", 
    ",", "\"\<Tabular\>\""}], "]"}]}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"0a442e26-d270-1840-be6d-c6436636d13a"],

Cell["The data can still be imported in CSV format:", "Text",ExpressionUUID->"6fbed90b-5917-d54e-8435-dfc169f24ca0"],

Cell[BoxData[
 RowBox[{"listData", " ", "=", " ", 
  RowBox[{
  "Import", "[", "\"\<ExampleData/TreesOwnedByTheCityOfChampaign.csv\>\"", 
   "]"}]}]], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"cb98c89b-4696-2644-a228-d65881ebfba6"],

Cell["Importing data as a Tabular object is generally faster:", "Text",ExpressionUUID->"75aca438-40c2-7045-bb47-e407c57b963e"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Import time with Tabular\>\"", ",", 
       RowBox[{
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{"Import", "[", 
           
           RowBox[{"\"\<ExampleData/TreesOwnedByTheCityOfChampaign.csv\>\"", 
            ",", "\"\<Tabular\>\""}], "]"}], ";"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Import time with CSV\>\"", ",", 
       RowBox[{
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{
          RowBox[{
          "Import", 
           "[", "\"\<ExampleData/TreesOwnedByTheCityOfChampaign.csv\>\"", 
           "]"}], ";"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"Alignment", "->", "Left"}], ",", 
   RowBox[{"Frame", "->", "All"}]}], "]"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"2a307467-5a97-8b48-b4ae-7ebea97af109"],

Cell["\<\
While importing Tabular content is much faster than importing CSV content, \
the Tabular object is more memory efficient as well:\
\>", "Text",ExpressionUUID->"04bf5181-92b2-8346-98f8-55d147fd6b45"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"ByteCount", "[", "trees", "]"}], ",", " ", 
   RowBox[{"ByteCount", "[", "listData", "]"}]}], "}"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"49418273-598e-004d-8976-8908f56055aa"],

Cell["\<\
The fast importing and memory efficiency make Tabular ideal when working with \
gigabytes of data or more. \
\>", "Text",ExpressionUUID->"3f771610-4008-064e-9a08-42a68541c099"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tabular: Workflow Example", "Section",ExpressionUUID->"dbf8c608-f227-9349-95a5-42f65844d485"],

Cell["\<\
In this example, the trees of the city of Champaign, Illinois, will be \
visualized on a map.\
\>", "Text",ExpressionUUID->"679728cf-a677-2b4a-a498-9fbbee9454e0"],

Cell["\<\
To test out a workflow quickly, it is often useful to try it out on a small \
subset of the data:\
\>", "Text",ExpressionUUID->"626a8230-702e-5641-99c0-5301d47dd896"],

Cell[BoxData[
 RowBox[{"st", " ", "=", " ", 
  RowBox[{"trees", "[", 
   RowBox[{"[", 
    RowBox[{"1", ";;", "10"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"b3b713fc-ed39-4946-b3f6-1f23f96a735e"],

Cell["\<\
The location of a string is given as a latitude and longitude pair. \
\>", "Text",ExpressionUUID->"295b2186-4afb-9549-b444-6555767d03e3"],

Cell[TextData[{
 "New columns of a Tabular object can easily be transformed or modified using \
",
 ButtonBox["TransformColumns",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/TransformColumns.html"], 
    None},
  ButtonNote->
   "https://reference.wolfram.com/language/ref/TransformColumns.html"],
 ":"
}], "Text",ExpressionUUID->"6fbfc8fe-02c3-e74c-89fd-fba7289b1b49"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"top1", " ", "=", " ", 
   RowBox[{"TransformColumns", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<lat\>\"", ",", "\"\<lon\>\""}], "}"}], "->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"StringSplit", "[", 
        RowBox[{"#Location", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<(\>\"", ",", "\"\<,\>\"", " ", ",", "\"\<)\>\""}], 
          "}"}]}], "]"}], "&"}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"st1", " ", "=", " ", 
  RowBox[{"top1", "[", "st", "]"}]}]}], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"bc73e262-ea59-ac40-a271-6678e3b28c6c"],

Cell[TextData[{
 "Use ",
 ButtonBox["Cast",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Cast.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Cast.html"],
 " to convert the strings to machine reals:"
}], "Text",ExpressionUUID->"5eb4a699-8573-6f48-9bd2-cac4a33b904a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"top2", " ", "=", " ", 
   RowBox[{"TransformColumns", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<lat\>\"", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Cast", "[", 
          RowBox[{"#lat", ",", "\"\<MachineReal\>\""}], "]"}], "&"}], ")"}]}],
       ",", 
      RowBox[{"\"\<lon\>\"", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Cast", "[", 
           RowBox[{"#lon", ",", "\"\<MachineReal\>\""}], "]"}]}], "&"}], 
        ")"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"st2", " ", "=", " ", 
  RowBox[{"top2", "[", "st1", "]"}]}]}], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"d7218cb4-a6ef-d746-8964-80bb9a1ccac3"],

Cell["Combine the strings to make geo coordinates:", "Text",ExpressionUUID->"7ad4ff61-ab32-fb48-8238-acd943b42ff3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"top3", " ", "=", " ", 
   RowBox[{"TransformColumns", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<gpos\>\"", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#lat", ",", " ", "#lon"}], "}"}], "&"}], ")"}]}], ",", " ", 
      RowBox[{"\"\<lat\>\"", "->", "Nothing"}], ",", 
      RowBox[{"\"\<lon\>\"", "->", "Nothing"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"st3", " ", "=", " ", 
  RowBox[{"top3", "[", "st2", "]"}]}]}], "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"cc25c3e1-3d49-184a-967b-b61427c96a4f"],

Cell[TextData[{
 "Extract the coordinates and make a ",
 ButtonBox["GeoPosition",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/GeoPosition.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/GeoPosition.html"],
 " from them:"
}], "Text",ExpressionUUID->"3ae219e3-e1a2-314b-b9ae-3cb48dc88ca2"],

Cell[BoxData[
 RowBox[{"geopos", " ", "=", " ", 
  RowBox[{"GeoPosition", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{"st3", "[", 
     RowBox[{"All", ",", "\"\<gpos\>\""}], "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"ee9bafaf-c522-b64c-a386-dd013adc5b89"],

Cell["Show the trees as points on a map of Champaign:", "Text",ExpressionUUID->"fb571d23-3b32-6c43-ab83-6557d6f60f6a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"champ", " ", "=", " ", 
   RowBox[{"Entity", "[", 
    RowBox[{"\"\<City\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Champaign\>\"", ",", "\"\<Illinois\>\"", 
       ",", "\"\<UnitedStates\>\""}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"GeoGraphics", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"GeoPolygon", "[", "champ", "]"}], ",", "Red", ",", 
    RowBox[{"Point", "[", "geopos", "]"}]}], "}"}], "]"}]}], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"d9523d4e-7ae0-694a-ab36-5fbfb4964d97"],

Cell["\<\
With the proof of concept working, perform these operations on the full \
dataset:\
\>", "Text",ExpressionUUID->"2b7879e9-f527-7d4c-b932-4f14454cd2eb"],

Cell[BoxData[
 RowBox[{"geopos", " ", "=", " ", 
  RowBox[{"GeoPosition", "[", 
   RowBox[{"Normal", "[", 
    RowBox[{"Part", "[", 
     RowBox[{
      RowBox[{"top3", "@", 
       RowBox[{"top2", "@", 
        RowBox[{"top1", "@", "trees"}]}]}], ",", "All", ",", "\"\<gpos\>\""}],
      "]"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"417fe17d-3649-174f-b34b-7a4d5fa99fea"],

Cell["\<\
Visualize all of the trees in the city of Champaign, Illinois, on a map:\
\>", "Text",ExpressionUUID->"a12f6b12-1e26-1a48-b780-a528ac385ea8"],

Cell[BoxData[
 RowBox[{"GeoGraphics", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"GeoPolygon", "[", "champ", "]"}], ",", 
     RowBox[{"Darker", "[", "Green", "]"}], ",", 
     RowBox[{"Point", "[", "geopos", "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"GeoBackground", "->", "\"\<VectorMarketing\>\""}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"c03152bd-e09b-774f-a840-da045375ee28"],

Cell[TextData[Cell[BoxData[
 DynamicModuleBox[{WolframUTools`Private`cyuOpen$$ = False}, 
  DynamicBox[ToBoxes[
    Grid[
     Join[{{
        Button[
         Mouseover[
          TextCell[
           Framed[
            Style["Check Your Understanding", "CYUButton"], RoundingRadius -> 
            5, FrameMargins -> {{18, 18}, {15, 15}}, ImageSize -> Automatic, 
            BaseStyle -> "Text"], "CYUButton"], 
          TextCell[
           Framed[
            Style["Check Your Understanding", "CYUButton"], RoundingRadius -> 
            5, FrameMargins -> {{18, 18}, {15, 15}}, ImageSize -> Automatic, 
            BaseStyle -> "Text"], "CYUButtonActive"]], (
         WolframUTools`Private`cyuOpen$$ = 
         Not[WolframUTools`Private`cyuOpen$$])& , Appearance -> None, 
         Evaluator -> Automatic, Method -> "Preemptive"]}}, 
      If[WolframUTools`Private`cyuOpen$$, {{
         Framed[
          Column[{
            TextCell[
            "What are the main advantages of using Tabular data compared to \
CSV data?", "Text"], 
            DynamicModule[{WolframUTools`Private`qState = None}, 
             RadioButtonBar[
              Dynamic[WolframUTools`Private`qState], {1 -> Dynamic[
                 Column[
                  If[WolframUTools`Private`qState === 1, {
                    TextCell["Faster import", "Text", FontColor -> RGBColor[
                    Rational[4, 9], 0, 0], FontWeight -> Bold], 
                    TextCell[
                    "Correct: However, there are other correct answers as \
well.", "Text", FontColor -> RGBColor[
                    Rational[2, 3], 0, 0]]}, {
                    TextCell["Faster import", "Text"]}], 
                  BaselinePosition -> {1, 1}, Spacings -> 0]], 2 -> Dynamic[
                 Column[
                  If[WolframUTools`Private`qState === 2, {
                    TextCell[
                    "Data storage is more memory efficient.", "Text", 
                    FontColor -> RGBColor[
                    Rational[4, 9], 0, 0], FontWeight -> Bold], 
                    TextCell[
                    "Correct: However, there are other correct answers as \
well.", "Text", FontColor -> RGBColor[
                    Rational[2, 3], 0, 0]]}, {
                    TextCell[
                    "Data storage is more memory efficient.", "Text"]}], 
                  BaselinePosition -> {1, 1}, Spacings -> 0]], 3 -> Dynamic[
                 Column[
                  If[WolframUTools`Private`qState === 3, {
                    TextCell[
                    "Only Tabular can handle data of different types.", 
                    "Text", FontColor -> RGBColor[
                    Rational[4, 9], 0, 0], FontWeight -> Bold], 
                    TextCell[
                    "Incorrect: CSV files can handle data of different types \
as well.", "Text", FontColor -> RGBColor[
                    Rational[2, 3], 0, 0]]}, {
                    TextCell[
                    "Only Tabular can handle data of different types.", 
                    "Text"]}], BaselinePosition -> {1, 1}, Spacings -> 0]], 4 -> 
               Dynamic[
                 Column[
                  If[WolframUTools`Private`qState === 4, {
                    TextCell["All of the above", "Text", FontColor -> RGBColor[
                    Rational[4, 9], 0, 0], FontWeight -> Bold], 
                    TextCell[
                    "Incorrect: At least one of the above answers is \
incorrect.", "Text", FontColor -> RGBColor[
                    Rational[2, 3], 0, 0]]}, {
                    TextCell["All of the above", "Text"]}], 
                  BaselinePosition -> {1, 1}, Spacings -> 0]], 5 -> Dynamic[
                 Column[
                  If[WolframUTools`Private`qState === 5, {
                    TextCell["Only A and B", "Text", FontColor -> RGBColor[0, 
                    Rational[4, 9], 0], FontWeight -> Bold], 
                    TextCell[
                    "Correct: The main advantage of using Tabular is that \
data is imported faster and stored more efficiently.", "Text", FontColor -> 
                    RGBColor[0, 
                    Rational[2, 3], 0]]}, {
                    TextCell["Only A and B", "Text"]}], 
                  BaselinePosition -> {1, 1}, Spacings -> 0]]}, Appearance -> 
              "Vertical", BaselinePosition -> Automatic], 
             DynamicModuleValues :> {}]}], FrameStyle -> Directive[
            GrayLevel[0.92], 
            Thickness[Large]], RoundingRadius -> 0, Background -> 
          GrayLevel[0.97], FrameMargins -> 15]}}, {}]], Spacings -> 2, 
     Alignment -> {Left, Baseline}, ItemSize -> Scaled[1], BaseStyle -> 
     "Text"], StandardForm],
   ImageSizeCache->{859., {21.959640502929688`, 29.192062377929688`}}],
