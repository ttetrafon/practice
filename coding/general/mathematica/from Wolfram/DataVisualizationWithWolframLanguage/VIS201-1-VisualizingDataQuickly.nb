Notebook[{

Cell[CellGroupData[{
Cell["Visualizing Data Quickly", "Subtitle",ExpressionUUID->"f0edfea8-3000-4771-adb4-5e080b7b8383"],

Cell[CellGroupData[{

Cell["Learning Objectives", "Section",ExpressionUUID->"a97f34a4-babe-4547-8f90-f67ece348d5f"],

Cell[CellGroupData[{

Cell["Visualization as a tool for understanding data", "Subsubsection",ExpressionUUID->"9e1a66a1-1f1e-4c21-8c3d-31b40f5215f0"],

Cell["\<\
Data comes in many forms. Examining numbers, categories, geolocations or \
dates is often less effective than looking at well-organized visualizations \
of the data.\
\>", "Text",ExpressionUUID->"76fe1e5f-2554-4dbc-b279-7c910faae26a"],

Cell["Quickly show trends and other correlations", "Item",ExpressionUUID->"301299fb-10f3-44bc-86aa-78767bcb69e4"],

Cell["Emphasize units and differences in scale", "Item",ExpressionUUID->"a2e0e307-9971-4e93-bc0c-4ac636531cec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Choosing the right data visualization function", "Subsubsection",ExpressionUUID->"099468d0-7c98-4cd9-bf8e-9a6e83c617a4"],

Cell["\<\
For every data structure, there is a corresponding visualization function. \
These include:\
\>", "Text",ExpressionUUID->"e03f0bad-fe9d-4c6f-9c4b-9bc9c496ec8f"],

Cell["Scatter plots", "Item",ExpressionUUID->"3112c5fc-8f77-43cc-b55b-f0d244a71423"],

Cell["Charts and histograms", "Item",ExpressionUUID->"13f468e7-8427-4a7f-a89e-d7fd2721a882"],

Cell["Time series visualizations", "Item",ExpressionUUID->"1fa85221-3b00-4a13-b61a-fd086abfc6e5"],

Cell["Tables", "Item",ExpressionUUID->"cc02be1f-4fb3-4ae5-a777-e32c0aa5f38f"],

Cell["Geographic visualizations", "Item",ExpressionUUID->"c9f7a506-a3cf-40b2-8109-818885487f7b"],

Cell["and more\[Ellipsis]", "Item",ExpressionUUID->"7591efb8-f101-4e90-9623-5e8a37af10c3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example Data: US Baby Names by State", "Section",ExpressionUUID->"be59ef5b-1e2f-4978-87a4-4063fb8076d7"],

Cell[TextData[{
 "All of the examples use a curated dataset from the ",
 ButtonBox["Wolfram Data Repository",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://datarepository.wolframcloud.com/"], None},
  ButtonNote->"https://datarepository.wolframcloud.com/"],
 ":"
}], "Text",ExpressionUUID->"ec35903c-5db8-4c93-9c79-4e95e34f9233"],

