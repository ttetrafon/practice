Cell[BoxData[{
 RowBox[{
  RowBox[{"rank1changes", "=", 
   RowBox[{"genderlessTop50perYear", "[", 
    RowBox[{
     RowBox[{"All", "/*", "Normal", "/*", 
      RowBox[{"GroupBy", "[", 
       RowBox[{"Last", "\[Rule]", "First"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"#Rank", "\[Equal]", "1"}], "&"}], "]"}], "/*", "First"}], 
     ",", "\"\<Name\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rank1changes", "=", 
   RowBox[{
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "x", "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Interval", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"DateObject", "[", 
              RowBox[{"{", 
               RowBox[{"Min", "[", "#", "]"}], "}"}], "]"}], ",", 
             RowBox[{"DateObject", "[", 
              RowBox[{"{", 
               RowBox[{"Max", "[", "#", "]"}], "}"}], "]"}]}], "}"}], "]"}], 
          "&"}], "/@", 
         RowBox[{"Split", "[", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#2", "-", "#1"}], "\[Equal]", "1"}], "&"}]}], "]"}]}]}],
        "]"}], ",", "rank1changes"}], "]"}], "//", "Normal"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[6]:=",ExpressionUUID->"d048e317-a83a-4e13-9b58-f61dce48994b"],

