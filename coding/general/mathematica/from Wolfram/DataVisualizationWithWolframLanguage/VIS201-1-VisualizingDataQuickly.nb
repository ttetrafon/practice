Cell[CellGroupData[{

Cell["2D", "Subsubsection",ExpressionUUID->"a84f4913-86f4-4905-8477-30dd3644686f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"listPolarPlot", "=", 
   RowBox[{"ListPolarPlot", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", 
        RowBox[{"Log", "[", "n", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "500"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"histogram3D", "=", 
   RowBox[{"Histogram3D", "[", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"500", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"smoothHistogram3D", "=", 
   RowBox[{"SmoothHistogram3D", "[", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"500", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"smoothDensityHistogram", "=", 
   RowBox[{"SmoothDensityHistogram", "[", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", "1"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"500", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorChart", "=", 
    RowBox[{"SectorChart", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "3"}], "}"}]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"connect", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t0_", ",", "t1_"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"r0_", ",", "r1_"}], "}"}]}], "}"}], ",", "r___"}], "]"}], ":=", 
   RowBox[{"Line", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"lastVertex", ",", 
       RowBox[{"lastVertex", "=", 
        RowBox[{"r1", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "t1", "]"}], ",", 
           RowBox[{"Sin", "[", "t1", "]"}]}], "}"}]}]}]}], "}"}], "}"}], 
    "]"}]}], ";", 
  RowBox[{"data", "=", 
   RowBox[{"{", 
    RowBox[{"50", ",", "30", ",", "60", ",", "40", ",", "30"}], "}"}]}], ";", 
  RowBox[{"labels", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Vitamin A\>\"", ",", "\"\<Protein\>\"", ",", "\"\<Niacin\>\"",
      ",", "\"\<Thiamin\>\"", ",", "\"\<Vitamin C\>\""}], "}"}]}], ";", 
  RowBox[{"options", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"SectorOrigin", "\[Rule]", "0"}], ",", 
     RowBox[{"ChartLayout", "\[Rule]", "\"\<Stacked\>\""}], ",", 
     RowBox[{"ChartBaseStyle", "\[Rule]", "Thick"}], ",", 
     RowBox[{"PolarAxes", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"ChartStyle", "\[Rule]", "Black"}], ",", 
     RowBox[{"ChartElementFunction", "\[Rule]", "connect"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<Food M\>\""}]}], "}"}]}], ";", 
  RowBox[{"radarChart", "=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lastVertex", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Last", "[", "data", "]"}], ",", "0"}], "}"}]}], ",", 
       RowBox[{"llen", "=", 
        RowBox[{"Length", "[", "labels", "]"}]}]}], "}"}], ",", 
     RowBox[{"SectorChart", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "d"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "data"}], "}"}]}], "]"}], ",", 
       RowBox[{"PolarTicks", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", " ", "2", 
               RowBox[{"Pi", "/", "llen"}]}], ",", 
              RowBox[{"labels", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "llen"}], "}"}]}], "]"}], ",", 
          "Automatic"}], "}"}]}], ",", 
       RowBox[{"PolarGridLines", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"i", "-", "1"}], ")"}], "2", 
             RowBox[{"Pi", "/", "llen"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "llen"}], "}"}]}], "]"}], ",", "Automatic"}], 
         "}"}]}], ",", "options"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listStreamPlot", "=", 
   RowBox[{"ListStreamPlot", "[", 
