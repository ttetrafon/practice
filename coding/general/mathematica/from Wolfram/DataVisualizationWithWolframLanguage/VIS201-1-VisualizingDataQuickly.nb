"Subsection"]], "Text",ExpressionUUID->"6fc335b2-a276-4239-a6ab-0b643617d857"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"names", "=", 
    RowBox[{"raw", "[", 
     RowBox[{
      RowBox[{"GroupBy", "[", 
       RowBox[{"#Name", "&"}], "]"}], "/*", "Keys"}], "]"}]}], ";"}], 
  "*)"}]], "Input",ExpressionUUID->"78ff9a7a-467d-4aca-be0f-55f812867b15"],

Cell[TextData[StyleBox["Top 50 names per year", "Subsection"]], "Text",ExpressionUUID->"341fb2a3-360b-4f04-ac93-2741c3ab5b29"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"d6", "=", 
    RowBox[{"raw", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"GroupBy", "[", 
        RowBox[{"#Year", "&"}], "]"}], "/*", "KeySort"}], ",", 
      RowBox[{
       RowBox[{"GroupBy", "[", 
        RowBox[{"#Name", "&"}], "]"}], "/*", 
       RowBox[{"TakeLargest", "[", 
        RowBox[{"UpTo", "[", "50", "]"}], "]"}]}], ",", 
      RowBox[{"Total", "/*", "Sort"}], ",", "\"\<Number\>\""}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
   RowBox[{"genderlessTop50perYear", "=", 
    RowBox[{"d6", "[", 
     RowBox[{"All", ",", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"i", ">", "50"}], ",", 
            RowBox[{"i", "=", "1"}]}], "]"}], ";", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{
            RowBox[{"{", 
             
             RowBox[{"\"\<Name\>\"", ",", "\"\<Number\>\"", 
              ",", "\"\<Rank\>\""}], "}"}], ",", 
            RowBox[{"List", "[", 
             RowBox[{"#1", ",", "#2", ",", 
              RowBox[{"i", "++"}]}], "]"}]}], "]"}]}], ")"}], "&"}], "]"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "*)"}]], "Input",ExpressionUUID->\
"f0ecf8d6-d81a-420b-93af-ae971f39f78a"],

