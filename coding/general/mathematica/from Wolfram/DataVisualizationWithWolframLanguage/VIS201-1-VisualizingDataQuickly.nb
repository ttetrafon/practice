Cell[TextData[{
 "The raw data has been preloaded and stored in files. While you ",
 StyleBox["can",
  FontSlant->"Italic"],
 " uncomment the code below and get the data that way, you have already taken \
the time to download it along with these notebooks, so there is little point \
in duplicating the effort."
}], "Text",ExpressionUUID->"c15d2c1b-551a-434a-aca5-01f8afdafce8"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"raw", "=", 
    RowBox[{"ResourceData", "[", "\"\<U.S. Baby Names By State\>\"", "]"}]}], 
   ";", "\n", 
   RowBox[{"Length", "[", "raw", "]"}]}], "*)"}]], "Input",ExpressionUUID->\
"6bbeafac-50f2-41ba-b0ca-5b46d844cf90"],

Cell["\<\
The raw data consists of a geolocation (state), category (gender), date \
(year), category (name) and value (number of people). For this course, \
relevant subsets of this raw data have been filtered and stored in separate \
files in the interest of time. The code to generate the individual datasets \
is located at the end of this module.\
\>", "Text",ExpressionUUID->"5508c07f-e3c7-4dfc-9910-e3f2433956fc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Organizing a Table of Data: Dataset", "Section",ExpressionUUID->"32c1ce2f-5b0b-4577-a31a-f6a36c3e1de5"],

Cell[TextData[{
 ButtonBox["ResourceData",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/ResourceData.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/ResourceData.html"],
 " comes in the form of a ",
 ButtonBox["Dataset",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://reference.wolfram.com/language/ref/Dataset.html"], None},
  ButtonNote->"https://reference.wolfram.com/language/ref/Dataset.html"],
 ". This already provides a nice way to visualize tabular data:"
}], "Text",ExpressionUUID->"7db38a6a-ce95-4cb4-9c89-0a5a0ca0eb04"],

Cell[BoxData[
 RowBox[{
  RowBox[{"raw", "=", 
   TagBox[
    TagBox[
     DynamicModuleBox[{TypeSystem`NestedGrid`PackagePrivate`$state$$ = <|
      "InitialData" -> {<|
         "State" -> Entity[
           "AdministrativeDivision", {"Minnesota", "UnitedStates"}], "Gender" -> 
          "Female", "Year" -> DateObject[{2015}, "Year", "Gregorian", -5.], 
          "Name" -> "Jemma", "Number" -> Quantity[6, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Arkansas", "UnitedStates"}], "Gender" -> 
          "Male", "Year" -> DateObject[{1918}, "Year", "Gregorian", -5.], 
          "Name" -> "Charles", "Number" -> Quantity[349, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Maryland", "UnitedStates"}], "Gender" -> 
          "Female", "Year" -> DateObject[{1985}, "Year", "Gregorian", -5.], 
          "Name" -> "Katelyn", "Number" -> Quantity[37, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Georgia", "UnitedStates"}], "Gender" -> 
          "Female", "Year" -> DateObject[{1997}, "Year", "Gregorian", -5.], 
          "Name" -> "Montana", "Number" -> Quantity[15, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Illinois", "UnitedStates"}], "Gender" -> 
          "Male", "Year" -> DateObject[{1968}, "Year", "Gregorian", -5.], 
          "Name" -> "Carlos", "Number" -> Quantity[142, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Mississippi", "UnitedStates"}], 
          "Gender" -> "Female", "Year" -> 
          DateObject[{1988}, "Year", "Gregorian", -5.], "Name" -> "Brittni", 
          "Number" -> Quantity[9, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Alabama", "UnitedStates"}], "Gender" -> 
          "Male", "Year" -> DateObject[{2010}, "Year", "Gregorian", -5.], 
          "Name" -> "Kevin", "Number" -> Quantity[65, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Texas", "UnitedStates"}], "Gender" -> 
          "Female", "Year" -> DateObject[{1972}, "Year", "Gregorian", -5.], 
          "Name" -> "Ivonne", "Number" -> Quantity[11, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Pennsylvania", "UnitedStates"}], 
          "Gender" -> "Female", "Year" -> 
          DateObject[{1973}, "Year", "Gregorian", -5.], "Name" -> "Shana", 
          "Number" -> Quantity[22, "People"]|>, <|
         "State" -> Entity[
           "AdministrativeDivision", {"Washington", "UnitedStates"}], 
          "Gender" -> "Female", "Year" -> 
          DateObject[{1978}, "Year", "Gregorian", -5.], "Name" -> "Davina", 
          "Number" -> Quantity[7, "People"]|>}, "AllowEmbedding" -> True, 
       "InitialShape" -> 
       TypeSystem`PackageScope`HeaderShape[<|{All, "State"} -> 
          1, {All, "Gender"} -> 1, {All, "Year"} -> 1, {All, "Name"} -> 
          1, {All, "Number"} -> 1|>, 
         TypeSystem`PackageScope`Limited[
          TypeSystem`PackageScope`ColumnShape[
           TypeSystem`PackageScope`Limited[
            
            TypeSystem`PackageScope`RowShape[<|
             "State" -> TypeSystem`PackageScope`AtomShape[150], "Gender" -> 
              TypeSystem`PackageScope`AtomShape[63.], "Year" -> 
              TypeSystem`PackageScope`AtomShape[75], "Name" -> 
              TypeSystem`PackageScope`AtomShape[78.4], "Number" -> 
              TypeSystem`PackageScope`AtomShape[75]|>], 
            DirectedInfinity[1], 5, {All}]], 10, 
          DirectedInfinity[1], {}]], "InitialType" -> TypeSystem`Vector[
         TypeSystem`Struct[{"State", "Gender", "Year", "Name", "Number"}, {
           TypeSystem`Atom[
            Entity["AdministrativeDivision"]], 
           TypeSystem`Atom[
            TypeSystem`Enumeration["Female", "Male"]], 
           TypeSystem`Atom[DateObject], 
           TypeSystem`Atom[String], 
           TypeSystem`Atom[
            Quantity[1, "People"]]}], 10], "Meta" -> <||>, "RowTarget" -> 20, 
       "ColumnTarget" -> 10, "Shape" -> 
       TypeSystem`PackageScope`HeaderShape[<|{All, "State"} -> 
          1, {All, "Gender"} -> 1, {All, "Year"} -> 1, {All, "Name"} -> 
          1, {All, "Number"} -> 1|>, 
         TypeSystem`PackageScope`Limited[
          TypeSystem`PackageScope`ColumnShape[
           TypeSystem`PackageScope`Limited[
            
            TypeSystem`PackageScope`RowShape[<|
             "State" -> TypeSystem`PackageScope`AtomShape[150], "Gender" -> 
              TypeSystem`PackageScope`AtomShape[63.], "Year" -> 
              TypeSystem`PackageScope`AtomShape[75], "Name" -> 
              TypeSystem`PackageScope`AtomShape[78.4], "Number" -> 
              TypeSystem`PackageScope`AtomShape[75]|>], 
            DirectedInfinity[1], 5, {All}]], 10, 
          DirectedInfinity[1], {}]], "Type" -> TypeSystem`Vector[
         TypeSystem`Struct[{"State", "Gender", "Year", "Name", "Number"}, {
           TypeSystem`Atom[
            Entity["AdministrativeDivision"]], 
           TypeSystem`Atom[
            TypeSystem`Enumeration["Female", "Male"]], 
           TypeSystem`Atom[DateObject], 
           TypeSystem`Atom[String], 
           TypeSystem`Atom[
            Quantity[1, "People"]]}], 10], "Path" -> {}, "DisplayedRowCount" -> 
       10, "DisplayedColumnCount" -> 5, "DataRowCount" -> 10, 
       "DataColumnCount" -> 5, "SortPaths" -> {}, "SortDirections" -> {}, 
       "HiddenItemsMap" -> Null, "UpdateType" -> 1|>, 
      TypeSystem`NestedGrid`PackagePrivate`$outputID$$, 
      TypeSystem`NestedGrid`PackagePrivate`$path$$ = {}, 
      TypeSystem`NestedGrid`PackagePrivate`$vPos$$ = 1, 
      TypeSystem`NestedGrid`PackagePrivate`$hPos$$ = 1, 
      TypeSystem`NestedGrid`PackagePrivate`$grid$$ = 
      DynamicModule[{
       TypeSystem`NestedGrid`PackagePrivate`renderedGrid = Deploy[
          Style[
           Grid[{{
              Item[
               Pane[
                Annotation[
                 EventHandler[
                  MouseAppearance[
                   Mouseover["State", 
                    Style[
                    "State", FontColor -> 
                    RGBColor[
                    0.27450980392156865`, 0.5372549019607843, 
                    0.792156862745098]]], "LinkHand"], {"MouseClicked", 1} :> 
                  If[
                    TypeSystem`NestedGrid`PackagePrivate`checkInteractivity[
                    TypeSystem`NestedGrid`PackagePrivate`$state$$], 
                    TypeSystem`NestedGrid`PackagePrivate`updateState[
                    TypeSystem`NestedGrid`PackagePrivate`$state$$, 
                    TypeSystem`NestedGrid`PackagePrivate`$path$$, 
